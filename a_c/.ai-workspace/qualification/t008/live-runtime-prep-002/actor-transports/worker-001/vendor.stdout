","refused(constraint)","refused(basis)","refused(authority)","refused(capability)"]}},"required":["predicate","value","cause","core_value","source_parent","evidence","limits"],"type":"object"}]},"refusal":{"oneOf":[{"type":"null"},{"additionalProperties":false,"properties":{"code":{"enum":["acquisition_denied","authority_missing","basis_ambiguous","basis_missing","basis_stale","budget_exceeded","contract_violation","dependency_changed","digest_mismatch","domain_invalid","effect_completion_unknown","effect_unreconciled","evidence_publication_failed","history_incomplete","internal_failure","invalid_initialize","malformed_request","observation_unavailable","path_refused","request_identity_conflict","result_surface_denied","role_effect_denied","source_missing","target_conflict","transition_record_missing","unknown_operation","unqualified_operator","unsupported_check","unsupported_contract","unsupported_executor","unsupported_measurement","unsupported_protocol_method","unsupported_translation"]},"gaps":{"items":{"$ref":"#/$defs/Json"},"type":"array"},"reason":{"type":"string"},"source_refs":{"items":{"$ref":"#/$defs/Json"},"type":"array"}},"required":["code","reason","gaps","source_refs"],"type":"object"}]},"result":{"oneOf":[{"type":"null"},{"additionalProperties":false,"properties":{"artifact":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/ArtifactRef"}]},"value":{"$ref":"#/$defs/Json"}},"required":["artifact","value"],"type":"object"}]},"schema":{"const":"a_c.fd-support.response/1"},"status":{"enum":["ok","refused","error"]}},"required":["schema","id","operation","status","result","refusal","operation_outcome","evidence"],"type":"object"},"prerequisites":["trusted exact policy","fixed principal operation grant","exact acquired input basis"]}],"qualification":"provisional construction; independent integrated qualification and owner acceptance pending","refusal_codes":{"acquisition_denied":"refused(authority)","authority_missing":"refused(authority)","basis_ambiguous":"refused(basis)","basis_missing":"refused(basis)","basis_stale":"refused(basis)","budget_exceeded":"refused(constraint)","contract_violation":"refused(constraint)","dependency_changed":"refused(basis)","digest_mismatch":"refused(basis)","domain_invalid":"refused(basis)","effect_completion_unknown":"held(effect)","effect_unreconciled":"held(effect)","evidence_publication_failed":"held(observation)","history_incomplete":"refused(basis)","internal_failure":"held(observation)","invalid_initialize":null,"malformed_request":null,"observation_unavailable":"held(observation)","path_refused":"refused(constraint)","request_identity_conflict":"refused(constraint)","result_surface_denied":"refused(authority)","role_effect_denied":"refused(authority)","source_missing":"refused(basis)","target_conflict":"refused(constraint)","transition_record_missing":"refused(authority)","unknown_operation":null,"unqualified_operator":"refused(basis)","unsupported_check":"refused(capability)","unsupported_contract":"refused(capability)","unsupported_executor":"refused(capability)","unsupported_measurement":"refused(capability)","unsupported_protocol_method":null,"unsupported_translation":"refused(capability)"},"schema":"a_c.fd-support.inventory/1","unsupported":["other method cuts","semantic sufficiency certification","inferred semantic edges","arbitrary executable predicates","OS sandboxing","external producer authentication","MCP server/discover","benefit or acceptance claims"]}},"schema":"a_c.fd-support.response/1","status":"ok"}},"tool_result_meta":[{"id":"toolu_01PDmEyJyq5EF11zYakBaBLs","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
