\\\"engine\\\": \\\"workspace-regular-file\\\",\\n      \\\"object\\\": null,\\n      \\\"path\\\": \\\"specification/requirements/fd-support-tools.md\\\",\\n      \\\"root\\\": \\\"product\\\",\\n      \\\"selector\\\": null,\\n      \\\"sha256\\\": \\\"e3fcebd7e9fbc60dc36ed4c02ee834a96f14226af134809c938169d4712dfc23\\\"\\n    },\\n    {\\n      \\\"engine\\\": \\\"workspace-regular-file\\\",\\n      \\\"object\\\": null,\\n      \\\"path\\\": \\\"specification/requirements/fd-support-verification.md\\\",\\n      \\\"root\\\": \\\"product\\\",\\n      \\\"selector\\\": null,\\n      \\\"sha256\\\": \\\"3746e614a5ddc3f0a551e926998f16d6101cc037c5c43b879b4447b017a8dbdf\\\"\\n    }\\n  ],\\n  \\\"grant\\\": {\\n    \\\"engine\\\": \\\"workspace-regular-file\\\",\\n    \\\"object\\\": null,\\n    \\\"path\\\": \\\"GRANT.md\\\",\\n    \\\"root\\\": \\\"runtime\\\",\\n    \\\"selector\\\": null,\\n    \\\"sha256\\\": \\\"bc26d713a2f162e61aaf96011f0931fa6d9b1656e21c611e6c4f23265f5b3ac8\\\"\\n  },\\n  \\\"instructions\\\": {\\n    \\\"engine\\\": \\\"workspace-regular-file\\\",\\n    \\\"object\\\": null,\\n    \\\"path\\\": \\\"worker-instructions.md\\\",\\n    \\\"root\\\": \\\"runtime\\\",\\n    \\\"selector\\\": null,\\n    \\\"sha256\\\": \\\"66bb45f919bc4f9ead81076a4acafbc2d2a46566df73c89f43147967eb5cc4b4\\\"\\n  },\\n  \\\"method_frame\\\": {\\n    \\\"engine\\\": \\\"workspace-regular-file\\\",\\n    \\\"object\\\": null,\\n    \\\"path\\\": \\\"REFERENCE_FRAME.md\\\",\\n    \\\"root\\\": \\\"method\\\",\\n    \\\"selector\\\": {\\n      \\\"lines\\\": [\\n        281,\\n        440\\n      ]\\n    },\\n    \\\"sha256\\\": \\\"d64ee5c05aaefac346116c2e43eabf193dd84123f1d461070ecd378ce5e9b551\\\"\\n  },\\n  \\\"method_results\\\": {\\n    \\\"engine\\\": \\\"workspace-regular-file\\\",\\n    \\\"object\\\": null,\\n    \\\"path\\\": \\\"FOUNDATIONS.md\\\",\\n    \\\"root\\\": \\\"method\\\",\\n    \\\"selector\\\": {\\n      \\\"lines\\\": [\\n        790,\\n        1