 transport bound.\\nBOOTSTRAP_MAX_MESSAGE_BYTES = 1_048_576\\n\\n\\n@dataclass(frozen=True)\\nclass _Number:\\n    \\\"\\\"\\\"A finite transport number with its decimal/exponent token preserved.\\\"\\\"\\\"\\n    lexeme: str\\n\\n    def __post_init__(self) -> None:\\n        if not Decimal(self.lexeme).is_finite():\\n            raise ValueError(\\\"Nonfinite transport number\\\")\\n\\n\\nWire: TypeAlias = None | bool | int | str | _Number | list[\\\"Wire\\\"] | dict[str, \\\"Wire\\\"]\\nWireObject: TypeAlias = dict[str, Wire]\\n\\n\\ndef _wire_pairs(pairs: list[tuple[str, object]]) -> dict[str, object]:\\n    result: dict[str, object] = {}\\n    for key, value in pairs:\\n        if key in result:\\n\",\"coordinates\":{\"lines\":[1,50]},\"encoding\":\"utf8\",\"parent_sha256\":\"4d1ea7fe98ec1b53f2a19d9a2fef2b3fbb070624c955fbb1e9e48f5cc88011b1\",\"selected_sha256\":\"0587a2c3526836c899f6df7063ac5763fe7613f175a4143d9cf4efdc3ba0821b\",\"size_bytes\":1583,\"source\":{\"engine\":\"workspace-regular-file\",\"object\":null,\"path\":\"build_tenants/graphify/code/ac_support.py\",\"root\":\"product\",\"selector\":{\"lines\":[1,50]},\"sha256\":\"4d1ea7fe98ec1b53f2a19d9a2fef2b3fbb070624c955fbb1e9e48f5cc88011b1\"}}},\"schema\":\"a_c.fd-support.response/1\",\"status\":\"ok\"}"}]},"parent_tool_use_id":null,"session_id":"3d70f2d0-ea95-44de-98cd-d06e9ca7170b","uuid":"4ef49b81-d40b-42a9-b39e-bd884951928e","timestamp":"2026-10-19T04:59:46.184Z","tool_use_result":{"content":"{\"evidence\":{\"id\":\"sha256:604ca3b46fb471bf7c77b27aae91e84563c8ac2f69fe2f0e4b1fd8b1150332b7\",\"sha256\":\"604ca3b46fb471bf7c77b27aae91e84563c8ac2f69fe2f0e4b1fd8b1150332b7\"},\"id\":\"p2-read-adapter-001\",\"operation\":\"source.read\",\"operation_outcome\":{\"cause\":\"declared output available\",\"core_value\":\"satisfied\",\"evidence\":[],\"limits\":[\"output availability only; no semantic acceptance\"],\"predicate\":\"B(source.read)[request_sha256=36d4c48a810d3213f36465d33f741aa1379b1463243d1decf163540750