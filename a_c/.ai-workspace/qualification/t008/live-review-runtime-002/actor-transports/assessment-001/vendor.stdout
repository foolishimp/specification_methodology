   _deliver(runtime, request, response, target, wire=wire)\\n\\n\\nclass _Parser(argparse.ArgumentParser):\\n    def error(self, message: str) -> NoReturn:\\n        raise core.SupportError(\\\"malformed_request\\\", message)\\n\\n\\ndef _startup_options(parser: argparse.ArgumentParser, *, required: bool = False) -> None:\\n    parser.add_argument(\\\"--policy\\\", required=required, help=\\\"Trusted operator-selected policy JSON path\\\")\\n    parser.add_argument(\\\"--policy-sha256\\\", required=required, help=\\\"Exact expected policy byte digest\\\")\\n    parser.add_argument(\\\"--principal\\\", required=required, help=\\\"Fixed operator-selected requester principal\\\")\\n\\n\\ndef _parser() -> argparse.ArgumentParser:\\n    parser = _Parser(description=__doc__)\\n    _startup_options(parser)\\n    commands = parser.add_subparsers(dest=\\\"command\\\", required=True, parser_class=_Parser)\\n\",\"coordinates\":{\"lines\":[341,375]},\"encoding\":\"utf8\",\"parent_sha256\":\"4d1ea7fe98ec1b53f2a19d9a2fef2b3fbb070624c955fbb1e9e48f5cc88011b1\",\"selected_sha256\":\"ad6db17bc8decf420582661a7bdb5c238cf2d00f10dc80244dfa9e2f25fc41ca\",\"size_bytes\":1763,\"source\":{\"engine\":\"workspace-regular-file\",\"object\":null,\"path\":\"build_tenants/graphify/code/ac_support.py\",\"root\":\"product\",\"selector\":{\"lines\":[341,375]},\"sha256\":\"4d1ea7fe98ec1b53f2a19d9a2fef2b3fbb070624c955fbb1e9e48f5cc88011b1\"}}},\"schema\":\"a_c.fd-support.response/1\",\"status\":\"ok\"}"}]},"parent_tool_use_id":null,"session_id":"3d70f2d0-ea95-44de-98cd-d06e9ca7170b","uuid":"56968b0c-f798-4cdc-a751-2d786866061a","timestamp":"2026-10-19T04:59:55.352Z","tool_use_result":{"content":"{\"evidence\":{\"id\":\"sha256:3cc3b9f07904c29ddbf67bea3bc866aa5a7fb0226a121552dc81331ebef9b8f5\",\"sha256\":\"3cc3b9f07904c29ddbf67bea3bc866aa5a7fb0226a121552dc81331ebef9b8f5\"},\"id\":\"p2-read-adapter-p341\",\"operation\":\"source.read\",\"operation_outcome\":{\"cause\":\"declared output available\",\"core_va