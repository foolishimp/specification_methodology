(definitions[identity])\\n        if not _equal(definition[\\\"subject\\\"], subject) or not _equal(definition[\\\"basis\\\"], basis):\\n            raise SupportError(\\\"effect_unreconciled\\\", \\\"Selected reconciliation predicate does not bind this predecessor/current basis\\\", [{\\\"predicate_id\\\": identity}])\\n    supplied = load_artifact(runtime, evidence_ref, \\\"operation\\\")\\n    records, query = _history(runtime, \\\"operation\\\", {\\\"payload.request.operation\\\": \\\"checks.evaluate\\\"})\\n    records.append(supplied)\\n    if query[\\\"complete\\\"] is not True:\\n        raise SupportError(\\\"history_incomplete\\\", \\\"Reconciliation evidence history is incomplete\\\", [query])\\n    actual: list[JSON] = []\\n    for identity in selected:\\n        matches: list[Object] = []\\n\",\"coordinates\":{\"lines\":[2550,2575]},\"encoding\":\"utf8\",\"parent_sha256\":\"78f70fa8da1a29ce4fadc8cb78743c2293bf7f35947b353218dc2a6b1e03ae94\",\"selected_sha256\":\"d258e6dc743c13b9bc60361a960dc302125bb9d957b208a0f84b25ef156004bc\",\"size_bytes\":1657,\"source\":{\"engine\":\"workspace-regular-file\",\"object\":null,\"path\":\"build_tenants/graphify/code/ac_support_core.py\",\"root\":\"product\",\"selector\":{\"lines\":[2550,2575]},\"sha256\":\"78f70fa8da1a29ce4fadc8cb78743c2293bf7f35947b353218dc2a6b1e03ae94\"}}},\"schema\":\"a_c.fd-support.response/1\",\"status\":\"ok\"}"}]},"parent_tool_use_id":null,"session_id":"3d70f2d0-ea95-44de-98cd-d06e9ca7170b","uuid":"d3161aaf-e54a-4120-8388-5334c35602fb","timestamp":"2026-10-19T04:58:24.684Z","tool_use_result":{"content":"{\"evidence\":{\"id\":\"sha256:e8522c7bda5d26f92546e66e597668b261b807adae54595a475b69d6c620ba64\",\"sha256\":\"e8522c7bda5d26f92546e66e597668b261b807adae54595a475b69d6c620ba64\"},\"id\":\"p2-read-core-p2550\",\"operation\":\"source.read\",\"operation_outcome\":{\"cause\":\"declared output available\",\"core_value\":\"satisfied\",\"evidence\":[],\"limits\":[\"output availability only; no semantic a