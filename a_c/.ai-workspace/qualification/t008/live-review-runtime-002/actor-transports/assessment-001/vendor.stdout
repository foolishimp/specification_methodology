ntry in applicable if _equal(as_object(entry[\"result\"])[\"key\"], f[\"key\"]) and constraint[\"obligation_id\"] in as_list(as_object(entry[\"assessment\"])[\"coverage\"])]\n                if admitted:\n                    constraint_failures.append({\"failure\": f, \"required_constraint\": constraint, \"obligation\": obligation_records[text(constraint[\"obligation_id\"])]})\n    if core_value == \"satisfied\":\n        if basis_disagreement:\n","coordinates":{"lines":[1476,1530]},"encoding":"utf8","parent_sha256":"78f70fa8da1a29ce4fadc8cb78743c2293bf7f35947b353218dc2a6b1e03ae94","selected_sha256":"30093b824ad1d711ead1156af3a3e75407c8b3e58d6bc95aed85c9e4de5b2275","size_bytes":4371,"source":{"engine":"workspace-regular-file","object":null,"path":"build_tenants/graphify/code/ac_support_core.py","root":"product","selector":{"lines":[1476,1530]},"sha256":"78f70fa8da1a29ce4fadc8cb78743c2293bf7f35947b353218dc2a6b1e03ae94"}}},"schema":"a_c.fd-support.response/1","status":"ok"}},"tool_result_meta":[{"id":"toolu_01YZJjpw8A86r9vfNapK1Yay","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
