ordering. |\n\n","coordinates":{"lines":[1900,1930]},"encoding":"utf8","parent_sha256":"b38eedbe85ee32ef11d945d6a60ed3f9bb2312ac10e873d8ddc9b7986744a005","selected_sha256":"d5e992b5f515eebcd039c4d5b05c4c43e992a9024b8bb0247b1a5afd8a51591e","size_bytes":5310,"source":{"engine":"workspace-regular-file","object":null,"path":"build_tenants/graphify/design/fd-support.md","root":"product","selector":{"lines":[1900,1930]},"sha256":"b38eedbe85ee32ef11d945d6a60ed3f9bb2312ac10e873d8ddc9b7986744a005"}}},"schema":"a_c.fd-support.response/1","status":"ok"}},"tool_result_meta":[{"id":"toolu_01RoBwr5iZ1tT4jiWQtGNALE","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
