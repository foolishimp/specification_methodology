ppend(supplied)\\n    if query[\\\"complete\\\"] is not True:\\n        raise SupportError(\\\"history_incomplete\\\", \\\"Reconciliation evidence history is incomplete\\\", [query])\\n    actual: list[JSON] = []\\n    for identity in selected:\\n        matches: list[Object] = []\\n\",\"coordinates\":{\"lines\":[2550,2575]},\"encoding\":\"utf8\",\"parent_sha256\":\"78f70fa8da1a29ce4fadc8cb78743c2293bf7f35947b353218dc2a6b1e03ae94\",\"selected_sha256\":\"d258e6dc743c13b9bc60361a960dc302125bb9d957b208a0f84b25ef156004bc\",\"size_bytes\":1657,\"source\":{\"engine\":\"workspace-regular-file\",\"object\":null,\"path\":\"build_tenants/graphify/code/ac_support_core.py\",\"root\":\"product\",\"selector\":{\"lines\":[2550,2575]},\"sha256\":\"78f70fa8da1a29ce4fadc8cb78743c2293bf7f35947b353218dc2a6b1e03ae94\"}}},\"schema\":\"a_c.fd-support.response/1\",\"status\":\"ok\"}","structuredContent":{"evidence":{"id":"sha256:e8522c7bda5d26f92546e66e597668b261b807adae54595a475b69d6c620ba64","sha256":"e8522c7bda5d26f92546e66e597668b261b807adae54595a475b69d6c620ba64"},"id":"p2-read-core-p2550","operation":"source.read","operation_outcome":{"cause":"declared output available","core_value":"satisfied","evidence":[],"limits":["output availability only; no semantic acceptance"],"predicate":"B(source.read)[request_sha256=22192c685461ec738021cc2d8e71b4ae78235a7320c8f85361918418e80c795c]: declared output availability","source_parent":{"clause":"results","member":"FOUNDATIONS.md","sha256":"fd2d895f90eb39bda0950c1c7ff02057ef5d8ae73fcbc5b3203f7e99081d6e3f"},"value":"returned"},"refusal":null,"result":{"artifact":null,"value":{"acquisition":{},"content":"\n\ndef verify_reconciliation(runtime: Runtime, evidence_ref: Object, predecessor_ref: Object,\n                          grant: Object, basis: Object) -> Object:\n    predecessor = load_artifact(runtime, predecessor_ref, \"attempt\")\n    _profile_basis(runtime, basis)\n    admission = _admission_selection(grant[\"admission\"])\n    selected = _strings(admission.get(\"required_reconciliation_predicates\", []))\n    subject: Object = document({\"id\": predecessor_ref[\"id\"], \"sha256\": predecessor_ref[\"sha256\"]})\n    definitions = as_object(runtime.policy[\"predicates\"])\n    if not selected:\n        raise SupportError(\"effect_unreconciled\", \"Grant has no selected predecessor-bound reconciliation contract\")\n    for identity in selected:\n        if identity not in definitions:\n            raise SupportError(\"effect_unreconciled\", \"Selected reconciliation predicate is not registered\", [{\"predicate_id\": identity}])\n        definition = as_object(definitions[identity])\n        if not _equal(definition[\"subject\"], subject) or not _equal(definition[\"basis\"], basis):\n            raise SupportError(\"effect_unreconciled\", \"Selected reconciliation predicate does not bind this predecessor/current basis\", [{\"predicate_id\": identity}])\n    supplied = load_artifact(runtime, evidence_ref, \"operation\")\n    records, query = _history(runtime, \"operation\", {\"payload.request.operation\": \"checks.evaluate\"})\n    records.append(supplied)\n    if query[\"complete\"] is not True:\n        raise SupportError(\"history_incomplete\", \"Reconciliation evidence history is incomplete\", [query])\n    actual: list[JSON] = []\n    for identity in selected:\n        matches: list[Object] = []\n","coordinates":{"lines":[2550,2575]},"encoding":"utf8","parent_sha256":"78f70fa8da1a29ce4fadc8cb78743c2293bf7f35947b353218dc2a6b1e03ae94","selected_sha256":"d258e6dc743c13b9bc60361a960dc302125bb9d957b208a0f84b25ef156004bc","size_bytes":1657,"source":{"engine":"workspace-regular-file","object":null,"path":"build_tenants/graphify/code/ac_support_core.py","root":"product","selector":{"lines":[2550,2575]},"sha256":"78f70fa8da1a29ce4fadc8cb78743c2293bf7f35947b353218dc2a6b1e03ae94"}}},"schema":"a_c.fd-support.response/1","status":"ok"}},"tool_result_meta":[{"id":"toolu_01JwTyxtd99SdorbDcZfmmD9","permission_decision"