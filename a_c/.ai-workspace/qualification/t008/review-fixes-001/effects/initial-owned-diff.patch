+class PublicRetryTests(unittest.TestCase):
+    """CLI composition controls, using real receipts and a local process only."""
+
+    def setUp(self) -> None:
+        self.temp = tempfile.TemporaryDirectory(prefix="ac-public-retry-")
+        self.root = Path(self.temp.name).resolve()
+        self.f = Fixture(self.root)
+        self.sequence = 0
+        self.policy_version = 0
+        self.policy_path = self.root / "not-selected.json"
+        self.policy_sha = ""
+        self.code = Path(__file__).resolve().parents[1] / "code"
+        self.python = Path(sys.executable).resolve()
+        fixture = Path(__file__).resolve().parent / "support_fixtures" / "local_actor.py"
+        dependency = self.f.write("inputs/actor.py", fixture.read_bytes())
+        self.target = self.f.workspace / "outputs" / "counter.txt"
+        executor = c.as_object(c.as_object(self.f.policy["executors"])["registered"])
+        executor["argv"] = [str(self.python), str(self.f.workspace / "inputs" / "actor.py"), "count", str(self.target)]
+        executor["dependencies"] = [dependency]
+        executor["settings"] = {"timeout_ms": 1500, "termination_grace_ms": 100}
+        self._select_policy()
+
+    def tearDown(self) -> None:
+        custody = os.environ.get("AC_SUPPORT_EFFECTS_PROOF_ROOT")
+        if custody is not None:
+            destination = Path(custody).resolve() / self.id().replace(".", "_")
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copytree(self.root, destination)
+            (destination / "CUSTODY.json").write_bytes(c.canonical({
+                "test": self.id(), "original_root": str(self.root),
+                "standing": "Actual public CLI/local process fixture evidence; no F_P usability or production retry.",
+                "source_sha256": hashlib.sha256((self.code / "ac_support_core.py").read_bytes()).hexdigest(),
+            }))
+        self.temp.cleanup()
+
+    def _select_policy(self) -> None:
+        self.policy_version += 1
+        self.policy_path = self.root / ("policy-" + str(self.policy_version) + ".json")
+        raw = c.canonical(self.f.policy)
+        self.policy_path.write_bytes(raw)
+        self.policy_sha = hashlib.sha256(raw).hexdigest()
+
+    def _public(self, operation: str, arguments: c.Object,
+                before_supervisor: tuple[Path, bytes] | None = None) -> c.Object:
+        self.sequence += 1
+        folder = self.root / "calls" / (str(self.sequence).zfill(3) + "-" + operation)
+        folder.mkdir(parents=True)
+        request: c.Object = {"schema": c.REQUEST, "id": "public-" + str(self.sequence),
+                             "operation": operation, "arguments": arguments}
+        request_path = folder / "request.json"
+        request_path.write_bytes(c.canonical(request))
+        argv = [str(self.python), "-B", str(self.code / "ac_support.py"),
+                "--policy", str(self.policy_path), "--policy-sha256", self.policy_sha,
+                "--principal", "executive", "call", "--request", str(request_path)]
+        if before_supervisor is not None:
+            material, replacement = before_supervisor
+            harness = folder / "pre-supervisor-barrier.py"
+            harness.write_text(
+                "import sys,time\nfrom pathlib import Path\n"
+                f"sys.path.insert(0,{str(self.code)!r})\n"
+                "import ac_support as a,ac_support_effects as e\n"
+                "original=e._fault\n"
+                "def barrier(point):\n"
+                " if point=='supervisor:before_spawn':\n"
+                f"  Path({str(material)!r}).write_bytes({replacement!r})\n"
+                f"  Path({str(folder / 'barrier-reached.txt')!r}).write_text(str(time.time_ns()))\n"
+                " original(point)\n"
+                "e._fault=barrier\nraise SystemExit(a.main())\n")
+            argv[2] = str(harness)
+        started = time.time_ns()
+        process = subprocess.run(argv, cwd=self.root, capture_output=True, timeout=10,
+                                 env={"PATH": os.defpath, "PYTHONDONTWRITEBYTECODE": "1"}, check=False)
+        (folder / "stdout.bin").write_bytes(process.stdout)
+        (folder / "stderr.bin").write_bytes(process.stderr)
+        (folder / "execution.json").write_bytes(c.canonical(c.document({
+            "argv": argv, "started_ns": started, "ended_ns": time.time_ns(),
+            "returncode": process.returncode, "policy_sha256": self.policy_sha,
+        })))
+        response = c.as_object(c.parse_json(process.stdout))
+        self.assertIsNotNone(response["evidence"], response)
+        return response
+
+    def _material_case(self, kind: str, stage: str, *, missing: bool = False) -> None:
+        case = self.root / (kind + "-" + stage + ("-missing" if missing else ""))
+        case.mkdir()
+        self.f = Fixture(case)
+        dependency = self.f.write("inputs/actor.py", (Path(__file__).resolve().parent / "support_fixtures/local_actor.py").read_bytes())
+        self.target = self.f.workspace / "outputs/counter.txt"
+        executor = c.as_object(c.as_object(self.f.policy["executors"])["registered"])
+        executor["argv"] = [str(self.python), str(self.f.workspace / "inputs/actor.py"), "count", str(self.target)]
+        executor["dependencies"] = [dependency]
+        executor["settings"] = {"timeout_ms": 1500, "termination_grace_ms": 100}
+        self._select_policy()
+        sources: list[c.JSON] = []; models: list[c.JSON] = []
+        host: c.Object = {"state": "unknown", "bytes": None, "evidence": None}
+        capacity: c.JSON = None
+        if kind == "extra-source":
+            material = self.f.write("inputs/material.txt", b"deciding input one")
+            sources = [material]; replacement = b"incompatible deciding input two"
+        elif kind == "model":
+            material = self.f.model_source
+            models = [{"model": self.f.model, "selections": [{"seeds": ["urn:a-c:toy:object:a"]}]}]
+            changed = c.as_object(c.parse_json((self.f.workspace / "inputs/model.json").read_bytes()))
+            changed["id"] = c.text(changed["id"]) + ":changed"
+            replacement = c.canonical(changed)
+        else:
+            material = self.f.write("inputs/host-bound.json", {"claimed_bytes": 0})
+            host = {"state": "known", "bytes": 0, "evidence": material}; capacity = 1000000
+            replacement = c.canonical({"claimed_bytes": 2000000})
+        material_path = self.f.workspace / c.text(material["path"])
+        assembled = self._public("context.assemble", {"packet": self.f.packet(), "models": models, "sources": sources, "late_acquisition": [], "envelope": {"capacity_bytes": capacity, "boundary": "executor-stdin-utf8", "host_context": host}})
+        value = self._ok(assembled)
+        if kind == "fit":
+            self.assertEqual(c.as_object(c.as_object(value["fit"])["judgment"])["core_value"], "satisfied")
+        context = c.as_object(c.as_object(assembled["result"])["artifact"])
+        if stage == "admission":
+            if missing:
+                material_path.unlink()
+            else:
+                material_path.write_bytes(replacement)
+        prepared = self._public("contract.preflight", {"context": context, "grant_id": "work", "executor_id": "registered", "result_key": "material-input", "observations": []})
+        if stage == "admission":
+            self.assertNotEqual(prepared["status"], "ok", prepared)
+        else:
+            self._ok(prepared)
+            receipt = c.as_object(c.as_object(prepared["result"])["artifact"])
+            envelope = c.as_object(c.parse_json((self.f.evidence / "objects" / (c.text(receipt["sha256"]) + ".json")).read_bytes()))
+            self.assertIn(material, c.as_list(c.as_object(c.as_object(envelope["payload"])["recheck"])["sources"]))
+            if stage == "dispatch":
+                material_path.write_bytes(replacement)
+            dispatched = self._public("dispatch.start", {"preflight": receipt}, (material_path, replacement) if stage == "supervisor" else None)
+            if stage == "dispatch":
+                self.assertNotEqual(dispatched["status"], "ok", dispatched)
+            else:
+                self._ok(dispatched)
+                attempt = c.as_object(c.as_object(dispatched["result"])["artifact"])
+                if stage == "unchanged":
+                    observed = self._finished(attempt)
+                    self.assertEqual(c.as_object(self._ok(observed)["process_end"])["returncode"], 0)
+                    self.assertEqual(self.target.read_text(), "1")
+                else:
+                    deadline = time.monotonic() + 5
+                    events: list[c.JSON] = []
+                    while time.monotonic() < deadline:
+                        observation = self._ok(self._public("dispatch.observe", {"attempt": attempt, "after_event": 0}))
+                        events = c.as_list(observation["events"])
+                        if any(c.as_object(event)["kind"] == "exception" for event in events):
+                            break
+                        time.sleep(0.03)
+                    self.assertTrue(any(c.as_object(event)["kind"] == "exception" for event in events), events)
+                    self.assertFalse(any(c.as_object(event)["kind"] in ("actor_launch_intent", "actor_started") for event in events), events)
+                    self.assertTrue(list((self.root / "calls").glob("*/barrier-reached.txt")))
+        if stage != "unchanged":
+            self.assertFalse(self.target.exists())
+            refused = self._public("source.read", {"source": material, "encoding": "utf8"})
+            self.assertEqual(c.as_object(refused["refusal"])["code"], "source_missing" if missing else "digest_mismatch")
+
+    def test_extra_source_currentness_at_admission_dispatch_and_supervisor(self) -> None:
+        for stage in ("unchanged", "admission", "dispatch", "supervisor"):
+            with self.subTest(stage=stage):
+                self._material_case("extra-source", stage)
