ion:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a2632e55759e01662eacb49ef3e021d0\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:result_domain_dependency\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"A member or profile combines results.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":927,\"path\":\"standards/FOUNDATIONS.md\",\"quote\":\"It is defined here once, over the\\ncore. A member or profile that combines results applies this rule and\\ndeclares only the choices it leaves open\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/FOUNDATIONS.md#FOUNDATIONS%2F4.%20Algebra%2FConjunction%20of%20results\",\"start_line\":925}],\"kind\":\"result_domain_dependency\",\"meaning\":\"Conjunction is defined over the shared core and preserves its distinctions while applying only expressly open policy choices.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:27e46433dafe1a605ba0856f6d082557\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:73f26e79b171732285e45607615def72\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:463285e19e04350e5c7174affb85f439","key":740,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:463285e19e04350e5c7174affb85f439\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:declared_decision_governance\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"The declared rule remains within the common conjunction law.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":1029,\"path\":\"standards/FOUNDATIONS.md\",\"quote\":\"A conjunction declares which results are mandatory; how\\nconflict and indeterminacy are handled; which basis relations must agree,\\nresults on different bases combining only under a declared coherent\\ncomposite basis (§2, Basis); which decision authority owns the\\nconjunction; how results that are not mandatory count; and whether any\\nresult may veto or defer the decision.\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/FOUNDATIONS.md#FOUNDATIONS%2F4.%20Algebra%2FConjunction%20of%20results\",\"start_line\":1024}],\"kind\":\"declared_decision_governance\",\"meaning\":\"The particular declared rule determines mandatory inputs and permitted policy choices for its conjunction; it confers no contributor semantic authority.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:efae46f9c8f159bf2892e36617e85953\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:27e46433dafe1a605ba0856f6d082557\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a2f7ddfb42703b3ea2429f3254729545","key":741,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a2f7ddfb42703b3ea2429f3254729545\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:conditional_composition_support\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"Steps are composed under an outer contract.\",\"Refinement premises hold for support of the outer predicate.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":1038,\"path\":\"standards/FOUNDATIONS.md\",\"quote\":\"The result of composed steps for the outer\\npredicate is the conjunction of the steps' results, with the outer\\ncontract's obligations as the required coverage. That each step returned\\n`satisfied` supports the outer predicate only where the refinement's\\npremises hold ([ACTIVATION §4](ACTIVATION.md#4-totality-and-refinement),\\nRefinement).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/FOUNDATIONS.md#FOUNDATIONS%2F4.%20Algebra%2FConjunction%20of%20results\",\"start_line\":1033}],\"kind\":\"conditional_composition_support\",\"meaning\":\"The result for a construction's outer predicate uses conjunction with outer-contract obligations as required coverage; local satisfaction supports the outer claim only under the applicable refinement premises.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bcbce5d0a737828a451a5a279b5244d0\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:27e46433dafe1a605ba0856f6d082557\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:338ecff379331b198013f9e