:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"residuals","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:9bd36d460375d4bc7b8af62b50eb1e99","key":1843,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"consequence\":\"No transformation was applied and no preservation, partition, migration, residual disposition or successor-admission claim is established. Operational verification would require the exact models, traversal, signature, owned relations and evidence.\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:9bd36d460375d4bc7b8af62b50eb1e99\",\"invalidation\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:invalidation:source-or-interpretation-change\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:residual-kind:authored-uncertainty\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"re_entry\":[],\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"subject\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:aea0ac1826c9dc379a8b046db93f8e1d\",\"uncertainty\":{\"grounding\":[{\"end_line\":862,\"path\":\"standards/AXIOMATIC_CALCULUS.md\",\"quote\":\"Failure to establish any model identity, basis, population, local or\\nexternal partition, equality, external-resolution witness, residual or\\ncodomain equation refuses (P4b, P5).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/AXIOMATIC_CALCULUS.md#AXIOMATIC_CALCULUS%2F4.%20Fundamental%20laws%2FAC-013%20Transformation\",\"start_line\":860}],\"statement\":\"Record fields, local/external partition equations and equality conditions are retained textually; this finite