generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:16623aa43b9cd5ca49e10295ac5d9f69","key":839,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:16623aa43b9cd5ca49e10295ac5d9f69\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:recommended_qualification_dependency\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[],\"exceptions\":[],\"grounding\":[{\"end_line\":734,\"path\":\"standards/WORLD_MODEL.md\",\"quote\":\"No object attribute\\nshould exist without ledger support; no ledger entry should exist without\\nassurance; no assurance should exist without traceable source (P6, P4b).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/WORLD_MODEL.md#WORLD_MODEL%2F8.%20Representation%20and%20publication%2FMaterialisation%20law\",\"start_line\":732}],\"kind\":\"recommended_qualification_dependency\",\"meaning\":\"Ledger entries should have assurance accepting their semantic claims; the governing flag records an explicit source rule without strengthening 'should'.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:861bbbd5b7d29d5df06de8f92d683ed1\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:3faa4fb493acae06174655ecb783af0f\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"u