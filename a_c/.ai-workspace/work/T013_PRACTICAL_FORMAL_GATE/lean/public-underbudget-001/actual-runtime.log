c3f7d:record:d5bd53ed4a271bf6fe95e17c01d7ac11\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:declared_profile_to_tier_two_binding\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"A boundary is governed by this profile.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":42,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"Direction: profile to tier 2; preserved meaning: the tier-2 law applies\\nunchanged to the bound objects; narrowed scope: boundaries this profile\\ngoverns; invalidation: a change of this profile's definition of any bound\\nobject re-evaluates the binding\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE\",\"start_line\":39}],\"kind\":\"declared_profile_to_tier_two_binding\",\"meaning\":\"Bind ASSURANCE carrier inventory to IACS, accepted ontology/design to accepted Ontology and target design, domain/sequence/state projections to the three-view design asset, and decision-completeness/co-evolution conditions to the two §5 predicates. Tier-2 law applies unchanged; changed bound-object definitions require binding re-evaluation.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:b53ecd7f95b44bc7ffed5180d491d116\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:ac55c80211cf131cf378a4be5f1205d3\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:35135b4379cec98f211b1adf4c888032","key":704,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:35135b4379cec98f211b1adf4c888032\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:refines_owned_core_rule\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"Only within boundaries governed by this profile.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":143,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"[SPEC_METHOD §2 Realisation shape](SPEC_METHOD.md#realisation-shape),\\nscoped to boundaries this profile governs; every rule below refines it\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F1.%20Purpose%20and%20position%2FCore%20rule\",\"start_line\":141}],\"kind\":\"refines_owned_core_rule\",\"meaning\":\"The profile's rules refine the once-owned SPEC_METHOD realisation core rule, retaining that owner and the profile's applicability boundary.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:803107dc0e8102b1fc0c5d9126108f77\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:1f5a3d72754c41847528656b6d22a2cc\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:c89ea04b3d87eab908b494d30fd7648d","key":705,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:c89ea04b3d87eab908b494d30fd7648d\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:authored_premise_dependency\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"The profile is adopted for the boundary; each row retains its cited instance premises.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":189,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"| Premises, with standing | Consequence that follows | Rule in this member that states it | Added domain or policy choice, and its owner | Pillar |\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F1.%20Purpose%20and%20position%2FFoundation%20to%20law\",\"start_line\":189}],\"kind\":\"authored_premise_dependency\",\"meaning\":\"The table explicitly derives these consequence families from these premises, without deriving the separate choice column: scope/core [P6,P1,F10,I1,F18]; results/records [P5,P6,F3]; closure [P3,P1,P6,I2]; typing [P4a,P1,P6,I2]; Ontology/projections [P1,P3,P6,F10,I1]; sequencing [P2,P0(candidate-output premise),P6,F2,I3]; frame/reconstruction [P4b,P0,F2,I3]; constructability/selection [P2,P5,P6,I4]; lifecycle/functions [P3,P5,P4a]; authority/admission [P6,P4b,P3,F1,F2]; Prime [P3,P6,P2]; IACS [P3,P2,F6]; three-view evaluation [P1,P5,P6,F3,I3]; gate [P6,P0(candidate-output premise),F3,F4,F6]; computational projection [P1,P3,P6,P2,I2 plus the instance premise that domain views omit realising machinery]; module taxonomy [P0,P1,I3]; immutable carriers/totality [P3,P5,I2]; effects/coupling [P6,P1,I2]; governance/strategy [P0(boundary commitment),P6]; optimisation [P2,P6]; recurrence [P2,P3,F13,I4]; post-ticket review [P6,P2,F3,F4,F6]; interface/proxy [P6,P1,P3]; review [P6,P1,P2]; adoption [P6,P2,F12,I1]; identity defaults [P3,P6,F8]. Governing denotes the source's stated premise dependency, not an interpreter proof of derivation.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:e33b4c2ac78d7102c41dd630b46098a2\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:af6461c6cd976f9897df29c33b0d379b\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:ab88a2ed1f0f2795dadafe8c0dd5e480","key":706,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:ab88a2ed1f0f2795dadafe8c0dd5e480\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:discovery:applied_by_at_named_locus\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"Each cited consumer applies only at its stated locus and applicability.\"],\"exceptions\":[\"The source expressly says no section of another member applies governance/strategy separation, opportunistic optimisation, post-ticket review or interface/proxy rules; their external governing laws do not thereby become consumers of these refinements.\"],\"grounding\":[{\"end_line\":261,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"Each consumer applies the rule and decides nothing the owning section does\\nnot (P2, P6).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F1.%20Purpose%20and%20position%2FFoundation%20to%20law\",\"start_line\":260}],\"kind\":\"applied_by_at_named_locus\",\"meaning\":\"Stated row consumers: scope/core → SPEC_METHOD §2 Realisation shape, UX §2/relationships, WORLD_MODEL §4, ODD §11.5D A15; results → reconstruction, cross-view evaluation, gate; closure → Adoption's explicit migration ADR/ticket evaluators, review questions 4,5,7,9,17–19 and ingress/truth checks; typing → UX §10's six obligatory ingress seams, CONFORMANCE §5 discriminator 11, questions 12,18; Ontology → PRODUCT_DEFINITION §3 subordination, ASSURANCE §§14–15 Ontology/reference mapping evidence, Adoption completion assets, questions 21,41–48; sequencing → SPEC_METHOD §4 Procedures, ASSURANCE §14, gate precondition, question 40; frames → ACTIVATION §1 Intake, EXECUTIVE_BASELINE §§8,14, post-ticket material-input change; selection → EXECUTIVE_BASELINE §§11,14, ASSURANCE §14's no-hidden-controller compensation, checklist, questions 49–56; lifecycle/functions → ASSURANCE §15 unit trace, Ontology evidence, questions 42,44,46; admission → ACTIVATION Intake, ODD §11.5B ABG specialisation, authority matrix, question 43; Prime → SPEC_METHOD §3 no prerequisite/experiment waiver, carrier consolidation's IACS-first, evidence/Adoption whole-family/domain prerequisites, questions 10,45; IACS → ASSURANCE §§2,7,14,15 inventory binding, UX §12 step 3/§14 question 13, WORLD_MODEL §4 candidate Markov cut, questions 13–16,22; three views → ASSURANCE §§7,14,15 three-view binding, UX same adoption/review loci, questions 35–39; gate → SPEC_METHOD reconstruction litmus (no waiver/no unchanged-view recreation), ASSURANCE §14 acceptance before retained implementation, ontology/decision-completeness clauses, post-ticket reuse and checklist; computational projection → ACTIVATION Intake, ASSURANCE §13 complete producer-consumer path; taxonomy → ASSURANCE §§2,7,14–16 module ownership/unit proof, Adoption classification, question 23; immutability/totality → UX §2, question 6, carrier/purity checklist; effects/coupling → UX §§6,2, questions 1–3, checklist; governance → question 20 and observability checklist only; optimisation → questions 24–25 and cleanup checklist only, with SPEC_METHOD §4 owning cross-boundary re-entry; recurrence → ASSURANCE §13, selection, Prime contraction, taxonomy, questions 26–27; post-ticket → question 28 and closure checklist only, consuming ACTIVATION §4/EVALUATION §5; interface/proxy → questions 8,11 and one-owner checklist only, citing SPEC_METHOD §7; review → ACTIVATION §2 prompt specialisation and Adoption migration criteria; adoption → SPEC_METHOD §2, ASSURANCE §14, UX §2's combined UX-module versus design-only non-UX scope; identity defaults → IDENTITY §7 Derived domain overrides. ASSURANCE §§14–16 consume through the head binding; UX refines typing/realisation for UX surfaces; recurrence refines TICKETS §6; selection refines FOUNDATIONS Shared machinery; Intake consumes frame evidence where the profile governs.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:af6461c6cd976f9897df29c33b0d379b\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:7aeab816d4886c4c3a6f91c67d6ca97c\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bf693e8cbc09fbdbfb3bb0ed464552bb","key":707,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bf693e8cbc09fbdbfb3bb0ed464552bb\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:limits_consumer_authority\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"A named consumer applies a row.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":261,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"Each consumer applies the rule and decides nothing the owning section does\\nnot (P2, P6).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F1.%20Purpose%20and%20position%2FFoundation%20to%20law\",\"start_line\":260}],\"kind\":\"limits_consumer_authority\",\"meaning\":\"Application preserves the owning section's decision scope; consumption does not grant additional decisions or transfer ownership.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:af6461c6cd976f9897df29c33b0d379b\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:7aeab816d4886c4c3a6f91c67d6ca97c\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:2ecf05dab6c680c7d6f82657673fdba5","key":708,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:2ecf05dab6c680c7d6f82657673fdba5\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:acceptance_precondition\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"One governed boundary's sequencing or gate readiness is considered.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":508,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"Design sequencing follows `decision_complete(B)`, not one global authoring\\norder (P2, P6).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F5.%20Ontology-first%20design%2FProportional%20design%20sequencing\",\"start_line\":505}],\"kind\":\"acceptance_precondition\",\"meaning\":\"Decision completeness controls lawful co-evolution and is the design gate's acceptance criterion; it does not itself issue an owner acceptance verdict.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:b8bc7d3a0ac93efb8d5099e60d3dfcad\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:17af2f81977b5a255c4155d8b1c3abd0\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:14448900a99299a9a47eab0a15a9fd88","key":709,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:14448900a99299a9a47eab0a15a9fd88\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:frame_type_derives_from_same_type\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"A material design frame derives from accepted governing frames.\"],\"exceptions\":[\"One governing frame is lawful for genuinely hierarchical structure but is not required.\"],\"grounding\":[{\"end_line\":622,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"A frame may derive from more than one governing frame.\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F5.%20Ontology-first%20design%2FBounded%20frame%20conservation%20%28UP-017%29\",\"start_line\":615}],\"kind\":\"frame_type_derives_from_same_type\",\"meaning\":\"Instances of design frames can derive from multiple instances of this frame category. Persistence may belong to lifecycle and operational-consistency frames; admission to domain-transition and runtime-authority frames; shared callables may serve sibling domains without subordination to one. This type-level relation does not assert that a particular frame governs itself.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a47b4123e6da5cd417b5ac30e436cd15\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a47b4123e6da5cd417b5ac30e436cd15\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:ee8174470b3a95a338f5332a38b12065","key":710,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:ee8174470b3a95a338f5332a38b12065\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:discovery:supplies_missing_decision_relation\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"A consequential entity-transition domain is covered.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":866,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"The authority matrix names who admits; it does not by itself establish the\\nrelation that decides which candidate transformation becomes durable\\nentity truth.\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F5.%20Ontology-first%20design%2FTransformation%20admission%20completeness%20%28UP-016%29\",\"start_line\":863}],\"kind\":\"supplies_missing_decision_relation\",\"meaning\":\"The complete admission relation supplements the matrix's who-admits information; plausible role completion alone cannot establish admission uniqueness or completeness.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:d2d50ec064f37926a95bcc1bbbb51190\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:094d58ecf1ad6d4feccfdf69b1667180\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a688cc60971016f2c3010c48ab63da1e","key":711,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a688cc60971016f2c3010c48ab63da1e\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:governs_realisation_projection\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"Realisation units implement accepted atoms.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":989,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"One atom may project into several realisation\\nunits, and one realisation unit may implement several atoms, provided the\\nmapping is explicit and introduces no rival meaning or authority.\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F5.%20Ontology-first%20design%2FPrime%20semantic%20atoms%20and%20admitted%20domain\",\"start_line\":987}],\"kind\":\"governs_realisation_projection\",\"meaning\":\"Accepted atoms govern explicit many-to-many realisation mappings within their admitted domains; the projection adds no rival meaning or authority.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:6814b648516f3fa537517748d3181520\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:982faaba8542901a360f970f115eecef\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:4c8d3e94555c3b554baf68563a7920c8","key":712,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:4c8d3e94555c3b554baf68563a7920c8\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:derives_from\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"A design projection is authored.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":1070,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"Each de