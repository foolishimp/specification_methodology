:"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:b0b9772ee0738956fdcfc236a73267f9","key":846,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:b0b9772ee0738956fdcfc236a73267f9\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:governing:requires_separate_activation_for_construction\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"The actor occupying Executive is to perform construction.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":173,\"path\":\"standards/templates/PROJECT_REFERENCE_FRAME_BASIS_TEMPLATE.md\",\"quote\":\"Executive performs no file or Git mutation. The same actor may construct only\\nafter entering a separately bound Writer activation with the inherited exact\\ngrant. Changing roles does not create authority or independent assessment.\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/templates/PROJECT_REFERENCE_FRAME_BASIS_TEMPLATE.md#Project%20Reference-Frame%20Basis%2FActivation%20And%20Return%20Topology\",\"start_line\":171}],\"kind\":\"requires_separate_activation_for_construction\",\"meaning\":\"Moving from Executive coordination to construction requires a separate Writer activation carrying the inherited exact grant; the relation is a source-prescribed prerequisite, not a grant or performed transition.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:fd824e786e3c2b80628328c7551a3b8d\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:ffde74ec9ef3edc98acf5d94b8ee5f6b\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":