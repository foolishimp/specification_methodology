57c3f7d:record:7aa09b14e24e7a0ec5cb69b02e8055b2\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"sort\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:sort:authored-concept\",\"value\":{\"conditions\":[],\"definition\":\"Bounded activation packet based on REFERENCE_FRAME §11. Worker activation additionally binds sufficient execution intake; Reviewer activation binds exact claim and assurance conditions; Executive activation binds current Product-role map, mandate, evaluation frontier, result and triage ledger, priority and boundary policy, conjunction and disposition grant.\",\"exceptions\":[],\"grounding\":[{\"end_line\":1679,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"Every activation first carries the generic binding of REFERENCE_FRAME §11\\n(minimal activation binding).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F19.%20Baseline-specific%20basis%20and%20activation%20additions%2FActivation%20additions\",\"start_line\":1672}],\"label\":\"Generic and frame-specific activation binding\"}}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"objects","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:f0b2a89787d06e354d150881b25848f7","key":249,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:f0b2a89787d06e354d150881b25848f7\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"scope\":[\"urn:a