:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:693b479b937035b8475a30ed676520e8","key":721,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:693b479b937035b8475a30ed676520e8\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:relation-kind:discovery:evidence_input\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"A review recommends a disposition.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":258,\"path\":\"standards/EVALUATION.md\",\"quote\":\"which is\\nevidence only and never a disposition; it does not apply one.\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EVALUATION.md#EVALUATION%2F4.%20Review%20results\",\"start_line\":257}],\"kind\":\"evidence_input\",\"meaning\":\"A review recommendation supplies evidence to the decision owner; it neither applies a disposition nor constitutes acceptance or closure.\"},\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"source\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:2bdf6340141f53f21c1781855206b707\",\"target\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:89222b77e50c83868d267c878c6103c4\"}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:06578