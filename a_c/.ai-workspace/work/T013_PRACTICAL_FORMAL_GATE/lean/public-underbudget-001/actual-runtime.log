n:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:fe98e06fec1e3ee2cc232529db0a3d68","key":1157,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bceb0794d7f53e7c746942b7b8e1a769\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a470d1aba69b9afe0d76c5f3e25bf466\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:fe98e06fec1e3ee2cc232529db0a3d68\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"A finding exists; admissible evidence and actor capability support the particular triage claims.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":416,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"Missing causal or repair evidence stays explicit. Where the missing\\nrelation can change the evaluation, the Reviewer returns `indeterminate` or\\n`out_of_frame` pressure (FOUNDATIONS §4 Results); it does not invent precision and\\ndoes not send work sideways to the Worker (P5).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F5.%20Profile%20terms%2FTechnical%20triage%2C%20severity%2C%20priority%20and%20boundary%20effect\",\"start_line\":413}],\"statement\":\"Triage records affected claim/observed failure; Product-scale severity; causal assessment and confidence governed as quantified assurance; blast radius and affected users/paths/relations; available workaround/containment; repair complexity, regression risk and material dependencies; and residual uncertainty with reducing evidence. Missing causal/repair evidence stays explicit. If the missing relation can change evaluation, return indeterminate or out_of_frame pressure without invented precision or sideways work dispatch.\",\"uncertainty\":\"Quantified-assurance requirements and per-result triage projection are referenced, not fully supplied.\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:f252e2593617909fb3d899f5a6c93b47","key":1158,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bceb0794d7f53e7c746942b7b8e1a769\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bac22443a8ebc6c8a3471d29babef1a3\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:f252e2593617909fb3d899f5a6c93b47\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[],\"exceptions\":[],\"grounding\":[{\"end_line\":454,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"A hard stop or a falsified mandatory claim cannot be\\nwaived by lowering priority. An observation outside the exact claim\\nboundary cannot open another review round because it carries a severe\\nlabel (P6, P2).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F5.%20Profile%20terms%2FTechnical%20triage%2C%20severity%2C%20priority%20and%20boundary%20effect\",\"start_line\":451}],\"statement\":\"Reviewer grades severity; Executive assigns priority. Product-owned basis selects severity/priority scales, boundary cutoff and non-waivable hard stops, without a universal numeric scale; imported hard-stop classes are typical, not closed. Stops hold regardless of priority, cutoff or risk appetite. Severity, priority, frame result and boundary effect are four distinct values and none alone decides promotion blocking. A recorded blocks effect must meet EVALUATION §5's condition and reaches the core only through one existing disposition; only disposition decides acceptance. Lower priority cannot waive a hard stop or falsified mandatory claim; severe labels outside the exact claim cannot open review rounds.\",\"uncertainty\":\"The complete promotion-blocking predicate and hard-stop classes are outside the supplied source.\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:6ad231e10378a8d57c5461a46f022995","key":1159,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:5126ced26ec459f2f807d8d313977e1e\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:6ad231e10378a8d57c5461a46f022995\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"After lawful Worker activation.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":500,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"- `re_entry_requested(authority)` (`out_of_frame`): the Executive returns\\n  the question to the decision owner the value names; and\\n- `re_entry_requested(basis)` (`invalid_basis`): the Executive revalidates\\n  the basis lock (§6 Drift locks) before any further activation.\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F5.%20Profile%20terms%2FWork%20result\",\"start_line\":497}],\"statement\":\"candidate_ready maps to satisfied and supplies exact candidate/transition evidence for deciding review need, never accept. refused maps to falsified, names the prohibition/refusal counterexample, and requires Executive basis verification and existing authority application. incomplete maps to falsified, not indeterminate: residuals/stop basis separately identify unperformed evaluations with no result, performed undecidable evaluations retaining their own indeterminate, and whether bounded execution ended first; reactivation needs current permission. re_entry_requested(authority) maps to out_of_frame and returns to the named decision owner. re_entry_requested(basis) maps to invalid_basis and requires basis-lock revalidation before further activation. Cause selection and mapping belong to ACTIVATION, not the profile; no value is accepted progress merely because work occurred.\",\"uncertainty\":\"The full grounds for selecting these values remain in ACTIVATION §3.\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:f5b93bb97294e68a1595bb4f902d5938","key":1160,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:5126ced26ec459f2f807d8d313977e1e\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:f5b93bb97294e68a1595bb4f902d5938\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[],\"exceptions\":[],\"grounding\":[{\"end_line\":504,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"A capability, authority, stale-basis, ambiguous-basis or topology mismatch\\nknown during activation is an `activation_refusal` with its cause, never a\\nsynthetic Worker result (P5, P6).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F5.%20Profile%20terms%2FWork%20result\",\"start_line\":502}],\"statement\":\"Activation refusal carries its owner-defined cause/core value to assigning authority or declared carrier and creates neither Worker activation nor Worker result. Known activation-time capability, authority, stale/ambiguous basis or topology mismatch cannot be fabricated into a work result. Results reference current computed classification, supporting evidence, residual judgments and original rulings in existing carriers, without reconstructing unchanged C/J/O at every handoff. Consumers check applicability and concrete invalidators; changed evidence revises affected results only, preserving originals and supported surviving claims.\",\"uncertainty\":\"The complete activation-refusal cause/core mapping is not supplied.\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:243f3c0d2b895fd08b5bd0523b344ddb","key":1161,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:8df660b9cabda7f7412953117071e6f3\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:243f3c0d2b895fd08b5bd0523b344ddb\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"A review or generic method qualification is performed.\"],\"exceptions\":[\"Outside generic method qualification an equivalent exact-subject relation may replace immutable identity if sufficient for the assessment.\"],\"grounding\":[{\"end_line\":520,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"Where generic\\nmethod qualification applies (EVALUATION §7), its construction result is\\nfrozen before material reference exposure as that clause requires.\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F5.%20Profile%20terms%2FExact%20candidate\",\"start_line\":518}],\"statement\":\"Review binds a stable exact subject, never a moving candidate identity. Apply the conditional qualification freeze before material exposure wherever its owner requires it; elsewhere stabilise to the claimed assessment's needed exactness. Stabilisation does not create a frozen lifecycle state.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:383d08606d02cda2d1f4f53c298de36f","key":1162,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bac22443a8ebc6c8a3471d29babef1a3\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:383d08606d02cda2d1f4f53c298de36f\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"The executive configuration is selected.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":553,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"3. authorised action selection: it assigns priority, determines the effect\\n   on the current promotion boundary, applies an existing disposition, and\\n   issues only the next already-authorised activation or action.\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F6.%20Executive%20attention%2C%20evaluation%20and%20action%2FThe%20three%20duties\",\"start_line\":551}],\"statement\":\"Three inseparable duties concern one governed outcome. Attention management retains exact outcome/basis, Product-role map, evaluation inventory, dependencies, unresolved frontier, actor envelopes, mandate, triage policy and residual boundary, selecting the smallest dependency-ready set sufficient for the next decision within finite envelopes. Orchestration activates capable Workers/Reviewers/specialists, preserves exact subject/basis and consumes only closed results or declared translations. Action selection assigns priority/boundary effect, applies existing disposition and issues only already-authorised next actions. Executive need not hold the whole workspace or perform every evaluation; its role grants no Product meaning, implementation, mutation, acceptance, publication or other operation authority. Material effects remain with actors holding exact operation grants.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:42a88d08e304fc8abf99cdf830c5710a","key":1163,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bac22443a8ebc6c8a3471d29babef1a3\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:85c4a097d7c23e71690337215dd1fa32\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:668afb84e5d220dd4674a57a384862c4\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:42a88d08e304fc8abf99cdf830c5710a\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"An actor occupies the Executive frame in the selected executive configuration.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":571,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"A same-actor role transition is explicit and is recorded in\\nthe existing work carrier before the effect; for that effect the actor is no\\nlonger acting as Executive. Recording or delegating after an Executive edit\\ncannot authorise the edit retroactively (P6, P3).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F6.%20Executive%20attention%2C%20evaluation%20and%20action%2FNo%20mutation%20while%20Executive\",\"start_line\":568}],\"statement\":\"Executive modifies no candidate, Product or worktree bytes and performs no implementation effects. Access and small, test-only, reversible or obvious edits are no exceptions; neither is a construction/status/checkpoint operation grant. Mutation requires separately activated Worker/Writer with exact grant, subject and write territory. Same-actor transition must be explicit and recorded before the effect, when that actor ceases acting as Executive for it. Later recording/delegation cannot authorise prior edits.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:c16e4b294469f483c724840eccf15ca6","key":1164,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:1e906ab4002640bb16a98dfd2f40993e\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bac22443a8ebc6c8a3471d29babef1a3\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:c16e4b294469f483c724840eccf15ca6\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"An attention cycle is active.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":610,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"end this cycle when every mandatory evaluation is closed, governing authority\\nhas retained every remaining residual consistently with the claim, or an\\napplicable stop condition holds; retain every unresolved obligation\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F6.%20Executive%20attention%2C%20evaluation%20and%20action%2FAttention%20cycle\",\"start_line\":608}],\"statement\":\"While U remains, an applicable stop preserves open obligations, results and required re-entry durably and ends with cause/bounded result. Otherwise select finite dependency-ready M fitting actors, activate on exact outcome/basis, isolate assurance-independent evaluations from unclosed peer results, and await relevant input when no other authorised decision is ready. Record every closed result, triage, residual and invalidator; use only declared conjunctions/translations; assign priority/effect under current mandate; withdraw affected reliance after subject/basis change until applicability is established; update U from coverage, dependencies, conflicts and discovered materiality. End under the source's alternatives—every mandatory evaluation closed, authority consistently retaining every remaining residual, or applicable stop—retaining every unresolved obligation. Ending proves neither Product success nor acceptance: closed results may be falsified and stops may leave no results. Return distinguishes closed results, unperformed evaluations, retained residuals and stop cause; success still needs outcome evidence and applicable closure/acceptance.\",\"uncertainty\":\"The source states termination alternatives but supplies no executable control semantics in this bounded interpretation.\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:65c4222129febb67213328200a7e56d4","key":1165,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:1e906ab4002640bb16a98dfd2f40993e\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bac22443a8ebc6c8a3471d29babef1a3\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:65c4222129febb67213328200a7e56d4\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[],\"exceptions\":[],\"grounding\":[{\"end_line\":642,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"A consumer receives the\\nclosed result and its source routes, not the child's hidden reasoning\\ncontext (P6, P4a; ACTIVATION §7).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F6.%20Executive%20attention%2C%20evaluation%20and%20action%2FAttention%20cycle\",\"start_line\":640}],\"statement\":\"Frontier and ledger must be durable/reconstructable; Executive acquires the material portion and exact owner routes/dependencies sufficient for the next decision, without every evaluator's working context. Severity, priority, boundary effect, disposition and next action remain distinct ledger entries even when policy maps them. Every return uses an explicit declared relation to Executive, conjunction or another frame, carries closed result/source routes and grants no activation/continuation by itself. Handoff, completion, model/tool output or shared actor cannot supply admission. Different candidates/bases/episodes retain identity; flattened projections establish no equality or translation. Subject/basis changes preserve history while current reliance follows owner-defined reuse law.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:c1d5c008533a20dfc1c5e04901efd0fd","key":1166,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:1e906ab4002640bb16a98dfd2f40993e\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bac22443a8ebc6c8a3471d29babef1a3\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:c1d5c008533a20dfc1c5e04901efd0fd\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"Executive is coordinating.\"],\"exceptions\":[\"Unavailable/unreliable notifications or actual supervision duties permit bounded fallback observation.\"],\"grounding\":[{\"end_line\":667,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"Silence proves neither progress nor\\nfailure. A genuine blocker or material risk is investigated, with\\nintervention where required, within existing grants; unknown status alone\\ndoes not establish a stalled Worker (P5, P6).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F6.%20Executive%20attention%2C%20evaluation%20and%20action%2FEvent-driven%20attention\",\"start_line\":664}],\"statement\":\"Default re-entry triggers are decision-relevant closed results, material exceptions/changed basis, owner requests and declared deadlines/checkpoints. While Workers execute grants and no other authorised decision is ready, wait without repeated unfinished-work inspection, unchanged-judgment replay or needless status requests. Preserve frontier, return conditions and valid support; refresh affected support on material observations and revalidate locks before activation/disposition. Waiting waives no verification, evidence, independent assessment, consumption, authority or closure duty. Fallback declares purpose, cadence/checkpoint, evidence target and stop/escalation condition. Investigate genuine blockers/material risks and intervene where required within grants; silence/unknown status is neither progress nor failure. Repeated no-progress or non-informative returns require bounded reassessment of frame/grant/dependency/evidence gap and an authorised decision, not endless polling or unchanged-basis repairs. Reduced churn permits no lower assurance/capability and creates no universal accounting gate.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a1f10b0ed91c7b113e71aff102a0bd40","key":1167,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:9eb4e5b2722bf42c8e9e4e78ac118aac\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a1f10b0ed91c7b113e71aff102a0bd40\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"A lock fails before activation, during evaluation or before disposition, as specified.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":698,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"| stale basis of a held result, before disposition | for the disposition's conjunction the component has no applicable closed result: a gap, never relabelled `invalid_basis` and never counted as returned\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F6.%20Executive%20attention%2C%20evaluation%20and%20action%2FDrift%20locks\",\"start_line\":698}],\"statement\":\"Use owner-defined outcomes only: changed Product meaning causes re_enter to its owner; stale/substituted basis before activation gives activation_refusal(basis), invalid_basis; evaluation performed on stale/substituted basis has its own invalid_basis or is reactivated currently; stale held result before disposition is a conjunction gap, never relabelled invalid_basis or counted returned. Missing material scope gives out_of_frame at activation under admission law or during evaluation for undeclared material relation/capability. Missing operation authority refuses activation with activation_refusal(authority) or refuses the effect. Unresolved mandatory conflict survives all joins and prevents satisfied conjunction. Executive cannot repair any failure by enlarging its own frame.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:8d647b21cbeb84320774aa8e6e422cc1","key":1168,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:d71326ac32b31ff5e9a0324a726e4bfc\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:85c4a097d7c23e71690337215dd1fa32\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:8df660b9cabda7f7412953117071e6f3\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:8d647b21cbeb84320774aa8e6e422cc1\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[],\"exceptions\":[],\"grounding\":[{\"end_line\":732,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"A repair advances the workspace, creates a new\\ncandidate and invalidates the affected results. A released Product, Release\\nCut or exact Install stays immutable under its own lifecycle law and imposes\\nno immutability on the Source Project constructing a successor (P3, P4b).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F6.%20Executive%20attention%2C%20evaluation%20and%20action%2FProduct-chain%20basis\",\"start_line\":729}],\"statement\":\"An installed Product may lawfully build its successor or another Product while remaining distinct from mutable source and authored Product. Nesting, shared code/actors, imports, tool reachability, labels and equal outputs create no identity, composition edge or authority transfer. Exact basis does not make Source Project immutable: Worker may cumulatively mutate its granted exact source/write territory. Reviewer assesses an exact checkpoint from that workspace. Repair advances source, creates a new candidate and invalidates affected results; released Product/Cut/exact Install immutability remains governed by their lifecycles, not inherited by successor source.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:23ceef471349c7574ad4d58b29b91470","key":1169,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:3b84039784294dad7e5f95fd3a5d0549\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bac22443a8ebc6c8a3471d29babef1a3\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:85c4a097d7c23e71690337215dd1fa32\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a470d1aba69b9afe0d76c5f3e25bf466\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:23ceef471349c7574ad4d58b29b91470\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[],\"exceptions\":[],\"grounding\":[{\"end_line\":760,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"The overlap collapses\\nneither evaluation nor authority (P1, P6, RF-008)\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F7.%20Non-hierarchical%20frame%20configuration\",\"start_line\":756}],\"statement\":\"Shared basis, outcome, checkpoint, affected relations, candidate, evidence and residuals do not collapse authority or evaluations. Executive evaluates activation, priority, boundary effect and disposition; Worker evaluates/performs bounded construction; activated Reviewer assesses exact candidate claims and technical triage. Other RF-009 structures remain distinct, with none added or merged. Active-evaluation notation requires neither Cartesian-product schema nor universal frame runtime.\",\"uncertainty\":\"The full RF-009 structure list is outside this excerpt.\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:d91f3997d9d8a05dc4f43a0c7d4d8821","key":1170,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:668afb84e5d220dd4674a57a384862c4\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:d91f3997d9d8a05dc4f43a0c7d4d8821\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"The executive configuration is selected.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":796,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"Selecting the configuration makes none of them optional, and no operation\\ngrant lifts them (P6).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F7.%20Non-hierarchical%20frame%20configuration%2FThe%20executive%20configuration\",\"start_line\":795}],\"statement\":\"All frame grants, duties, limits and prohibitions apply without exception when selected, including Executive no-mutation, attention duties and Worker/Reviewer exclusions; operation grants lift none. Allocation must be explained against task fit, finite resources and failure assumptions; when one sufficient frame covers the task direct entry applies. Adopting basis records concrete capability envelopes; execution binding supplies declared, measured and honoured resource limits. Constructor self-review is construction output, required assessment is independent, stale results trigger lock revalidation, and refused activation returns cause without Worker result. Other configurations are evaluated against their own task, not distance from this configuration.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:52efd014e786604207b2c7c82fe8b9f2","key":1171,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:668afb84e5d220dd4674a57a384862c4\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:5126ced26ec459f2f807d8d313977e1e\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bac22443a8ebc6c8a3471d29babef1a3\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:52efd014e786604207b2c7c82fe8b9f2\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"An effect has uncertain completion or the coordinator's bounded view lacks decision-relevant information.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":843,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"A\\ncompact result carries every blocker material to delivery, as that rule\\nrequires, in the residuals, stop basis and effect values of a work\\nresult, the findings, counterexamples and residuals of a review result,\\nand the residuals of a specialist result (P0, P4b, P6).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F7.%20Non-hierarchical%20frame%20configuration%2FThe%20executive%20configuration\",\"start_line\":839}],\"statement\":\"Work results name each intended external effect with its ACTIVATION Effects value. Unknown completion, including lost responses, must be reconciled sufficiently for the next dependent action before reactivation or that action. Coordinator uses the ledger and work/review/specialist projections; additional necessary information comes through frame inputs or further bounded evaluation. Compact returns must retain every delivery-material blocker in work residuals/stop basis/effect values, review findings/counterexamples/residuals and specialist residuals.\",\"uncertainty\":\"The effect-value algebra and detailed reconciliation protocol are referenced, not supplied.\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:0200585f9317720f9a7934c53d277ac5","key":1172,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bac22443a8ebc6c8a3471d29babef1a3\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:0200585f9317720f9a7934c53d277ac5\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"Executive frame is activated.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":872,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"| invalidation | a material change of method, authority, outcome, mandate, triage policy, checkpoint, candidate, evidence, finding, capability or topology |\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F8.%20Derived%20Executive%20frame\",\"start_line\":872}],\"statement\":\"Evaluation asks authorisation of outcome/basis, capable frames/actors, exact/current returned results and mandate-based priority/effect/disposition/action. Basis includes complete method cut, exact Goals/Product/requirements/design/work authority, mandate, workspace/checkpoint, findings/triage, selected policy and any proxy grant. Manifold includes outcome/mandate/causal cone, inventory/configuration/envelopes, evidence/results/triage, priority/effect, re-entry owners and authorised continuation boundary. Coordinates identify method/project/outcome/mandate/authority/checkpoint/candidate/evidence/finding/policy/actor exactly. Governing invariants remain RF-001–RF-017, execution/intake/conservation and identity/carrier/assurance/release law. Evidence includes live authority, frame/specialist results, triage, candidate identity, transition evidence and coverage residuals. Capability must suffice for method/Product/mandate/authority/workspace/triage/actor selection and bounded configuration/prioritisation/disposition. Exclusions include mutation, implementation ownership, silent evidence/severity rewriting, independent-review claims without qualifying activation, others' semantic reconstruction and disposition outside grant. Any material change of method, authority, outcome, mandate, policy, checkpoint, candidate, evidence, finding, capability or topology invalidates the affected evaluation.\",\"uncertainty\":\"Referenced invariant and execution-law details are outside supplied text.\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:d1b4de931d0f2122611b0061ff7f3092","key":1173,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bac22443a8ebc6c8a3471d29babef1a3\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:bceb0794d7f53e7c746942b7b8e1a769\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:d1b4de931d0f2122611b0061ff7f3092\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[],\"exceptions\":[],\"grounding\":[{\"end_line\":881,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"If the Executive cannot\\nrely on a supplied severity or technical assessment, it reactivates a\\ncapable evaluation or keeps the uncertainty; it never silently rewrites the\\nReviewer result (P5, P6).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F8.%20Derived%20Executive%20frame\",\"start_line\":878}],\"statement\":\"Executive returns one core result, assigned priority and current-boundary effect, and one existing disposition where basis is decidable. Dispositions remain exactly accept, local_repair, re_enter and reject; authorize and no_action are not added. Activation remains the activate function; priority/effect are neither core results nor dispositions. Unreliable severity/technical assessment requires capable reevaluation or retained uncertainty, never silent rewriting.\",\"uncertainty\":\"No concrete result or disposition is selected by this interpretation.\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:c0adc0dbc63a98a2bdd3ca7e597eab34","key":1174,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:f6ecf4a769d282df4ea3c82a852c0588\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:c0adc0dbc63a98a2bdd3ca7e597eab34\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"The executive profile's delivery strategy applies.\"],\"exceptions\":[\"An existing affected thread is extended or revalidated; early focused user probes remain appropriate when they decide material outcome uncertainty.\"],\"grounding\":[{\"end_line\":905,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"Each passing thread establishes only the relations and\\nconditions actually exercised; untested branches, interaction combinations,\\nand refusal and recovery paths keep their material proof obligations.\\nSettled construction decisions are revisited when material counterevidence\\ninvalidates their basis (P6, P4b).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F8.%20Derived%20Executive%20frame%2FSteel-thread%20delivery\",\"start_line\":901}],\"statement\":\"Establish the runnable thread early and widen in bounded increments selected for consequential uncertainty, dependency/interface reach and failure impact. Early end-to-end/integration evidence prunes incompatible choices and settles exercised interfaces only; untested branches/combinations/refusal/recovery paths retain proof obligations and material counterevidence reopens settled decisions. During construction use focused deterministic regressions and targeted judgment probes for material uncertainty and unit evidence for module-owned laws. Schedule substantial resource-intensive user-acceptance cycles near release or when bounded capability is sufficiently complete to qualify. Distinct testing claims govern scenarios, independent assessments and repetitions. Reuse qualified results while exact subject/basis remain valid, rerun affected assurance upon invalidation, and activate construction only under existing mandate and operation grants.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a899a0ee3c19a1983a19dfa4c23e00b8","key":1175,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:82f113a16ea802824461602cdcb694b0\",\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a1d9192a9add8672ac09f1e82f9d892c\"],\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:a899a0ee3c19a1983a19dfa4c23e00b8\",\"judgment_kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"predicate\":{\"conditions\":[\"Worker frame activation is lawful.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":948,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"missing, ambiguous or out-of-territory\\nmutation authority refuses the effect\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F9.%20Derived%20Worker%20frame\",\"start_line\":947},{\"end_line\":938,\"path\":\"standards/EXECUTIVE_BASELINE.md\",\"quote\":\"| invalidation | a material change of intake, basis, checkpoint, dependency, configuration, capability or topology |\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/EXECUTIVE_BASELINE.md#EXECUTIVE_BASELINE%2F9.%20Derived%20Worker%20frame\",\"start_line\":938}],\"statement\":\"Worker construction/transformation and self-review authority is inherited and bounded by the complete selected method/project relations material to the cone; ACTIVATION §1 owns construction/self-review. Mutation requires the exact owner grant naming subject and write territory; role label gives no authority and missing, ambiguous or out-of-territory authority refuses the effect. No admission, publication, independent acceptance, frame-set revision, inferred next action, upstream semantic change, unauthorised cone expansion, self-acceptance, hidden competing path or advance after result return is permitted. candidate_ready binds exact candidate and ACTIVATION §7 transition evidence, never accept. Green tests evidence only relations actually exercised by production/test semantics. Material change in intake, basis, checkpoint, dependency, configuration, capability or topology invalidates the frame.\",\"uncertainty\":\"External ACTIVATION and EVALUATION details are referenced, not supplied.\"},\"refusal\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa4845