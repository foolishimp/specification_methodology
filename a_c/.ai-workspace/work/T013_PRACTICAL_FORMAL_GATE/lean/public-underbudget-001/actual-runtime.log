57852b6fd1fa48457c3f7d:actor:f-p-author\",\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"sort\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:sort:authored-concept\",\"value\":{\"conditions\":[],\"definition\":\"The schema's STDO binding distinguishes a Git source repository, mutable annotated-tag version-line discovery selector, and exact immutable installed release basis with deterministic manifest digest carrying tag, commit, tree and complete distribution identity.\",\"exceptions\":[],\"grounding\":[{\"end_line\":319,\"path\":\"standards/schemas/product-definition.schema.json\",\"quote\":\"\\\"description\\\": \\\"Mutable version-line discovery selector carried by an annotated Git tag. It is never operative constitutional authority without digest-bound explicit resolution and adoption.\\\"\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/schemas/product-definition.schema.json#preamble\",\"start_line\":319},{\"end_line\":334,\"path\":\"standards/schemas/product-definition.schema.json\",\"quote\":\"\\\"description\\\": \\\"Digest of the deterministic installed-release manifest carrying tag, commit, tree, and complete distribution identity.\\\"\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/schemas/product-definition.schema.json#preamble\",\"start_line\":334}],\"label\":\"Exact STDO binding\"}}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"objects","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:63e7fb7252af0f1ce2a3b61569f5ea55","key":640,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"context\":\"urn:a-c:generation:0657852b6fd1fa484