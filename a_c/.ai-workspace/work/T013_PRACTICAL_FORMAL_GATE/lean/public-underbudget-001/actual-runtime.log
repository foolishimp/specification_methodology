57c3f7d:record:770fcc5357db9571656e4e89a8719021\",\"uncertainty\":{\"grounding\":[{\"end_line\":1384,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"The four decisions are a refinement of the core result algebra\\n([FOUNDATIONS §4 Results](FOUNDATIONS.md#results)).\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F7.%20Ontology%20and%20three-view%20design%20gate%2FInvariant%20reconstruction%20sufficiency%20%28UP-018%29\",\"start_line\":1366}],\"statement\":\"The five active record families represent operational rules and result meanings declaratively; they do not supply the source's actual evaluators, proof procedures or runtime state.\"}}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"residuals","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:d47f8ccc0c56b8d94a29ff7d79739601","key":1859,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"consequence\":\"The sequence-specific external-actor exception is retained. No claim is made that every externally declared participant must also be authored as an internal domain identity.\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:d47f8ccc0c56b8d94a29ff7d79739601\",\"invalidation\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:invalidation:source-or-interpretation-change\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:residual-kind:authored-uncertainty\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"re_entry\":[],\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"subject\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:b3edab6c836a19d0a7e8ead6cccc099f\",\"uncertainty\":{\"grounding\":[{\"end_line\":1463,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"every sequence participant\\nand lifecycle carrier exists in the domain model;\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F7.%20Ontology%20and%20three-view%20design%20gate%2FCross-view%20axiom%20evaluation\",\"start_line\":1462},{\"end_line\":1431,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"Every participant exists in the domain model or is an\\nexplicitly external actor.\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F7.%20Ontology%20and%20three-view%20design%20gate%2FSequence%20model\",\"start_line\":1430}],\"statement\":\"The cross-view summary states universal participant presence in the domain model without restating the sequence model's explicit external-actor exception.\"}}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"residuals","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:42fafc98d7d5bc84d8edcda1eab68314","key":1860,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"consequence\":\"Retain accepted/accept → satisfied and distinguish non-accepted dispositions from no disposition/no result. Do not invent names or core mappings for the other dispositions.\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:42fafc98d7d5bc84d8edcda1eab68314\",\"invalidation\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:invalidation:source-or-interpretation-change\",\"kind\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:residual-kind:authored-uncertainty\",\"owner\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author\",\"re_entry\":[],\"scope\":[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"],\"subject\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:17af2f81977b5a255c4155d8b1c3abd0\",\"uncertainty\":{\"grounding\":[{\"end_line\":1538,\"path\":\"standards/DESIGN_MODULE.md\",\"quote\":\"A verdict that is not `accepted` is one\\nof the other three dispositions, mapped there, or no disposition yet,\\nwhich is no acceptance result.\",\"section\":\"repo://stdo-v3-common/35fb4824a064a84df5af214a0d0e2da597c18ac6/source/standards/DESIGN_MODULE.md#DESIGN_MODULE%2F7.%20Ontology%20and%20three-view%20design%20gate%2FGate%20and%20retrospective%20work\",\"start_line\":1536}],\"statement\":\"ACTIVATION §3 owns the other three dispositions and their mappings, whose definitions are absent from the supplied source.\"}}","scope":"[\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis","context":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal","family":"residuals","identity":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:4c0fb8254a02ecf2eaf4d0ceac8f13a6","key":1861,"owner":"urn:a-c:generation:0657852b6fd1fa48457c3f7d:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:basis\",\"consequence\":\"Role conservation, whole-path admission/reuse, cost separation and algorithmic dispositions are retained only to the extent stated here; their external formal tests and M(B)'s domain are not fabricated.\",\"context\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:context:source-first-proposal\",\"id\":\"urn:a-c:generation:0657852b6fd1fa48457c3f7d:record:4c0fb8254a02ecf2eaf4d0ceac8f13a6\",\"invalidation\":\"urn:a-c:generation:0657852b6