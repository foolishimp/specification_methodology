kind:source-section\"],\"governing\":false,\"local_families\":[],\"local_sorts\":[],\"type\":\"ref\"},\"start_line\":{\"type\":\"integer\"}},\"type\":\"object\"},\"min_items\":1,\"type\":\"array\"},\"label\":{\"min_length\":1,\"type\":\"string\"}},\"type\":\"object\"}}},\"stop_kinds\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:stop:no-execution-or-acceptance\"]},\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:signature:compact-source-proposal-v1\",\"sha256\":\"ba18237c16ba9bed43b058c27b135a7bb2f19fd8d79ee0ac76b309df26ba3ee7\"}}","parentIdentity":"urn:stdo:3.0.2:composition-release:interpretation:1","parentRawSha256":"fc3114dd666218c387a64846b755a14979182f488de64ffff6a6d305a9698793","records":[{"basis":"urn:a-c:generation:630ce49ea536c4b3949b529c:basis","context":"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal","family":"objects","identity":"urn:a-c:generation:630ce49ea536c4b3949b529c:record:740591d30370a65f48fcebfec32179ad","key":2,"owner":"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:740591d30370a65f48fcebfec32179ad\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"],\"sort\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:sort:authored-concept\",\"value\":{\"conditions\":[\"The selected engagement has the Product-composition scope described by this clause.\"],\"definition\":\"An edge records source/target capability, exact basis, existing authorities, eligible information, actual operations, lifecycle and return conditions without manufacturing a grant.\",\"exceptions\":[],\"grounding\":[{\"end_line\":916,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-03 — The edge's contract and authority record\\n\\nFor each directed relation, the `relation` authority and referenced `contracts`\\nstate, directly or by exact reference:\\n\\n1. Source and target Product identities and roles; the consumed capability,\\n   outcome, purpose, selected basis and currentness policy.\\n2. The existing owners and grants for each material operation: acquisition,\\n   disclosure, use, execution, mutation, assessment and disposition. A kind or\\n   role label records no grant by itself.\\n3. Admissible inputs and exports; material assumptions, effects, failures,\\n   obligations and evidence; restrictions on implementation material and derived\\n   information where applicable.\\n4. The acting principals or binding rule, task/phase scope, permitted delegation,\\n   return consumer, stop/refusal conditions and revocation/invalidation route.\\n\\nThese coordinates may be supplied by source-linked prose. The relation locates\\nand constrains lawfully granted authority; it cannot manufacture the target's\\npermission or the source's admission. Missing material authority or an unresolved\\nconflict withholds the dependent action. The execution-scoped activation remains\\nthe place where a particular actor, input, effect and return are bound.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-03--the-edges-contract-and-authority-record\",\"start_line\":895}],\"label\":\"Edge authority and capability contract\"}}","scope":"[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:630ce49ea536c4b3949b529c:basis","context":"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:630ce49ea536c4b3949b529c:record:c30e2430febe3916693f9d5c65dbe976","key":15,"owner":"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:740591d30370a65f48fcebfec32179ad\"],\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:c30e2430febe3916693f9d5c65dbe976\",\"judgment_kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"predicate\":{\"conditions\":[\"Apply the clause within its explicitly stated scope and qualifications.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":916,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-03 — The edge's contract and authority record\\n\\nFor each directed relation, the `relation` authority and referenced `contracts`\\nstate, directly or by exact reference:\\n\\n1. Source and target Product identities and roles; the consumed capability,\\n   outcome, purpose, selected basis and currentness policy.\\n2. The existing owners and grants for each material operation: acquisition,\\n   disclosure, use, execution, mutation, assessment and disposition. A kind or\\n   role label records no grant by itself.\\n3. Admissible inputs and exports; material assumptions, effects, failures,\\n   obligations and evidence; restrictions on implementation material and derived\\n   information where applicable.\\n4. The acting principals or binding rule, task/phase scope, permitted delegation,\\n   return consumer, stop/refusal conditions and revocation/invalidation route.\\n\\nThese coordinates may be supplied by source-linked prose. The relation locates\\nand constrains lawfully granted authority; it cannot manufacture the target's\\npermission or the source's admission. Missing material authority or an unresolved\\nconflict withholds the dependent action. The execution-scoped activation remains\\nthe place where a particular actor, input, effect and return are bound.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-03--the-edges-contract-and-authority-record\",\"start_line\":895}],\"statement\":\"For each directed relation, the `relation` authority and referenced `contracts`\\nstate, directly or by exact reference:\\n\\n1. Source and target Product identities and roles; the consumed capability,\\n   outcome, purpose, selected basis and currentness policy.\\n2. The existing owners and grants for each material operation: acquisition,\\n   disclosure, use, execution, mutation, assessment and disposition. A kind or\\n   role label records no grant by itself.\\n3. Admissible inputs and exports; material assumptions, effects, failures,\\n   obligations and evidence; restrictions on implementation material and derived\\n   information where applicable.\\n4. The acting principals or binding rule, task/phase scope, permitted delegation,\\n   return consumer, stop/refusal conditions and revocation/invalidation route.\\n\\nThese coordinates may be supplied by source-linked prose. The relation locates\\nand constrains lawfully granted authority; it cannot manufacture the target's\\npermission or the source's admission. Missing material authority or an unresolved\\nconflict withholds the dependent action. The execution-scoped activation remains\\nthe place where a particular actor, input, effect and return are bound.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]"}],"seeds":[2],"unresolved":[]},"underbudgetRefusal":"insufficient record budget; required closure is not truncated"},{"budget":6,"projection":{"excluded":[0,1,4,5,6,7,8,9,11,12,13,14,17,18,19,20,21,22,23,24,26,27,28,29,30,31],"excludedResiduals":[{"basis":"urn:a-c:generation:630ce49ea536c4b3949b529c:basis","context":"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal","family":"residuals","identity":"urn:a-c:generation:630ce49ea536c4b3949b529c:record:9f379db2ef9a8451a57bc145d36d9db3","key":29,"owner":"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"consequence\":\"Keep unsupported adequacy/clean-room claims unresolved and use the declared re-entry.\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:9f379db2ef9a8451a57bc145d36d9db3\",\"invalidation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:invalidation:source-or-interpretation-change\",\"kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:residual-kind:authored-uncertainty\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"re_entry\":[],\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"],\"subject\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:acc8c965a48d0a6498144ae726e9a1a5\",\"uncertainty\":{\"grounding\":[{\"end_line\":963,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-05 — Context construction and clean-room conditions\\n\\nAn actor's selected context must satisfy both permission and adequacy for its\\nengagement. Permission covers the source information and permitted derivations,\\nnot only paths or filenames. The boundary identifies eligible source classes,\\nexports and tool outputs, material provenance, intended use, later acquisitions\\nand the effect of prior exposure. An allowed file location or a fresh summary\\ndoes not sanitize prohibited information.\\n\\nA target owner may authorize an export, but clean-room eligibility additionally\\nrequires that the engagement's information policy admits that export and its\\nprovenance. The actual delivered/acquired material must be recorded to the extent\\nrequired by the claim. An uncertain or prohibited exposure follows the declared\\nhold/re-entry rule; it cannot be repaired by deleting its receipt or relabeling\\nthe same actor fresh. Prior actor knowledge and external acquisition channels are\\npart of the declared limits.\\n\\nAdequacy retains the distinctions required for the task's decisions and\\ncontinuations, including unresolved obligations, result standing, currentness and\\nauthority. If the permitted material is insufficient, acquire an authorized\\nextension, narrow the task with the owner, use a suitable actor or return the\\nunresolved outcome. Permission is not evidence of sufficiency, and a budget is\\nnot permission to omit a deciding condition. This applies [FOUNDATIONS Observation sufficiency](FOUNDATIONS.md#assurance-relations)\\nand its scoped preservation law; it supplies no general optimal context selector (P1, P2, P6).\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-05--context-construction-and-clean-room-conditions\",\"start_line\":939}],\"statement\":\"Permission alone cannot establish semantic sufficiency or exclude unknown prior/external exposure.\"}}","scope":"[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:630ce49ea536c4b3949b529c:basis","context":"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal","family":"residuals","identity":"urn:a-c:generation:630ce49ea536c4b3949b529c:record:a62977ad70d316938830d82d18f33f6d","key":30,"owner":"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"consequence\":\"Hold dependent assurance or widen assessment without erasing original evidence.\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:a62977ad70d316938830d82d18f33f6d\",\"invalidation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:invalidation:source-or-interpretation-change\",\"kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:residual-kind:authored-uncertainty\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"re_entry\":[],\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"],\"subject\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:759dcede800bb40bf1b35ef8393b00f2\",\"uncertainty\":{\"grounding\":[{\"end_line\":995,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-07 — Change, evidence and reliance\\n\\nEach cross-boundary use binds the actual selected sources and material execution\\nbasis, including uncommitted bytes where relevant. A moving selection identifies\\nhow advancement is detected and which reliance must be reassessed. Git is one\\npossible carrier, not a mandatory identity system.\\n\\nChanges and new counterexamples propagate through material assertion, execution\\nand evidence-use dependencies under [FOUNDATIONS Change impact and evidence reuse](FOUNDATIONS.md#change-impact-and-evidence-reuse). Historical\\nevidence remains about its original subject. Reuse on a changed subject needs an\\nestablished applicability or preservation relation; rereading alone does not\\nestablish it. A new release does not invalidate a still-selected older release,\\nand a changed hash alone establishes neither semantic incompatibility nor\\ncontinued validity. Unknown impact holds the dependent assurance or widens\\nassessment; it does not require unrelated work to restart.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-07--change-evidence-and-reliance\",\"start_line\":980}],\"statement\":\"Material impact may remain unknown after a change.\"}}","scope":"[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:630ce49ea536c4b3949b529c:basis","context":"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal","family":"residuals","identity":"urn:a-c:generation:630ce49ea536c4b3949b529c:record:3b3041db69d216ff76f8fe4e6d41e9b9","key":31,"owner":"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"consequence\":\"Retain the exact evidence and owner verdicts for each semantic or acceptance claim.\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:3b3041db69d216ff76f8fe4e6d41e9b9\",\"invalidation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:invalidation:source-or-interpretation-change\",\"kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:residual-kind:authored-uncertainty\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"re_entry\":[],\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"],\"subject\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:6cc92570e9e1d4cc0b93ea894305e162\",\"uncertainty\":{\"grounding\":[{\"end_line\":374,\"path\":\"standards/RELEASE.md\",\"quote\":\"### Immutable stable publication\\n\\nStable publication applies the same scope, source reconciliation, proportionate\\nchecks, exact carrier, subtree and inventory obligations as RC publication.\\nIt instead creates one stable-v1 annotated tag and any explicitly selected\\nrelease branch, with no RC branch or separate selector. Before publication,\\nverify the fresh-line conditions of [Stable cuts](#stable-cuts), bind remote\\nabsence for the immutable tag and bind every mutable destination's expected\\nobject. Publish the selected refs atomically where supported; a changed\\nexpectation stops publication for reconciliation. Read back the remote tag\\nobject, commit, subtree and declared assets. The release is publicly classified\\nas a normal published release; release-host flags do not replace exact identity\\nor qualification evidence (P3, P5, P6).\",\"section\":\"repo://stdo-v3.0.2-source/RELEASE.md#immutable-stable-publication\",\"start_line\":361}],\"statement\":\"A stable naming and discovery profile alone does not establish stronger semantic qualification.\"}}","scope":"[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]"}],"external":[{"identity":"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-03--the-edges-contract-and-authority-record","payload":"{\"basis_relation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis-relation:exact\",\"evidence_identity\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:evidence:explicit-generation-signature\",\"external_identity\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-03--the-edges-contract-and-authority-record\",\"external_target_kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:external-kind:source-section\",\"reference_domain\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:reference-domain:declared\",\"resolution_basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"resolved_target_identity\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-03--the-edges-contract-and-authority-record\"}"},{"identity":"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-04--recursive-authority-and-information-eligibility","payload":"{\"basis_relation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis-relation:exact\",\"evidence_identity\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:evidence:explicit-generation-signature\",\"external_identity\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-04--recursive-authority-and-information-eligibility\",\"external_target_kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:external-kind:source-section\",\"reference_domain\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:reference-domain:declared\",\"resolution_basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"resolved_target_identity\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-04--recursive-authority-and-inform