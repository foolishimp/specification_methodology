30ce49ea536c4b3949b529c:reference-domain:declared\",\"external_kinds\":[],\"governing\":false,\"local_families\":[\"traversals\"],\"local_sorts\":[],\"type\":\"ref\"},\"min_items\":0,\"type\":\"array\"},\"subject\":{\"basis_relation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis-relation:exact\",\"domain\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:reference-domain:declared\",\"external_kinds\":[],\"governing\":true,\"local_families\":[\"objects\",\"relations\",\"constraints\",\"latitude\"],\"local_sorts\":[],\"type\":\"ref\"},\"uncertainty\":{\"fields\":{\"grounding\":{\"items\":{\"fields\":{\"end_line\":{\"type\":\"integer\"},\"path\":{\"min_length\":1,\"type\":\"string\"},\"quote\":{\"min_length\":1,\"type\":\"string\"},\"section\":{\"basis_relation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis-relation:exact\",\"domain\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:reference-domain:declared\",\"external_kinds\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:external-kind:source-section\"],\"governing\":false,\"local_families\":[],\"local_sorts\":[],\"type\":\"ref\"},\"start_line\":{\"type\":\"integer\"}},\"type\":\"object\"},\"min_items\":1,\"type\":\"array\"},\"statement\":{\"min_length\":1,\"type\":\"string\"}},\"type\":\"object\"}}},\"sorts\":{\"urn:a-c:generation:630ce49ea536c4b3949b529c:sort:authored-concept\":{\"value\":{\"fields\":{\"conditions\":{\"items\":{\"min_length\":1,\"type\":\"string\"},\"min_items\":0,\"type\":\"array\"},\"definition\":{\"min_length\":1,\"type\":\"string\"},\"exceptions\":{\"items\":{\"min_length\":1,\"type\":\"string\"},\"min_items\":0,\"type\":\"array\"},\"grounding\":{\"items\":{\"fields\":{\"end_line\":{\"type\":\"integer\"},\"path\":{\"min_length\":1,\"type\":\"string\"},\"quote\":{\"min_length\":1,\"type\":\"string\"},\"section\":{\"basis_relation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis-relation:exact\",\"domain\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:reference-domain:declared\",\"external_kinds\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:external-kind:source-section\"],\"governing\":false,\"local_families\":[],\"local_sorts\":[],\"type\":\"ref\"},\"start_line\":{\"type\":\"integer\"}},\"type\":\"object\"},\"min_items\":1,\"type\":\"array\"},\"label\":{\"min_length\":1,\"type\":\"string\"}},\"type\":\"object\"}}},\"stop_kinds\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:stop:no-execution-or-acceptance\"]},\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:signature:compact-source-proposal-v1\",\"sha256\":\"ba18237c16ba9bed43b058c27b135a7bb2f19fd8d79ee0ac76b309df26ba3ee7\"}}","parentIdentity":"urn:stdo:3.0.2:composition-release:interpretation:1","parentRawSha256":"fc3114dd666218c387a64846b755a14979182f488de64ffff6a6d305a9698793","records":[{"basis":"urn:a-c:generation:630ce49ea536c4b3949b529c:basis","context":"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal","family":"objects","identity":"urn:a-c:generation:630ce49ea536c4b3949b529c:record:740591d30370a65f48fcebfec32179ad","key":2,"owner":"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:740591d30370a65f48fcebfec32179ad\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"],\"sort\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:sort:authored-concept\",\"value\":{\"conditions\":[\"The selected engagement has the Product-composition scope described by this clause.\"],\"definition\":\"An edge records source/target capability, exact basis, existing authorities, eligible information, actual operations, lifecycle and return conditions without manufacturing a grant.\",\"exceptions\":[],\"grounding\":[{\"end_line\":916,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-03 — The edge's contract and authority record\\n\\nFor each directed relation, the `relation` authority and referenced `contracts`\\nstate, directly or by exact reference:\\n\\n1. Source and target Product identities and roles; the consumed capability,\\n   outcome, purpose, selected basis and currentness policy.\\n2. The existing owners and grants for each material operation: acquisition,\\n   disclosure, use, execution, mutation, assessment and disposition. A kind or\\n   role label records no grant by itself.\\n3. Admissible inputs and exports; material assumptions, effects, failures,\\n   obligations and evidence; restrictions on implementation material and derived\\n   information where applicable.\\n4. The acting principals or binding rule, task/phase scope, permitted delegation,\\n   return consumer, stop/refusal conditions and revocation/invalidation route.\\n\\nThese coordinates may be supplied by source-linked prose. The relation locates\\nand constrains lawfully granted authority; it cannot manufacture the target's\\npermission or the source's admission. Missing material authority or an unresolved\\nconflict withholds the dependent action. The execution-scoped activation remains\\nthe place where a particular actor, input, effect and return are bound.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-03--the-edges-contract-and-authority-record\",\"start_line\":895}],\"label\":\"Edge authority and capability contract\"}}","scope":"[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:630ce49ea536c4b3949b529c:basis","context":"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal","family":"objects","identity":"urn:a-c:generation:630ce49ea536c4b3949b529c:record:9cf5abaccc2c192f2b63905987f18afc","key":3,"owner":"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:9cf5abaccc2c192f2b63905987f18afc\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"],\"sort\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:sort:authored-concept\",\"value\":{\"conditions\":[\"The selected engagement has the Product-composition scope described by this clause.\"],\"definition\":\"Recursive reachability and shared targets do not merge permissions; providers may encapsulate adequate internals and separately authorized inspection remains distinct from durable consumption.\",\"exceptions\":[],\"grounding\":[{\"end_line\":938,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-04 — Recursive authority and information eligibility\\n\\nA permitted A → B use does not entail A's access to B's dependencies. Neither\\nA → B plus B → C nor two routes to a shared leaf imply a union of their grants.\\nEach onward acquisition, disclosure or delegated effect needs authority for that\\nactor, purpose and path, including any permitted onward use of returned material.\\nExisting delegation may authorize a chain explicitly; its scope cannot expand\\nsilently at a recursive step.\\n\\nA provider may encapsulate internal dependencies behind an adequate contract.\\nConsumers need not flatten every implementation dependency into a direct edge.\\nWhere an outer claim materially relies on a far-side contract, assumption,\\nevidence item or acquisition, that reliance and its applicable authority must be\\npreserved through the boundary. Unknown impact is not evidence of encapsulation.\\n\\nDurable Product consumption and bounded authorized inspection are different\\nrelations. A Reviewer or diagnostic Worker may inspect a larger causal cone under\\nan explicit access grant without thereby adopting those internals as a runtime\\ndependency or gaining a write grant. If findings become a continuing construction\\nconstraint or dependency, their producer, applicability and governing relation\\nmust be retained.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-04--recursive-authority-and-information-eligibility\",\"start_line\":917}],\"label\":\"Recursive acquisition and information eligibility\"}}","scope":"[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:630ce49ea536c4b3949b529c:basis","context":"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal","family":"relations","identity":"urn:a-c:generation:630ce49ea536c4b3949b529c:record:d3e6d4bb0e4d5d63c95ab3ae190219d2","key":10,"owner":"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author","payload":"{\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:d3e6d4bb0e4d5d63c95ab3ae190219d2\",\"kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:relation-kind:governing:authority_boundary\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"qualifiers\":{\"conditions\":[\"When the referenced condition is material to the selected engagement.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":938,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-04 — Recursive authority and information eligibility\\n\\nA permitted A → B use does not entail A's access to B's dependencies. Neither\\nA → B plus B → C nor two routes to a shared leaf imply a union of their grants.\\nEach onward acquisition, disclosure or delegated effect needs authority for that\\nactor, purpose and path, including any permitted onward use of returned material.\\nExisting delegation may authorize a chain explicitly; its scope cannot expand\\nsilently at a recursive step.\\n\\nA provider may encapsulate internal dependencies behind an adequate contract.\\nConsumers need not flatten every implementation dependency into a direct edge.\\nWhere an outer claim materially relies on a far-side contract, assumption,\\nevidence item or acquisition, that reliance and its applicable authority must be\\npreserved through the boundary. Unknown impact is not evidence of encapsulation.\\n\\nDurable Product consumption and bounded authorized inspection are different\\nrelations. A Reviewer or diagnostic Worker may inspect a larger causal cone under\\nan explicit access grant without thereby adopting those internals as a runtime\\ndependency or gaining a write grant. If findings become a continuing construction\\nconstraint or dependency, their producer, applicability and governing relation\\nmust be retained.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-04--recursive-authority-and-information-eligibility\",\"start_line\":917}],\"kind\":\"authority_boundary\",\"meaning\":\"Recursive use applies the existing edge authorities without transitive widening.\"},\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"],\"source\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:9cf5abaccc2c192f2b63905987f18afc\",\"target\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:740591d30370a65f48fcebfec32179ad\"}","scope":"[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:630ce49ea536c4b3949b529c:basis","context":"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:630ce49ea536c4b3949b529c:record:c30e2430febe3916693f9d5c65dbe976","key":15,"owner":"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author","payload":"{\"applies_to\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:740591d30370a65f48fcebfec32179ad\"],\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:c30e2430febe3916693f9d5c65dbe976\",\"judgment_kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"predicate\":{\"conditions\":[\"Apply the clause within its explicitly stated scope and qualifications.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":916,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-03 — The edge's contract and authority record\\n\\nFor each directed relation, the `relation` authority and referenced `contracts`\\nstate, directly or by exact reference:\\n\\n1. Source and target Product identities and roles; the consumed capability,\\n   outcome, purpose, selected basis and currentness policy.\\n2. The existing owners and grants for each material operation: acquisition,\\n   disclosure, use, execution, mutation, assessment and disposition. A kind or\\n   role label records no grant by itself.\\n3. Admissible inputs and exports; material assumptions, effects, failures,\\n   obligations and evidence; restrictions on implementation material and derived\\n   information where applicable.\\n4. The acting principals or binding rule, task/phase scope, permitted delegation,\\n   return consumer, stop/refusal conditions and revocation/invalidation route.\\n\\nThese coordinates may be supplied by source-linked prose. The relation locates\\nand constrains lawfully granted authority; it cannot manufacture the target's\\npermission or the source's admission. Missing material authority or an unresolved\\nconflict withholds the dependent action. The execution-scoped activation remains\\nthe place where a particular actor, input, effect and return are bound.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-03--the-edges-contract-and-authority-record\",\"start_line\":895}],\"statement\":\"For each directed relation, the `relation` authority and referenced `contracts`\\nstate, directly or by exact reference:\\n\\n1. Source and target Product identities and roles; the consumed capability,\\n   outcome, purpose, selected basis and currentness policy.\\n2. The existing owners and grants for each material operation: acquisition,\\n   disclosure, use, execution, mutation, assessment and disposition. A kind or\\n   role label records no grant by itself.\\n3. Admissible inputs and exports; material assumptions, effects, failures,\\n   obligations and evidence; restrictions on implementation material and derived\\n   information where applicable.\\n4. The acting principals or binding rule, task/phase scope, permitted delegation,\\n   return consumer, stop/refusal conditions and revocation/invalidation route.\\n\\nThese coordinates may be supplied by source-linked prose. The relation locates\\nand constrains lawfully granted authority; it cannot manufacture the target's\\npermission or the source's admission. Missing material authority or an unresolved\\nconflict withholds the dependent action. The execution-scoped activation remains\\nthe place where a particular actor, input, effect and return are bound.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]}","scope":"[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]"},{"basis":"urn:a-c:generation:630ce49ea536c4b3949b529c:basis","context":"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal","family":"constraints","identity":"urn:a-c:generation:630ce49ea536c4b3949b529c:record:327a3e49f772e920c8b67e82701841cd","key":16,"owner":"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-a