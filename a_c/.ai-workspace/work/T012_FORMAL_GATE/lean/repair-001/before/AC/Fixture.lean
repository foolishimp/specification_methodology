  payload := "{\"allowed_variation\":{\"grounding\":[{\"end_line\":995,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-07 — Change, evidence and reliance\\n\\nEach cross-boundary use binds the actual selected sources and material execution\\nbasis, including uncommitted bytes where relevant. A moving selection identifies\\nhow advancement is detected and which reliance must be reassessed. Git is one\\npossible carrier, not a mandatory identity system.\\n\\nChanges and new counterexamples propagate through material assertion, execution\\nand evidence-use dependencies under [FOUNDATIONS Change impact and evidence reuse](FOUNDATIONS.md#change-impact-and-evidence-reuse). Historical\\nevidence remains about its original subject. Reuse on a changed subject needs an\\nestablished applicability or preservation relation; rereading alone does not\\nestablish it. A new release does not invalidate a still-selected older release,\\nand a changed hash alone establishes neither semantic incompatibility nor\\ncontinued validity. Unknown impact holds the dependent assurance or widens\\nassessment; it does not require unrelated work to restart.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-07--change-evidence-and-reliance\",\"start_line\":980}],\"statements\":[\"Retain old-subject evidence and justified applicability across material change.\"]},\"applies_to\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:759dcede800bb40bf1b35ef8393b00f2\"],\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"forbidden_variation\":{\"grounding\":[{\"end_line\":995,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-07 — Change, evidence and reliance\\n\\nEach cross-boundary use binds the actual selected sources and material execution\\nbasis, including uncommitted bytes where relevant. A moving selection identifies\\nhow advancement is detected and which reliance must be reassessed. Git is one\\npossible carrier, not a mandatory identity system.\\n\\nChanges and new counterexamples propagate through material assertion, execution\\nand evidence-use dependencies under [FOUNDATIONS Change impact and evidence reuse](FOUNDATIONS.md#change-impact-and-evidence-reuse). Historical\\nevidence remains about its original subject. Reuse on a changed subject needs an\\nestablished applicability or preservation relation; rereading alone does not\\nestablish it. A new release does not invalidate a still-selected older release,\\nand a changed hash alone establishes neither semantic incompatibility nor\\ncontinued validity. Unknown impact holds the dependent assurance or widens\\nassessment; it does not require unrelated work to restart.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-07--change-evidence-and-reliance\",\"start_line\":980}],\"statements\":[\"Use a changed hash or rereading alone to prove invalidity or equivalence.\"]},\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:3e3f03245d00d6080a6a206cef4a155e\",\"invalidation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:invalidation:source-or-interpretation-change\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]}"
