  basis := "urn:a-c:generation:630ce49ea536c4b3949b529c:basis"
  payload := "{\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"consequence\":\"Hold dependent assurance or widen assessment without erasing original evidence.\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:a62977ad70d316938830d82d18f33f6d\",\"invalidation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:invalidation:source-or-interpretation-change\",\"kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:residual-kind:authored-uncertainty\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"re_entry\":[],\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"],\"subject\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:759dcede800bb40bf1b35ef8393b00f2\",\"uncertainty\":{\"grounding\":[{\"end_line\":995,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-07 — Change, evidence and reliance\\n\\nEach cross-boundary use binds the actual selected sources and material execution\\nbasis, including uncommitted bytes where relevant. A moving selection identifies\\nhow advancement is detected and which reliance must be reassessed. Git is one\\npossible carrier, not a mandatory identity system.\\n\\nChanges and new counterexamples propagate through material assertion, execution\\nand evidence-use dependencies under [FOUNDATIONS Change impact and evidence reuse](FOUNDATIONS.md#change-impact-and-evidence-reuse). Historical\\nevidence remains about its original subject. Reuse on a changed subject needs an\\nestablished applicability or preservation relation; rereading alone does not\\nestablish it. A new release does not invalidate a still-selected older release,\\nand a changed hash alone establishes neither semantic incompatibility nor\\ncontinued validity. Unknown impact holds the dependent assurance or widens\\nassessment; it does not require unrelated work to restart.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-07--change-evidence-and-reliance\",\"start_line\":980}],\"statement\":\"Material impact may remain unknown after a change.\"}}"
}

