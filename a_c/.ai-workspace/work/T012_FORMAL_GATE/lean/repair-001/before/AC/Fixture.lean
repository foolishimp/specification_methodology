a536c4b3949b529c:scope:source-corpus\"],\"source\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:759dcede800bb40bf1b35ef8393b00f2\",\"target\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:acc8c965a48d0a6498144ae726e9a1a5\"}"
}

