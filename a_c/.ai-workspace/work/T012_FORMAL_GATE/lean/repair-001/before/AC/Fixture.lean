  payload := "{\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"consequence\":\"Retain the exact evidence and owner verdicts for each semantic or acceptance claim.\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:3b3041db69d216ff76f8fe4e6d41e9b9\",\"invalidation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:invalidation:source-or-interpretation-change\",\"kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:residual-kind:authored-uncertainty\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"re_entry\":[],\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"],\"subject\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:6cc92570e9e1d4cc0b93ea894305e162\",\"uncertainty\":{\"grounding\":[{\"end_line\":374,\"path\":\"standards/RELEASE.md\",\"quote\":\"### Immutable stable publication\\n\\nStable publication applies the same scope, source reconciliation, proportionate\\nchecks, exact carrier, subtree and inventory obligations as RC publication.\\nIt instead creates one stable-v1 annotated tag and any explicitly selected\\nrelease branch, with no RC branch or separate selector. Before publication,\\nverify the fresh-line conditions of [Stable cuts](#stable-cuts), bind remote\\nabsence for the immutable tag and bind every mutable destination's expected\\nobject. Publish the selected refs atomically where supported; a changed\\nexpectation stops publication for reconciliation. Read back the remote tag\\nobject, commit, subtree and declared assets. The release is publicly classified\\nas a normal published release; release-host flags do not replace exact identity\\nor qualification evidence (P3, P5, P6).\",\"section\":\"repo://stdo-v3.0.2-source/RELEASE.md#immutable-stable-publication\",\"start_line\":361}],\"statement\":\"A stable naming and discovery profile alone does not establish stronger semantic qualification.\"}}"
}

