def str21 : String := "{\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:affa9b0f00992af17c94ef079b5f2c5e\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"],\"sort\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:sort:authored-concept\",\"value\":{\"conditions\":[\"Within the release-profile scope and explicit qualifications in this source section.\"],\"definition\":\"Stable publication retains exact source, scoped qualification and inventory obligations while publishing one immutable tag and any selected release branch without RC branch or separate selector.\",\"exceptions\":[],\"grounding\":[{\"end_line\":374,\"path\":\"standards/RELEASE.md\",\"quote\":\"### Immutable stable publication\\n\\nStable publication applies the same scope, source reconciliation, proportionate\\nchecks, exact carrier, subtree and inventory obligations as RC publication.\\nIt instead creates one stable-v1 annotated tag and any explicitly selected\\nrelease branch, with no RC branch or separate selector. Before publication,\\nverify the fresh-line conditions of [Stable cuts](#stable-cuts), bind remote\\nabsence for the immutable tag and bind every mutable destination's expected\\nobject. Publish the selected refs atomically where supported; a changed\\nexpectation stops publication for reconciliation. Read back the remote tag\\nobject, commit, subtree and declared assets. The release is publicly classified\\nas a normal published release; release-host flags do not replace exact identity\\nor qualification evidence (P3, P5, P6).\",\"section\":\"repo://stdo-v3.0.2-source/RELEASE.md#immutable-stable-publication\",\"start_line\":361}],\"label\":\"Stable publication transaction\"}}"

