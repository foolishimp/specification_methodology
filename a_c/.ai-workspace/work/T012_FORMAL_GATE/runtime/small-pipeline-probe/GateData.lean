def str33 : String := "{\"applies_to\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:2a0ecacec7ce9d5757a75e9452572642\"],\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:b6d49f4139757fba2623671e276472d1\",\"judgment_kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"predicate\":{\"conditions\":[\"Apply the clause within its explicitly stated scope and qualifications.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":894,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-02 — Independent entry and the integrated outcome\\n\\nA Product offered as a standalone constituent must be enterable through its own\\nProduct Definition and a Product-authorized applicable frame basis, with the\\ndependency closure and capabilities its contract declares. Entry must not require\\nan enclosing composition's activation unless that enclosing capability is itself\\nan explicit prerequisite. Such a prerequisite is disclosed as a limit on the\\nstandalone claim. Shared or externally located frame documents are permitted\\nwhere adoption, scope and availability are established; file ownership alone is\\nnot the deciding test.\\n\\nStandalone does not imply dependency-free, separately deployable or able to\\nsupply every host itself. The claim names which construction, evaluation or use\\ncan be performed independently and its required inputs. The composition owner\\nseparately establishes interface compatibility, material joins and its complete\\noutcome. Successful constituent checks do not establish that outer predicate.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-02--independent-entry-and-the-integrated-outcome\",\"start_line\":878}],\"statement\":\"A Product offered as a standalone constituent must be enterable through its own\\nProduct Definition and a Product-authorized applicable frame basis, with the\\ndependency closure and capabilities its contract declares. Entry must not require\\nan enclosing composition's activation unless that enclosing capability is itself\\nan explicit prerequisite. Such a prerequisite is disclosed as a limit on the\\nstandalone claim. Shared or externally located frame documents are permitted\\nwhere adoption, scope and availability are established; file ownership alone is\\nnot the deciding test.\\n\\nStandalone does not imply dependency-free, separately deployable or able to\\nsupply every host itself. The claim names which construction, evaluation or use\\ncan be performed independently and its required inputs. The composition owner\\nseparately establishes interface compatibility, material joins and its complete\\noutcome. Successful constituent checks do not establish that outer predicate.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]}"

