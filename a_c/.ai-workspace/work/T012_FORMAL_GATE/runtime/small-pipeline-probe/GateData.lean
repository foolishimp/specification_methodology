def str57 : String := "{\"allowed_variation\":{\"grounding\":[{\"end_line\":979,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-06 — Readiness, cycles and replacement\\n\\nWork selects a dependency-ready frontier at the required subjects and revisions.\\nA cycle in declared Product relationships need not be a cycle in the selected\\nwork. A cycle of current prerequisite claims requires an executable resolution:\\nfor example an admitted prior revision, explicit seed, staged contract or bounded\\niteration with its continuation/stop conditions. Naming a lead alone does not\\nsupply a missing prerequisite or establish convergence.\\n\\nReplacing a constituent or refining it into further Products preserves the\\nconsumer's material contract: meaning, preconditions, effects, failures,\\nauthority, lifecycle, evidence and subsequent obligations. A semantic change\\nrequires an authorized successor relation and affected reassessment. The [ACTIVATION refinement contract](ACTIVATION.md#refinement) governs this\\npreservation. Matching signatures, labels or a sample output is insufficient (P4a, P6). New capabilities may be\\nadded without silently widening existing consumers' duties or grants.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-06--readiness-cycles-and-replacement\",\"start_line\":964}],\"statements\":[\"Resolve current prerequisites with a lawful prior revision, explicit seed, staged contract or bounded iteration.\"]},\"applies_to\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:fd620dc380b563ff699c644f38d970b4\"],\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"forbidden_variation\":{\"grounding\":[{\"end_line\":979,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-06 — Readiness, cycles and replacement\\n\\nWork selects a dependency-ready frontier at the required subjects and revisions.\\nA cycle in declared Product relationships need not be a cycle in the selected\\nwork. A cycle of current prerequisite claims requires an executable resolution:\\nfor example an admitted prior revision, explicit seed, staged contract or bounded\\niteration with its continuation/stop conditions. Naming a lead alone does not\\nsupply a missing prerequisite or establish convergence.\\n\\nReplacing a constituent or refining it into further Products preserves the\\nconsumer's material contract: meaning, preconditions, effects, failures,\\nauthority, lifecycle, evidence and subsequent obligations. A semantic change\\nrequires an authorized successor relation and affected reassessment. The [ACTIVATION refinement contract](ACTIVATION.md#refinement) governs this\\npreservation. Matching signatures, labels or a sample output is insufficient (P4a, P6). New capabilities may be\\nadded without silently widening existing consumers' duties or grants.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-06--readiness-cycles-and-replacement\",\"start_line\":964}],\"statements\":[\"Treat a named lead as missing evidence or silently change consumer obligations on replacement.\"]},\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:12a722d0655ad76ca2ff85dbb231246e\",\"invalidation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:invalidation:source-or-interpretation-change\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]}"

