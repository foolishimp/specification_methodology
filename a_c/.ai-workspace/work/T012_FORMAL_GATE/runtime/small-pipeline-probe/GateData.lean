def str53 : String := "{\"allowed_variation\":{\"grounding\":[{\"end_line\":894,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-02 — Independent entry and the integrated outcome\\n\\nA Product offered as a standalone constituent must be enterable through its own\\nProduct Definition and a Product-authorized applicable frame basis, with the\\ndependency closure and capabilities its contract declares. Entry must not require\\nan enclosing composition's activation unless that enclosing capability is itself\\nan explicit prerequisite. Such a prerequisite is disclosed as a limit on the\\nstandalone claim. Shared or externally located frame documents are permitted\\nwhere adoption, scope and availability are established; file ownership alone is\\nnot the deciding test.\\n\\nStandalone does not imply dependency-free, separately deployable or able to\\nsupply every host itself. The claim names which construction, evaluation or use\\ncan be performed independently and its required inputs. The composition owner\\nseparately establishes interface compatibility, material joins and its complete\\noutcome. Successful constituent checks do not establish that outer predicate.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-02--independent-entry-and-the-integrated-outcome\",\"start_line\":878}],\"statements\":[\"Use a shared or external frame document with established adoption, scope and availability.\"]},\"applies_to\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:2a0ecacec7ce9d5757a75e9452572642\"],\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"forbidden_variation\":{\"grounding\":[{\"end_line\":894,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-02 — Independent entry and the integrated outcome\\n\\nA Product offered as a standalone constituent must be enterable through its own\\nProduct Definition and a Product-authorized applicable frame basis, with the\\ndependency closure and capabilities its contract declares. Entry must not require\\nan enclosing composition's activation unless that enclosing capability is itself\\nan explicit prerequisite. Such a prerequisite is disclosed as a limit on the\\nstandalone claim. Shared or externally located frame documents are permitted\\nwhere adoption, scope and availability are established; file ownership alone is\\nnot the deciding test.\\n\\nStandalone does not imply dependency-free, separately deployable or able to\\nsupply every host itself. The claim names which construction, evaluation or use\\ncan be performed independently and its required inputs. The composition owner\\nseparately establishes interface compatibility, material joins and its complete\\noutcome. Successful constituent checks do not establish that outer predicate.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-02--independent-entry-and-the-integrated-outcome\",\"start_line\":878}],\"statements\":[\"Infer dependency-free or independent deployment from a scoped standalone claim.\"]},\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:4dde58febc58181d7348d7576cafb66f\",\"invalidation\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:invalidation:source-or-interpretation-change\",\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]}"

