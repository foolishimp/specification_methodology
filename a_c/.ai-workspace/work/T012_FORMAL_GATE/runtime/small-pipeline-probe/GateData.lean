def str47 : String := "{\"applies_to\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:affa9b0f00992af17c94ef079b5f2c5e\"],\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:fd364d00ee8c2f69fa70124db27f92a7\",\"judgment_kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"predicate\":{\"conditions\":[\"Apply the full source section, including its named imported obligations.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":374,\"path\":\"standards/RELEASE.md\",\"quote\":\"### Immutable stable publication\\n\\nStable publication applies the same scope, source reconciliation, proportionate\\nchecks, exact carrier, subtree and inventory obligations as RC publication.\\nIt instead creates one stable-v1 annotated tag and any explicitly selected\\nrelease branch, with no RC branch or separate selector. Before publication,\\nverify the fresh-line conditions of [Stable cuts](#stable-cuts), bind remote\\nabsence for the immutable tag and bind every mutable destination's expected\\nobject. Publish the selected refs atomically where supported; a changed\\nexpectation stops publication for reconciliation. Read back the remote tag\\nobject, commit, subtree and declared assets. The release is publicly classified\\nas a normal published release; release-host flags do not replace exact identity\\nor qualification evidence (P3, P5, P6).\",\"section\":\"repo://stdo-v3.0.2-source/RELEASE.md#immutable-stable-publication\",\"start_line\":361}],\"statement\":\"Stable publication applies the same scope, source reconciliation, proportionate\\nchecks, exact carrier, subtree and inventory obligations as RC publication.\\nIt instead creates one stable-v1 annotated tag and any explicitly selected\\nrelease branch, with no RC branch or separate selector. Before publication,\\nverify the fresh-line conditions of [Stable cuts](#stable-cuts), bind remote\\nabsence for the immutable tag and bind every mutable destination's expected\\nobject. Publish the selected refs atomically where supported; a changed\\nexpectation stops publication for reconciliation. Read back the remote tag\\nobject, commit, subtree and declared assets. The release is publicly classified\\nas a normal published release; release-host flags do not replace exact identity\\nor qualification evidence (P3, P5, P6).\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]}"

