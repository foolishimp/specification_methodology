def str31 : String := "{\"applies_to\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:ccbe2ad8126ee7065b45afdbb70cef1e\"],\"basis\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:basis\",\"context\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:context:source-first-proposal\",\"id\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:record:3bb0ac5964f14dca578757d7d2bec6be\",\"judgment_kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:judgment-kind:external-semantic-review\",\"kind\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:constraint-kind:authored-source-statement\",\"latitude_ref\":[],\"owner\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:actor:f-p-author\",\"predicate\":{\"conditions\":[\"Apply the clause within its explicitly stated scope and qualifications.\"],\"exceptions\":[],\"grounding\":[{\"end_line\":877,\"path\":\"standards/PRODUCT_DEFINITION.md\",\"quote\":\"### PC-01 — Recursive Product boundaries\\n\\nA Product identifies one coherent WHAT and its owning authority. Alternative\\nrealizations of that WHAT are build tenants. A decomposition into Products names\\nwhich distinct outcomes and authorities each constituent owns, and which outer\\noutcome the composition owns.\\n\\nUnder the identity and ownership laws (P3, P6), within a declared decomposition scope, a leaf has no further constituent Product\\nboundary exposed by that decomposition. It may contain modules and declared\\nexternal dependencies. A composite relates two or more constituent capabilities\\nor an outer capability to its constituent capability; its own capability may in\\nturn be consumed as a constituent. The same definition, contract and authority\\nlaws apply at every depth. Shared constituents keep one identity and their\\nseparately bound uses; a hierarchy view may show several references to one leaf.\\n\\nDecomposition, capability/data dependency, inspection permission, authority and\\nwork prerequisites are distinct relations. A directory tree establishes none of\\nthem. A named composition view states its root, participating identities,\\nselected boundaries and relation kinds rather than treating all reachable edges\\nas one hierarchy.\",\"section\":\"repo://stdo-v3.0.2-source/PRODUCT_DEFINITION.md#pc-01--recursive-product-boundaries\",\"start_line\":857}],\"statement\":\"A Product identifies one coherent WHAT and its owning authority. Alternative\\nrealizations of that WHAT are build tenants. A decomposition into Products names\\nwhich distinct outcomes and authorities each constituent owns, and which outer\\noutcome the composition owns.\\n\\nUnder the identity and ownership laws (P3, P6), within a declared decomposition scope, a leaf has no further constituent Product\\nboundary exposed by that decomposition. It may contain modules and declared\\nexternal dependencies. A composite relates two or more constituent capabilities\\nor an outer capability to its constituent capability; its own capability may in\\nturn be consumed as a constituent. The same definition, contract and authority\\nlaws apply at every depth. Shared constituents keep one identity and their\\nseparately bound uses; a hierarchy view may show several references to one leaf.\\n\\nDecomposition, capability/data dependency, inspection permission, authority and\\nwork prerequisites are distinct relations. A directory tree establishes none of\\nthem. A named composition view states its root, participating identities,\\nselected boundaries and relation kinds rather than treating all reachable edges\\nas one hierarchy.\",\"uncertainty\":\"\"},\"refusal\":\"urn:a-c:generation:630ce49ea536c4b3949b529c:stop:no-execution-or-acceptance\",\"scope\":[\"urn:a-c:generation:630ce49ea536c4b3949b529c:scope:source-corpus\"]}"

