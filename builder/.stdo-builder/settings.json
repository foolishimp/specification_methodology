{
  "definition": "stdo_builder.json",
  "agents": {
    "claude": [
      "claude",
      "-p",
      "Read the activation packet at {brief}, and do the work it binds in this folder.",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Bash,Read,Write,Edit,Glob,Grep",
      "--output-format",
      "json",
      "--model",
      "claude-opus-5-5",
      "--max-budget-usd",
      "12"
    ]
  },
  "work": "claude",
  "evaluation": "claude",
  "reports": {
    "claude": {
      "cost": "total_cost_usd",
      "calls": "num_turns",
      "unit": "USD"
    }
  },
  "limits": {
    "sessions": 12
  }
}
