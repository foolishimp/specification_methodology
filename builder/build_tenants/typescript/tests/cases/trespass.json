        "fixture": "method",
        "vector": "write-code",
        "kind": "work",
        "ticket": "tickets/active/261119-a.md",
        "start": {
          "specification/requirements/FUNCTIONS.md": "a1",
          "build_tenants/main/code/main.ts": "c1",
          "tickets/active/261119-a.md": "t1"
        },
        "end": {
          "specification/requirements/FUNCTIONS.md": "a2",
          "build_tenants/main/code/main.ts": "c2",
          "scratch/notes.txt": "z1",
          "tickets/active/261119-a.md": "t1"
        }
      },
      "expect": [
        "specification/requirements/FUNCTIONS.md"
      ]
    },
    {
      "covers": [
        "REQ-ALG-008 law 2"
      ],
      "says": "The session committed, then undid its commits with git: the protected files are as they were at the start, and nothing is returned.",
