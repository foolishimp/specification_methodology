{
  "algorithm": "trespass",
  "requirement": "REQ-ALG-008",
  "shared": {
    "places": {
      "definition": "stdo_product.json",
      "settings": ".stdo-builder/settings.json",
      "graph": ".stdo-builder/graph.json",
      "registry": ".stdo-builder/registry.json",
      "own": [
        ".stdo-builder/.gitignore"
      ],
      "lanes": [
        "tickets/backlog",
        "tickets/active",
        "tickets/done"
