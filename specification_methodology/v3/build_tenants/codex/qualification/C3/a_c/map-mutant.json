{"calculus_ref":"stdo://releases/v2.5.1-rc.2/standards/AXIOMATIC_CALCULUS.md","clauses":[{"arguments":[{"ref":"urn:codex-stdo3:c3:symbol:findings","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#input"},{"literal":"Only planned slot A is admitted/authenticated; B is required uncovered coverage.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#premise"},{"literal":"Retain A falsified, its original producer and source/A.md#permission-branch, and B uncovered; remain non-green.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#consequence"},{"literal":"A missing planned judgment invalidates a complete planned-set claim; never invent the judgment.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#qualification"}],"clause_type":"constraint","operator":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#conserves","source_refs":["repo://codex-v3/qualification/C3/a_c/SOURCE.md#finding-conservation","repo://codex-v3/successor/standards/TRANSFORMATION_LIBRARY.md#conjoin"],"statement":"Known failure and uncovered responsibility coexist without loss of lineage or coverage.","uri":"urn:codex-stdo3:c3:clause:finding-conservation"},{"arguments":[{"ref":"urn:codex-stdo3:c3:symbol:state","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#input"},{"literal":"A named current owner or display label supplies permission without an exact grant.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#premise"},{"ref":"urn:codex-stdo3:c3:symbol:observed","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#premise"},{"literal":"Unknown current observation returns unresolved with no effect; known missing exact permission returns refused with no effect.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#qualification"}],"clause_type":"constraint","operator":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#requires","source_refs":["repo://codex-v3/qualification/C3/a_c/SOURCE.md#token-state","repo://codex-v3/successor/standards/TRANSFORMATION_LIBRARY.md#bind"],"s