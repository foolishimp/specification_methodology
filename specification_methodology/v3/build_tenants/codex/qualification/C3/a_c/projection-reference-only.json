{"calculus_ref":"stdo://releases/v2.5.1-rc.2/standards/AXIOMATIC_CALCULUS.md","clause_relations":[{"arguments":[{"literal":"After an unknown possible effect, observe/reconcile actual state or stop unresolved before a potentially duplicating retry; no operation authority follows.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#qualification"}],"clause_type":"constraint","operator":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#requires","uri":"urn:codex-stdo3:c3:clause:effect-recovery"},{"arguments":[{"ref":"urn:codex-stdo3:c3:symbol:findings","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#input"},{"literal":"Exactly planned slot A is admitted/authenticated, bound to source-v1 and its one original producer; B is required uncovered coverage.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#premise"},{"literal":"Retain A falsified, its original producer and source/A.md#permission-branch, and B uncovered; remain non-green.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#consequence"},{"literal":"A missing planned judgment invalidates a complete planned-set claim; never invent the judgment.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#qualification"}],"clause_type":"constraint","operator":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#conserves","uri":"urn:codex-stdo3:c3:clause:finding-conservation"},{"arguments":[{"ref":"urn:codex-stdo3:c3:symbol:state","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#input"},{"ref":"urn:codex-stdo3:c3:symbol:permission","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#premise"},{"ref":"urn:codex-stdo3:c3:symbol:observed","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#premise"},{"literal":"Unknown current observation returns unresolved with no effect; known missing exact permission returns refused with no effect.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#qualification"},{"literal":"An exact assignment grant names issuer equal to the selected token current owner, the exact token, destination and operation assign. A label or an inspect grant supplies no assignment permission.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#qualification"}],"clause_type":"constraint","operator":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#requires","uri":"urn:codex-stdo3:c3:clause:permission"},{"arguments":[{"ref":"urn:codex-stdo3:c3:clause:finding-conservation","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#premise"},{"ref":"urn:codex-stdo3:c3:clause:token-transfer","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#premise"},{"ref":"urn:codex-stdo3:c3:clause:typed-join","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#premise"},{"literal":"A predicate result supplies no action or acceptance grant; a decision owner acts only within its existing grant.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#qualification"}],"clause_type":"constraint","operator":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#requires","uri":"urn:codex-stdo3:c3:clause:role-boundary"},{"arguments":[{"ref":"urn:codex-stdo3:c3:clause:permission","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#premise"},{"ref":"urn:codex-stdo3:c3:symbol:state","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#input"},{"literal":"With known state and exact permission, only the selected token receives the named destination owner; token set and single-valued ownership survive.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#consequence"},{"literal":"Resumption re-observes actual state; no universal idempotence is asserted.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#qualification"}],"clause_type":"constraint","operator":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#conserves","uri":"urn:codex-stdo3:c3:clause:token-transfer"},{"arguments":[{"ref":"urn:codex-stdo3:c3:symbol:join","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#input"},{"literal":"LengthMetres -> DurationSeconds is incompatible; DurationMilliseconds -> DurationSeconds requires divide by 1000.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#premise"},{"literal":"Compatible types confer no operation permission.","role":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#qualification"}],"clause_type":"constraint","operator":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#requires","uri":"urn:codex-stdo3:c3:clause:typed-join"}],"closure":{"clauses":["urn:codex-stdo3:c3:clause:effect-recovery","urn:codex-stdo3:c3:clause:finding-conservation","urn:codex-stdo3:c3:clause:permission","urn:codex-stdo3:c3:clause:role-boundary","urn:codex-stdo3:c3:clause:token-transfer","urn:codex-stdo3:c3:clause:typed-join"],"residuals":["urn:codex-stdo3:c3:residual:scope"],"symbols":["urn:codex-stdo3:c3:symbol:findings","urn:codex-stdo3:c3:symbol:join","urn:codex-stdo3:c3:symbol:observed","urn:codex-stdo3:c3:symbol:permission","urn:codex-stdo3:c3:symbol:state"]},"frame_indexes":[{"clause_refs":["urn:codex-stdo3:c3:clause:effect-recovery","urn:codex-stdo3:c3:clause:role-boundary"],"frame_ref":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#authority-and-interpretation","residual_refs":["urn:codex-stdo3:c3:residual:scope"],"scope":"Separate predicate/model results from operation or acceptance grants; handle unknown effects without blind repetition.","source_refs":["repo://codex-v3/qualification/C3/a_c/SOURCE.md#authority-and-interpretation"],"uri":"urn:codex-stdo3:c3:index:authority"},{"clause_refs":["urn:codex-stdo3:c3:clause:role-boundary"],"frame_ref":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#finding-conservation","residual_refs":[],"scope":"Conserve A falsified and B uncovered under an exact admitted planned set.","source_refs":["repo://codex-v3/qualification/C3/a_c/SOURCE.md#finding-conservation"],"uri":"urn:codex-stdo3:c3:index:findings"},{"clause_refs":["urn:codex-stdo3:c3:clause:effect-recovery","urn:codex-stdo3:c3:clause:token-transfer"],"frame_ref":"repo://codex-v3/qualification/C3/a_c/SOURCE.md#token-state","residual