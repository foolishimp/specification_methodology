  "clauses": [
    {
      "uri": "urn:stdo-3:claude:i3:clause:block-four-conditions",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:policy-choice"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:promotion-block"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "must"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:owner",
          "literal": "EVALUATION §5, conserving UP-007"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:choice",
          "literal": "the four necessary conditions for blocking"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:among",
          "literal": "any enumeration of conditions bearing on the claim's acceptance"
        }
      ],
      "statement": "A finding can block current promotion only when it: 1. falsifies that claim; 2. exposes competing or ambiguous authority on the claim's acceptance path; 3. violates applicable active authority, safety or retained accepted behaviour; or 4. establishes a material architectural decision with durable consequences that forecloses an admitted Product outcome.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/EVALUATION.md#when-a-finding-blocks-promotion"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:block-hard-stop-row",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:promotion-block"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:hard-stop"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "must"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p6"
        }
      ],
      "statement": "a valid falsification of a mandatory claim governed by a non-waivable hard stop — the boundary blocks, whatever the assigned priority or the decision cutoff",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/EVALUATION.md#when-a-finding-blocks-promotion"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:block-owner-decides",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:policy-choice"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:promotion-block"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "must"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:owner",
          "literal": "EVALUATION §5; the cutoff: the adopting Product"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:choice",
          "literal": "below the Product-owned cutoff no block follows mechanically"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:among",
          "literal": "mechanical blocking by severity, or the decision owner's act under a cutoff"
        }
      ],
      "statement": "any other finding meeting one of the four conditions — the decision owner decides blocking from the exact affected claim, the governed outcome or decision the work serves (ACTIVATION §1, Intake), the applicable hard stops and the Product-owned cutoff policy; below that cutoff no block follows mechanically, and an accepted residual is retained explicitly",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/EVALUATION.md#when-a-finding-blocks-promotion"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:block-outside-claim",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:forbids",
      "arguments": [
        {
