  "clauses": [
    {
      "uri": "urn:stdo-3:claude:i3:clause:three-invalidators",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:closed-result"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:invalidator"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "must"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p4b"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p3"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p6"
        }
      ],
      "statement": "An invalidator invalidates the affected result before reliance, even where the subject's own bytes are unchanged, preserving its predecessor/successor relation and any demonstrably independent surviving results.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/ACTIVATION.md#7-closed-result-and-reuse"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:invalidators-are-three",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:states",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:policy-choice"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:invalidator"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:owner",
          "literal": "ACTIVATION §7"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:choice",
          "literal": "three kinds of invalidator: material input change, changed basis, declared revising observation"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:among",
          "literal": "separate trigger lists in each member, or one owner list"
        }
      ],
      "statement": "The invalidators are three: - a material input change: a change to the result's subject or to an input it rests on, including the admissible evidence that bears on its predicate; newly acquired or changed admissible evidence is such a change when it is material to the result as [FOUNDATIONS §2](FOUNDATIONS.md#2-ontology) defines material, that is, when it could change the result's value; - a changed basis: a change to any coordinate of the basis the result binds (FOUNDATIONS §2, Basis); - a declared revising observation: an observation that the result or judgment itself names as one that would revise it, once it occurs.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/ACTIVATION.md#7-closed-result-and-reuse"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:reuse-not-by-role-change",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:permits",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:closed-result"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "may"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:condition",
          "literal": "an unchanged consumer that checks exact applicability"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:exception",
          "literal": "A reused judgment does not satisfy a separately required independent judgment"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p4b"
        }
      ],
      "statement": "A closed result is reused by an unchanged consumer that checks exact applicability; a role, conversation or resumption change alone invalidates nothing.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/ACTIVATION.md#7-closed-result-and-reuse"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:only-admitted-contract-activates",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:forbids",
