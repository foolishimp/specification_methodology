  ],
  "clauses": [
    {
      "uri": "urn:stdo-3:claude:i3:clause:p0",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:premise"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:qualification",
          "literal": "recovered: P0's standing in FOUNDATIONS §3"
        }
      ],
      "statement": "P0 Bounded construction. A finite actor realises a selected outer contract through steps. Each step's selected context fits the actor's envelope.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:p1",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:premise"
        }
      ],
      "statement": "P1 Interpretation. Subject, representation and interpretation are distinct; meaning holds within a declared context through a declared contract.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:p2",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:premise"
        }
      ],
      "statement": "P2 Purpose. A selected outcome defines adequacy; interfaces inherit material obligations from the transformation they serve.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:p3",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:premise"
        }
      ],
      "statement": "P3 Identity. An object's identity is declared (authority, kind, value) and survives admissible change; a boundary is a claim with a proof obligation.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:p4b",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p0"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p2"
        }
      ],
      "statement": "P4b Conservation of step-produced facts. Judgments, residuals, observations and authority decisions the outer contract needs are recorded by the step that produced them.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:p5",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p0"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p6"
        }
      ],
      "statement": "P5 Totality. A step can meet a condition outside its context (P0's open-world premise), and it cannot report success on one (P6).",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:p6",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:premise"
        }
      ],
      "statement": "P6 Justification and authority. Definitions, assumptions, observations, candidate judgments and accepted claims have distinct standing; evidence supports a claim on a basis; authority permits or disposes within scope.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:core-only-one",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:states",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:core-result"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "must"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p5"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p6"
        }
      ],
      "statement": "This core is the only one.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#results"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:only-satisfied-establishes",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:states",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:core-result"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p6"
        }
      ],
      "statement": "Only `satisfied` establishes the predicate.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#results"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:no-mapping-raises-standing",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:forbids",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:refinement"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:not-performed"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "must-not"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p5"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p6"
        }
      ],
      "statement": "No refinement or mapping raises a result's standing (P5, P6): - a falsified or failed result never maps to a satisfied or successful one; - a result that admissible evidence cannot decide never maps to `satisfied`; - an evaluation that was not performed stays distinct from one whose evidence cannot decide: it has no [closed result](ACTIVATION.md#7-closed-result-and-reuse), and it is never mapped to `indeterminate` or to any other core value; - an effect whose completion is unknown never maps to no effect or to completed.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#results"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:not-performed-no-result",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:states",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:not-performed"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p6"
        }
      ],
      "statement": "An evaluation that is required or planned and was not performed has no closed result; an actor cannot report an evaluation it did not perform (P6).",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#results"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:refinement-maps-once",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:refinement"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "must"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p5"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p1"
        }
      ],
      "statement": "A member, profile or adopting Product that needs finer outcomes defines a refinement. The refinement names the question it answers and the predicate its mapping is for, and maps every refined value to exactly one core value.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#results"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:parent-value-rule",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:policy-choice"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:refinement"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "must"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:owner",
          "literal": "FOUNDATIONS §4 Results"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:choice",
          "literal": "a child value keeps its parent's core value"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:among",
          "literal": "letting a split by cause change the core value, or keeping it"
        }
      ],
      "statement": "The parent-value rule governs every such split: each child value names its parent value and its cause and keeps its parent's core value; a child that needs a different core value needs a different parent value, which only the owner of the parent declares; and no child takes `satisfied` from a parent that is not `satisfied`.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#results"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:availability-assessment-acceptance",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:states",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:core-result"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p6"
        }
      ],
      "statement": "Availability, assessment and acceptance are separate results, each with its own predicate: that a step produced a candidate; that the candidate meets its declared criteria; and that the [decision owner](ACTIVATION.md#roles-and-delegation) accepts it at its boundary.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#results"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:conjunction-defined-once",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:states",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:conjunction"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:core-only-one"
        }
      ],
      "statement": "It is defined here once, over the core.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#conjunction-of-results"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:conjunction-three-inputs",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:requires",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:conjunction"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:gap"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "must"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p5"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p4b"
        }
      ],
      "statement": "A conjunction takes three inputs and keeps them apart: 1. the closed results returned, each a core value with its predicate and domain outcome; 2. the planned assessments that have no closed result applicable to the composite: evaluations the composite requires that were not performed, or whose result is absent, stale, bound to another subject or basis, or incapable of establishing its claim; 3. the required coverage that no planned assessment addresses: for a required obligation set R and the coverage C that the planned assessments admit, the uncovered coverage R minus C.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#conjunction-of-results"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:gap-never-satisfied",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:forbids",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:gap"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "must-not"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:conjunction-three-inputs"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p5"
        }
      ],
      "statement": "A conjunction with any item in the second or third input is never `satisfied`.",
      "source_refs": [
        "stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#conjunction-of-results"
      ]
    },
    {
      "uri": "urn:stdo-3:claude:i3:clause:stale-satisfied-never-counts",
      "clause_type": "constraint",
      "operator": "urn:stdo-3:claude:i3:vocabulary:operator:forbids",
      "arguments": [
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:standing",
          "ref": "urn:stdo-3:claude:i3:standing:consequence"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:subject",
          "ref": "urn:stdo-3:claude:i3:concept:stale-result"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:force",
          "literal": "must-not"
        },
        {
          "role": "urn:stdo-3:claude:i3:vocabulary:role:support",
          "ref": "urn:stdo-3:claude:i3:clause:p3"
        },
        {
