{"calculus_ref":"stdo://releases/v2.5.1-rc.2/standards/AXIOMATIC_CALCULUS.md","clause_relations":[{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:policy-choice","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"},{"ref":"urn:stdo-3:claude:i3:concept:invalidator","role":"urn:stdo-3:claude:i3:vocabulary:role:subject"},{"literal":"ACTIVATION §7","role":"urn:stdo-3:claude:i3:vocabulary:role:owner"},{"literal":"three kinds of invalidator: material input change, changed basis, declared revising observation","role":"urn:stdo-3:claude:i3:vocabulary:role:choice"},{"literal":"separate trigger lists in each member, or one owner list","role":"urn:stdo-3:claude:i3:vocabulary:role:among"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:states","uri":"urn:stdo-3:claude:i3:clause:invalidators-are-three"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:premise","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"},{"literal":"recovered: P0's standing in FOUNDATIONS §3","role":"urn:stdo-3:claude:i3:vocabulary:role:qualification"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","uri":"urn:stdo-3:claude:i3:clause:p0"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:premise","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","uri":"urn:stdo-3:claude:i3:clause:p2"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:premise","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","uri":"urn:stdo-3:claude:i3:clause:p3"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:consequence","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"},{"ref":"urn:stdo-3:claude:i3:clause:p0","role":"urn:stdo-3:claude:i3:vocabulary:role:support"},{"ref":"urn:stdo-3:claude:i3:clause:p2","role":"urn:stdo-3:claude:i3:vocabulary:role:support"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","uri":"urn:stdo-3:claude:i3:clause:p4b"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:premise","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","uri":"urn:stdo-3:claude:i3:clause:p6"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:consequence","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"},{"ref":"urn:stdo-3:claude:i3:concept:closed-result","role":"urn:stdo-3:claude:i3:vocabulary:role:subject"},{"literal":"may","role":"urn:stdo-3:claude:i3:vocabulary:role:force"},{"literal":"an unchanged consumer that checks exact applicability","role":"urn:stdo-3:claude:i3:vocabulary:role:condition"},{"literal":"A reused judgment does not satisfy a separately required independent judgment","role":"urn:stdo-3:claude:i3:vocabulary:role:exception"},{"ref":"urn:stdo-3:claude:i3:clause:p4b","role":"urn:stdo-3:claude:i3:vocabulary:role:support"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:permits","uri":"urn:stdo-3:claude:i3:clause:reuse-not-by-role-change"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:consequence","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"},{"ref":"urn:stdo-3:claude:i3:concept:closed-result","role":"urn:stdo-3:claude:i3:vocabulary:role:subject"},{"ref":"urn:stdo-3:claude:i3:concept:invalidator","role":"urn:stdo-3:claude:i3:vocabulary:role:subject"},{"literal":"must","role":"urn:stdo-3:claude:i3:vocabulary:role:force"},{"ref":"urn:stdo-3:claude:i3:clause:p4b","role":"urn:stdo-3:claude:i3:vocabulary:role:support"},{"ref":"urn:stdo-3:claude:i3:clause:p3","role":"urn:stdo-3:claude:i3:vocabulary:role:support"},{"ref":"urn:stdo-3:claude:i3:clause:p6","role":"urn:stdo-3:claude:i3:vocabulary:role:support"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","uri":"urn:stdo-3:claude:i3:clause:three-invalidators"}],"clauses":[{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:policy-choice","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"},{"ref":"urn:stdo-3:claude:i3:concept:invalidator","role":"urn:stdo-3:claude:i3:vocabulary:role:subject"},{"literal":"ACTIVATION §7","role":"urn:stdo-3:claude:i3:vocabulary:role:owner"},{"literal":"three kinds of invalidator: material input change, changed basis, declared revising observation","role":"urn:stdo-3:claude:i3:vocabulary:role:choice"},{"literal":"separate trigger lists in each member, or one owner list","role":"urn:stdo-3:claude:i3:vocabulary:role:among"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:states","source_refs":["stdo-3://build_tenants/claude/standards/ACTIVATION.md#7-closed-result-and-reuse"],"statement":"The invalidators are three: - a material input change: a change to the result's subject or to an input it rests on, including the admissible evidence that bears on its predicate; newly acquired or changed admissible evidence is such a change when it is material to the result as [FOUNDATIONS §2](FOUNDATIONS.md#2-ontology) defines material, that is, when it could change the result's value; - a changed basis: a change to any coordinate of the basis the result binds (FOUNDATIONS §2, Basis); - a declared revising observation: an observation that the result or judgment itself names as one that would revise it, once it occurs.","uri":"urn:stdo-3:claude:i3:clause:invalidators-are-three"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:premise","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"},{"literal":"recovered: P0's standing in FOUNDATIONS §3","role":"urn:stdo-3:claude:i3:vocabulary:role:qualification"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","source_refs":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"],"statement":"P0 Bounded construction. A finite actor realises a selected outer contract through steps. Each step's selected context fits the actor's envelope.","uri":"urn:stdo-3:claude:i3:clause:p0"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:premise","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","source_refs":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"],"statement":"P2 Purpose. A selected outcome defines adequacy; interfaces inherit material obligations from the transformation they serve.","uri":"urn:stdo-3:claude:i3:clause:p2"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:premise","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","source_refs":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"],"statement":"P3 Identity. An object's identity is declared (authority, kind, value) and survives admissible change; a boundary is a claim with a proof obligation.","uri":"urn:stdo-3:claude:i3:clause:p3"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:consequence","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"},{"ref":"urn:stdo-3:claude:i3:clause:p0","role":"urn:stdo-3:claude:i3:vocabulary:role:support"},{"ref":"urn:stdo-3:claude:i3:clause:p2","role":"urn:stdo-3:claude:i3:vocabulary:role:support"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","source_refs":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"],"statement":"P4b Conservation of step-produced facts. Judgments, residuals, observations and authority decisions the outer contract needs are recorded by the step that produced them.","uri":"urn:stdo-3:claude:i3:clause:p4b"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:premise","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","source_refs":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"],"statement":"P6 Justification and authority. Definitions, assumptions, observations, candidate judgments and accepted claims have distinct standing; evidence supports a claim on a basis; authority permits or disposes within scope.","uri":"urn:stdo-3:claude:i3:clause:p6"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:consequence","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"},{"ref":"urn:stdo-3:claude:i3:concept:closed-result","role":"urn:stdo-3:claude:i3:vocabulary:role:subject"},{"literal":"may","role":"urn:stdo-3:claude:i3:vocabulary:role:force"},{"literal":"an unchanged consumer that checks exact applicability","role":"urn:stdo-3:claude:i3:vocabulary:role:condition"},{"literal":"A reused judgment does not satisfy a separately required independent judgment","role":"urn:stdo-3:claude:i3:vocabulary:role:exception"},{"ref":"urn:stdo-3:claude:i3:clause:p4b","role":"urn:stdo-3:claude:i3:vocabulary:role:support"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:permits","source_refs":["stdo-3://build_tenants/claude/standards/ACTIVATION.md#7-closed-result-and-reuse"],"statement":"A closed result is reused by an unchanged consumer that checks exact applicability; a role, conversation or resumption change alone invalidates nothing.","uri":"urn:stdo-3:claude:i3:clause:reuse-not-by-role-change"},{"arguments":[{"ref":"urn:stdo-3:claude:i3:standing:consequence","role":"urn:stdo-3:claude:i3:vocabulary:role:standing"},{"ref":"urn:stdo-3:claude:i3:concept:closed-result","role":"urn:stdo-3:claude:i3:vocabulary:role:subject"},{"ref":"urn:stdo-3:claude:i3:concept:invalidator","role":"urn:stdo-3:claude:i3:vocabulary:role:subject"},{"literal":"must","role":"urn:stdo-3:claude:i3:vocabulary:role:force"},{"ref":"urn:stdo-3:claude:i3:clause:p4b","role":"urn:stdo-3:claude:i3:vocabulary:role:support"},{"ref":"urn:stdo-3:claude:i3:clause:p3","role":"urn:stdo-3:claude:i3:vocabulary:role:support"},{"ref":"urn:stdo-3:claude:i3:clause:p6","role":"urn:stdo-3:claude:i3:vocabulary:role:support"}],"clause_type":"constraint","operator":"urn:stdo-3:claude:i3:vocabulary:operator:requires","source_refs":["stdo-3://build_tenants/claude/standards/ACTIVATION.md#7-closed-result-and-reuse"],"statement":"An invalidator invalidates the affected result before reliance, even where the subject's own bytes are unchanged, preserving its predecessor/successor relation and any demonstrably independent surviving results.","uri":"urn:stdo-3:claude:i3:clause:three-invalidators"}],"closure":{"clauses":["urn:stdo-3:claude:i3:clause:invalidators-are-three","urn:stdo-3:claude:i3:clause:p0","urn:stdo-3:claude:i3:clause:p2","urn:stdo-3:claude:i3:clause:p3","urn:stdo-3:claude:i3:clause:p4b","urn:stdo-3:claude:i3:clause:p6","urn:stdo-3:claude:i3:clause:reuse-not-by-role-change","urn:stdo-3:claude:i3:clause:three-invalidators"],"residuals":[],"symbols":["urn:stdo-3:claude:i3:concept:closed-result","urn:stdo-3:claude:i3:concept:invalidator","urn:stdo-3:claude:i3:standing:consequence","urn:stdo-3:claude:i3:standing:policy-choice","urn:stdo-3:claude:i3:standing:premise"]},"frame_indexes":[{"clause_refs":["urn:stdo-3:claude:i3:clause:invalidators-are-three","urn:stdo-3:claude:i3:clause:reuse-not-by-role-change","urn:stdo-3:claude:i3:clause:three-invalidators"],"frame_ref":"stdo-3://build_tenants/claude/standards/ACTIVATION.md#7-closed-result-and-reuse","residual_refs":[],"scope":"Decide whether a closed result may be reused or is invalidated: the three invalidators and reuse after an exact applicability check.","source_refs":["stdo-3://build_tenants/claude/standards/ACTIVATION.md#7-closed-result-and-reuse"],"uri":"urn:stdo-3:claude:i3:frame-index:reuse-and-invalidation"}],"frame_refs":["stdo-3://build_tenants/claude/standards/ACTIVATION.md#7-closed-result-and-reuse"],"kind":"axiom-indexer.frame-projection","map_s