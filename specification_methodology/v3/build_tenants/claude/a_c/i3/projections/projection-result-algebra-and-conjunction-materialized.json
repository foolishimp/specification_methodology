md#3-commitments"],"urn:stdo-3:claude:i3:standing:policy-choice":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"],"urn:stdo-3:claude:i3:standing:premise":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#3-commitments"]},"symbols":[{"kind":"urn:stdo-3:claude:i3:vocabulary:kind:concept","label":"Conjunction of results: the one rule combining results for a composite predicate","source_refs":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#conjunction-of-results"],"uri":"urn:stdo-3:claude:i3:concept:conjunction"},{"kind":"urn:stdo-3:claude:i3:vocabulary:kind:concept","label":"Core result algebra: the one set of five result values of FOUNDATIONS §4","source_refs":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#results"],"uri":"urn:stdo-3:claude:i3:concept:core-result"},{"kind":"urn:stdo-3:claude:i3:vocabulary:kind:concept","label":"Gap: a planned assessment without a closed result, or uncovered coverage","source_refs":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#conjunction-of-results"],"uri":"urn:stdo-3:claude:i3:concept:gap"},{"kind":"urn:stdo-3:claude:i3:vocabulary:kind:concept","label":"Not performed: a planned evaluation with no closed result","source_refs":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#results"],"uri":"urn:stdo-3:claude:i3:concept:not-performed"},{"kind":"urn:stdo-3:claude:i3:vocabulary:kind:concept","label":"Refinement: a member's finer values, each mapped to exactly one core value","source_refs":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#results"],"uri":"urn:stdo-3:claude:i3:concept:refinement"},{"kind":"urn:stdo-3:claude:i3:vocabulary:kind:concept","label":"Stale result: a held result bound to a basis the composite does not require","source_refs":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#conjunction-of-results"],"uri":"urn:stdo-3:claude:i3:concept:stale-result"},{"kind":"urn:stdo-3:claude:i3:vocabulary:kind:standing","label":"consequence","source_