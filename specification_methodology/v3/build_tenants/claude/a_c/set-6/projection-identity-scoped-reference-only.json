:claude:a-c-text:symbol:scoped-identity-kind":["stdo-3://build_tenants/claude/standards/IDENTITY.md#type"],"urn:stdo-3:claude:a-c-text:symbol:scoped-identity-proxy-grant":["stdo-3://build_tenants/claude/standards/IDENTITY.md#6-authority-identity-and-conservation-stdo-up-004"],"urn:stdo-3:claude:a-c-text:symbol:scoped-identity-recorded-decision":["stdo-3://build_tenants/claude/standards/IDENTITY.md#6-authority-identity-and-conservation-stdo-up-004"]},"vocabulary_refs":["urn:stdo-3:claude:vocabulary:kind:concept","urn:stdo-3:claude:vocabulary:kind:record","urn:stdo-3:claude:vocabulary:kind:role","urn:stdo-3:claude:vocabulary:operator:distinguishes","urn:stdo-3:claude:vocabulary:operator:forbids","urn:stdo-3:claude:vocabulary:operator:preserves","urn:stdo-3:claude:vocabulary:operator:requires","urn:stdo-3:claude:vocabulary:role:qualification","urn:stdo-3:claude:vocabulary:role:requirement","urn:stdo-3:claude:vocabulary:role:subject","urn:stdo-3:claude:vocabulary:role:support"]}
