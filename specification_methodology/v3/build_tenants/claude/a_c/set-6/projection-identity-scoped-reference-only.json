.md#type"},{"sha256":"sha256:03150e390768bf92d7bc66068ffad9ecfb3acce69e5188552316d2e049027f53","uri":"stdo-3://build_tenants/claude/standards/IDENTITY.md#uniqueness"},{"sha256":"sha256:cbe2edb928d3e75e23446f6d525baea664966e8d5920e6fa389cbaa4af8f1f8d","uri":"stdo://releases/v2.5.1-rc.2/standards/AXIOMATIC_CALCULUS.md"}],"schema_version":1,"source_basis":"stdo-3://build_tenants/claude/standards/","source_routes":{"urn:stdo-3:claude:a-c-text:clause:authority-is-an-identity-bearing-relation":["stdo-3://build_tenants/claude/standards/IDENTITY.md#6-authority-identity-and-conservation-stdo-up-004"],"urn:stdo-3:claude:a-c-text:clause:authority-is-never-minted":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#2-ontology"],"urn:stdo-3:claude:a-c-text:clause:carriers-never-widen-authority":["stdo-3://build_tenants/claude/standards/IDENTITY.md#6-authority-identity-and-conservation-stdo-up-004"],"urn:stdo-3:claude:a-c-text:clause:engine-and-domain-own-different-identities":["stdo-3://build_tenants/claude/standards/IDENTITY.md#5-authority-split","stdo-3://build_tenants/claude/standards/IDENTITY.md#domain-owned-identity","stdo-3://build_tenants/claude/standards/IDENTITY.md#engine-owned-identity"],"urn:stdo-3:claude:a-c-text:clause:identity-change-is-an-explicit-relation":["stdo-3://build_tenants/claude/standards/IDENTITY.md#stability"],"urn:stdo-3:claude:a-c-text:clause:identity-is-authority-kind-value":["stdo-3://build_tenants/claude/standards/IDENTITY.md#scoped-identity"],"urn:stdo-3:claude:a-c-text:clause:identity-is-unique-within-its-lawful-scope":["stdo-3://build_tenants/claude/standards/IDENTITY.md#uniqueness"],"urn:stdo-3:claude:a-c-text:clause:identity-kinds-are-not-collapsed":["stdo-3://build_tenants/claude/standards/IDENTITY.md#type"],"urn:stdo-3:claude:a-c-text:clause:identity-survives-admissible-change":["stdo-3://build_tenants/claude/standards/FOUNDATIONS.md#2-ontology"],"urn:stdo-3:claude:a-c-text:clause:proxy-identity-stays-distinct-from-human-authority":["s