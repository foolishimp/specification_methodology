  "domain": {
    "observation": "four admissible cases with every truth assignment (16) and every observation partition (15): 240",
    "assertion": "a check that is a necessary condition or a sufficient conjunction, passing or not: 4",
    "quantified": "two checks with miss probabilities in {1/4, 1/2}, under a declared independent or dependent joint model: 8",
    "impact": "two tests, each with validity dependencies {f1}, {f2}, {f1,f2} or unknown and a mandatory flag, under a nonempty change {f1}, {f2} or {f1,f2}: 8 x 8 x 3 = 192",
    "cases": "240 + 4 + 8 + 192 = 444; one deterministic output each"
  },
  "properties": {
    "P1_satisfied_only_on_uniform_true": "a case is judged satisfied only when every case sharing its observation is true (ASSURANCE Assertions And Observation: same observation, opposite truth values admit no sound complete decision; FOUNDATIONS Observation sufficiency)",
    "P2_falsified_only_on_uniform_false": "a case is judged falsified only when every case sharing its observation is false (the same sentences: a reported failure is treated the same way)",
    "P3_mixed_observation_indeterminate": "a case whose observation class holds opposite truth values is judged indeterminate (ASSURANCE: further evidence, a narrower scope or an indeterminate judgment is required)",
    "P4_uniform_observation_decided": "a case whose observation class is uniform is decided, not indeterminate (non-vacuity guard: this check's reading that the sufficiency condition met permits the decision)",
    "P5_necessary_not_full": "a passing check of a necessary condition does not establish the full obligation (ASSURANCE: passing a check of a necessary condition does not establish the full obligation)",
    "P6_sufficient_establishes": "a passing sufficient conjunction establishes the obligation (ASSURANCE: the stated conjunction is sufficient; non-vacuity guard)",
    "P7_joint_from_declared_model": "the joint miss probability is the declared model's, and equals the product of marginals only under declared independence (ASSURANCE Assurance Within A Risk Model; FOUNDATIONS Quantified assurance: replacing the terms by the product requires conditional independence)",
    "P8_detection_not_correctness": "one minus the joint miss is reported as at least one detection, never as the probability that the whole product is correct (FOUNDATIONS Quantified assurance)",
    "P9_affected_selected": "every test whose known dependencies meet the change is selected (FOUNDATIONS Change impact: S_\u0394 = { t : D*(t) intersects I(\u0394) })",
    "P10_mandatory_selected": "every mandatory gate is selected whatever the change (ASSURANCE: mandatory gates remain applicable; FOUNDATIONS: a mandatory gate remains applicable)",
    "P11_unknown_selected": "a test whose dependencies are unknown is selected (ASSURANCE: missing influence information cannot justify exclusion; FOUNDATIONS: unknown impact widens reassessment)",
    "P12_retained_only_if_unaffected": "a retained test is not mandatory, has known dependencies and none of them is in the change (FOUNDATIONS: retention establishes the validity conditions; excluding a check requires supported coverage of its dependencies)"
  },
