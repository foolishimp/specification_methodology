{
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "/Users/jim/**/CLAUDE.md",
    "/Users/jim/**/.claude/rules/**",
    "/private/tmp/CLAUDE.md",
    "/private/CLAUDE.md"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/Library/Frameworks/Python.framework/Versions/3.12/bin/python3.12",
            "args": [
              "/private/tmp/stdo304-probes-xun7ttbp/candidate/plugins/spec/scripts/claude_tool_gate.py",
              "--policy",
              "/private/tmp/stdo304-probes-xun7ttbp/controls/issuer-policy.json",
              "--policy-sha256",
              "e8d23ecfa2854842701625ae34d5e95c27c6bbe6dd9742d8f08526ef180dd03b",
              "--audit",
              "/private/tmp/stdo304-probes-xun7ttbp/controls/issuer-audit.jsonl"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
