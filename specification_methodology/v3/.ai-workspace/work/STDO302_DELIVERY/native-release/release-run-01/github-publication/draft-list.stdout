_methodology/releases/download/untagged-bd9a88b2735a1e4676e5/stdo-v3.0.2-manifest.json.sha256"},{"url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/assets/675598295","id":675598295,"node_id":"RA_kwDOR7M92c4oRM_X","name":"stdo_toolchain-0.1.6-py3-none-any.whl","label":"","uploader":{"login":"foolishimp","id":1457632,"node_id":"MDQ6VXNlcjE0NTc2MzI=","avatar_url":"https://avatars.githubusercontent.com/u/1457632?v=4","gravatar_id":"","url":"https://api.github.com/users/foolishimp","html_url":"https://github.com/foolishimp","followers_url":"https://api.github.com/users/foolishimp/followers","following_url":"https://api.github.com/users/foolishimp/following{/other_user}","gists_url":"https://api.github.com/users/foolishimp/gists{/gist_id}","starred_url":"https://api.github.com/users/foolishimp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foolishimp/subscriptions","organizations_url":"https://api.github.com/users/foolishimp/orgs","repos_url":"https://api.github.com/users/foolishimp/repos","events_url":"https://api.github.com/users/foolishimp/events{/privacy}","received_events_url":"https://api.github.com/users/foolishimp/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":61549,"digest":"sha256:ef726f780220a4be93c8ce014e2838d140851ec0e3d47902ea2ddd36a26c3242","download_count":0,"created_at":"2026-10-25T16:58:12Z","updated_at":"2026-10-25T16:58:13Z","browser_download_url":"https://github.com/foolishimp/specification_methodology/releases/download/untagged-bd9a88b2735a1e4676e5/stdo_toolchain-0.1.6-py3-none-any.whl"},{"url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/assets/675598320","id":675598320,"node_id":"RA_kwDOR7M92c4oRM_w","name":"stdo_toolchain-0.1.6-py3-none-any.whl.sha256","label":"","uploader":{"login":"foolishimp","id":1457632,"node_id":"MDQ6VXNlcjE0NTc2MzI=","avatar_url":"https://avatars.githubusercontent.com/u/1457632?v=4","gravatar_id":"","url":"https://api.github.com/users/foolishimp","html_url":"https://github.com/foolishimp","followers_url":"https://api.github.com/users/foolishimp/followers","following_url":"https://api.github.com/users/foolishimp/following{/other_user}","gists_url":"https://api.github.com/users/foolishimp/gists{/gist_id}","starred_url":"https://api.github.com/users/foolishimp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foolishimp/subscriptions","organizations_url":"https://api.github.com/users/foolishimp/orgs","repos_url":"https://api.github.com/users/foolishimp/repos","events_url":"https://api.github.com/users/foolishimp/events{/privacy}","received_events_url":"https://api.github.com/users/foolishimp/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":104,"digest":"sha256:5a2ff8ed8195de385542ab37f2150401f1c7d9444ba5aac003518f57c6a3e6e6","download_count":0,"created_at":"2026-10-25T16:58:13Z","updated_at":"2026-10-25T16:58:13Z","browser_download_url":"https://github.com/foolishimp/specification_methodology/releases/download/untagged-bd9a88b2735a1e4676e5/stdo_toolchain-0.1.6-py3-none-any.whl.sha256"}],"tarball_url":null,"zipball_url":null,"body":"# STDO 3.0.2\n\nSTDO 3.0.2 is a published immutable release with no RC suffix. It adds recursive\nProduct composition, explicit edge authority and context conditions, composition\ncontracts and examples, and source-matched reference frames. The stable-v1 release\nprofile gives this exact version an immutable tag while preserving historical\nRC release and selector semantics.\n\nThe accompanying manager 0.1.6 wheel supports stable acquisition and explicit\ncomposition-edge verification. The updated a_c and Codex/Claude Skills sources are\ncheckpointed on main; those independently owned tools and their consumer bases\nretain their own lifecycle. Installing the native method does not adopt a project\nor change an existing method installation.\n\n## Exact release\n\n| Coordinate | Identity |\n|---|---|\n| Immutable tag | `specification_methodology/v3.0.2` |\n| Native commit C | `23ca9c0929d7be8570edafaf30542e3daeb8dc1f` |\n| Annotated tag object T | `d03b00a7fdf8972dc236b52eb09f3eccba7f62cb` |\n| Native manifest SHA256 | `f7f3f824ee1ac3e048d1b1ea86ce3aae84866e2e9d5010fe5eda2e38e12f4477` |\n| Manager wheel SHA256 | `ef726f780220a4be93c8ce014e2838d140851ec0e3d47902ea2ddd36a26c3242` |\n| Reviewed source A | `44448b14ecc9c5636d0e7972c7a4f1a80a07c623` |\n\nThe native distribution contains 86 payload files plus its installed manifest:\nstandards, generated frames, the supplied spec plugin, licence and release note.\nThe native predecessor is the published 3.0.1 RC1 commit; its tags and bytes remain\nunchanged. No legacy 2.* coordinated cohort is republished.\n\n## Install the exact method\n\nUse Python 3.11 or later. Download the manager wheel, native manifest and their\nchecksum sidecars from the assets below. In that download directory, verify and create a separate environment:\n\n```sh\nshasum -a 256 -c stdo_toolchain-0.1.6-py3-none-any.whl.sha256\nshasum -a 256 -c stdo-v3.0.2-manifest.json.sha256\npython3 -m venv .stdo302\n.stdo302/bin/python -I -m pip install ./stdo_toolchain-0.1.6-py3-none-any.whl\n.stdo302/bin/python -I -m stdo_toolchain.cli --store ./stdo-store install v3.0.2 \\\n  --repository https://github.com/foolishimp/specification_methodology.git \\\n  --manifest-sha256 f7f3f824ee1ac3e048d1b1ea86ce3aae84866e2e9d5010fe5eda2e38e12f4477\n.stdo302/bin/python -I -m stdo_toolchain.cli --store ./stdo-store verify v3.0.2 \\\n  --manifest-sha256 f7f3f824ee1ac3e048d1b1ea86ce3aae84866e2e9d5010fe5eda2e38e12f4477\n```\n\nThe manager wheel is a separate distribution asset, not executable content added\nto the native standards package. Existing installed 3.0.1/2.5.1 and pinned project\nbases remain unchanged by this separate-store installation.\n\n## Representation and evidence\n\nThe separate `stdo-v3.0.2-composition-release-supplement.tar.gz` and its sidecar bind\nthe same native commit and manifest. The archive supplies 32 authored composition\nand release records, exact source custody, both graph carriers, and a portable\nverifier. Check the sidecar, extract the archive, then run:\n\n```sh\npython3 -I -S -B stdo-v3.0.2-supplement/supplement.py verify \\\n  --bundle stdo-v3.0.2-supplement\n```\n\nIndependent source and local-native readbacks passed. The exact manager wheel\npassed 121 affected tests; a_c support passed 240 tests. Fresh isolated local\ninstallation and both carrier recoveries passed on these exact assets. The\nsupplement is bounded to the selected 32 records; it does not complete the earlier\nwhole-method representation. Whole-method practical qualification, host behavior\nand cost/efficiency claims remain outside this release's established evidence.\n"},{"url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/422770275","assets_url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/422770275/assets","upload_url":"https://uploads.github.com/repos/foolishimp/specification_methodology/releases/422770275/assets{?name,label}","html_url":"https://github.com/foolishimp/specification_methodology/releases/tag/specification_methodology/v3.0.1-rc.1","id":422770275,"author":{"login":"foolishimp","id":1457632,"node_id":"MDQ6VXNlcjE0NTc2MzI=","avatar_url":"https://avatars.githubusercontent.com/u/1457632?v=4","gravatar_id":"","url":"https://api.github.com/users/foolishimp","html_url":"https://github.com/foolishimp","followers_url":"https://api.github.com/users/foolishimp/followers","following_url":"https://api.github.com/users/foolishimp/following{/other_user}","gists_url":"https://api.github.com/users/foolishimp/gists{/gist_id}","starred_url":"https://api.github.com/users/foolishimp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foolishimp/subscriptions","organizations_url":"https://api.github.com/users/foolishimp/orgs","repos_url":"https://api.github.com/users/foolishimp/repos","events_url":"https://api.github.com/users/foolishimp/events{/privacy}","received_events_url":"https://api.github.com/users/foolishimp/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOR7M92c4ZMvZj","tag_name":"specification_methodology/v3.0.1-rc.1","target_commitish":"fe4941f56a52ed3697a2b516d8d68948b0ea65d9","name":"STDO 3.0.1 RC1","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-24T13:34:42Z","updated_at":"2026-10-24T17:22:07Z","published_at":"2026-10-24T14:11:07Z","assets":[{"url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/assets/672433385","id":672433385,"node_id":"RA_kwDOR7M92c4oFITp","name":"stdo-v3.0.1-rc.1-manifest.json","label":"","uploader":{"login":"foolishimp","id":1457632,"node_id":"MDQ6VXNlcjE0NTc2MzI=","avatar_url":"https://avatars.githubusercontent.com/u/1457632?v=4","gravatar_id":"","url":"https://api.github.com/users/foolishimp","html_url":"https://github.com/foolishimp","followers_url":"https://api.github.com/users/foolishimp/followers","following_url":"https://api.github.com/users/foolishimp/following{/other_user}","gists_url":"https://api.github.com/users/foolishimp/gists{/gist_id}","starred_url":"https://api.github.com/users/foolishimp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foolishimp/subscriptions","organizations_url":"https://api.github.com/users/foolishimp/orgs","repos_url":"https://api.github.com/users/foolishimp/repos","events_url":"https://api.github.com/users/foolishimp/events{/privacy}","received_events_url":"https://api.github.com/users/foolishimp/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":13792,"digest":"sha256:60356364a412dbde8cffe68fe0eda4e2749b0162acce93495534eee13b223df8","download_count":5,"created_at":"2026-10-24T14:11:06Z","updated_at":"2026-10-24T14:11:06Z","browser_download_url":"https://github.com/foolishimp/specification_methodology/releases/download/specification_methodology/v3.0.1-rc.1/stdo-v3.0.1-rc.1-manifest.json"},{"url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/assets/672433383","id":672433383,"node_id":"RA_kwDOR7M92c4oFITn","name":"stdo-v3.0.1-rc.1-manifest.json.sha256","label":"","uploader":{"login":"foolishimp","id":1457632,"node_id":"MDQ6VXNlcjE0NTc2MzI=","avatar_url":"https://avatars.githubusercontent.com/u/1457632?v=4","gravatar_id":"","url":"https://api.github.com/users/foolishimp","html_url":"https://github.com/foolishimp","followers_url":"https://api.github.com/users/foolishimp/followers","following_url":"https://api.github.com/users/foolishimp/following{/other_user}","gists_url":"https://api.github.com/users/foolishimp/gists{/gist_id}","starred_url":"https://api.github.com/users/foolishimp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foolishimp/subscriptions","organizations_url":"https://api.github.com/users/foolishimp/orgs","repos_url":"https://api.github.com/users/foolishimp/repos","events_url":"https://api.github.com/users/foolishimp/events{/privacy}","received_events_url":"https://api.github.com/users/foolishimp/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":97,"digest":"sha256:d53e6a5ffda20159252308a2d064232208ddc1a875bf84b58708527006668a49","download_count":4,"created_at":"2026-10-24T14:11:06Z","updated_at":"2026-10-24T14:11:06Z","browser_download_url":"https://github.com/foolishimp/specification_methodology/releases/download/specification_methodology/v3.0.1-rc.1/stdo-v3.0.1-rc.1-manifest.json.sha256"}],"tarball_url":"https://api.github.com/repos/foolishimp/specification_methodology/tarball/specification_methodology/v3.0.1-rc.1","zipball_url":"https://api.github.com/repos/foolishimp/specification_methodology/zipball/specification_methodology/v3.0.1-rc.1","body":"STDO 3.0.1 RC1 is a **published, immutable STDO release**. The `rc.1` suffix identifies its first immutable cut. There is no separate final cut required to make this a release. Qualification and acceptance are verdicts over this exact cut; each consumer's adoption is a separate decision.\n\nThis release establishes the common total deterministic processing contract while keeping operation permissions, evaluation, admission and closure authority separate. It adds bounded continuation-preservation and qualified-reference guidance, worked finite examples, and explicit legacy migration obligations. The stronger totality/dependency requirements mean the version label does not promise automatic compatibility for old operations.\n\n- Native commit: `fe4941f56a52ed3697a2b516d8d68948b0ea65d9`\n- Immutable tag: `specification_methodology/v3.0.1-rc.1`\n- Annotated tag object: `6e96ce1d2422508e5620bd12afceda890c556fd6`\n- Source checkpoint: `9f70f54d13929b4629808030077da0f1691ce7bd`\n- Canonical manifest SHA256: `60356364a412dbde8cffe68fe0eda4e2749b0162acce93495534eee13b223df8`\n- Payload: 83 files, including 12 regenerated native reference frames.\n\nThe affected source received cross-family semantic review and supported repairs. A fresh installation acquired from the public release reproduces all 83 payload files and the exact manifest. Four installed-route tasks support the selected amendment distinctions; the retained assessment qualifies one actor's categorical-equivalence overstatement.\n\nThe supplemental a_c/Graphify representation is **incomplete and is not included in this release**. It is a separate artifact representing this exact native cut and is not a dependency of the native install. Whole-method qualification and measured efficiency benefit remain open. These limits do not change this cut's published-release status. The construction builder remains STDO 2.5.1 RC2.\n\nInstall and verify this exact release:\n\n```sh\nstdo --store ./stdo-3.0.1-store install v3.0.1-rc.1 \\\n  --repository https://github.com/foolishimp/specification_methodology.git \\\n  --manifest-sha256 60356364a412dbde8cffe68fe0eda4e2749b0162acce93495534eee13b223df8\nstdo --store ./stdo-3.0.1-store verify v3.0.1-rc.1 \\\n  --manifest-sha256 60356364a412dbde8cffe68fe0eda4e2749b0162acce93495534eee13b223df8\n```\n\nInstallation does not automatically change an existing Product Definition's selected basis.\n\nPublication correction: the original GitHub prerelease flag and test-candidate presentation were incorrect. The owner clarified that each published cut is a proper release. This correction supersedes any implication in earlier publication or bundled candidate wording that another final release must be awaited. It changes the publication classification and presentation; the tag, payload, manifest, assets and recorded qualification evidence are unchanged. [Correction record](https://github.com/foolishimp/specification_methodology/blob/main/specification_methodology/v3/.ai-workspace/work/STDO301_DELIVERY/native-release/publication-correction-001/README.md).\n"},{"url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/418547214","assets_url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/418547214/assets","upload_url":"https://uploads.github.com/repos/foolishimp/specification_methodology/releases/418547214/assets{?name,label}","html_url":"https://github.com/foolishimp/specification_methodology/releases/tag/specification_methodology/v3.0.0-rc.1","id":418547214,"author":{"login":"foolishimp","id":1457632,"node_id":"MDQ6VXNlcjE0NTc2MzI=","avatar_url":"https://avatars.githubusercontent.com/u/1457632?v=4","gravatar_id":"","url":"https://api.github.com/users/foolishimp","html_url":"https://github.com/foolishimp","followers_url":"https://api.github.com/users/foolishimp/followers","following_url":"https://api.github.com/users/foolishimp/following{/other_user}","gists_url":"https://api.github.com/users/foolishimp/gists{/gist_id}","starred_url":"https://api.github.com/users/foolishimp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foolishimp/subscriptions","organizations_url":"https://api.github.com/users/foolishimp/orgs","repos_url":"https://api.github.com/users/foolishimp/repos","events_url":"https://api.github.com/users/foolishimp/events{/privacy}","received_events_url":"https://api.github.com/users/foolishimp/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOR7M92c4Y8oYO","tag_name":"specification_methodology/v3.0.0-rc.1","target_commitish":"0a04feb788c080183b58cf4a162e88372be1d87e","name":"STDO 3.0.0 RC1","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-10-20T13:28:52Z","updated_at":"2026-10-25T16:56:51Z","published_at":"2026-10-20T15:17:27Z","assets":[{"url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/assets/659674426","id":659674426,"node_id":"RA_kwDOR7M92c4nUdU6","name":"a_c-stdo-v3-common-35fb4824-packaging-r1.tar.gz","label":"","uploader":{"login":"foolishimp","id":1457632,"node_id":"MDQ6VXNlcjE0NTc2MzI=","avatar_url":"https://avatars.githubusercontent.com/u/1457632?v=4","gravatar_id":"","url":"https://api.github.com/users/foolishimp","html_url":"https://github.com/foolishimp","followers_url":"https://api.github.com/users/foolishimp/followers","following_url":"https://api.github.com/users/foolishimp/following{/other_user}","gists_url":"https://api.github.com/users/foolishimp/gists{/gist_id}","starred_url":"https://api.github.com/users/foolishimp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foolishimp/subscriptions","organizations_url":"https://api.github.com/users/foolishimp/orgs","repos_url":"https://api.github.com/users/foolishimp/repos","events_url":"htt