ub.com/users/foolishimp/following{/other_user}","gists_url":"https://api.github.com/users/foolishimp/gists{/gist_id}","starred_url":"https://api.github.com/users/foolishimp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foolishimp/subscriptions","organizations_url":"https://api.github.com/users/foolishimp/orgs","repos_url":"https://api.github.com/users/foolishimp/repos","events_url":"https://api.github.com/users/foolishimp/events{/privacy}","received_events_url":"https://api.github.com/users/foolishimp/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":13478,"digest":"sha256:069285ad5a79d59ca2dd835e34a54b3e537b0eeef99c29994b18c339dbe62232","download_count":1,"created_at":"2026-10-20T15:17:15Z","updated_at":"2026-10-20T15:17:15Z","browser_download_url":"https://github.com/foolishimp/specification_methodology/releases/download/specification_methodology/v3.0.0-rc.1/stdo-v3.0.0-rc.1-manifest.json"},{"url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/assets/659674438","id":659674438,"node_id":"RA_kwDOR7M92c4nUdVG","name":"stdo-v3.0.0-rc.1-manifest.json.sha256","label":"","uploader":{"login":"foolishimp","id":1457632,"node_id":"MDQ6VXNlcjE0NTc2MzI=","avatar_url":"https://avatars.githubusercontent.com/u/1457632?v=4","gravatar_id":"","url":"https://api.github.com/users/foolishimp","html_url":"https://github.com/foolishimp","followers_url":"https://api.github.com/users/foolishimp/followers","following_url":"https://api.github.com/users/foolishimp/following{/other_user}","gists_url":"https://api.github.com/users/foolishimp/gists{/gist_id}","starred_url":"https://api.github.com/users/foolishimp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foolishimp/subscriptions","organizations_url":"https://api.github.com/users/foolishimp/orgs","repos_url":"https://api.github.com/users/foolishimp/repos","events_url":"https://api.github.com/users/foolishimp/events{/privacy}","received_events_url":"https://api.github.com/users/foolishimp/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":97,"digest":"sha256:22d6b0ecafb0ca1789df87b477d0c0c31d46d2114df83a18de273fcd0acaf849","download_count":1,"created_at":"2026-10-20T15:17:15Z","updated_at":"2026-10-20T15:17:15Z","browser_download_url":"https://github.com/foolishimp/specification_methodology/releases/download/specification_methodology/v3.0.0-rc.1/stdo-v3.0.0-rc.1-manifest.json.sha256"}],"tarball_url":"https://api.github.com/repos/foolishimp/specification_methodology/tarball/specification_methodology/v3.0.0-rc.1","zipball_url":"https://api.github.com/repos/foolishimp/specification_methodology/zipball/specification_methodology/v3.0.0-rc.1","body":"# STDO 3.0.0 RC1\n\nPublication clarification follows the owner's direction: an RC-labelled cut is a\nproper release; this presentation change supplies no new semantic acceptance or\nqualification. The [original API record](https://github.com/foolishimp/specification_methodology/blob/44448b14ecc9c5636d0e7972c7a4f1a80a07c623/specification_methodology/v3/.ai-workspace/work/STDO302_DELIVERY/prior-release-presentation-300/before.json)\nis preserved with its original notes and qualification snapshot.\n\nSTDO **v3.0.0-rc.1** is a proper published immutable standalone release.\nInstall the exact method and supplied `spec` plugin payload from this repository:\n\n```sh\nstdo install v3.0.0-rc.1 --repository https://github.com/foolishimp/specification_methodology.git --manifest-sha256 069285ad5a79d59ca2dd835e34a54b3e537b0eeef99c29994b18c339dbe62232\n```\n\nV3 installs alongside V2.5.1. Existing projects keep their pinned Product\nDefinitions and governing versions; this command adds an installed cut and\ndoes not adopt V3 for a project or activate a global plugin. Project adoption\nand review of V3 entry routes are separate actions.\n\n## Exact native cut\n\n| Coordinate | Identity |\n|---|---|\n| Immutable tag | `specification_methodology/v3.0.0-rc.1` |\n| Commit C | `0a04feb788c080183b58cf4a162e88372be1d87e` |\n| Annotated tag object T | `dde3e5f70d36f95369f88cc3b4130c6909678326` |\n| Native manifest SHA256 | `069285ad5a79d59ca2dd835e34a54b3e537b0eeef99c29994b18c339dbe62232` |\n\nThe native distribution has **81 payload files plus `manifest.json`**:\n62 standards, 17 plugin files, the root licence and the release note. The\nprivate pipeline and shared native installation were checked on these exact\nobjects and bytes; separately activated nonauthor assessment passed the\nbounded mechanical pipeline and ten selected refusal outcomes. These receipts\nsupport those installation, identity, route and refusal claims only.\n\nThe embedded release note describes the original private/local test and its\nqualification snapshot. This later public publication adds availability of\nthat **unchanged exact cut**. The exact RC1 tag is preserved; no additional\nfinal cut is required. Publication does not change the recorded qualification\nscope or turn the frozen source into an accepted method. Source checkpoint `35fb4824a064a84df5af214a0d0e2da597c18ac6` remains `not_ready` and\nunaccepted; open source-review/owner decisions and whole-method/actual-use\nqualification are not closed by this publication. The governing builder was\nthe installed STDO v2.5.1-rc.2.\n\n## Selected release assets\n\n- `stdo-v3.0.0-rc.1-manifest.json` is the exact reviewed native installed\n  manifest, SHA256 `069285ad5a79d59ca2dd835e34a54b3e537b0eeef99c29994b18c339dbe62232`, with its `.sha256` sidecar. Native installation reads\n  the tagged Git distribution; this JSON is verification metadata.\n- `a_c-stdo-v3-common-35fb4824-packaging-r1.tar.gz` is a **separate supplemental\n  representation artifact**, 10,089,542 bytes, SHA256\n  `989c0efbbba90c1d444c6a1c24def4174ef8519bec5f63d9bef021f27dd75e2b`,\n  supplied with its unchanged `.sha256` sidecar.\n\nThe a_c artifact represents source checkpoint `35fb4824a064a84df5af214a0d0e2da597c18ac6`, package tree\n`7f2070b61c848b42b4dfb3af1e0ce53869de1aa1` and canonical model SHA256 `691c4ab0d0993312a31e7e2371070ea4758fdf74b32862ff4d5a32d05af79fbf`. It is independently owned\noutput; it is neither a runtime dependency nor a member of the native RC1\nmethod/plugin distribution. No legacy 2.* matched-cohort upgrade is included.\n\nSource checkpoint 35fb and native C are distinct identities. Three\nnonsemantic packaging edits distinguish the native payload: two plugin\nversion fields change `3.0.0-dev.1` to `3.0.0-rc.1`, and the release note records\nthe truthful test scope. All 58 selected semantic inputs, all frames and the\nremaining payload bytes are unchanged. The separate representation is not\nrebased to native C, and this relation supplies no new semantic equivalence,\nwhole-calculus, interpretation-acceptance or actual-use qualification claim.\n\nInside the a_c archive, `RELEASE.json` retains `publication: not_performed`,\n`product_version: null`, unaccepted-source and `semantic_acceptance:\nnot_issued` preparation fields. These are frozen **preparation-snapshot\nfacts**, not a live global publication registry. Current public availability\nis recorded by this GitHub release and its publication receipt; it does not\nretroactively rewrite that snapshot or issue semantic acceptance. The\nartifact's existing qualification limits and reserved owner decisions remain\nintact.\n\nAfter downloading the selected assets together, verify their sidecars:\n\n```sh\nshasum -a 256 -c stdo-v3.0.0-rc.1-manifest.json.sha256\nshasum -a 256 -c a_c-stdo-v3-common-35fb4824-packaging-r1.tar.gz.sha256\n```\n\nThe additional `a_c-stdo-v3-common-35fb4824.tar.gz` archive and its checksum are the historical original preparation baseline. The `packaging-r1` archive is the current reviewed packaging recipe. Source and evidence: https://github.com/foolishimp/specification_methodology/blob/main/a_c/applications/stdo-v3-common-35fb4824/PUBLICATION.md .\n"},{"url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/370105645","assets_url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/370105645/assets","upload_url":"https://uploads.github.com/repos/foolishimp/specification_methodology/releases/370105645/assets{?name,label}","html_url":"https://github.com/foolishimp/specification_methodology/releases/tag/v2.4.0","id":370105645,"author":{"login":"foolishimp","id":1457632,"node_id":"MDQ6VXNlcjE0NTc2MzI=","avatar_url":"https://avatars.githubusercontent.com/u/1457632?v=4","gravatar_id":"","url":"https://api.github.com/users/foolishimp","html_url":"https://github.com/foolishimp","followers_url":"https://api.github.com/users/foolishimp/followers","following_url":"https://api.github.com/users/foolishimp/following{/other_user}","gists_url":"https://api.github.com/users/foolishimp/gists{/gist_id}","starred_url":"https://api.github.com/users/foolishimp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foolishimp/subscriptions","organizations_url":"https://api.github.com/users/foolishimp/orgs","repos_url":"https://api.github.com/users/foolishimp/repos","events_url":"https://api.github.com/users/foolishimp/events{/privacy}","received_events_url":"https://api.github.com/users/foolishimp/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOR7M92c4WD10t","tag_name":"v2.4.0","target_commitish":"main","name":"STDO 2.4.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-08-13T18:19:27Z","updated_at":"2026-08-13T18:19:35Z","published_at":"2026-08-13T17:56:59Z","assets":[],"tarball_url":"https://api.github.com/repos/foolishimp/specification_methodology/tarball/v2.4.0","zipball_url":"https://api.github.com/repos/foolishimp/specification_methodology/zipball/v2.4.0","body":"# STDO 2.4.0\n\n## Publication Boundary\n\nThis note describes the exact semantic and member delta for the STDO `2.4.0`\nrelease subject. It carries no mutable construction, review, acceptance,\nbranch, tag-existence, or publication state. Those facts are exact-carrier\nevidence outside these release-scoped bytes.\n\n## Product Predecessor And Promotion Basis\n\nThe operative Product predecessor is:\n\n- release: `v2.3.0`;\n- exact commit: `b2c64047e01d9d582243a25af587ac772233a4ea`;\n- standards aggregate:\n  `014ead42a96412f51a172a8158e42fdfe1447a0af5e4f70a79cf8a020129630c`;\n  and\n- successor relation: every predecessor claim is conserved except where the\n  explicit amendments below extend it.\n\nThe direct-promotion basis is:\n\n- published carrier: `v2.3.1-rc.2`;\n- exact commit: `e204f3bb287651daedefa9ea28f1c2c7cc387787`;\n- standards aggregate:\n  `53b33aab4bf4f4859126f8e794d9edfd3497e2eed8a9fd22b954abdc07f7e4df`;\n  and\n- relation: its independently accepted `STDO-UP-021` and `STDO-UP-022`\n  semantics are conserved in `2.4.0`; the RC was not tapped as an intermediate\n  `2.3.1` Product.\n\n## Product Delta\n\n### Conserved RC2 Admission And Assurance Amendments\n\nThe release conserves the complete accepted RC2 relations:\n\n- `STDO-UP-021` requires every admission owner to derive the complete enclosing\n  relation independently, preserve one exact authoritative basis, validate\n  every participant and equality join before effects, admit the complete\n  transition or none, reconstruct and replay the exact relation, and qualify\n  every owner and supported boundary including materially distinct\n  post-validation partial-failure seams.\n- `STDO-UP-022` binds assurance to the exact claimed subject and composition,\n  mechanical enforcement to a reproducible predicate and ordinary-path\n  witness, verdict scope to evaluated populations, and generic-method\n  qualification to fresh declared-input construction, construction freeze,\n  mandatory governing-basis evaluation, reference-outcome non-authority, and\n  explicit post-exposure qualification boundaries.\n- Design Module Method retains the accepted IACS revision relation for carrier\n  addition, removal, merge, and split through accepted Ontology/design re-entry,\n  complete-set gate replay, assurance-subject reconciliation, and\n  implementation reconciliation.\n\n### Universal Reference Frame Method\n\n`REFERENCE_FRAME_METHOD.md` introduces the finite engagement atom above any one\nspecification methodology or domain realization.\n\nA frame binds one evaluation family to an exact workspace and topology basis,\nmaterial-relation manifold, coordinates and equality law, inherited invariants,\nsemantic/evaluation/decision authorities and operation authority where\nmaterial, admissible evidence, exclusions, closed result algebra, actor\ncapability envelope, declared dependencies, and invalidation conditions.\n\nThe method separately defines:\n\n- frame-set declaration;\n- exact activation;\n- evaluation and closed result return;\n- independently activated co-evaluation, assurance independence, and result\n  conjunction;\n- evidence or coordinate translation;\n- material composition where an evaluation requires it;\n- tuple-relative operational coverage with explicit residual uncertainty; and\n- empirical revision after failures, topology mutation, evidence change, or\n  capability change.\n\nFrames need not form a hierarchy, partition, tree, service topology, or runtime\nontology. They may be disjoint or overlapping, refine, restrict, translate,\ncompose, or succeed one another. Structural disjointness, separately activated\nevaluation, and assurance independence remain distinct. Role, persona, actor,\nabstraction, component, and lens remain distinct from a frame; each may help\nconstruct or activate one but does not become one by label.\n\nThe method explicitly admits `satisfied`, `falsified`, `indeterminate`,\n`out_of_frame`, and `invalid_basis`. Operational full coverage is relative to\none declared workspace, outcome, basis, evaluation inventory, frame set, and\ntime. It does not assert that no undiscovered material evaluation exists.\n\nMethod self-qualification covers every claimed function and failure relation:\ndeclaration, activation, evaluation, conjunction, translation, coverage,\nrevision, result consumption, material composition, authority conservation,\nactivation refusal, and the closed Worker-result mapping.\n\n### Applied STDO Executive, Worker, And Reviewer Baseline\n\n`STDO_REFERENCE_FRAME_BASELINE.md` is an optional derived application profile,\nnot a second execution constitution. It maps three overlapping finite\nengagement frames onto existing STDO owners:\n\n```text\nExecutive attempts Worker activation\n  -> activation refusal returns to Executive and creates no Worker result\n  -> after lawful activation, Worker returns\n     candidate_ready | refused | incomplete | re_entry_requested to Executive\n  -> Executive disposes directly when independent review is not required\n     or activates Reviewer when it is required\n  -> Reviewer independently reacquires and evaluates the exact subject\n     and returns one Reference Frame Method result to Executive\n  -> Executive applies the existing STDO disposition and continuation relation\n```\n\nThe Worker carries only its inherited construction/transformation operation\nauthority and cannot admit, publish, accept itself, or activate the Reviewer.\nThe Reviewer cannot implement repair, return or apply an STDO disposition, or\nselect continuation. The Executive does not gain universal semantic,\noperation, or implementation authority. Frames and actors are separately bound;\nthe profile requires no fixed actor count.\n\nProjects may adopt the baseline or define another frame configuration through\nexisting Goals, Product, requirement, or accepted-design authority. A local\naxioms carrier projects that authority and does not mint a parallel\nconstitutional layer.\n\n### Compression And Dual-Agent Bootstrap\n\nThe aggregate authority compression includes both new sources and carries the\nminimum universal and applied frame relations. The Codex `AGENTS_TEMPLATE.md`\nand Claude `CLAUDE_TEMPLATE.md` contain equal frame-engagement semantics and\nroute exact use to the selected complete method cut.\n\nThe templates are derived bootstrap projections. They do not replace source\nmethod law or the consumer's selected immutable release identity.\n\n## Conserved Law\n\nThe successor retains:\n\n- the complete STDO normative Product boundary;\n- every material `v2.3.0` claim and the accepted `v2.3.1-rc.2` admission,\n  assurance, and IACS-revision amendments;\n- Goals, Intent, Product, requirements, design, execution, identity, and release\n  ownership without a new peer authority path;\n- Product-outcome conservation, proportional delivery, Ontology, IACS, Prime,\n  three-view design, exact-subject assurance, and final identity law;\n- source-specific compression ownership and aggregate-only cross-method\n  compression;\n- consumer ownership of domain meaning, concrete actors, prompts, tools,\n  runtime, orchestration, schemas, storage, tests, and implementation; and\n- direct human acceptance of the exact final Product subject and carrier before\n  publication.\n\n## Exclusions\n\nThis release adds no:\n\n- executable STDO conformance engine, frame engine, workflow governor, runtime,\n  controller, registry, service, graph, or universal carrier;\n- required frame hierarchy, partition, exhaustive ontology, universal\n  composition, or mechanical frame-selection algorithm;\n- fixed model, vendor, prompt, tool, actor count, repository layout,\n  collaboration topology, or worker/reviewer process implementation;\n- authority arising from an Executive, Worker, Reviewer, role, persona, actor,\n  local axioms file, prompt, installed copy, or frame label;\n- ABIogenesis Product, GTL, HoG, ABG, runtime, module, ticket, or local\n  realization relation as universal STDO law;\n- normative methodology meaning, member-count change, or version increment\n  arising from the bounded Apache-2.0 release-license repair;\n- downstream consumer adoption or implementation change; or\n- claim that operational coverage proves metaphysical or undiscoverable\n  completeness.\n\n## Apache-2.0 License\n\nCopyright 2026 Dimitar Popov.\n\nThe complete `2.4.0` release carrier is made available under the Apache\nLicense, Version 2.0 (`Apache-2.0`). The canonical license text is carried at\nrepository root as `LICENSE`. Its SHA-256 is:\n\n`cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30`\n\nThe repository `README.md` identifies the license and requires an installed or\notherwise redistributed STDO cut to carry an exact license copy with the\nstandards payload. The independently distributable Claude plugin carries an\nexact copy at `plugins/spec/LICENSE` and declares `Apache-2.0` in its manifest.\n\nThe legal assets grant permissions over the work. They are release-scoped\ncarrier inputs, not normative methodology law or members of the 43-member\nstandards inventory. They do not make an installed cut operative without\nexplicit selection of the immutable release.\n\n| Legal distribution asset | SHA-256 |\n|---|---|\n| `LICENSE` | `cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30` |\n| `README.md` | `cc6a483821cf5eb15446852f432ee0632b70afc56f83792469a34490a3c88cb6` |\n| `plugins/spec/LICENSE` | `cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30` |\n\n## Auxiliary Distribution Assets\n\nThe Claude Code `spec` plugin remains delivery tooling, not a normative\nstandards member. Its independently versioned `2.1.0` update adds `frame` and\n`frame-baseline` to the document registry so an operator can load both new\nsources from an explicitly selected installed, released, or candidate basis.\n\n| Asset | Release identity | SHA-256 |\n|---|---|---|\n| `.claude-plugin/marketplace.json` | marketplace description | `ad88de5384c19227ee1512051d28fc9bb5b3b916f873cb42df93dddc99105106` |\n| `plugins/spec/.claude-plugin/plugin.json` | plugin version `2.1.0`, license `Apache-2.0` | `77cb1a4ada6b9a8970811a35f33d1ce52e3c5a2c9c9bb841b9469427e97f2ccd` |\n| `plugins/spec/skills/refresh/SKILL.md` | `/spec:refresh` registry | `1ca76a378245de66e3b1726f778fc5eb4abcddadb5675c3159f23156a8ab933d` |\n\nThese three plugin bytes and the three legal distribution assets above are\nqualified and frozen with the final carrier but remain outside the 43-member\nstandards Product inventory.\n\n## Release Subject And Direct Publication\n\nThe Product release subject is the exact 43-member\n`specification/standards/` distribution and aggregate recorded below. This\nrelease note is the release-scoped claim surface. `specification/PRODUCT.md`,\nthis note, the three legal distribution assets, and the three auxiliary plugin\nassets above are protected final carrier inputs. Co-located mutable\nsource-project state is excluded from the Product and final-delta subject,\nlimited to milestone state in `specification/GOALS.md`, ticket state and\npublication bookkeeping, and commentary/review evidence.\n\nDirect human Product authority selected a release-specific direct-final path\nfrom the published `v2.3.1-rc.2` lineage. No `v2.4.0-rc.*` identity is required\nfor this cut. Before publication, independent exact-cut review binds one frozen\nfinal carrier containing the exact Product and release-scoped bytes. Direct\nhuman acceptance then binds that subject, carrier, and review relation before\n`release/2.4.0` and annotated tag `v2.4.0` are published.\n\nThis release-specific exception does not amend the generic RC process in\n`RELEASE_METHOD.md` and is not evidence that another Product may omit its\ngoverning release gates.\n\n## Exact Standards Inventory\n\nRelative to `v2.3.0`, the distribution adds two members, changes nine existing\nmembers, removes none, and byte-conserves the other 32 predecessor members.\n\n| Disposition | Member | SHA-256 |\n|---|---|---|\n| changed | `specification/standards/SPEC_METHOD.md` | `23f33acb7c8e8c02f1d2d639615c427b76d698c371a5270b9c40871e2508b13e` |\n| changed | `specification/standards/DESIGN_MODULE_METHOD.md` | `1ef7a7c1cfbe8cd4f992aa629cfe8813c209fc841b9e22bcd859bb43bda4313d` |\n| changed | `specification/standards/README.md` | `c080938f2eed31dee8ec83086bac0545c2a5889ca8036440e886b4505ecc8981` |\n| added | `specification/standards/REFERENCE_FRAME_METHOD.md` | `0d8370e383e72cf89eb68175a6f3ecccb4a7fb913f4feed1f0810d1b558e471d` |\n| added | `specification/standards/STDO_REFERENCE_FRAME_BASELINE.md` | `e9731953144b5a0cf679ed5ed25150b2f82d4de7efce9d52b952504578f05d2e` |\n| changed | `specification/standards/authority_compressions/README.md` | `e421d8bdce98a4dd7c23e81125a919939568a344201d3a4700200b9eea6c44a2` |\n| changed | `specification/standards/authority_compressions/spec_method.compressed.md` | `8e196952cd1bc73440530edd442efca9ad24671e5b520a69d3bc017aaafc9069` |\n| changed | `specification/standards/authority_compressions/design_module_method.compressed.md` | `d0c2f65bbb49ccd26a098eba8acc932fe84893e1ca3b3e4c9f308e5abd40037b` |\n| changed | `specification/standards/authority_compressions/stdo_compressed.md` | `3190ecbcc1f2b6a3f19b005ca6ffe47d3d6217630679eb33634846f76b0b957e` |\n| changed | `specification/standards/templates/AGENTS_TEMPLATE.md` | `c1ed95a205176513f0fad18a7a0246bd13c812c8d3e1a7299557243cde01121e` |\n| changed | `specification/standards/templates/CLAUDE_TEMPLATE.md` | `cb90ef689985dd33c11c7e376ab8cc809bd0cdf86530b5c1bc7fb38075054485` |\n\nThe canonical member-set digest is:\n\n```sh\nfind specification/standards -type f | LC_ALL=C sort | xargs shasum -a 256 | shasum -a 256\n```\n\n`1571aab5bf9cc3605222d79502117c4873e4e5e136e07f909f4d4ad3684a4cc5`\n\nTop-level standards contain 12,738 lines, compared with 10,533 in `v2.3.0`:\nan increase of 2,111 lines, or 20.04 percent. The new minor release carries the\nuniversal method and derived profile as explicit members rather than hiding\ntheir semantics inside a pre-existing owner.\n\n## Qualification And Publication\n\nFinal qualification covers:\n\n- the complete `v2.3.0..v2.4.0` semantic and member delta;\n- exact 43-member identity and aggregate reproducibility;\n- source/compression digest agreement and semantic projection fidelity;\n- Reference Frame Method function, result, failure, coverage, revision, and\n  result-consumption populations;\n- combined method/profile ownership, transition, independence, actor-binding,\n  and project-configuration relations;\n- equivalent frame-engagement semantics in both agent bootstrap templates;\n- canonical Apache-2.0 text, repository and plugin declaration agreement, and\n  an exact installed license copy kept outside the normative member inventory;\n- clean installed-preview reconstruction and standards/license checksum\n  verification;\n- exact frozen final-carrier review; and\n- direct human acceptance before final branch/tag publication.\n"}]