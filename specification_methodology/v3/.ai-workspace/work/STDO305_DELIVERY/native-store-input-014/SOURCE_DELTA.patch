+def installed_input_directory(value):
+    """Read an explicit ordinary installation input without widening outputs."""
+    path = Path(value)
+    require(".." not in path.parts, "installation input traversal refused")
+    # Retain the historical relative/internal spelling; external inputs must
+    # be selected by their absolute path.
+    path = path if path.is_absolute() else output_path(path)
+    for parent in (path, *path.parents):
+        require(not parent.is_symlink(), f"redirected installation input: {parent}")
+    require(path.is_dir(), "missing installation input directory")
+    return path
+
