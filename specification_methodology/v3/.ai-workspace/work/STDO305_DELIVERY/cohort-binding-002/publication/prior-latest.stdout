s","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":61549,"digest":"sha256:ef726f780220a4be93c8ce014e2838d140851ec0e3d47902ea2ddd36a26c3242","download_count":3,"created_at":"2026-11-03T04:15:12Z","updated_at":"2026-11-03T04:15:12Z","browser_download_url":"https://github.com/foolishimp/specification_methodology/releases/download/specification_methodology/v3.0.4/stdo_toolchain-0.1.6-py3-none-any.whl"},{"url":"https://api.github.com/repos/foolishimp/specification_methodology/releases/assets/704246445","id":704246445,"node_id":"RA_kwDOR7M92c4p-fKt","name":"stdo_toolchain-0.1.6-py3-none-any.whl.sha256","label":"","uploader":{"login":"foolishimp","id":1457632,"node_id":"MDQ6VXNlcjE0NTc2MzI=","avatar_url":"https://avatars.githubusercontent.com/u/1457632?v=4","gravatar_id":"","url":"https://api.github.com/users/foolishimp","html_url":"https://github.com/foolishimp","followers_url":"https://api.github.com/users/foolishimp/followers","following_url":"https://api.github.com/users/foolishimp/following{/other_user}","gists_url":"https://api.github.com/users/foolishimp/gists{/gist_id}","starred_url":"https://api.github.com/users/foolishimp/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/foolishimp/subscriptions","organizations_url":"https://api.github.com/users/foolishimp/orgs","repos_url":"https://api.github.com/users/foolishimp/repos","events_url":"https://api.github.com/users/foolishimp/events{/privacy}","received_events_url":"https://api.github.com/users/foolishimp/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":104,"digest":"sha256:5a2ff8ed8195de385542ab37f2150401f1c7d9444ba5aac003518f57c6a3e6e6","download_count":2,"created_at":"2026-11-03T04:15:12Z","updated_at":"2026-11-03T04:15:12Z","browser_download_url":"https://github.com/foolishimp/specification_methodology/releases/download/specification_methodology/v3.0.4/stdo_toolchain-0.1.6-py3-none-any.whl.sha256"}],"tarball_url":"https://api.github.com/repos/foolishimp/specification_methodology/tarball/specification_methodology/v3.0.4","zipball_url":"https://api.github.com/repos/foolishimp/specification_methodology/zipball/specification_methodology/v3.0.4","body":"# STDO 3.0.4\n\nA normal standalone release, continuing 3.0.3. This publishes the owner's\naccepted scope with the recorded qualification limits; no further RC/final\ncut is needed. Existing consumer bases remain unchanged.\n\n- Five native skills—work, review, status, ticket and help—share bounded\n  issuing, receiving and return paths while preserving direct work.\n- Review distinguishes landing, work closure and Product release. Severity\n  is graded 1 highest to 5 lowest, separately from Executive priority.\n  Severity 3 gets an explicit downstream-impact assessment: material dependent\n  impact normally calls for repair; contained deferral needs a reason and owner.\n- The source reader fixes Unicode line/fence boundaries and empty ATX headings,\n  preserving exact physical lines and refusing unsupported Markdown structures.\n\n[Install and get started](https://github.com/foolishimp/specification_methodology/blob/16bc30d215915a4b7b3ed2f13e52e14510ae1c9d/specification_methodology/v3/plugins/spec/references/GETTING_STARTED.md#new-project).\n[Load the five native skills](https://github.com/foolishimp/specification_methodology/blob/16bc30d215915a4b7b3ed2f13e52e14510ae1c9d/specification_methodology/v3/plugins/spec/references/GETTING_STARTED.md#install-the-shared-skills)\nfrom the verified installed plugin, using direct Claude loading, exact Codex\nfile use or the documented optional local registration route. These skills\nare distinct from the unchanged 191-file a_c/independent Skills source bundle.\n\nWith an existing released manager:\n\n```sh\nstdo install v3.0.4 --manifest-sha256 102817a3f4bea4dca1d6fa0fc634b94404dd2ba82ba6d8c38b273402dda9f95b\nstdo verify v3.0.4 --manifest-sha256 102817a3f4bea4dca1d6fa0fc634b94404dd2ba82ba6d8c38b273402dda9f95b\nstdo resolve stdo://releases/v3.0.4/standards/documentation/index.html\n```\n\nThe four assets supply manager 0.1.6, the exact manifest and both checksums.\nThe guide includes fresh-machine bootstrap. Documentation retains the offline\n3D/2D/Layered constraint explorer, ABI code example and Lean proof reader.\nThese representations/proof results remain historical, not a complete graph\nor fresh proof of all 3.0.4 law. Optional execution dependencies are installed\nonly into an explicit writable tooling workspace.\n\nThe source and bounded release checks pass. Native workflow evidence remains\nmixed: two strict-return failures, a separately verified R1 recovery, R2's\nconditional record and E1's unsupported authorization/grouping claim; no\nexecution followed that claim and no successor actor trial ran. Other modes,\nfull independent-review operation and broad host portability remain\nunqualified. Publication does not convert those limits into passes.\n\nNative commit: `16bc30d215915a4b7b3ed2f13e52e14510ae1c9d`. Annotated tag: `e7bc3083bfb87ff6756a361cb14740dd9a9fedcd`.\n[Full release notes](https://github.com/foolishimp/specification_methodology/blob/16bc30d215915a4b7b3ed2f13e52e14510ae1c9d/specification_methodology/v3/release/release-note.md).\n"}