  "additional_statements": [
    {
      "section": "Method Identity",
      "constraint_class": "axiom",
      "statement": "STDO means Specification, Ticketing, Design, and Outcome-Driven Development; ODD means Outcome-Driven Development."
    },
    {
      "section": "Governing Claim",
      "constraint_class": "invariant",
      "statement": "Specification is constitutional source; design and realization are subordinate implementation surfaces, and generated views are not independent truth."
    },
    {
      "section": "Governing Claim",
      "constraint_class": "prohibition",
      "statement": "A downstream Product may prove or falsify conformance but cannot supply reusable STDO method meaning."
    },
    {
      "section": "Authority Flow",
      "constraint_class": "obligation",
      "statement": "Use the smallest current authority surface that can decide the question and re-enter at the smallest upstream owner when meaning must change."
    },
    {
      "section": "Proof Compression",
      "constraint_class": "obligation",
      "statement": "Closure requires authority trace, realization proof, negative proof where drift is plausible, and a present-tense statement of residual open pressure."
    }
  ]
