before.get(key), after.get(key))]\n841\t\n842\t\n843\tdef check_preconditions(runtime: Runtime, recheck_set: Object) -> Object:\n844\t    exact_keys(recheck_set, (\"schema\", \"policy_sha256\", \"product_definition\", \"method_profile\", \"sources\", \"observations\", \"executor_dependencies\"))\n845\t    if recheck_set[\"schema\"] != \"a_c.fd-support.recheck/1\":\n846\t        raise SupportError(\"unsupported_contract\", \"Unknown recheck contract\")\n847\t    changes: list[JSON] = []; gaps: list[JSON] = []; observations: list[JSON] = []\n848\t    try:\n849\t        if _sha(_regular_bytes(runtime.policy_path)) != runtime.policy_sha256 or recheck_set[\"policy_sha256\"] != runtime.policy_sha256:\n850\t            changes.append({\"kind\": \"policy_changed\"})\n851\t    except SupportError as exc:\n852\t        gaps.append(exc.document())\n853\t    refs = [recheck_set[\"product_definition\"], recheck_set[\"method_profile\"]] + as_list(recheck_set[\"sources\"]) + as_list(recheck_set[\"executor_dependencies\"])\n854\t    for value in refs:\n855\t        try:\n856\t            read_source(runtime, as_object(value))\n857\t        except SupportError as exc:\n858\t            gaps.append(exc.document())\n859\t    for value in as_list(recheck_set[\"observations\"]):\n860\t        try:\n861\t            old = as_object(load_artifact(runtime, as_object(value), \"observation\")[\"payload\"])\n862\t            fresh = observe(runtime, as_list(old[\"scope\"]))\n863\t            diff = observation_diff(old, fresh)\n864\t            fresh[\"diff\"] = diff\n865\t            observations.append(fresh)\n866\t            changes.extend(diff)\n867\t        except SupportError as exc:\n868\t            gaps.append(exc.document())\n869\t    return document({\"observations\": observations, \"changes\": changes, \"gaps\": gaps})\n870\t\n871\t\n872\tdef _history(runtime: Runtime, kind: str, matches: Object) -> tuple[list[Object], Object]:\n873\t    if runtime.query_artifacts is None:\n874\t        raise SupportError(\"history_incomplete\", \"Protected cross-process history is unavailable\")\n875\t    query = runtime.query_artifacts(kind, matches)\n876\t    exact_keys(query, (\"refs\", \"complete\", \"gaps\", \"scope\", \"observed_at_ns\"))\n877\t    records: list[Object] = []\n878\t    for value in as_list(query[\"refs\"]):\n879\t        record = load_artifact(runtime, as_object(value), kind)\n880\t        if as_object(record[\"provenance\"])[\"product_id\"] != as_object(runtime.policy[\"product\"])[\"definition_id\"]:\n881\t            raise SupportError(\"history_incomplete\", \"History escaped its exact selected Product scope\")\n882\t        for field, expected in matches.items():\n883\t            try:\n884\t                actual = pointer(record, \"/\" + field.replace(\".\", \"/\"))\n885\t            except SupportError as exc:\n886\t                raise SupportError(\"history_incomplete\", \"History returned an unmatching record\") from exc\n887\t            if not _equal(actual, expected):\n888\t                raise SupportError(\"history_incomplete\", \"History returned an unmatching record\")\n889\t        records.append(record)\n890\t    return records, query\n891\t\n892\t\n893\tdef _profile_basis(runtime: Runtime, basis: Object, observations: bool = True) -> None:\n894\t    validate_content(basis, \"Basis\")"}]},"parent_tool_use_id":null,"session_id":"9069a765-b3ee-4a03-8f71-6288ce3b57b6","uuid":"cf45cd4f-c248-438a-9123-a9775c90af57","timestamp":"2026-10-25T02:29:43.576Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jim/src/apps/specification_methodology-skills/a_c/build_tenants/graphify/code/ac_support_core.py","content":"            if exists and not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):\n                raise SupportError(\"path_refused\", \"Observation encountered nonregular/symlink content\")\n            data = _regular_bytes(member_path) if stat.S_ISREG(mode) else b\"\"\n            total += len(data)\n            if len(entries) >= max_files or total > max_bytes:\n                raise SupportError(\"budget_exceeded\", \"Observation population/byte bound exceeded; no complete snapshot returned\")\n            entries[(root_id, rel)] = {\"root\": root_id, \"path\": rel, \"exists\": exists,\n                                       \"type\": \"file\" if stat.S_ISREG(mode) else \"directory\" if exists else \"absent\",\n                                       \"size\": len(data) if stat.S_ISREG(mode) else None,\n                                       \"sha256\": _sha(data) if stat.S_ISREG(mode) else None}\n    return document({\"schema\": \"a_c.fd-support.observation/1\", \"scope\": scope,\n            \"observed_interval\": {\"clock\": \"unix_ns\", \"started_ns\": started, \"ended_ns\": time.time_ns()},\n            \"entries\": [entries[key] for key in sorted(entries)], \"bindings\": _binding(runtime),\n            \"git\": None, \"diff\": [], \"gaps\": []})\n\n\ndef observation_diff(previous: Object, current: Object) -> list[JSON]:\n    before = {(text(as_object(x)[\"root\"]), text(as_object(x)[\"path\"])): x for x in as_list(previous[\"entries\"])}\n    after = {(text(as_object(x)[\"root\"]), text(as_object(x)[\"path\"])): x for x in as_list(current[\"entries\"])}\n    return [{\"root\": key[0], \"path\": key[1], \"previous\": before.get(key), \"current\": after.get(key)}\n            for key in sorted(set(before) | set(after)) if not _equal(before.get(key), after.get(key))]\n\n\ndef check_preconditions(runtime: Runtime, recheck_set: Object) -> Object:\n    exact_keys(recheck_set, (\"schema\", \"policy_sha256\", \"product_definition\", \"method_profile\", \"sources\", \"observations\", \"executor_dependencies\"))\n    if recheck_set[\"schema\"] != \"a_c.fd-support.recheck/1\":\n        raise SupportError(\"unsupported_contract\", \"Unknown recheck contract\")\n    changes: list[JSON] = []; gaps: list[JSON] = []; observations: list[JSON] = []\n    try:\n        if _sha(_regular_bytes(runtime.policy_path)) != runtime.policy_sha256 or recheck_set[\"policy_sha256\"] != runtime.policy_sha256:\n            changes.append({\"kind\": \"policy_changed\"})\n    except SupportError as exc:\n        gaps.append(exc.document())\n    refs = [recheck_set[\"product_definition\"], recheck_set[\"method_profile\"]] + as_list(recheck_set[\"sources\"]) + as_list(recheck_set[\"executor_dependencies\"])\n    for value in refs:\n        try:\n            read_source(runtime, as_object(value))\n        except SupportError as exc:\n            gaps.append(exc.document())\n    for value in as_list(recheck_set[\"observations\"]):\n        try:\n            old = as_object(load_artifact(runtime, as_object(value), \"observation\")[\"payload\"])\n            fresh = observe(runtime, as_list(old[\"scope\"]))\n            diff = observation_diff(old, fresh)\n            fresh[\"diff\"] = diff\n            observations.append(fresh)\n            changes.extend(diff)\n        except SupportError as exc:\n            gaps.append(exc.document())\n    return document({\"observations\": observations, \"changes\": changes, \"gaps\": gaps})\n\n\ndef _history(runtime: Runtime, kind: str, matches: Object) -> tuple[list[Object], Object]:\n    if runtime.query_artifacts is None:\n        raise SupportError(\"history_incomplete\", \"Protected cross-process history is unavailable\")\n    query = runtime.query_artifacts(kind, matches)\n    exact_keys(query, (\"refs\", \"complete\", \"gaps\", \"scope\", \"observed_at_ns\"))\n    records: list[Object] = []\n    for value in as_list(query[\"refs\"]):\n        record = load_artifact(runtime, as_object(value), kind)\n        if as_object(record[\"provenance\"])[\"product_id\"] != as_object(runtime.policy[\"product\"])[\"definition_id\"]:\n            raise SupportError(\"history_incomplete\", \"History escaped its exact selected Product scope\")\n        for field, expected in matches.items():\n            try:\n                actual = pointer(record, \"/\" + field.replace(\".\", \"/\"))\n            except SupportError as exc:\n                raise SupportError(\"history_incomplete\", \"History returned an unmatching record\") from exc\n            if not _equal(actual, expected):\n                raise SupportError(\"history_incomplete\", \"History returned an unmatching record\")\n        records.append(record)\n    return records, query\n\n\ndef _profile_basis(runtime: Runtime, basis: Object, observations: bool = True) -> None:\n    validate_content(basis, \"Basis\")","numLines":75,"startLine":820,"totalLines":3047}},"tool_result_meta":[{"id":"toolu_016jugjE5CJRGm1v2F8YUrDm","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
