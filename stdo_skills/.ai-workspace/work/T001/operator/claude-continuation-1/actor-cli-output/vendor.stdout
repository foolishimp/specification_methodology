{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017GodocPZ1SuaqQczo9R93f","type":"tool_result","content":"2780\t        if operation == \"context.assemble\":\n2781\t            return _assemble(runtime, request, args, started)\n2782\t        if operation == \"return.capture\":\n2783\t            return _capture_return(runtime, request, args, started)\n2784\t        if operation == \"review.prepare\":\n2785\t            return _review(runtime, request, args, started)\n2786\t        artifacts: list[JSON] = []; acquisitions: list[JSON] = []; primary: JSON = None\n2787\t        value: JSON\n2788\t        if operation == \"tools.describe\":\n2789\t            if \"method_profile\" in args and not _equal(args[\"method_profile\"], runtime.method_profile):\n2790\t                raise SupportError(\"unsupported_contract\", \"Requested exact method/profile is unsupported\")\n2791\t            value = inventory(cast(str | None, args.get(\"operation\")), profile=runtime.method_profile)\n2792\t        elif operation == \"workspace.observe\":\n2793\t            payload = observe(runtime, as_list(args[\"scope\"]))\n2794\t            if \"previous\" in args:\n2795\t                old = as_object(load_artifact(runtime, as_object(args[\"previous\"]), \"observation\")[\"payload\"])\n2796\t                if not _equal(old[\"scope\"], args[\"scope\"]):\n2797\t                    raise SupportError(\"basis_ambiguous\", \"Observation scopes differ\")\n2798\t                payload[\"diff\"] = observation_diff(old, payload)\n2799\t            artifact, primary = make_artifact(\"observation\", payload, provenance(runtime, request, started, time.time_ns()))\n2800\t            artifacts.append(artifact); value = payload\n2801\t        elif operation == \"source.read\":\n2802\t            source = as_object(args[\"source\"]); acquired = read_source(runtime, source)\n2803\t            raw = base64.b64decode(cast(str, acquired[\"content_base64\"]))\n2804\t            