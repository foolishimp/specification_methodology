{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport json, subprocess, pathlib, hashlib, sys, time\nargv=json.loads(\\\"[\\\\\\\"/opt/homebrew/Cellar/python@3.13/3.13.7/Frameworks/Python.framework/Versions/3.13/bin/python3.13\\\\\\\",\\\\\\\"-B\\\\\\\",\\\\\\\"/Users/jim/src/apps/specification_methodology-skills/a_c/build_tenants/graphify/code/ac_support.py\\\\\\\",\\\\\\\"--policy\\\\\\\",\\\\\\\"/Users/jim/src/apps/specification_methodology-skills/stdo_skills/.ai-workspace/work/T001/operator/successor-1/codex/worker-policy.json\\\\\\\",\\\\\\\"--policy-sha256\\\\\\\",\\\\\\\"038f1b1fdd56d0860dbfc94a0a17ff28e98e41153f6774cf4dc5ff7658d425b9\\\\\\\",\\\\\\\"--principal\\\\\\\",\\\\\\\"codex\\\\\\\",\\\\\\\"call\\\\\\\",\\\\\\\"--request\\\\\\\",\\\\\\\"-\\\\\\\"]\\\")\ntask=json.loads(\\\"{\\\\\\\"engine\\\\\\\":\\\\\\\"workspace-regular-file\\\\\\\",\\\\\\\"root\\\\\\\":\\\\\\\"successor\\\\\\\",\\\\\\\"path\\\\\\\":\\\\\\\"codex/TASK.md\\\\\\\",\\\\\\\"object\\\\\\\":null,\\\\\\\"sha256\\\\\\\":\\\\\\\"4c33deea408deef15ac9900f66d5986b06efefb94de40697cf249d536770845b\\\\\\\",\\\\\\\"selector\\\\\\\":null}\\\")\nroot=pathlib.Path(\\\"/Users/jim/src/apps/specification_methodology-skills/stdo_skills\\\")\ndef call(op,args,rid):\n r=subprocess.run(argv,input=json.dumps({\\\"schema\\\":\\\"a_c.fd-support.request/1\\\",\\\"id\\\":rid,\\\"operation\\\":op,\\\"arguments\\\":args}),text=True,capture_output=True)\n if r.returncode or r.stderr:\n  print(json.dumps({\\\"transport_exit\\\":r.returncode,\\\"stderr\\\":r.stderr}),flush=True)\n result=json.loads(r.stdout)\n if result[\\\"status\\\"]\"'!=\"ok\":\n  print(json.dumps(result),flush=True); raise SystemExit(\"Required public operation failed; no retry\")\n return result\n\nr=call(\"workspace.observe\",{\"scope\":[{\"root\":\"product\",\"path\":\"build_tenants/codex/design\",\"kind\":\"directory\"}]},\"codex-s1-design-before\")\nprint(json.dumps(r))\nr=call(\"source.read\",{\"source\":{\"engine\":\"workspace-regular-file\",\"root\":\"method\",\"path\":\"standards/frames/bootstrap.md\",\"object\":None,\"sha256\":\"cbf4a10e8d0b4ca2ab4a1f3ee28a85ffedc3298a0fba666949d9b091e82cc714\",\"selector\":None},\"encoding\":\"utf8\"},\"codex-s1-bootstrap\")\nprint(json.dumps(r))\n\nPY'","aggregated_output":"{\"evidence\": {\"id\": \"sha256:f76219e2b01a5cc469445deeb55d79eaf88e6df4f2908fdede3d70186f8cc635\", \"sha256\": \"f76219e2b01a5cc469445deeb55d79eaf88e6df4f2908fdede3d70186f8cc635\"}, \"id\": \"codex-s1-design-before\", \"operation\": \"workspace.observe\", \"operation_outcome\": {\"cause\": \"declared output available\", \"core_value\": \"satisfied\", \"evidence\": [], \"limits\": [\"output availability only; no semantic acceptance\"], \"predicate\": \"B(workspace.observe)[request_sha256=bf56aed661a25288a9a08b7ee99b066b83cd961defdc63b5f92d6fd2d8b3cf5f]: declared output availability\", \"source_parent\": {\"clause\": \"results\", \"member\": \"FOUNDATIONS.md\", \"sha256\": \"92fe2f3c09a59b4e9a732463a41d4a45d7efd693648159621e03c75f7127eac5\"}, \"value\": \"returned\"}, \"refusal\": null, \"result\": {\"artifact\": {\"id\": \"sha256:4eaa6f765870f0262daba1fb1b1615c5e4f627a1ffdde4c430b2b2bc2944f36b\", \"sha256\": \"4eaa6f765870f0262daba1fb1b1615c5e4f627a1ffdde4c430b2b2bc2944f36b\"}, \"value\": {\"bindings\": {\"method_profile\": {\"engine\": \"workspace-regular-file\", \"object\": null, \"path\": \"build_tenants/graphify/design/fd-method-stdo-3.0.1.json\", \"root\": \"tool\", \"selector\": null, \"sha256\": \"a886047e50b8a45c3b47addea0f0809dca2a6c54ac35948df5e01893cc30bbf7\"}, \"policy_sha256\": \"038f1b1fdd56d0860dbfc94a0a17ff28e98e41153f6774cf4dc5ff7658d425b9\", \"product_definition\": {\"engine\": \"workspace-regular-file\", \"object\": null, \"path\": \"stdo_skills.json\", \"root\": \"product\", \"selector\": null, \"sha256\": \"4339a7dbc735052c08962154966fc13a4e30206d42ba2e80b53c6009a5008c22\"}}, \"diff\": [], \"entries\": [{\"exists\": true, \"path\": \"build_tenants/codex/design\", \"root\": \"product\", \"sha256\": null, \"size\": null, \"type\": \"directory\"}], \"gaps\": [], \"git\": null, \"observed_interval\": {\"clock\": \"unix_ns\", \"ended_ns\": 1792893933838442000, \"started_ns\": 1792893933838055000}, \"schema\": \"a_c.fd-support.observation/1\", \"scope\": [{\"kind\": \"directory\", \"path\": \"build_tenants/codex/design\", \"root\": \"product\"}]}}, \"schema\": \"a_c.fd-support.response/1\", \"status\": \"ok\"}\n{\"evidence\": {\"id\": \"sha256:16d193db8dc0adccbb11335c94525a6fc9ea42ed91f1dae4e7f61acd6bd247b6\", \"sha256\": \"16d193db8dc0adccbb11335c94525a6fc9ea42ed91f1dae4e7f61acd6bd247b6\"}, \"id\": \"codex-s1-bootstrap\", \"operation\": \"source.read\", \"operation_outcome\": {\"cause\": \"declared output available\", \"core_value\": \"satisfied\", \"evidence\": [], \"limits\": [\"output availability only; no semantic acceptance\"], \"predicate\": \"B(source.read)[request_sha256=0339c588b3837b0935c78dc5fd1602bd98d5df690963e651a46e122abcd4303d]: declared output availability\", \"source_parent\": {\"clause\": \"results\", \"member\": \"FOUNDATIONS.md\", \"sha256\": \"92fe2f3c09a59b4e9a732463a41d4a45d7efd693648159621e03c75f7127eac5\"}, \"value\": \"returned\"}, \"refusal\": null, \"result\": {\"artifact\": null, \"value\": {\"acquisition\": {}, \"content\": \"# Reference frame bootstrap\\n\\nTask: Enter this method for a task not yet specified: say what the method is, bind the exact basis and the one applicable product definition, say how a reference frame is activated for a step and what the step may and may not do before its contract is admitted, give the core result values, and acquire the deciding owner sections for the task.\\n\\nPurpose: The owning sections for the method's canonical statement; the product lineage objects; the product definition's required relations, recursive discovery and the one constitutional surface with its staleness binding; the authority kinds, the frame tuple and the activation packet; the step's intake and admission; context construction with the size measurement, acquisition, activation and evaluation; and the core result algebra.\\n\\nBinds:\\n\\n- This task binds the construction relation: A is the exact subject and basis the activation binds, Z is the task's required outcome with the acceptance conditions the task states, and the actor's claims keep preservation, progress and outcome satisfaction distinct; a judgment its evidence cannot decide is `indeterminate`, and work it cannot finish is reported as unresolved work, not as a judgment ([../ACTIVATION.md#construction-relation](../ACTIVATION.md#construction-relation); member sha256=56109ffa2e8ec6f158e6dbd0b387fededa685abc100a288ea88525854a78441d; section sha256=6b6c2ce91c5a7e4be765af2f8009252fa8918719e1d885af6b5810ba4eb699da)\\n\\nA `Binds:` item names an obligation the activation of this frame binds, with\\na link to the owning section, the digest of its member and the digest of that\\nsection, or of the span of sections it names, where it names one; the item\\ncopies no section and owns no determination, and where no route of this frame\\ncarries the section the item is a paraphrase of it.\\n\\nEach excerpt below copies one owning section of a member of this method\\nbyte for byte, except a `rows=k/n` excerpt (see below) and except that\\neach relative link destination is rebased\\nto resolve from this directory to the same target. Fenced code, inline\\ncode and absolute and `stdo://` links are unchanged. The `Source:` line\\nbefore an excerpt names the member and the section's anchor, and gives\\nthe SHA-256 of the whole owning member. The section digest recorded in\\nFRAME_INPUTS.json is over the owner's bytes, not over this copy. The\\nowning section decides; this frame owns no determination. An excerpt\\nwhose `Source:` line says `rows=k/n` is a family table of which only\\nthe k rows that cite a section this frame carries are copied, with the\\ntable's preamble, header and every non-family table; the other rows\\nstay in the owning member and are not copied. The frame's\\nqualification, not this selection, decides whether the frame is\\nsufficient for its task.\\n\\nRoutes, in order:\\n\\n1. [SPEC_METHOD.md#canonical-statement](../SPEC_METHOD.md#canonical-statement)\\n2. [FOUNDATIONS.md#product-lineage-objects](../FOUNDATIONS.md#product-lineage-objects)\\n3. [PRODUCT_DEFINITION.md#2-required-definition-relations](../PRODUCT_DEFINITION.md#2-required-definition-relations)\\n4. [PRODUCT_DEFINITION.md#9-recursive-discovery-and-explicit-composition](../PRODUCT_DEFINITION.md#9-recursive-discovery-and-explicit-composition)\\n5. [PRODUCT_DEFINITION.md#11-one-constitutional-surface-and-version-boundary](../PRODUCT_DEFINITION.md#11-one-constitutional-surface-and-version-boundary)\\n6. [FOUNDATIONS.md#authority-kinds](../FOUNDATIONS.md#authority-kinds)\\n7. [FOUNDATIONS.md#the-frame-tuple](../FOUNDATIONS.md#the-frame-tuple)\\n8. [REFERENCE_FRAME.md#11-the-activation-packet](../REFERENCE_FRAME.md#11-the-activation-packet)\\n9. [ACTIVATION.md#intake](../ACTIVATION.md#intake)\\n10. [ACTIVATION.md#admission](../ACTIVATION.md#admission)\\n11. [ACTIVATION.md#2-context-construction-under-an-envelope](../ACTIVATION.md#2-context-construction-under-an-envelope)\\n12. [FOUNDATIONS.md#results](../FOUNDATIONS.md#results)\\n13. [PRODUCT_DEFINITION.md#foundation-to-law-binding-a-project-to-the-method](../PRODUCT_DEFINITION.md#foundation-to-law-binding-a-project-to-the-method)\\n14. [REFERENCE_FRAME.md#foundation-to-law](../REFERENCE_FRAME.md#foundation-to-law)\\n15. [SPEC_METHOD.md#foundation-to-law-chain-outcome-and-build-tenant-binding](../SPEC_METHOD.md#foundation-to-law-chain-outcome-and-build-tenant-binding)\\n\\nSize of this frame: 84475 bytes.\\n\\nSource: SPEC_METHOD.md#canonical-statement sha256=b2773dc0c9feb429b6b357bcfd60e7df46e54db8adcb04dc8d6dbfa023b73677\\n\\n### Canonical statement\\n\\nThe method in one statement, each clause owned by a section of this corpus\\n. Specification is constitutional source, not\\ncommentary on code. The method defines the process constitution; intent,\\nproduct definition and requirements define the project constitution (\\u00a71).\\nSpecification defines WHAT; design and realisation define HOW (\\u00a72). Every\\nproduct under this method publishes a layout-neutral definition that locates\\nits governing constitution, local constitutional decisions, collective\\nreference-frame bases, WHAT, independent build-tenant HOW realisations, work\\nsurfaces and explicit product composition; the definition is a routing\\noverlay, not a rival truth surface\\n([PRODUCT_DEFINITION \\u00a71](../PRODUCT_DEFINITION.md#1-overlay-and-layout-independence)). A material term\\nresolves only under its bounded-context identity, owning authority, selected\\nbasis and governed scope; equal spelling creates no cross-context meaning or\\nauthority; explicit imports, translations, equivalences and disambiguations\\ngovern those seams, and zero or multiple applicable meanings fail closed\\n([PRODUCT_DEFINITION \\u00a75](../PRODUCT_DEFINITION.md#5-bounded-context-semantic-resolution)). Requirements define the full constitutional what:\\ncapabilities, guarantees, governance and verification obligations; design\\ndefines the structural how, and ADRs are one durable form of that record\\n(\\u00a72, \\u00a710). The lifecycle is a governed disambiguation pipeline: each major\\nboundary reduces the space of lawful interpretations and surfaces major\\nambiguity explicitly; detection is mandatory; blocking or escalation is\\npolicy under declared risk appetite, except for hard-stop prerequisite\\nfailures (\\u00a75; ACTIVATION \\u00a74). Products, applications, modules, functions,\\nbuild tenants and runtime surfaces are implementations of the constitutional\\ndocuments, not substitutes for them. Scenarios verify operational meaning\\nwhere capability claims need end-to-end proof ([ASSURANCE \\u00a74](../ASSURANCE.md#4-scenario-bundle)). Code realises\\ndecisions. Design is derivable from requirements, which are derivable from\\ngoals, intent and product definition; code is derivable from requirements\\nand design (\\u00a72). Iteration is cumulative repricing, not waterfall. Events,\\nprojection and delta reveal drift. Every live requirement family has design\\nownership, explicit classification and downstream closure or explicit\\ndeferment; every design record grounds itself in requirements; shipping\\nbehaviour traces back to constitutional authority (\\u00a72). Live constitutional\\nsurfaces are versioned history that change by supersession or withdrawal,\\nnever by silent in-place mutation (\\u00a72). New intent emerges from real use\\ncases hitting the current model through explicit gap analysis, not from ad\\nhoc pressure (\\u00a72). Sprints are execution-control batches for pricing proof\\ncost and forcing close review; they are not authority layers and cannot hide\\ndrift (\\u00a74).\\n\\n\\nSource: FOUNDATIONS.md#product-lineage-objects sha256=92fe2f3c09a59b4e9a732463a41d4a45d7efd693648159621e03c75f7127eac5\\n\\n### Product lineage objects\\n\\nSoftware is recursive and compositional: a released product may build the\\nnext released version of itself, a dependent product, or downstream project\\nartifacts. Most taxonomy drift in recursive systems comes from collapsing\\nthe roles below into one overloaded word such as \\\"product\\\". Each role is an\\nobject with its own identity (P3). This member owns the bounded context\\n`urn:stdo:bounded-context:recursive-product-taxonomy` and the concept\\nidentities below under the selected complete basis.\\n\\n| Term | Definition | Requires |\\n|---|---|---|\\n| Substrate (`urn:stdo:concept:recursive-product-taxonomy:substrate`) | a lower product or runtime used to build other products | P3 |\\n| Development product (`urn:stdo:concept:recursive-product-taxonomy:development-product`) | the role of one exact install of a released product while that install acts as builder substrate for a source project; the role creates no new product identity and transfers no meaning or authority from the builder to the product being authored | P3, P6 |\\n| Source project (`urn:stdo:concept:recursive-product-taxonomy:source-project`) | the mutable workspace building the next release cut | P3 |\\n| Release cut (`urn:stdo:concept:recursive-product-taxonomy:release-cut`) | one immutable annotated release-candidate boundary over a published feature set | P3 |\\n| Product (`urn:stdo:concept:recursive-product-taxonomy:product`) | the released immutable thing resulting when that release cut is accepted | P3 |\\n| Install (`urn:stdo:concept:recursive-product-taxonomy:install`) | a stamped workspace instance of that released product | P3 |\\n| Artifact (`urn:stdo:concept:recursive-product-taxonomy:artifact`) | any published output built by a source project or by a configured installed product | P3 |\\n| Product definition (`urn:stdo:concept:recursive-product-taxonomy:product-definition`) | the present-tense source-project authority surface, conventionally carried by `PRODUCT.md`; it defines the current product WHAT for decomposition and is not the released product artifact | P3, P2 |\\n\\nThe governing rules: a mutable source workspace is not called a product;\\nwhen a released product acts as builder substrate, the exact install is\\nbound as a development product without confusing it with the product being\\nauthored; an immutable release cut or installed product is not confused\\nwith the mutable source project building the next cut; the product\\ndefinition is the surface of a source project, not the released product\\nartifact; products may depend on other products; installed products may\\nbuild the next version of themselves or other products. The compiler\\nanalogy is the intended model: bootstrap source, release P0, install P0,\\nuse P0 to build the source for P1, release P1. The taxonomy is load-bearing:\\nblurred, dependency and self-hosting errors compound quickly and are\\nexpensive to unwind. SPEC_METHOD \\u00a76 applies these objects to lineage and\\nrelease.\\n\\nRelease objects. A release cut has three neighbours that release keeps\\ndistinct from it and from each other (P3, P6).\\nA candidate source is the mutable source-project state constructing a\\npossible successor; it is non-operative for released consumers. A release\\nsubject is the exact declared product member set or artifact that one\\nrelease cut binds, described by that cut's release-scoped claims; a\\ncarrier that holds it does not thereby make co-located material a\\nmember. A version-line selector is a mutable\\nalias naming the highest-ordinal published release cut on one version\\nline of one project; it is convenient discovery, not immutable identity,\\nand not sufficient as an exact basis ([RELEASE \\u00a71](../RELEASE.md#1-context-and-position)\\nstates which).\\nEqual version text does not collapse these objects. A selector or a\\nmutable carrier may move; a release cut never moves. RELEASE \\u00a72 realises\\nthem, with the carriers that hold them, as refs of one release source.\\n\\n\\nSource: PRODUCT_DEFINITION.md#2-required-definition-relations sha256=95afb85e4cf8f248a6f430be34ef288add61445dc43d9c8121239409b9fac231\\n\\n## 2. Required definition relations\\n\\nEach definition contains (P3, P6):\\n\\n- `product`: the stable product-definition identity, display name,\\n  source-project locator and an explicit bounded-context declaration or\\n  `null`;\\n- `constitution.stdo`: the STDO source repository, the mutable\\n  version-line discovery selector, and the exact installed release basis\\n  with its deterministic manifest digest;\\n- `constitution.additional_authorities`: every non-STDO constitutional\\n  set;\\n- `constitution.entrypoints`: basis-qualified useful reading routes;\\n- `constitution.agent_bootstrap`: the constitutional entrypoint and the\\n  marker-managed agent-instruction targets;\\n- `local_constitution`: local axioms, overrides and disambiguations with\\n  their owning authority, target, basis and scope, including\\n  context-qualified term resolution where applicable;\\n- `reference_frame_bases`: one or more accepted collective\\n  reference-frame basis declarations with their admitting authorities and\\n  governed scopes;\\n- `what`: the current Intent, Product and specification bindings;\\n- `how`: any shared realisation surfaces and one or more independent\\n  build tenants;\\n- `ticketing`: the Goals, ticket, comment and optional sprint carrier\\n  bindings;\\n- `composition`: explicit relations to other product definitions; and\\n- `$schema` and `kind`: the schema locator and the\\n  `stdo.product-definition` discriminator.\\n\\nThe overlay owns this locator and relation map; the referenced documents\\nown their content. Repeating source truth inside the JSON creates a rival\\nauthority and is non-conformant (P6).\\n\\n`product.bounded_context` identifies the enclosing bounded context of the\\ndefinition's own product WHAT, or is `null` when no separate enclosing\\ncontext is claimed. It is not an exhaustive registry and does not flatten\\nsubordinate, peer, composed, tenant, user or runtime contexts into one\\nnamespace. Those contexts stay defined by their owning authorities, and\\nevery local disambiguation names the exact context in which its resolution\\napplies (P1, P3).\\n\\n\\nSource: PRODUCT_DEFINITION.md#9-recursive-discovery-and-explicit-composition sha256=95afb85e4cf8f248a6f430be34ef288add61445dc43d9c8121239409b9fac231\\n\\n## 9. Recursive discovery and explicit composition\\n\\nTools discover `stdo_*.json` recursively within the selected workspace\\nboundary: definitions at the workspace root and definitions at arbitrarily\\ndeep nested project roots (P3).\\n\\nFor a requested Product scope exactly one applicable definition is\\nselected; zero or several unresolved definitions fail closed, and a\\nsymlinked definition is refused (P6, P5).\\n\\nDirectory nesting creates no implicit inheritance, ownership, composition\\nor constitutional override. Parent and child definitions stay independent\\nuntil `composition` explicitly relates them. Each composition entry records\\n(P6, P3):\\n\\n- `product_definition`: the current locator for the target definition;\\n- `target_definition_id`: the stable identity expected from the target's\\n  `product.definition_id`;\\n- `relation`: the authority defining the directed composition kind, the\\n  source and target roles, owner, scope, lifecycle and invalidation\\n  conditions; and\\n- `contracts`: one or more exact interface, capability, identity,\\n  lifecycle, data, evidence or other governing contract references\\n  consumed by that relation.\\n\\nResolution verifies both the locator and the expected identity. Moving a\\ndefinition requires a locator update and does not change its identity.\\nReplacing the content at the same locator with another definition identity\\nfails closed. When an edge binds exact immutable Product or release\\nversions, the cited relation and contracts also carry and verify those\\nidentities; the mutable definition identity cannot substitute for them\\n(P3, P5).\\n\\nA conforming discovered set satisfies all of the following (P3, P6, P1):\\n\\n- every definition validates against its selected released schema;\\n- every required URI and fragment resolves under the declared workspace\\n  and resolver boundary;\\n- every `product.definition_id` is unique;\\n- every build-tenant identity is unique within its overlay;\\n- every governed scope has a resolvable applicable reference-frame basis,\\n  and overlapping basis bindings are reconciled by their cited authority;\\n- every local disambiguation binds one exact term, target context,\\n  complete material candidate set, selected concept, authority, basis and\\n  scope; `resolves_to` is a member of `disambiguates`; and its referenced\\n  resolution carrier is congruent with those bindings;\\n- every material cross-context term seam resolves through an explicit\\n  import, disambiguation, translation or equivalence relation rather than\\n  nominal match;\\n- every composition target resolves to another product definition whose\\n  `product.definition_id` equals `target_definition_id`, and every\\n  relation and non-empty contract set resolves; and\\n- no two carriers claim authority for the same Product, tenant, ticket\\n  state or constitutional relation.\\n\\nPortable Draft 2020-12 JSON Schema validation establishes structural shape.\\nThe schema's `uri` and `uri-reference` formats are annotations unless the\\ndeclared validator implements format assertion. Conformance therefore\\nperforms an explicit RFC 3986 URI and URI-reference syntax check with an\\nassertion-capable validator, followed separately by resolution, fragment\\nexistence, selected-release identity, uniqueness across files,\\nconstitutional sufficiency, semantic-resolution and cross-context-relation\\ncompleteness, and authority-congruence checks. The structural subset and\\nthe semantic subset of these checks are distinct claims (EVALUATION \\u00a72;\\nP1, P6).\\n\\n\\nSource: PRODUCT_DEFINITION.md#11-one-constitutional-surface-and-version-boundary sha256=95afb85e4cf8f248a6f430be34ef288add61445dc43d9c8121239409b9fac231\\n\\n## 11. One constitutional surface and version boundary\\n\\nSTDO-SURFACE-001. The shared methodology is modular in authorship and\\nsingular in authority. Each law has one owning member; other members\\nconsume it by reference. The members become operative only as one complete\\nreleased version of the method (P6, P3).\\n\\nA released cut identifies its exact member set, member digests, review\\nbasis, human acceptance and immutable identity. Compressions, templates,\\ncomments, candidate work, installed copies and mutable source are derived,\\nevidential or authoring surfaces. They cannot become a selectable partial\\nconstitution and cannot reinterpret the owning members (P3, P6).\\n\\nWithin their declared scope, derived instructions preserve the owning\\nclauses' applicability, obligations, permissions, exclusions, decision\\nowners and invalidators. A projected prohibition cannot lose its condition\\nor its lawful alternative, even when every source digest is correct. A\\nsummary, bootstrap or index cannot require a stricter or weaker relation by\\ncompression. Its references are resolvable within the declared actor's\\naccess; otherwise the required meaning is supplied directly (P4b, P1;\\nFOUNDATIONS \\u00a74, reference versus body).\\n\\nStaleness binding. What a derived surface is, when it is stale, and\\nwhat an actor uses in its place are\\n[ACTIVATION \\u00a72 Staleness of derived surfaces](../ACTIVATION.md#staleness-of-derived-surfaces);\\nwhich questions a derived surface decides on its own is ACTIVATION \\u00a72,\\nStandalone scope. This member refines that law for the derived surfaces\\na released cut or an installation carries, among them compressions,\\ntemplates, bootstraps, indexes and projected frames. Each carries the\\npath and digest of each deciding source it was derived from, and of each\\nindex it watches (GLOSSARY \\u00a72). A change to any of those digests is the\\nsource change that makes it stale under that law, and it must be\\nregenerated or explicitly re-accepted before an installation treats it\\nas current. What a matching digest establishes is stated above\\n(EVALUATION \\u00a77). The raw owning members of the same\\nselected cut remain the deciding authority: a question that a stale or\\ninsufficient carrier cannot decide is decided from them, as ACTIVATION\\n\\u00a72 states (P3, P5, P6).\\n\\nThe method owns normative construction algebra, authority relations,\\nabstract state and transition laws, admissibility conditions, necessary\\ncausal order and evidence invariants. Consumers own concrete Product\\nrealisation: instantiated types and schemas, files, tools, runtime and\\norchestration machinery, tests and executable conformance implementation.\\nA concrete form is method law only when the method explicitly accepts it\\nas an interoperability boundary, as \\u00a71 does for the definition schema and\\ntemplate (P2, P6).\\n\\nA shared-method amendment cannot create an executable tool, workflow\\nengine, runtime, assurance system or consumer realisation as STDO Product\\nscope without separate explicit human authorisation. An agent recording a\\nruling cannot widen its subject, implication, authority or change class\\n(P6).\\n\\nOnly a released method version is publication authority. Mutable method\\nsource may author a future cut; it must not silently govern a consumer\\n(P6, P3).\\n\\n\\nSource: FOUNDATIONS.md#authority-kinds sha256=92fe2f3c09a59b4e9a732463a41d4a45d7efd693648159621e03c75f7127eac5\\n\\n### Authority kinds\\n\\nAuthority takes these kinds (P6): frame-set authority, the human authority\\nthat declares or accepts a project frame set; semantic authority, the\\nowner of meaning for a material relation; evaluation authority, the role\\npermitted to perform an evaluation; operation authority, the owner-issued\\ngrant to construct, transform, admit, publish or mutate a material subject\\nwhere an evaluation performs such an operation; decision authority, the\\nrole permitted to accept, reject or otherwise dispose a result; and actor\\nidentity, the human, agent, tool or process performing the work, which is\\nan identity and not an authority. These may coincide in a lawful case and\\nnever collapse by default. A read-only evaluation declares no operation\\nauthority; an effectful evaluation inherits the exact operation grant from\\nits existing owner, and the frame does not create that grant (P6, P3).\\n\\nWhat creates no authority. Authority of any kind exists only by an\\nadmitted grant or an explicit authority decision of its owner, with an\\nidentifiable basis. None of the following mints, widens, transfers or\\nreconstructs semantic, evaluation, operation or decision authority (P6,\\nP3):\\n\\n- actor identity, an actor's capability, its tools or its access;\\n- a name, label, display label, status label, role name, capability\\n  string, locator, file name or path;\\n- declaring, naming, selecting, activating or executing a frame, or\\n  occupying a role;\\n- implementation reachability, a reachable code path or an available\\n  operation;\\n- the shape of evidence or of a payload, or the availability of evidence\\n  inside a frame;\\n- a passing check, a successful step, a completed review or a count of\\n  any of them;\\n- copying, interpreting, encoding, evaluating, transporting, projecting,\\n  compressing, importing or acquiring material;\\n- drafting, admitting or retaining a work contract, beyond what its owner\\n  has admitted;\\n- composition, delegation, adapters, wrappers and registries, which may\\n  restrict admitted authority or carry it faithfully, and never widen its\\n  scope, add a role, increase its cardinality or change its kind.\\n\\nElevation, transfer, split, merge, proxy grant, revocation and retirement\\neach need an explicit authority decision with an identifiable basis. A\\nmember that names an instance of this list for its own domain cites this\\nparagraph and adds only the instance.\\n\\nProxy limit. Human authority may act directly, or through an explicitly\\nadmitted bounded proxy where the governing identity and authority law\\npermits it; proxy identity and human-authority identity stay distinct\\n(P6, P3). A proxy acts only inside its existing grant. It cannot change\\nthe governing outcome's meaning, the requirements, the governing authority\\nor the accepted design; such a change re-enters at its owning relation.\\nProxy authority does not make a constructor's self-review independent,\\nconfers no unrelated runtime or domain authority, and does not replace\\ndirect human acceptance where the governing product or release law\\nrequires it. The contents of a proxy grant are\\n[IDENTITY \\u00a76](../IDENTITY.md#6-authority-identity-and-conservation-stdo-up-004)'s,\\nand the decisions a proxy may take inside a step are\\n[ACTIVATION \\u00a71 Roles and delegation](../ACTIVATION.md#roles-and-delegation)'s.\\n\\nPurpose and material relation of the list and the proxy limit: each\\nmember that names what cannot create authority decides the same question,\\nso one list keeps the answer the same in every member, and a capability,\\na label or a passing check can never be read as a permission (P6).\\n\\n\\nSource: FOUNDATIONS.md#the-frame-tuple sha256=92fe2f3c09a59b4e9a732463a41d4a45d7efd693648159621e03c75f7127eac5\\n\\n### The frame tuple\\n\\nA reference frame F is the tuple \\u27e8Q, B, M, C, I, A, E, X, R, J, K, D\\u27e9\\n(P0): Q the evaluation family; B the workspace and topology basis; M the\\nmaterial-relation manifold; C the coordinate and equality law; I the\\napplicable invariant set; A the authority relation; E the admissible\\nevidence and provenance law; X the exclusion and prohibited-assumption set;\\nR the closed result algebra (\\u00a74 [Results](../FOUNDATIONS.md#results), or a refinement mapped\\ninto it); J the invalidation and rechart\\ncondition; K the actor capability envelope; and D the optional set of\\ndeclared dependencies, overlaps, inputs and outputs involving other frames.\\nThe tuple specifies the relation; it is not a required schema or runtime\\ncarrier (P2). Operationally a frame is an evaluation contract that defines\\nthe finite attention scope one evaluation family requires. A prompt, a\\ncontext packet, a symbolic program or any other representation is a\\nprojection of an activated frame, not the frame (P1). A frame is bound\\nwhen every material coordinate above resolves to an exact source, subject,\\nbasis, authority, evidence route, actor envelope, result relation and\\ninvalidation condition; the binding may be expressed entirely in\\nsource-linked prose, and representation cannot create, widen or replace it\\n(P3, P6).\\n\\n\\nSource: REFERENCE_FRAME.md#11-the-activation-packet sha256=8152838639950b09389f99181172792100e4470b4807b4e112870cd4e6f6ba21\\n\\n## 11. The activation packet\\n\\nAn actor receives one activated frame or one declared active frame\\nconfiguration, never an implied demand to reconstruct the complete\\nworkspace from ambient context (P0). The minimum\\nactivation packet contains:\\n\\n- frame identity and revision;\\n- the evaluation and its result algebra;\\n- the exact subject and basis;\\n- the material relations and applicable invariants;\\n- semantic, evaluation, operation where material, and decision authority;\\n- admissible evidence and tools;\\n- the capability and context envelope;\\n- exclusions and prohibited assumptions;\\n- declared frame dependencies or conjunction outputs; and\\n- invalidation, stop and reconfiguration conditions.\\n\\nThe actor may own its internal reasoning and search where the governing\\nmethod permits. It returns through the declared result relation. Hidden\\ninternal reasoning is no substitute for required evidence, provenance or\\nauthority (P6). Frame size is optimised for reliable evaluation, not for\\nmaximum context loading: a more capable actor may activate a broader frame\\nand a less capable one may use a lawful refinement sequence, and both\\npreserve the same material invariants and authority relations (P0, P2;\\nRF-014).\\n\\n### Minimal activation binding\\n\\nThe following carrier-neutral content is sufficient to bind one declared\\nframe for one evaluation. It may be written in Markdown, structured data, a\\nprompt or another consumer-selected carrier without changing the relation\\n(P0, RF-016).\\n\\n```markdown\\n# Reference-Frame Activation: <stable activation identity>\\n\\n## Frame\\n- declaration identity and revision:\\n- exact evaluation and closed result algebra:\\n\\n## Subject And Basis\\n- exact subject or candidate identity:\\n- workspace, authority, dependency, configuration, and time basis:\\n\\n## Attention Surface\\n- material relations and applicable invariants:\\n- exact source and semantic references:\\n- explicit exclusions and prohibited assumptions:\\n\\n## Actor And Authority\\n- actor and capability envelope:\\n- semantic and evaluation authority:\\n- operation authority, subject, and territory where material:\\n- decision, acceptance, and publication authority:\\n\\n## Evidence And Relations\\n- admissible evidence and acquisition route:\\n- dependency, overlap, input, conjunction, or translation relations used:\\n- expected result consumer and return relation:\\n\\n## Stop And Change\\n- invalidation conditions:\\n- stop, residual, re-entry, and reconfiguration conditions:\\n```\\n\\nEvery field resolves through stable identities and source references.\\nPaths, line numbers, member counts, summaries and matching labels may aid\\nnavigation or diagnostics; they do not substitute for the declared identity\\nand basis (P3).\\n\\n\\nSource: ACTIVATION.md#intake sha256=56109ffa2e8ec6f158e6dbd0b387fededa685abc100a288ea88525854a78441d\\n\\n### Intake\\n\\nA step is activated from an intake sufficient to reconstruct its governing\\nrelations without conversation history, commentary or a prior actor's memory\\n(P0, actor-change premise). The intake names:\\n\\n- the governed outcome or decision: the selected outcome, admitted\\n  prerequisite or experiment it serves (P2);\\n- the exact workspace subject and basis, and the inputs it may acquire,\\n  each by identity and hash or by an input commit;\\n- the evaluation or evaluation family the step performs and its result\\n  algebra: the core of [FOUNDATIONS \\u00a74 Results](../FOUNDATIONS.md#results) or\\n  a refinement mapped into it (\\u00a73);\\n- the bounded affected relation set and the applicable governing\\n  invariants;\\n- the accepted transformation-admission relations the step relies on (\\u00a74);\\n- the selected computational or common-library dispositions: which\\n  shared machinery serves the step and under what binding (FOUNDATIONS \\u00a74,\\n  shared machinery);\\n- the construction and assessment authority: the applicable frame-set,\\n  semantic, evaluation, operation where material, and decision authority\\n  (FOUNDATIONS \\u00a72, authority kinds), and the grant: the operations\\n  permitted, the territory that may change, and the decisions reserved to\\n  others (P6);\\n- the available actor capability envelopes;\\n- the conditions that make the result stale or out of scope, and the\\n  conditions that require re-entry at an owning relation;\\n- where the governed question is a cost claim, the allowance and how\\n  spend will be measured (\\u00a76).\\n\\nImplementation folklore is not an intake source. Where a design profile\\napplies, its bounded-frame conservation, transformation-admission\\ncompleteness, invariant-reconstruction sufficiency and\\ncomputational-realisation projection laws supply the affected set, the\\nadmission relations, the invariants and the computational dispositions;\\nthis section consumes those laws and creates no second design package\\n([DESIGN_MODULE](../DESIGN_MODULE.md)).\\n\\n\\nSource: ACTIVATION.md#admission sha256=56109ffa2e8ec6f158e6dbd0b387fededa685abc100a288ea88525854a78441d\\n\\n### Admission\\n\\nDrafting a step's contract and admitting it are distinct relations, even\\ninside one invocation that drafts, validates, admits and executes; no\\nseparate turn, carrier or approval ceremony is implied by the distinction.\\nA contract carries at minimum the states drafted, admitted, rejected and\\nsuperseded ([TICKETS \\u00a75](../TICKETS.md#execution-contract-admission)).\\nExecution begins only after deterministic admission or an\\nexplicit human override of the exact contract. The drafting actor never\\ninfers admission from its own draft, from the presence of a carrier\\n(ticket, sprint entry, work contract), from lane placement or from an\\n`active` label. The admitted result identifies the admission mechanism and\\nits authority, the exact contract identity or digest, the decision and the\\nevidence, including any human override; absent those coordinates the\\ncontract stays drafted or rejected, and prose asserting admission is not\\nadmission evidence (P6; the actor cannot self-certify its own execution\\nbasis). Admission validates the contract against its cited outcome,\\nprerequisite or experiment basis; it does not admit that basis, and\\ndrafting, admitting or retaining a contract creates or renews no authority\\nits owner has not admitted (P6, P2;\\n[FOUNDATIONS \\u00a72 Authority kinds](../FOUNDATIONS.md#authority-kinds), What\\ncreates no authority). Only an admitted contract activates a step: no\\nresult, child completion, tool output, model response, shared actor or\\nlateral handoff activates another step or authorises continuation by\\nitself, and a profile that routes results names its instances of this\\nrule. Purpose and material relation: these admission conditions govern every\\nconfiguration, and their generic owner is this section (P6).\\nThe admitted contract names one\\ndurable result and evidence surface; every result, withheld closure and\\nresidual obligation is recorded there before return, a conversation return\\nalone is not durable evidence, and if no such surface is authorised and\\navailable, admission refuses (P4b). Absent or rejected admission returns\\nthe missing work authority without execution, as `admission_refused` with\\nits cause ([\\u00a73 Admission and activation](../ACTIVATION.md#admission-and-activation)).\\nThe selection of the carrier (ticket, sprint entry, run-scoped contract)\\nis owned by [TICKETS \\u00a75](../TICKETS.md#5-from-carrier-to-execution).\\n\\n\\nSource: ACTIVATION.md#2-context-construction-under-an-envelope sha256=56109ffa2e8ec6f158e6dbd0b387fededa685abc100a288ea88525854a78441d\\n\\n## 2. Context construction under an envelope\\n\\nQualified-reference guidance. Under\\n[AC-003](../AXIOMATIC_CALCULUS.md#ac-003-reference-closure) and\\n[AC-011](../AXIOMATIC_CALCULUS.md#ac-011-projection), a reference can supply\\nsufficient context when its accessible target and qualifications preserve\\nthe consuming contract. Check the required subject and basis, assessment\\nstanding, provenance, active obligation and version, and invalidators, rather\\nthan candidate identity alone. A typed annotation supplies no evidence of\\nsufficiency by itself. Preserve the required body or a qualified resolvable\\nreference; no mandatory carrier or registry follows (P1, P3, P6).\\n\\nAn exact local reference to a complete assessed record can preserve the\\nconsumer-required distinctions. A candidate-only pointer can lose them when\\nunchanged candidate bytes have satisfied and indeterminate assessments that\\nrequire different continuations. A sufficiency claim relying on hash matching\\nstates its collision and access assumptions. Unknown semantic relations retain their owning gap or\\nresult; they do not all become one error class. A declared but unperformed\\nevaluation has no assessment result; an undeclared required capability is\\na different condition. The [qualified-reference example](../examples/DETERMINISTIC_CONTRACTS.md#qualified-references)\\napplies the sufficiency law owned by\\n[FOUNDATIONS \\u00a74](../FOUNDATIONS.md#assertions-and-observation).\\n\\nGiven a seed set Z (the subject, outcome and affected relations named in the\\nintake), a relation family R (the dependency relations whose change can\\nalter the result, basis validity, evidence sufficiency or authority), and\\nthe actor's envelope B:\\n\\n1. Compute the material closure of Z under R (AC-010,\\n   [AXIOMATIC_CALCULUS \\u00a74](../AXIOMATIC_CALCULUS.md#ac-010-material-closure)).\\n   If Z, R, the required-edge semantics, the basis or the scope is not\\n   exact, or the closure is not finite and unique on the exact basis,\\n   activation returns `closure_unresolved` (\\u00a73, Admission and activation)\\n   and no step proceeds; it does not guess.\\n2. Project the closure to the selected context, recording its boundary: the\\n   excluded, external, unresolved, translated and invalidation-sensitive\\n   seams (AC-011,\\n   [AXIOMATIC_CALCULUS \\u00a74](../AXIOMATIC_CALCULUS.md#ac-011-projection)).\\n   If the projection returns a gap or refusal, activation returns\\n   `closure_unresolved` and no step proceeds.\\n   Material not in the closure stays out; adjacent material does not enter\\n   because it exists\\n   ([RF-004](../REFERENCE_FRAME.md#rf-004-irrelevance-exclusion)).\\n3. Test fit against B. This step owns the size measurement and the fit\\n   test for the context dimension. Where B declares a context capacity,\\n   the size of the selected context is measured before the actor reads it,\\n   in the unit the capacity is declared in (bytes or tokens) and over the\\n   boundary that the selected execution binding states for it (\\u00a76), and is\\n   compared with that capacity. The measurement, the capacity and the\\n   outcome of the comparison are recorded before the read. A fit holds\\n   only for the measured boundary: context outside it is recorded as not\\n   measured, and no fit claim covers it. The fit claim for a measured\\n   boundary and the step's fit judgment are distinct: the judgment is\\n   established from the recorded complete active inputs, or from a\\n   supported upper bound that includes any host-supplied context; where\\n   neither exists it is `indeterminate`, unless a counterexample, such as\\n   a measured excess, establishes `falsified`. A correct task result keeps\\n   its own bounded standing and does not satisfy a missing fit judgment\\n   (P0, P5). The measurement applies wherever B declares a\\n   context capacity, whatever question the step governs, because without\\n   it a fit claim against that capacity is an assertion, and a context\\n   that exceeds it would be cut without record\\n   ([RF-014](../REFERENCE_FRAME.md#rf-014-capability-fit)). It applies only\\n   there, because a resource control applies only through a selected frame\\n   and its owning scope\\n   ([REFERENCE_FRAME \\u00a74](../REFERENCE_FRAME.md#frame-set-selection)), and a\\n   declared capacity is such a control: the measurement tests that\\n   capacity, is no budget, and is not a universal measurement gate (P0,\\n   P2). Where B declares no context capacity, no measurement is\\n   required, and the other conditions of\\n   [RF-002](../REFERENCE_FRAME.md#rf-002-finite-attention) still apply. The size\\n   shows fit and nothing else: whether the actor attends adequately to a\\n   context that fits is decided by actual-use evidence under\\n   [EVALUATION \\u00a77](../EVALUATION.md#frame-qualification). The envelope's\\n   other dimensions are fitted as RF-014 states; time, spend and other\\n   resource limits follow [\\u00a76 Resource limits](../ACTIVATION.md#resource-limits), which\\n   this step refines for the context dimension.\\n   If the context fits, activate. If it does not, one or more of these, in\\n   combination: refine the outer contract into steps whose contexts fit\\n   (\\u00a74); sequence activations; apply a lawful compression that preserves the material\\n   distinctions and failure detections the evaluation needs\\n   ([RF-017](../REFERENCE_FRAME.md#rf-017-proportional-compression));\\n   select another actor whose envelope fits; or return `out_of_frame`\\n   ([\\u00a73 Admission and activation](../ACTIVATION.md#admission-and-activation)). Silent\\n   omission to fit is never one of them\\n   ([RF-014](../REFERENCE_FRAME.md#rf-014-capability-fit)).\\n   None of these options silently reduces the required predicate: the\\n   obligations the step preserves stay bound\\n   ([\\u00a71 Transitions](../ACTIVATION.md#transitions)), a narrowing of them is a destination\\n   change under its owning authority (\\u00a71, Destination change), and what\\n   the selected context leaves undecided stays an explicit unknown.\\n   Within its grant a step selects refinement, sequencing and compression\\n   itself; selecting another actor or enlarging the envelope re-enters the\\n   owner of the grant or envelope, who may delegate that choice in the grant\\n   (RF-014 vests the selection in human authority; a grant is that authority\\n   exercised in advance). Whether a compression preserved what the\\n   evaluation needs is a claim with the standing of any other (EVALUATION\\n   \\u00a71): the compressing step records the compression and its preservation\\n   argument, and the claim is assessed independently only where the\\n   promotion it serves needs independent assessment (EVALUATION \\u00a73).\\n4. Acquire declared inputs by their exact identity. A declared input absent\\n   from the actor's materialised view is neither licence to read elsewhere\\n   nor evidence that it is absent.\\n\\nAcquisition. Acquisition is the read-only observation of the material a\\nstep needs (its frame, its subject and its declared inputs) within the\\ninputs its intake permits it to acquire (\\u00a71 Intake). It is not an admission and not a further\\nactor stage; effectful work still needs its admitted contract (\\u00a71\\nAdmission), and acquiring material grants no role, operation or decision\\n([FOUNDATIONS \\u00a72 Authority kinds](../FOUNDATIONS.md#authority-kinds), What\\ncreates no authority). A derived surface is material derived from owning\\nsources by copying, projection or compression, such as a projected frame\\nfor a task; it names its sources and owns no determination. Where a\\ncurrent interpretation of the subject in `a_c` exists, the constraint\\nsurface it yields for the task is such a derived surface, under the\\nconditions of\\n[AXIOMATIC_CALCULUS \\u00a79 Constraint surfaces](../AXIOMATIC_CALCULUS.md#constraint-surfaces).\\nWhere a derived surface whose sources\\nare current serves the task, the actor acquires it. For another task, or\\nwhere the derived surface is stale ([Staleness of derived surfaces](../ACTIVATION.md#staleness-of-derived-surfaces)),\\nmissing or insufficient for a named unresolved question, the actor acquires the deciding owner sections\\ndirectly: the owning sections that decide the task's questions, which are\\ndeclared inputs of the selected basis. Only material in the exact selected\\nbasis is acquired: where that basis has no derived surface for the task,\\nits exact owner sections are used, and a candidate source, a version-line\\nselector or another basis is no substitute for it\\n([FOUNDATIONS \\u00a72 Product lineage objects](../FOUNDATIONS.md#product-lineage-objects)).\\nThe actor reads the selected material and the actual subject, and follows\\nthe material source and coupled-obligation references the task needs\\n(step 2; [RF-003](../REFERENCE_FRAME.md#rf-003-material-sufficiency));\\npresence of the corpus is no reason to read it (step 2;\\n[RF-004](../REFERENCE_FRAME.md#rf-004-irrelevance-exclusion)). No frame,\\nderived surface or acquisition carries a universal sufficiency claim:\\nsufficiency is decided for the named question against the task's\\nmaterial relations, never for the corpus or the frame as a whole\\n([RF-003](../REFERENCE_FRAME.md#rf-003-material-sufficiency)). Before any dependent action, a missing binding is returned with\\nits outcome of [\\u00a73 Admission and activation](../ACTIVATION.md#admission-and-activation),\\nnaming what is missing: where no available frame declares what the\\nevaluation needs, `out_of_frame`; where the basis the step requires is\\nabsent, or cannot be verified as the exact basis named, the basis cannot\\nsupport the step, and the outcome is `admission_refused(basis)` at\\nadmission or `activation_refusal(basis)` at activation. Coupled material that does not fit is handled under\\nstep 3 (P0, P6, P3).\\n\\nActivation. The actor or the assigning authority selects one frame or one\\ndeclared active frame configuration capable of the evaluation. Activation\\nbinds each reusable frame declaration to the exact subject and basis and\\nloads the declared material relations and evidence sources, never an\\nundifferentiated workspace dump; what the actor receives is the packet of\\nREFERENCE_FRAME \\u00a711. When no available frame and actor pairing can lawfully\\nperform the evaluation, activation returns `out_of_frame` where no such\\npairing declares a material relation or capability the evaluation needs,\\nand otherwise the `activation_refusal` whose cause holds\\n([REFERENCE_FRAME \\u00a75](../REFERENCE_FRAME.md#5-method-functions)); both are\\noutcomes of \\u00a73 Admission and activation. Work does not proceed through\\nimplied context (P0, P5).\\n\\nEvaluation. The evaluator applies the activated frame's declared\\ninvariants, evidence rules and result algebra. It distinguishes semantic\\nlaw, observed evidence, inference and decision, and records every\\nassumption whose failure could change the result (P6).\\n\\nStandalone scope. A derived surface or projected frame decides standalone\\nonly the questions that its own source members own. It refuses to close a\\nquestion owned by another member, or one that joins the law of several\\nowners; the evaluation of that question returns `out_of_frame`\\n([FOUNDATIONS \\u00a74 Results](../FOUNDATIONS.md#results)) naming the owning\\nmembers, and\\nthe question is decided from those members at their current digests or\\nfrom a derived surface whose declared sources include every owner of it\\n(P6, P1).\\n\\nPrompt construction. A prompt is rendered contract over typed authority;\\nit is not source law. Prompt text must project the current authority\\nreferences, obligations, contracts, boundaries, proof expectations and\\nfallback conditions the step needs. A prompt body must not carry\\nhistorical workaround prose unless the current requirement, design,\\nruntime or test still needs that constraint. Construction starts from the\\nhighest live authority surface the question needs. If the prompt needs an\\nupstream ambiguity resolved, it names the unresolved authority gap before\\nfallback context is read. The prompt projects the material that\\nAcquisition above selects, including the raw owning members where\\nAcquisition falls back to them (P6, P0, P5). The design, ODD, UX and ticket\\nspecialisations are\\n[DESIGN_MODULE \\u00a711](../DESIGN_MODULE.md#11-review),\\n[ODD \\u00a711.5D](../ODD.md#115d-constructive-evaluation-and-yield-loop) A5 and\\n[\\u00a711.7A](../ODD.md#117a-conforming-agentic-development),\\n[UX \\u00a77](../UX.md#7-carrier-binding) and\\n[TICKETS \\u00a75](../TICKETS.md#5-from-carrier-to-execution) and\\n[\\u00a77](../TICKETS.md#7-authority-judgment-closure-and-state) (P6).\\n\\nThe operation that joins AC-010, AC-011 and RF-002, RF-003, RF-004,\\nRF-014 and RF-017 into one procedure is stated here (P0); each of\\nthose laws is applied here from its owning section in\\n[AXIOMATIC_CALCULUS \\u00a74](../AXIOMATIC_CALCULUS.md#ac-010-material-closure) and\\n[REFERENCE_FRAME \\u00a73](../REFERENCE_FRAME.md#3-laws). The method does not require proving\\nthat no undiscovered material relation exists\\n([RF-003](../REFERENCE_FRAME.md#rf-003-material-sufficiency)).\\nThe size measurement of step 3 applies under its stated condition.\\nPurpose and material relation of that measurement and Acquisition:\\nfinite context makes fit necessary (P0), so a fit against a declared\\ncapacity is measured rather than asserted, while fit and attention stay\\nseparate claims (P6); and an actor without a derived surface for its task\\nstill reaches the sections that decide it, from the exact basis, without\\nreading the corpus or substituting a stale or mutable copy (P3, P6). The\\nmaterial relation is whether a context larger than the declared capacity\\nis read as if it fit, a fit is taken as adequate attention, or a decision\\nrests on material other than its deciding owners at the selected basis.\\n\\n### Staleness of derived surfaces\\n\\nThis subsection owns when a derived surface (Acquisition above) is current\\nand when it is stale, for any method and any carrier (P3, P5, P6):\\n\\n- A derived surface names the exact identity, such as the path and\\n  digest, of each source it was derived from and of each source whose\\n  change can change its content.\\n- It is current for a selected basis only while every source identity it\\n  names equals the identity of that source in the selected basis. A change\\n  to any of them makes it stale.\\n- A stale derived surface is not used as current for any question. It\\n  becomes current again only by regeneration from the sources at the\\n  selected basis, or by an explicit re-acceptance that records the new\\n  source identities and the finding that its content still matches them;\\n  until then the actor acquires the deciding owner sections directly\\n  (Acquisition above).\\n- Matching source identities establish only that the surface was derived\\n  from those sources. They establish neither its fidelity to them nor its\\n  sufficiency for a question; a surface found insufficient for a named\\n  question is handled as Acquisition above states.\\n- The owning sections at the selected basis remain the deciding source.\\n  Whether a current surface is insufficient for a question, or decides\\n  beyond its own sources, is judged against them (Standalone scope above);\\n  a derived surface never decides that about itself.\\n\\nA packaging or installation carrier refines this rule with its own\\nidentities and re-acceptance procedure, and names this subsection as its\\nowner; [PRODUCT_DEFINITION \\u00a711](../PRODUCT_DEFINITION.md#11-one-constitutional-surface-and-version-boundary)\\ndoes so for the method's released carriers. Purpose and material relation: an actor that relies on a\\nderived surface after one of its sources has changed decides from material\\nthat no longer matches its owners, and a matching digest read as fidelity\\nwould let a faithful-looking but wrong surface decide; the material\\nrelation is whether a decision rests on a surface whose sources are not\\nthose of the selected basis. This rule applies to derived surfaces under every selected carrier.\\n\\n\\nSource: FOUNDATIONS.md#results sha256=92fe2f3c09a59b4e9a732463a41d4a45d7efd693648159621e03c75f7127eac5 rows=0/18 selected by the anchors this frame carries; the consumers paragraph of 18 items is omitted\\n\\n### Results\\n\\nEvery performed evaluation returns one value of the core result algebra,\\ndirectly or as a refined value mapped into it (P5):\\n\\n| Value | Meaning |\\n|---|---|\\n| `satisfied` | the declared predicate holds on the exact basis |\\n| `falsified` | a declared counterexample defeats it |\\n| `indeterminate` | the available admissible evidence cannot decide it |\\n| `out_of_frame` | the evaluation requires an undeclared material relation or capability |\\n| `invalid_basis` | the subject or basis cannot support the evaluation |\\n\\nThis core is the only one. Results of constraints, judgments, frame\\nevaluations, stops, work steps and effects are stated in it or in a\\nrefinement mapped into it, so that results from any members combine under\\none rule ([Conjunction of results](../FOUNDATIONS.md#conjunction-of-results)). Purpose and\\nmaterial relation: no combination can report success while a failure, an\\nundecided question, an unperformed evaluation or an uncertain effect\\nremains, and none of these can be mistaken for another (P5, P6).\\n\\nRecording. A result records its core value together with the predicate\\nevaluated and the original domain outcome, which is the refined value\\nwhere a refinement produced it. A mapping into the core never owns domain\\nmeaning: the member, profile or adopting Product that defines the refined\\nvalue keeps it, and a consumer that needs the domain distinction reads the\\ndomain outcome, never the core value alone (P1, P6).\\n\\nStanding. The standing of a result is what it establishes about its\\npredicate; it is distinct from the standing of a commitment (\\u00a71). Only\\n`satisfied` establishes the predicate. `falsified` establishes that the\\npredicate fails and names the counterexample. `indeterminate`,\\n`out_of_frame` and `invalid_basis` establish neither, and each names what\\nwould decide: the evidence, the missing relation or capability with its\\nowner where the subject gives one, or the basis repair. By support for the\\npredicate, `satisfied` stands above each other value, and the other four\\nare not ordered among themselves.\\n\\nNo refinement or mapping raises a result's standing (P5, P6):\\n\\n- a falsified or failed result never maps to a satisfied or successful one;\\n- a result that admissible evidence cannot decide never maps to\\n  `satisfied`;\\n- an evaluation that was not performed stays distinct from one whose\\n  evidence cannot decide: it has no\\n  [closed result](../ACTIVATION.md#7-closed-result-and-reuse), and it is never mapped\\n  to `indeterminate` or to any other core value;\\n- an effect whose completion is unknown never maps to no effect or to\\n  completed.\\n\\nNot performed. An evaluation that is required or planned and was not\\nperformed has no closed result; an actor cannot report an evaluation it\\ndid not perform (P6). Nothing is coerced to success: a failed,\\nindeterminate, out-of-frame, out-of-scope or invalid-basis result follows\\nthe declared result algebra and returns its own value under it, never\\n`satisfied`, and a missing result, being no result, enters every\\nconjunction over it as a gap: a planned assessment without a closed result\\nwhere an assessment was planned, and uncovered coverage where none was.\\n[REFERENCE_FRAME \\u00a73](../REFERENCE_FRAME.md#rf-012-closed-results) states\\nRF-012 as a law over frames and\\n[AXIOMATIC_CALCULUS \\u00a74](../AXIOMATIC_CALCULUS.md#ac-007-constraint-and-refusal)\\nstates AC-007 as a law over constraints; each uses this core and neither\\ndefines it again.\\n\\nRefinements. A member, profile or adopting Product that needs finer\\noutcomes defines a refinement. The refinement names the question it\\nanswers and the predicate its mapping is for, and maps every refined value\\nto exactly one core value. No outcome exists outside the core; a\\nrefinement adds no core value and keeps the pressure of `indeterminate`,\\n`out_of_frame` and `invalid_basis` explicit. Where a refined value would\\nmap to one of two core values according to its cause, the cause is part of\\nthe refined value and each resulting value maps once (P5, P1). A further\\nrefinement, by a member, profile, project or adopting Product, may split a\\nrefined value by cause. The parent-value rule governs every such split:\\neach child value names its parent value and its cause and keeps its\\nparent's core value; a child that needs a different core value needs a\\ndifferent parent value, which only the owner of the parent declares; and\\nno child takes `satisfied` from a parent that is not `satisfied`. No\\nfurther refinement raises a result's standing (P5, P6, P1). Purpose and\\nmaterial relation: a consumer that reads a parent value reads the same\\ncore value from each of its children, so a split by cause adds a domain\\ndistinction and never changes what the parent establishes (P5, P6). The\\nrefinements for admission, activation and steps are\\n[ACTIVATION \\u00a73](../ACTIVATION.md#3-step-results-and-disposition); each other\\nmember, profile and adopting Product states its mapping where it defines\\nits values.\\n\\nAvailability, assessment and acceptance are separate results, each with its\\nown predicate: that a step produced a candidate; that the candidate meets\\nits declared criteria; and that the\\n[decision owner](../ACTIVATION.md#roles-and-delegation) accepts it at its\\nboundary. A step having produced a candidate never maps to the candidate's\\nfitness or acceptance, and acceptance is never inferred from a successful\\nstep (P6; [ACTIVATION \\u00a73](../ACTIVATION.md#3-step-results-and-disposition),\\n[EVALUATION \\u00a74](../EVALUATION.md#4-review-results) and\\n[\\u00a75](../EVALUATION.md#5-acceptance)).\\n\\nOut of frame or indeterminate. The boundary between these values is drawn\\non what the activated frame declares and on what the step did with it (P5,\\nfinite capacity and graceful total handling; the material relation drawn\\nis the three-way out_of_frame boundary: capability not declared, capability\\ndeclared and exercised, capability declared and not exercised). Three cases; the first two name core values, and\\nthe third names none:\\n\\n- `out_of_frame` when the claim requires a material relation or an\\n  evaluator capability that the activated frame does not declare. The\\n  result names the missing relation or capability, its owner where the\\n  subject gives one, and the reconfiguration pressure it creates\\n  ([ACTIVATION \\u00a74](../ACTIVATION.md#4-totality-and-refinement)). A term the claim depends on and the frame\\n  leaves undefined is an undeclared material relation: its meaning can\\n  alter the result and it enters through no declared input (RF-003; P1). Whether the step exercised anything is\\n  irrelevant to this value; the ground is the missing declaration.\\n- `indeterminate` when the available admissible evidence cannot decide the\\n  claim. The result names the evidence that would decide, as\\n  its residual uncertainty. Where the\\n  claim also depends on an undeclared relation or capability,\\n  `out_of_frame` and `indeterminate` each have a lawful ground; the result\\n  names the value it returns and that ground, and this boundary excludes\\n  neither (P5).\\n- no value of its own when the step did not exercise a declared capability\\n  the evaluation requires. A result is returned wherever a sufficient\\n  evaluation or an applicable judgment exists without that capability,\\n  identifying its evidence, verdict and residual uncertainty like any\\n  closed result:\\n  a counterexample found by what was exercised, as when source inspection\\n  falsifies A in a claim of A and B, returns `falsified`, and common\\n  agreement cannot discard it. Where none\\n  exists because the capability was not exercised, the evaluation was not\\n  performed and has no result: the step's stop state carries it,\\n  `incomplete` under\\n  [construction availability](../ACTIVATION.md#construction-availability), and\\n  its work state ([ACTIVATION \\u00a75](../ACTIVATION.md#5-work-state-and-restart))\\n  carries the unexercised capability as a residual (P6). In either case\\n  the unexercised part, B above, has no result: in every conjunction over\\n  it, it is a planned assessment without a closed result, and the known\\n  failure A survives with it ([Conjunction of results](../FOUNDATIONS.md#conjunction-of-results)).\\n  The evaluation's result and the step's stop state answer different\\n  questions, so the step's stop value never becomes the evaluation's\\n  result.\\n\\nFoundation to law for results and their combination (family F3). The\\ntable covers every rule of \\u00a74 and the result grounds of \\u00a72 Imports\\nbetween members, in the format of\\n[Foundation to law](../FOUNDATIONS.md#foundation-to-law), which states the standing of its\\nconsequences. Purpose and material relation: a reader of \\u00a74 sees which\\ncommitments each result rule rests on and which choices it adds, with their\\nowners (P6, P2). Instance premises, which the commitments do not supply:\\n(i) an evaluation declares its predicate, subject and basis; (ii) results\\nof several evaluations, steps or members are combined into one decision;\\n(iii) members, profiles and adopting Products need outcomes finer than the\\ncore.\\n\\n| Premises, with standing | Consequence that follows | Rule in this member that states it | Added domain or policy choice, and its owner | Pillar |\\n|---|---|---|---|---|\\n\\nRF-012 in [REFERENCE_FRAME \\u00a73](../REFERENCE_FRAME.md#rf-012-closed-results),\\nAC-007 in\\n[AXIOMATIC_CALCULUS \\u00a74](../AXIOMATIC_CALCULUS.md#ac-007-constraint-and-refusal)\\nand [EVALUATION \\u00a74](../EVALUATION.md#4-review-results) apply the first row's\\nalgebra to frames, constraints and reviews and add no choice of their own\\nbeyond any refinement they map under the fifth row;\\n[ACTIVATION \\u00a73](../ACTIVATION.md#3-step-results-and-disposition) holds the\\nstep's refinements of the fifth row and the stop state of the seventh.\\n\\n\\nSource: PRODUCT_DEFINITION.md#foundation-to-law-binding-a-project-to-the-method sha256=95afb85e4cf8f248a6f430be34ef288add61445dc43d9c8121239409b9fac231 rows=3/10 selected by the anchors this frame carries; the consumers paragraph of 10 items is omitted\\n\\n### Foundation to law: binding a project to the method\\n\\nThis family (F12 in the index of\\n[FOUNDATIONS \\u00a73 Foundation to law](../FOUNDATIONS.md#foundation-to-law))\\ndecides how one project binds to the method. Its instance premises, which\\nthe commitments do not supply, are named in the rows as follows: own\\nauthorities, a project has its own product WHAT under its own authorities\\nand adopts the method without becoming part of it; chosen layout, the\\nproject's governing documents, realisations and work carriers already\\nlive where the project placed them; shared workspace, several projects,\\nproduct definitions, tenants and actors share one workspace or machine;\\nrecurring terms, one term occurs in several bounded contexts with\\ndifferent meanings; released method, the method is published as\\nimmutable released versions that a project selects, installs and later\\nreplaces. The index also assigns to this family the rule of\\n[FOUNDATIONS \\u00a72 Imports between members](../FOUNDATIONS.md#imports-between-members);\\nthe table traces that rule in its sixth row, whose rule column names that\\nsection, and owns none of it. Each commitment's standing is written as the\\ntable of commitments in FOUNDATIONS \\u00a73 states it.\\n\\n| Premises, with standing | Consequence that follows | Rule in this member that states it | Added domain or policy choice, and its owner | Pillar |\\n|---|---|---|---|---|\\n| P6 (independent); P3 (independent); P2 (independent); P1 (independent); instance: own authorities, chosen layout | By P6 each surface keeps its own authority, and by P2 binding adds only what the outcome needs, so a project binds to the method through one definition for each distinct product WHAT, which locates the governing surfaces and records their relations without holding their content; adoption therefore needs no restructuring, and by P3 content repeated in the definition would be a second record of one fact, a rival authority. | [\\u00a71](../PRODUCT_DEFINITION.md#1-overlay-and-layout-independence); [\\u00a72](../PRODUCT_DEFINITION.md#2-required-definition-relations) | the JSON overlay, the filename convention and Definition Label, the schema and template, and the relation fields of \\u00a72: interoperability choices of this member, accepted under [\\u00a711](../PRODUCT_DEFINITION.md#11-one-constitutional-surface-and-version-boundary) | 1, 9 |\\n| P3 (independent); P6 (independent); P5 (derived from P0 and P6, with P0's open-world premise); P1 (independent); instance: own authorities, shared workspace | By P3 each identity binds its own exact basis, and by P1 a locator, filename, path or nesting carries no meaning, so each definition line, Product, release, tenant and project keeps its own identity, and location mints no identity, authority, inheritance or composition. By P5 an ambiguous selection is no selection, so discovery selects exactly one applicable definition for a scope or fails closed, and by P6 composition is explicit and verifies the identity it expects. | [\\u00a71](../PRODUCT_DEFINITION.md#1-overlay-and-layout-independence), the identity paragraphs; [\\u00a79](../PRODUCT_DEFINITION.md#9-recursive-discovery-and-explicit-composition) | the composition entry fields and the checks of a conforming discovered set: domain choices of this member | 1, 2 |\\n| P6 (independent); P3 (independent); P4b (derived from P0 and P2, with P0's premise that step-produced facts are not re-acquirable); P1 (independent); P5 (derived from P0 and P6, with P0's open-world premise); P2 (independent); instance: released method | By P6 and P3 one law has one owner on one released basis, so the method has one authority surface, each law has one owning member, and the members govern only together, as one released version. By P4b a derived surface depends on its sources, so it preserves the owning clauses' conditions, carries their digests and is stale when one changes; by P1 a matching digest establishes identity, not fidelity. | [\\u00a711](../PRODUCT_DEFINITION.md#11-one-constitutional-surface-and-version-boundary) | the generic staleness law, which the digest binding refines for the carriers of a cut or installation: [ACTIVATION \\u00a72 Staleness of derived surfaces](../ACTIVATION.md#staleness-of-derived-surfaces); which concrete forms the method accepts as interoperability boundaries: this member (\\u00a71, \\u00a74); any widening of Product scope to an executable tool, runtime or realisation: separate explicit human authorisation; a policy of this member: the members govern only together, as one released version | 1, 6, 9 |\\n\\nThe standing of these consequences is stated in\\n[FOUNDATIONS \\u00a73 Foundation to law](../FOUNDATIONS.md#foundation-to-law).\\nThe table accounts for \\u00a71 to \\u00a712 and for FOUNDATIONS \\u00a72 Imports between\\nmembers; the grounds of `out_of_frame` and `invalid_basis` stated there\\nare traced by family F3 at\\n[FOUNDATIONS \\u00a74 Results](../FOUNDATIONS.md#results).\\n\\n\\nSource: REFERENCE_FRAME.md#foundation-to-law sha256=8152838639950b09389f99181172792100e4470b4807b4e112870cd4e6f6ba21 rows=13/36 selected by the anchors this frame carries; the consumers paragraph of 36 items is omitted\\n\\n### Foundation to law\\n\\nThis family, frames and context (F1 in the index of\\n[FOUNDATIONS \\u00a73 Foundation to law](../FOUNDATIONS.md#foundation-to-law)),\\ndecides how a finite actor engages a body of work through bounded reference\\nframes: how a frame is declared, sized, bound, activated, related to other\\nframes, used to audit coverage and revised. It covers this member; the\\ncontext construction of\\n[ACTIVATION \\u00a72](../ACTIVATION.md#2-context-construction-under-an-envelope);\\nand the frame objects, authority kinds, disjointness and independence and\\nframe tuple of [FOUNDATIONS \\u00a72](../FOUNDATIONS.md#frame-objects). A rule in\\nanother member is marked \\\"outside this member\\\" in the third column; the\\ntable owns none of the rules it names. Its instance premises are: (a) a\\nworkspace holds more material than one actor's capability envelope (its\\ncompetence, context capacity, tools and access) can evaluate at once; (b)\\nthe evaluations to be made are declared questions about a governed\\noutcome; (c) several frames and actors may bear on one workspace, and their\\nmaterial may overlap; (d) the workspace, its topology and the actors'\\ncapabilities change between activations; (e) an actor may read both owning\\nsources and surfaces derived from them by copying, projection or\\ncompression. They are conditions of the work this family governs, not\\ncommitments, and do not follow from finite capacity alone. Two of P0's\\npremises are cited by name: its actor-change premise, that the actor of one\\nstep need not be the actor of the next and may re-acquire declared sources\\nbut not private memory; and its open-world premise, that the world is open.\\nThe standing of the consequences below is stated in\\n[FOUNDATIONS \\u00a73 Foundation to law](../FOUNDATIONS.md#foundation-to-law).\\n\\n| Premises, with standing | Consequence that follows | Rule in this member that states it | Added domain or policy choice, and its owner | Pillar |\\n|---|---|---|---|---|\\n| P0 (recovered), P1 (independent), P2 (independent), P3 (independent), P6 (independent) | By P0 an actor engages only a finite specification, and by P1 and P3 a carrier is a representation of it, not the relation, so a reference frame is a finite specification of the attention, coordinates, authority, evidence and result relations one evaluation family requires. It specifies a relation, not a required schema or runtime carrier; a prompt, context packet or program is a projection of an activated frame, not the frame. A frame is bound only when every material coordinate resolves to an exact source, subject, basis, authority, evidence route, actor envelope, result relation and invalidation condition, and representation cannot create, widen or replace that binding | [FOUNDATIONS \\u00a72 The frame tuple](../FOUNDATIONS.md#the-frame-tuple) and [Frame objects](../FOUNDATIONS.md#frame-objects), Workspace, Material-relation manifold, Reference frame and Active frame configuration, outside this member | the twelve components \\u27e8Q, B, M, C, I, A, E, X, R, J, K, D\\u27e9: FOUNDATIONS \\u00a72 The frame tuple | 6, 7 |\\n| P0 (recovered, with its actor-change premise), P2 (independent), P6 (independent); instance premise a | By P0 and its actor-change premise an attention surface must fit and be reconstructable by the actor that uses it, so an activated frame's attention surface is finite and fits the selected actor's declared envelope; a frame that needs undeclared ambient memory, conversation history or an effectively global workspace context is not reconstructable for that actor. Where the envelope declares a context capacity, the selected context's size is measured before the actor reads it, over a stated boundary, and recorded with the capacity and the comparison; context outside the boundary is recorded as not measured. The measurement applies there and only there, is no budget and no universal gate, and shows fit and nothing else | [RF-002](../REFERENCE_FRAME.md#rf-002-finite-attention); [ACTIVATION \\u00a72](../ACTIVATION.md#2-context-construction-under-an-envelope) step 3, the size measurement, outside this member; [\\u00a712](../REFERENCE_FRAME.md#12-violations) item 10 | the capacity and its unit, bytes or tokens: the actor's declared envelope; the measured boundary, and time, spend and other resource limits: the selected execution binding ([SPEC_METHOD \\u00a711](../SPEC_METHOD.md#11-build-tenant-binding)) | 7, 8 |\\n| P2 (independent), P0 (recovered, with its open-world premise), P5 (derived from P0 and P6, with P0's open-world premise); instance premise a | By P2 and P5 a result is sound only if every relation that can change it is present, and by P0's open-world premise relations not held are not thereby absent, so every known relation whose lawful change can alter the result, the validity of the basis, the sufficiency of evidence, operation authority or decision authority appears in the frame or enters through a declared authoritative input, and omitting one makes the frame insufficient; the law does not require proof that no undiscovered material relation exists. The context starts as the material closure of the intake's seed set (the subject, outcome and affected relations it names) under that relation family, and a closure that is not finite and unique on the exact basis stops the step and is not guessed | [RF-003](../REFERENCE_FRAME.md#rf-003-material-sufficiency); [ACTIVATION \\u00a72](../ACTIVATION.md#2-context-construction-under-an-envelope) step 1, outside this member | the closure law: [AC-010](../AXIOMATIC_CALCULUS.md#ac-010-material-closure); the stop's outcome, `closure_unresolved`: [ACTIVATION \\u00a73 Admission and activation](../ACTIVATION.md#admission-and-activation) | 6, 7 |\\n| P2 (independent) | By P2 attention is spent only on what bears on the evaluation, so relations that cannot affect the declared evaluation stay outside active attention unless they are needed to establish that irrelevance; adjacent material, or the presence of the corpus, is no reason to load or read it. The closure is projected to the selected context with its boundary recorded | [RF-004](../REFERENCE_FRAME.md#rf-004-irrelevance-exclusion); [ACTIVATION \\u00a72](../ACTIVATION.md#2-context-construction-under-an-envelope) step 2 and Acquisition, outside this member | the seams the boundary records (excluded, external, unresolved, translated, invalidation-sensitive): ACTIVATION \\u00a72 step 2, applying [AC-011](../AXIOMATIC_CALCULUS.md#ac-011-projection) | 7 |\\n| P6 (independent), P3 (independent); instance premise c | By P6 authority exists only through an admitted grant, and by P3 it binds its owner and scope, so a frame carries and applies admitted authority and never mints, widens, transfers or reconstructs it from actor identity, capability, evidence shape, implementation reachability or frame selection; declaring, selecting, activating or executing a frame, or naming a role, grants none. The kinds of authority may coincide in a lawful case and never collapse by default, and actor identity is not an authority. A read-only evaluation declares no operation authority; an effectful one inherits the exact operation grant from its existing owner. A proxy for human authority keeps its identity distinct from the human authority's | [RF-006](../REFERENCE_FRAME.md#rf-006-authority-conservation); [FOUNDATIONS \\u00a72 Authority kinds](../FOUNDATIONS.md#authority-kinds) and [Frame objects](../FOUNDATIONS.md#frame-objects), Role, persona, abstraction, component, outside this member; [\\u00a72](../REFERENCE_FRAME.md#2-core-claims) claim 8; [\\u00a712](../REFERENCE_FRAME.md#12-violations) item 6 | the division into frame-set, semantic, evaluation, operation and decision authority, with actor identity apart, and frame-set authority as human authority: FOUNDATIONS \\u00a72 Authority kinds; when a bounded proxy may act: [IDENTITY \\u00a76](../IDENTITY.md#6-authority-identity-and-conservation-stdo-up-004) | 7, 9 |\\n| P6 (independent) | By P6 meaning, evidence, application, operation and decision are separate authorities, so semantic law defines what the evaluation means, evidence supplies observations, the evaluator applies the declared relation, the existing operation owner supplies any operation grant, and decision authority disposes the result; a frame declaration keeps these roles distinguishable even when one actor performs several. The evaluator applies the frame's declared invariants, evidence rules and result algebra and records every assumption whose failure could change the result | [RF-007](../REFERENCE_FRAME.md#rf-007-semantic-evidence-and-verdict-separation); [ACTIVATION \\u00a72](../ACTIVATION.md#2-context-construction-under-an-envelope) Evaluation, outside this member | none; [EVALUATION \\u00a72](../EVALUATION.md#2-separation) applies this law to review (family F6) | 7, 9 |\\n| P0 (recovered, with its actor-change premise), P6 (independent), P2 (independent), P3 (independent) | By P0's actor-change premise a frame must work for a fresh actor, and by P6 and P3 that actor receives only declared, bound inputs, so a fresh competent actor inside the declared envelope can reconstruct the activated evaluation from the frame declaration, the exact subject, the basis and the admissible inputs, without undocumented conversational or historical context. An actor receives one activated frame or one declared active frame configuration, never an implied demand to reconstruct the workspace from ambient context; it may own its internal reasoning where the governing method permits, returns through the declared result relation, and hidden reasoning substitutes for no required evidence, provenance or authority. Every field of the binding resolves through stable identities and source references, for which paths, line numbers, counts, summaries and matching labels do not substitute | [RF-013](../REFERENCE_FRAME.md#rf-013-reconstructable-activation); [\\u00a711](../REFERENCE_FRAME.md#11-the-activation-packet); [Minimal activation binding](../REFERENCE_FRAME.md#minimal-activation-binding) | the packet's minimum contents and the binding's fields: this member; the carrier: its consumer (RF-016) | 7, 9 |\\n| P0 (recovered), P5 (derived from P0 and P6, with P0's open-world premise), P6 (independent); instance premise a | By P0 an actor's envelope is finite, and by P5 a step cannot report success on what it did not hold, so frame adequacy includes actor usability. When the material manifold exceeds an actor's envelope, the lawful responses are another actor, a refined frame or outer contract, sequenced activations, a lawful compression or `out_of_frame`; silently omitting material relations to fit is never one of them, and a frame never silently grows beyond the selected actor's envelope. Actor capability may justify a different frame size or activation sequence, and can neither waive an invariant nor widen authority | [RF-014](../REFERENCE_FRAME.md#rf-014-capability-fit); [ACTIVATION \\u00a72](../ACTIVATION.md#2-context-construction-under-an-envelope) step 3, the responses when the context does not fit, outside this member; [FOUNDATIONS \\u00a72 Frame objects](../FOUNDATIONS.md#frame-objects), Capability envelope, outside this member; [\\u00a711](../REFERENCE_FRAME.md#11-the-activation-packet), frame size; [\\u00a712](../REFERENCE_FRAME.md#12-violations) item 10 | the selection among these responses: human authority, directly or in advance through the grant; which responses a step selects within its grant (refinement, sequencing, compression) and which re-enter the owner of the grant or envelope (another actor, a larger envelope): ACTIVATION \\u00a72 step 3 | 7, 8 |\\n| P2 (independent), P0 (recovered), P6 (independent) | By P2 a compression serves the evaluation, and by P0 it must fit the envelope, so a compression preserves the material distinctions and failure detections the evaluation family requires while fitting the envelope; it need not be a unique smallest frame. Intentional overlap is kept where it supplies independently activated evaluation, different capability fit, different evidence altitude or useful fault detection, and frames are merged only when the merged frame preserves evaluation meaning, authority, capability fit and proportional reasoning cost. Whether a compression preserved what the evaluation needs is a claim: the compressing step records the compression and its preservation argument | [RF-017](../REFERENCE_FRAME.md#rf-017-proportional-compression); [ACTIVATION \\u00a72](../ACTIVATION.md#2-context-construction-under-an-envelope) step 3, compression, outside this member; [\\u00a712](../REFERENCE_FRAME.md#12-violations) item 13 | whether that claim is assessed independently: the promotion it serves ([EVALUATION \\u00a73](../EVALUATION.md#3-independent-assessment)) | 6, 7 |\\n| P0 (recovered, with its actor-change premise), P3 (independent), P6 (independent); instance premise e | By P0's actor-change premise and P3 an input is acquired by exact identity from the selected basis, and by P6 absence from view grants nothing, so declared inputs are acquired by exact identity, and only from the exact selected basis: a declared input absent from the actor's view is neither licence to read elsewhere nor evidence that it is absent, and a candidate source, a moving selector or another basis is no substitute. Where a derived surface is stale, missing or insufficient for a named question, the deciding owner sections are acquired directly. Acquisition is read-only, grants no role, operation or decision, and a missing binding is returned with its outcome before any dependent action | [ACTIVATION \\u00a72](../ACTIVATION.md#2-context-construction-under-an-envelope) step 4 and Acquisition, outside this member | acquiring a current derived surface in preference to its owning sections where it serves the task: ACTIVATION \\u00a72 Acquisition; which derived surfaces are published: their publisher, and none owns a determination | 2, 7 |\\n| P0 (recovered), P5 (derived from P0 and P6, with P0's open-world premise), P3 (independent), P6 (independent) | By P0 an actor loads only what its frame declares, and by P5 and P3 a declaration is not evidence about one activation, so activation binds each reusable frame declaration to the exact subject and basis and loads the declared material relations and evidence sources, never an undifferentiated workspace dump; a reusable declaration is not evidence that a particular activation was correct. When no available frame and actor pairing can lawfully perform the evaluation, activation returns `out_of_frame` or the refusal whose cause holds, and work does not proceed through implied context | [ACTIVATION \\u00a72](../ACTIVATION.md#2-context-construction-under-an-envelope) Activation, outside this member; [FOUNDATIONS \\u00a72 Frame objects](../FOUNDATIONS.md#frame-objects), Activated frame, outside this member | who selects the frame: the actor or the assigning authority, as the configuration allocates ([ACTIVATION \\u00a71 Configuration](../ACTIVATION.md#configuration), family F2) | 7, 8 |\\n| P6 (independent), P1 (independent); instance premise e | By P6 a derived surface owns no determination, and by P1 it is a representation of its sources, so a derived surface or projected frame decides standalone only the questions its own source members own. For a question another member owns, or one that joins the law of several owners, the step returns `out_of_frame` naming the owning members, and the question is decided from those members or from a derived surface whose declared sources include every owner | [ACTIVATION \\u00a72](../ACTIVATION.md#2-context-construction-under-an-envelope) Standalone scope, outside this member | none | 6, 7, 9 |\\n| P6 (independent), P0 (recovered), P5 (derived from P0 and P6, with P0's open-world premise) | By P6 a prompt holds no authority of its own, and by P0 and P5 it carries only what the step needs, so a prompt is a rendered contract over typed authority, not source law. It projects the current authority references, obligations, contracts, boundaries, proof expectations and fallback conditions the step needs, and the material Acquisition selects; it carries no historical workaround prose unless a current surface still needs that constraint. Construction starts from the highest live authority surface the question needs and names an unresolved upstream authority gap before fallback context is read | [ACTIVATION \\u00a72](../ACTIVATION.md#2-context-construction-under-an-envelope) Prompt construction, outside this member | the design, ODD, UX and ticket specialisations: [DESIGN_MODULE \\u00a711](../DESIGN_MODULE.md#11-review), [ODD \\u00a711.5D](../ODD.md#115d-constructive-evaluation-and-yield-loop) and [\\u00a711.7A](../ODD.md#117a-conforming-agentic-development), [UX \\u00a77](../UX.md#7-carrier-binding), and [TICKETS \\u00a75](../TICKETS.md#5-from-carrier-to-execution) and [\\u00a77](../TICKETS.md#7-authority-judgment-closure-and-state) | 6, 7 |\\n\\nRF-012, and the mapping of the outcomes of \\u00a75 and the coverage statuses of\\n\\u00a78 into the core, apply the core result algebra and its refinement rule;\\nthey are traced in family F3 at\\n[FOUNDATIONS \\u00a74 Results](../FOUNDATIONS.md#results), and the rows above trace\\nonly what those rules decide about frames. Claim 9 of \\u00a72 and item 8 of \\u00a712\\nstate RF-012 and go with it to F3. \\u00a72 states ten core claims that the rules\\nnamed in the rows, or RF-012, make precise; it adds no rule of its own. \\u00a712\\nlists violations, each of the rule it cites, and each is traced in that\\nrule's row or, for item 8, in F3. \\u00a714 states when a project operates under this member: when the\\nrules named in the rows hold for its frame set, with no frame machinery,\\nglobal context, universal completeness or domain authority inferred from\\nadopting the member.\\n\\n\\nSource: SPEC_METHOD.md#foundation-to-law-chain-outcome-and-build-tenant-binding sha256=b2773dc0c9feb429b6b357bcfd60e7df46e54db8adcb04dc8d6dbfa023b73677 rows=1/13 selected by the anchors this frame carries; the consumers paragraph of 13 items is omitted\\n\\n### Foundation to law: chain, outcome and build-tenant binding\\n\\nThis family (F10 in the index of\\n[FOUNDATIONS \\u00a73 Foundation to law](../FOUNDATIONS.md#foundation-to-law))\\ndecides how a product's specification governs its realisations. Its\\ninstance premises, which the commitments do not supply, are named in the\\nrows as follows: owned layers, a product has a selected outcome and an\\nowning authority for each layer of its specification; layered surfaces,\\nits specification is written as layered surfaces that actors interpret;\\nseveral realisations, one specification may have several realisations,\\nwhich change over time; immutable releases, a release is an immutable\\nidentity. Standing of the commitments cited (FOUNDATIONS \\u00a73): P0\\nrecovered; P1, P2, P3, P4a and P6 independent; P4b derived from P0 and\\nP2, with P0's premise that step-produced facts are not re-acquirable; P5\\nderived from P0 and P6, with P0's open-world premise.\\n\\n| Premises, with standing | Consequence that follows | Rule in this member that states it | Added domain or policy choice, and its owner | Pillar |\\n|---|---|---|---|---|\\n| P3 independent; P6 independent; instance: immutable releases, several realisations | By P3 each lineage object binds its own identity, so lineage objects keep distinct identities, and a consumer selects one complete released version. By P6 a reusable method change has authority only through its relation to its evidence, so it keeps one authority relation from that evidence to the consumer that realises it. | [\\u00a76](../SPEC_METHOD.md#6-lineage-and-release); [Shared method adoption and propagation](../SPEC_METHOD.md#shared-method-adoption-and-propagation-stdo-up-012) | the eight-step adoption chain: a policy choice of this member; the lineage objects: [FOUNDATIONS \\u00a72](../FOUNDATIONS.md#product-lineage-objects) | 1, 2 |\\n\\nThe standing of these consequences is stated in\\n[FOUNDATIONS \\u00a73 Foundation to law](../FOUNDATIONS.md#foundation-to-law).\\nThe table accounts for \\u00a71 to \\u00a73, \\u00a76 and \\u00a79 to \\u00a711. \\u00a71 Canonical statement\\ndecides nothing of its own: each clause names its owning section. \\u00a78\\nbinds the step of ACTIVATION to this method's terms; its delivery\\npriority is accounted for by family F5 at ACTIVATION \\u00a76, and the rest of\\nit by family F2 at ACTIVATION \\u00a71, whose paragraph after its table names\\nthe rows \\u00a78 applies and the families that trace its statement of the\\nstep's results and its use of the tenant's binding.\\n\\n\", \"coordinates\": null, \"encoding\": \"utf8\", \"parent_sha256\": \"cbf4a10e8d0b4ca2ab4a1f3ee28a85ffedc3298a0fba666949d9b091e82cc714\", \"selected_sha256\": \"cbf4a10e8d0b4ca2ab4a1f3ee28a85ffedc3298a0fba666949d9b091e82cc714\", \"size_bytes\": 84475, \"source\": {\"engine\": \"workspace-regular-file\", \"object\": null, \"path\": \"standards/frames/bootstrap.md\", \"root\": \"method\", \"selector\": null, \"sha256\": \"cbf4a10e8d0b4ca2ab4a1f3ee28a85ffedc3298a0fba666949d9b091e82cc714\"}}}, \"schema\": \"a_c.fd-support.response/1\", \"status\": \"ok\"}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"The pinned STDO installation verifies successfully. I’ve read all twelve shared requirements and scenarios. I’m building one `stdo-work` skill with focused references for tool use, delegation, recovery and installation, while preserving the direct Writer path for small authorized tasks.\n\n"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport json, subprocess, pathlib, hashlib, sys, time\nargv=json.loads(\\\"[\\\\\\\"/opt/homebrew/Cellar/python@3.13/3.13.7/Frameworks/Python.framework/Versions/3.13/bin/python3.13\\\\\\\",\\\\\\\"-B\\\\\\\",\\\\\\\"/Users/jim/src/apps/specification_methodology-skills/a_c/build_tenants/graphify/code/ac_support.py\\\\\\\",\\\\\\\"--policy\\\\\\\",\\\\\\\"/Users/jim/src/apps/specification_methodology-skills/stdo_skills/.ai-workspace/work/T001/operator/successor-1/codex/worker-policy.json\\\\\\\",\\\\\\\"--policy-sha256\\\\\\\",\\\\\\\"038f1b1fdd56d0860dbfc94a0a17ff28e98e41153f6774cf4dc5ff7658d425b9\\\\\\\",\\\\\\\"--principal\\\\\\\",\\\\\\\"codex\\\\\\\",\\\\\\\"call\\\\\\\",\\\\\\\"--request\\\\\\\",\\\\\\\"-\\\\\\\"]\\\")\ntask=json.loads(\\\"{\\\\\\\"engine\\\\\\\":\\\\\\\"workspace-regular-file\\\\\\\",\\\\\\\"root\\\\\\\":\\\\\\\"successor\\\\\\\",\\\\\\\"path\\\\\\\":\\\\\\\"codex/TASK.md\\\\\\\",\\\\\\\"object\\\\\\\":null,\\\\\\\"sha256\\\\\\\":\\\\\\\"4c33deea408deef15ac9900f66d5986b06efefb94de40697cf249d536770845b\\\\\\\",\\\\\\\"selector\\\\\\\":null}\\\")\nroot=pathlib.Path(\\\"/Users/jim/src/apps/specification_methodology-skills/stdo_skills\\\")\ndef call(op,args,rid):\n r=subprocess.run(argv,input=json.dumps({\\\"schema\\\":\\\"a_c.fd-support.request/1\\\",\\\"id\\\":rid,\\\"operation\\\":op,\\\"arguments\\\":args}),text=True,capture_output=True)\n if r.returncode or r.stderr:\n  print(json.dumps({\\\"transport_exit\\\":r.returncode,\\\"stderr\\\":r.stderr}),flush=True)\n result=json.loads(r.stdout)\n if result[\\\"status\\\"]\"'!=\"ok\":\n  print(json.dumps(result),flush=True); raise SystemExit(\"Required public operation failed; no retry\")\n return result\n\ndef write(rel,content,rid):\n p=root/rel\n allowed=[root/\"build_tenants/codex\",root/\".ai-workspace/work/T001/codex/actor/successor-1\"]\n if not any(p.is_relative_to(a) for a in allowed) or \"..\" in pathlib.PurePath(rel).parts: raise SystemExit(\"territory escape\")\n for ancestor in [p,*p.parents]:\n  if ancestor.is_symlink(): raise SystemExit(\"symlink refused: \"+str(ancestor))\n p.parent.mkdir(parents=True,exist_ok=True)\n before=call(\"workspace.observe\",{\"scope\":[{\"root\":\"product\",\"path\":str(p.parent.relative_to(root)),\"kind\":\"directory\"}]},rid+\"-observe\")\n pre=hashlib.sha256(p.read_bytes()).hexdigest() if p.exists() else None\n target={\"engine\":\"workspace-regular-file\",\"root\":\"product\",\"path\":rel,\"object\":None,\"sha256\":pre,\"selector\":None}\n result=call(\"work.write\",{\"grant_id\":\"urn:stdo-skills:T001:codex:construction:2\",\"target\":target,\"mode\":\"replace\",\"record\":{\"text\":content,\"provenance\":task},\"interpretation\":None,\"observations\":[before[\"result\"][\"artifact\"]]},rid)\n print(json.dumps({\"path\":rel,\"observation\":before[\"result\"][\"artifact\"],\"response\":result}),flush=True)\n return result\nwrite(\"build_tenants/codex/design/DESIGN.md\",json.loads(\"'\"\\\\\\\"# Codex tenant design — T001 successor 1\\\\\\\\n\\\\\\\\nRecorded before implementation. Scope: build_tenants/codex and .ai-workspace/work/T001/codex/actor/successor-1 only; construction authority is successor codex/TASK.md SHA256 4c33deea408deef15ac9900f66d5986b06efefb94de40697cf249d536770845b, grant urn:stdo-skills:T001:codex:construction:2. No Product acceptance, publication or installation is claimed.\\\\\\\\n\\\\\\\\n## Basis and source ownership\\\\\\\\n\\\\\\\\nSTDO Skills common inventory a6d348b8385ea453ce29362fb9d74559304b1b91743b3c9ea31a83a9f02b5f2d governs this candidate. STDO stdo://releases/v3.0.1-rc.1/ manifest 60356364a412dbde8cffe68fe0eda4e2749b0162acce93495534eee13b223df8 owns the method. Its installed basis was verified by stdo status --definition stdo_skills.json --verify on 2026-10-25. The discovery channel does not select a newer basis.\\\\\\\\n\\\\\\\\nRequirements SHA256 dcc2564e597d3d3c8fcff025a515f4a92a62e7f3aa2f7ba80af97f7db75f6acc and scenarios SHA256 089221fb9d7eee532f91c6ef40a4bfdaaa18c00fcc28bc2f538ddd6b6e3ff03e remain common external authority. The frame basis SHA256 00a91bb5a16ba8802cb2d3132c08677c978f3ef50d4e6c61d864c5afdb960baa is selected by this activation for construction, not accepted by this Worker. Method routing comes from specification/SOURCE_OWNERS.md SHA256 15300e9871b842cb6ab81b360fe9717766638e82abc2d1cf06c5cebc2febfca3. Installed deciding sections are acquired as needed; no copied methodology is installed.\\\\\\\\n\\\\\\\\n## Algorithm and host binding\\\\\\\\n\\\\\\\\nOne skill, stdo-work, supplies task-based discovery for an already governed workspace and explicit setup requests. Its name and description remain available to Codex; automatic invocation stays enabled by omitting any disabling policy. Only the entrypoint and the relevant reference are acquired. References are packaged inside the skill, so copying the complete directory preserves their links.\\\\\\\\n\\\\\\\\n| Requirements | Algorithm | Codex or tool mechanism | Finite proof |\\\\\\\\n|---|---|---|---|\\\\\\\\n| SK-01 | Route relevant task, ignore unrelated task, distinguish discovery from execution | SKILL.md frontmatter; repository .agents/skills/stdo-work; explicit \"'$stdo-work | Q01, Q02, Q12 |'\"\\\\\\\\n| SK-02 | Select one Product, verify exact installed basis, acquire bootstrap and deciding owner | stdo status --definition PATH --verify; public source.read with exact SourceRefs | Q03 |\\\\\\\\n| SK-03 | Reuse sufficient authority; choose direct Writer for a sufficient small effect; coordinate only on material boundary | Codex reasoning over acquired contract; host actors only where selected and admitted | Q04, Q05 |\\\\\\\\n| SK-04 | Discover exact schemas, call required operation, retain actual response and effect evidence | ordinary public a_c CLI, complete JSON envelope on stdin; MCP optional | Q01, Q06, Q08 |\\\\\\\\n| SK-05 | Preserve smallest deciding causal context including retained obligations and differing histories | exact SourceRefs, context.assemble when selected; activation carrier | Q05, Q07 |\\\\\\\\n| SK-06 | Bind child outcome, basis, territory, proof, consumer and stop; consume closed return before next activation | configured contract.preflight, dispatch.start/observe and return.capture/check where admitted; no invented tool | Q04, Q05 |\\\\\\\\n| SK-07 | Derive expected behavior from source before exact candidate; retain exposure and family limits | review.prepare where selected; fresh separately admitted reviewer; source.read | Q05, Q09 |\\\\\\\\n| SK-08 | Reacquire current evidence, reconcile uncertain effects before retry, retain unaffected evidence | workspace.observe, source.read, evidence.read, granted recovery path | Q07-Q10 |\\\\\\\\n| SK-09 | Separate candidate availability, assessment, consumer disposition, acceptance | declared closed return schema, original basis, explicit residuals and not_performed | Q06, Q09, Q10 |\\\\\\\\n| SK-10 | Prepare exact immutable candidate; act only on authorized release destination; scoped package install/update/remove | selected release tool discovered from its contract; file-copy deployment only with corresponding grant | Q11, Q12 |\\\\\\\\n| SK-11 | Package references together; inventory exact content; retain previous identity on update | read-only package verifier; owned-directory installation recipe | Q12 |\\\\\\\\n| SK-12 | Freeze substantive tasks and independent oracle, preserve every attempt and unknown costs | qualification plan and actual host traces, not keyword success grading | Q01-Q12 |\\\\\\\\n\\\\\\\\nCodex mechanics are independently sourced in operator codex/HOST.md SHA256 6f940ea5514cf8ea3e0b359adbb0337d3ff020c414aca54c502befab9665213e: codex-cli 0.164.0, repository-local .agents/skills discovery, explicit \"'$skill-name, relative references, restart when discovery is stale. Configured model/effort gpt-6-astra/max is inherited; actual resolution is unknown unless the run records it. No nested actor is launched in this construction.'\"\\\\\\\\n\\\\\\\\n## Tool boundary and failure behavior\\\\\\\\n\\\\\\\\nNative method profile urn:a-c:fd-support:method:stdo-3.0.1-rc.1:executive:1 SHA256 a886047e50b8a45c3b47addea0f0809dca2a6c54ac35948df5e01893cc30bbf7 is selected. tools.describe reports provisional construction support, not qualification. Its builder identity v2.5.1-rc.2 is distinct from this selected operation binding. There is no supported native results.conjoin. Executive consumption is F_P under its granted relation; any decision must preserve required predicates, applicability, incompatible bases and unresolved contradictions.\\\\\\\\n\\\\\\\\nHost reads, SHA256 computation and static package checks are declared auxiliary mechanics. They establish byte/structure facts only and never replace required source.read, workspace.observe, work.write, admission or assessment results. All current construction deliverables are written with work.write, own observation and exact preimage; postimage and OperationEvidence are then read. Unknown completion stops dependent writing pending reconciliation.\\\\\\\\n\\\\\\\\nA failed required operation withholds its dependent claim. Independent work can continue under its existing grant. No automatic retries, authorization renewal or publication follow from successful transport. A missing installation or ambiguous Product is a basis problem, not a request to adopt latest. An unperformed assessment has no core result; performed inconclusive assessment is indeterminate; construction without an output is incomplete for candidate availability.\\\\\\\\n\\\\\\\\n## Installation and qualification\\\\\\\\n\\\\\\\\nREADME supplies a repository-local, single-directory copy recipe and explicit update/removal custody checks. No installer mutates host configuration implicitly. A read-only verifier checks packaged resources and optional observed inventory. It does not assess instruction semantics or host discovery.\\\\\\\\n\\\\\\\\nQ01-Q12 actual host trials, source-first independent assessment, release and owner acceptance remain unperformed here. The qualification plan keeps each case/lane visible and preserves failures. Static checks support only packaging integrity; they do not justify automatic-selection reliability or efficiency claims.\\\\\\\\n\\\\\\\\n## Successor construction decisions\\\\\\\\n\\\\\\\\nThe earlier text was a refused proposal, not an adopted design. HISTORY.json retains that failure and does not prove universal external-effect absence. This new activation authorizes scoped ordinary mkdir and the repaired public CLI. This design is written before implementation under that new grant. The current Worker reran the manager verification successfully and acquired all common deciding sources through public source.read.\\\\\\\\n\\\\\\\\nDeliver one stdo-work/SKILL.md with references/basis.md, tools.md, delegation.md, recovery.md, release-install.md and qualification.md. A package-local source-routes.json preserves exact source locators without copying the method. The tenant README carries installation commands; tests/verify_package.py performs only read-only finite metadata, contained-path, resource and inventory checks. inventory.json freezes all tenant regular files except itself; its own digest is returned separately. Assessment/transition records stay in the actor territory so the assessed package remains frozen. Every artifact content uses work.write after current containing-directory observation; allowed host mkdir checks every ancestor for symlinks. No peer or global effects, nested model calls or installation happen in this construction.\\\\\\\\n\\\\\\\\nThe skill uses the host mechanics acquired from HOST.md and local skill-authoring guidance. These establish documented instruction paths only. The declared 0.164.0 host remains the qualification target; automatic discovery, explicit invocation, model resolution and installation behavior require actual later trials. Existing tool responses establish supported schemas and narrow operation output, not automatic semantic acceptance. The public tools.describe response and all writes retain OperationEvidence. Required operation failure stops its dependent branch with the actual cause.\\\\\\\\n\\\\\\\"\\\"),\\\"codex-s1-design\\\")\n\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport json, subprocess, pathlib, hashlib, sys, time\nargv=json.loads(\\\"[\\\\\\\"/opt/homebrew/Cellar/python@3.13/3.13.7/Frameworks/Python.framework/Versions/3.13/bin/python3.13\\\\\\\",\\\\\\\"-B\\\\\\\",\\\\\\\"/Users/jim/src/apps/specification_methodology-skills/a_c/build_tenants/graphify/code/ac_support.py\\\\\\\",\\\\\\\"--policy\\\\\\\",\\\\\\\"/Users/jim/src/apps/specification_methodology-skills/stdo_skills/.ai-workspace/work/T001/operator/successor-1/codex/worker-policy.json\\\\\\\",\\\\\\\"--policy-sha256\\\\\\\",\\\\\\\"038f1b1fdd56d0860dbfc94a0a17ff28e98e41153f6774cf4dc5ff7658d425b9\\\\\\\",\\\\\\\"--principal\\\\\\\",\\\\\\\"codex\\\\\\\",\\\\\\\"call\\\\\\\",\\\\\\\"--request\\\\\\\",\\\\\\\"-\\\\\\\"]\\\")\ntask=json.loads(\\\"{\\\\\\\"engine\\\\\\\":\\\\\\\"workspace-regular-file\\\\\\\",\\\\\\\"root\\\\\\\":\\\\\\\"successor\\\\\\\",\\\\\\\"path\\\\\\\":\\\\\\\"codex/TASK.md\\\\\\\",\\\\\\\"object\\\\\\\":null,\\\\\\\"sha256\\\\\\\":\\\\\\\"4c33deea408deef15ac9900f66d5986b06efefb94de40697cf249d536770845b\\\\\\\",\\\\\\\"selector\\\\\\\":null}\\\")\nroot=pathlib.Path(\\\"/Users/jim/src/apps/specification_methodology-skills/stdo_skills\\\")\ndef call(op,args,rid):\n r=subprocess.run(argv,input=json.dumps({\\\"schema\\\":\\\"a_c.fd-support.request/1\\\",\\\"id\\\":rid,\\\"operation\\\":op,\\\"arguments\\\":args}),text=True,capture_output=True)\n if r.returncode or r.stderr:\n  print(json.dumps({\\\"transport_exit\\\":r.returncode,\\\"stderr\\\":r.stderr}),flush=True)\n result=json.loads(r.stdout)\n if result[\\\"status\\\"]\"'!=\"ok\":\n  print(json.dumps(result),flush=True); raise SystemExit(\"Required public operation failed; no retry\")\n return result\n\ndef write(rel,content,rid):\n p=root/rel\n allowed=[root/\"build_tenants/codex\",root/\".ai-workspace/work/T001/codex/actor/successor-1\"]\n if not any(p.is_relative_to(a) for a in allowed) or \"..\" in pathlib.PurePath(rel).parts: raise SystemExit(\"territory escape\")\n for ancestor in [p,*p.parents]:\n  if ancestor.is_symlink(): raise SystemExit(\"symlink refused: \"+str(ancestor))\n p.parent.mkdir(parents=True,exist_ok=True)\n before=call(\"workspace.observe\",{\"scope\":[{\"root\":\"product\",\"path\":str(p.parent.relative_to(root)),\"kind\":\"directory\"}]},rid+\"-observe\")\n pre=hashlib.sha256(p.read_bytes()).hexdigest() if p.exists() else None\n target={\"engine\":\"workspace-regular-file\",\"root\":\"product\",\"path\":rel,\"object\":None,\"sha256\":pre,\"selector\":None}\n result=call(\"work.write\",{\"grant_id\":\"urn:stdo-skills:T001:codex:construction:2\",\"target\":target,\"mode\":\"replace\",\"record\":{\"text\":content,\"provenance\":task},\"interpretation\":None,\"observations\":[before[\"result\"][\"artifact\"]]},rid)\n print(json.dumps({\"path\":rel,\"observation\":before[\"result\"][\"artifact\"],\"response\":result}),flush=True)\n return result\nwrite(\"build_tenants/codex/design/DESIGN.md\",json.loads(\"'\"\\\\\\\"# Codex tenant design — T001 successor 1\\\\\\\\n\\\\\\\\nRecorded before implementation. Scope: build_tenants/codex and .ai-workspace/work/T001/codex/actor/successor-1 only; construction authority is successor codex/TASK.md SHA256 4c33deea408deef15ac9900f66d5986b06efefb94de40697cf249d536770845b, grant urn:stdo-skills:T001:codex:construction:2. No Product acceptance, publication or installation is claimed.\\\\\\\\n\\\\\\\\n## Basis and source ownership\\\\\\\\n\\\\\\\\nSTDO Skills common inventory a6d348b8385ea453ce29362fb9d74559304b1b91743b3c9ea31a83a9f02b5f2d governs this candidate. STDO stdo://releases/v3.0.1-rc.1/ manifest 60356364a412dbde8cffe68fe0eda4e2749b0162acce93495534eee13b223df8 owns the method. Its installed basis was verified by stdo status --definition stdo_skills.json --verify on 2026-10-25. The discovery channel does not select a newer basis.\\\\\\\\n\\\\\\\\nRequirements SHA256 dcc2564e597d3d3c8fcff025a515f4a92a62e7f3aa2f7ba80af97f7db75f6acc and scenarios SHA256 089221fb9d7eee532f91c6ef40a4bfdaaa18c00fcc28bc2f538ddd6b6e3ff03e remain common external authority. The frame basis SHA256 00a91bb5a16ba8802cb2d3132c08677c978f3ef50d4e6c61d864c5afdb960baa is selected by this activation for construction, not accepted by this Worker. Method routing comes from specification/SOURCE_OWNERS.md SHA256 15300e9871b842cb6ab81b360fe9717766638e82abc2d1cf06c5cebc2febfca3. Installed deciding sections are acquired as needed; no copied methodology is installed.\\\\\\\\n\\\\\\\\n## Algorithm and host binding\\\\\\\\n\\\\\\\\nOne skill, stdo-work, supplies task-based discovery for an already governed workspace and explicit setup requests. Its name and description remain available to Codex; automatic invocation stays enabled by omitting any disabling policy. Only the entrypoint and the relevant reference are acquired. References are packaged inside the skill, so copying the complete directory preserves their links.\\\\\\\\n\\\\\\\\n| Requirements | Algorithm | Codex or tool mechanism | Finite proof |\\\\\\\\n|---|---|---|---|\\\\\\\\n| SK-01 | Route relevant task, ignore unrelated task, distinguish discovery from execution | SKILL.md frontmatter; repository .agents/skills/stdo-work; explicit \"'$stdo-work | Q01, Q02, Q12 |'\"\\\\\\\\n| SK-02 | Select one Product, verify exact installed basis, acquire bootstrap and deciding owner | stdo status --definition PATH --verify; public source.read with exact SourceRefs | Q03 |\\\\\\\\n| SK-03 | Reuse sufficient authority; choose direct Writer for a sufficient small effect; coordinate only on material boundary | Codex reasoning over acquired contract; host actors only where selected and admitted | Q04, Q05 |\\\\\\\\n| SK-04 | Discover exact schemas, call required operation, retain actual response and effect evidence | ordinary public a_c CLI, complete JSON envelope on stdin; MCP optional | Q01, Q06, Q08 |\\\\\\\\n| SK-05 | Preserve smallest deciding causal context including retained obligations and differing histories | exact SourceRefs, context.assemble when selected; activation carrier | Q05, Q07 |\\\\\\\\n| SK-06 | Bind child outcome, basis, territory, proof, consumer and stop; consume closed return before next activation | configured contract.preflight, dispatch.start/observe and return.capture/check where admitted; no invented tool | Q04, Q05 |\\\\\\\\n| SK-07 | Derive expected behavior from source before exact candidate; retain exposure and family limits | review.prepare where selected; fresh separately admitted reviewer; source.read | Q05, Q09 |\\\\\\\\n| SK-08 | Reacquire current evidence, reconcile uncertain effects before retry, retain unaffected evidence | workspace.observe, source.read, evidence.read, granted recovery path | Q07-Q10 |\\\\\\\\n| SK-09 | Separate candidate availability, assessment, consumer disposition, acceptance | declared closed return schema, original basis, explicit residuals and not_performed | Q06, Q09, Q10 |\\\\\\\\n| SK-10 | Prepare exact immutable candidate; act only on authorized release destination; scoped package install/update/remove | selected release tool discovered from its contract; file-copy deployment only with corresponding grant | Q11, Q12 |\\\\\\\\n| SK-11 | Package references together; inventory exact content; retain previous identity on update | read-only package verifier; owned-directory installation recipe | Q12 |\\\\\\\\n| SK-12 | Freeze substantive tasks and independent oracle, preserve every attempt and unknown costs | qualification plan and actual host traces, not keyword success grading | Q01-Q12 |\\\\\\\\n\\\\\\\\nCodex mechanics are independently sourced in operator codex/HOST.md SHA256 6f940ea5514cf8ea3e0b359adbb0337d3ff020c414aca54c502befab9665213e: codex-cli 0.164.0, repository-local .agents/skills discovery, explicit \"'$skill-name, relative references, restart when discovery is stale. Configured model/effort gpt-6-astra/max is inherited; actual resolution is unknown unless the run records it. No nested actor is launched in this construction.'\"\\\\\\\\n\\\\\\\\n## Tool boundary and failure behavior\\\\\\\\n\\\\\\\\nNative method profile urn:a-c:fd-support:method:stdo-3.0.1-rc.1:executive:1 SHA256 a886047e50b8a45c3b47addea0f0809dca2a6c54ac35948df5e01893cc30bbf7 is selected. tools.describe reports provisional construction support, not qualification. Its builder identity v2.5.1-rc.2 is distinct from this selected operation binding. There is no supported native results.conjoin. Executive consumption is F_P under its granted relation; any decision must preserve required predicates, applicability, incompatible bases and unresolved contradictions.\\\\\\\\n\\\\\\\\nHost reads, SHA256 computation and static package checks are declared auxiliary mechanics. They establish byte/structure facts only and never replace required source.read, workspace.observe, work.write, admission or assessment results. All current construction deliverables are written with work.write, own observation and exact preimage; postimage and OperationEvidence are then read. Unknown completion stops dependent writing pending reconciliation.\\\\\\\\n\\\\\\\\nA failed required operation withholds its dependent claim. Independent work can continue under its existing grant. No automatic retries, authorization renewal or publication follow from successful transport. A missing installation or ambiguous Product is a basis problem, not a request to adopt latest. An unperformed assessment has no core result; performed inconclusive assessment is indeterminate; construction without an output is incomplete for candidate availability.\\\\\\\\n\\\\\\\\n## Installation and qualification\\\\\\\\n\\\\\\\\nREADME supplies a repository-local, single-directory copy recipe and explicit update/removal custody checks. No installer mutates host configuration implicitly. A read-only verifier checks packaged resources and optional observed inventory. It does not assess instruction semantics or host discovery.\\\\\\\\n\\\\\\\\nQ01-Q12 actual host trials, source-first independent assessment, release and owner acceptance remain unperformed here. The qualification plan keeps each case/lane visible and preserves failures. Static checks support only packaging integrity; they do not justify automatic-selection reliability or efficiency claims.\\\\\\\\n\\\\\\\\n## Successor construction decisions\\\\\\\\n\\\\\\\\nThe earlier text was a refused proposal, not an adopted design. HISTORY.json retains that failure and does not prove universal external-effect absence. This new activation authorizes scoped ordinary mkdir and the repaired public CLI. This design is written before implementation under that new grant. The current Worker reran the manager verification successfully and acquired all common deciding sources through public source.read.\\\\\\\\n\\\\\\\\nDeliver one stdo-work/SKILL.md with references/basis.md, tools.md, delegation.md, recovery.md, release-install.md and qualification.md. A package-local source-routes.json preserves exact source locators without copying the method. The tenant README carries installation commands; tests/verify_package.py performs only read-only finite metadata, contained-path, resource and inventory checks. inventory.json freezes all tenant regular files except itself; its own digest is returned separately. Assessment/transition records stay in the actor territory so the assessed package remains frozen. Every artifact content uses work.write after current containing-directory observation; allowed host mkdir checks every ancestor for symlinks. No peer or global effects, nested model calls or installation happen in this construction.\\\\\\\\n\\\\\\\\nThe skill uses the host mechanics acquired from HOST.md and local skill-authoring guidance. These establish documented instruction paths only. The declared 0.164.0 host remains the qualification target; automatic discovery, explicit invocation, model resolution and installation behavior require actual later trials. Existing tool responses establish supported schemas and narrow operation output, not automatic semantic acceptance. The public tools.describe response and all writes retain OperationEvidence. Required operation failure stops its dependent branch with the actual cause.\\\\\\\\n\\\\\\\"\\\"),\\\"codex-s1-design\\\")\n\nPY\"","aggregated_output":"{\"path\": \"build_tenants/codex/design/DESIGN.md\", \"observation\": {\"id\": \"sha256:9ede70e8926d1eed3bc06a6ef874031a5e375bc5c13c2a2c3bd12ba5edae377f\", \"sha256\": \"9ede70e8926d1eed3bc06a6ef874031a5e375bc5c13c2a2c3bd12ba5edae377f\"}, \"response\": {\"evidence\": {\"id\": \"sha256:60730135ae38ab4d6dfa61735190d64d74f77f0e3b94531d39e10e69708b7223\", \"sha256\": \"60730135ae38ab4d6dfa61735190d64d74f77f0e3b94531d39e10e69708b7223\"}, \"id\": \"codex-s1-design\", \"operation\": \"work.write\", \"operation_outcome\": {\"cause\": \"declared output available\", \"core_value\": \"satisfied\", \"evidence\": [], \"limits\": [\"output availability only; no semantic acceptance\"], \"predicate\": \"B(work.write): declared exact output/effect-evidence payload availability on the requested basis\", \"source_parent\": {\"clause\": \"results\", \"member\": \"FOUNDATIONS.md\", \"sha256\": \"92fe2f3c09a59b4e9a732463a41d4a45d7efd693648159621e03c75f7127eac5\"}, \"value\": \"returned\"}, \"refusal\": null, \"result\": {\"artifact\": {\"id\": \"sha256:dfee05792ae6147b4614eae72b613e9c868013b9eea8de5e23479eb27cb980c1\", \"sha256\": \"dfee05792ae6147b4614eae72b613e9c868013b9eea8de5e23479eb27cb980c1\"}, \"value\": {\"effect\": {\"core_value\": \"satisfied\", \"end_established\": true, \"observed_interval\": {\"clock\": \"unix_ns\", \"ended_ns\": 1792893986484533000, \"started_ns\": 1792893986484094000}, \"scope\": \"one qualified atomic target-file publication\", \"value\": \"completed\"}, \"grant_id\": \"urn:stdo-skills:T001:codex:construction:2\", \"intent\": {\"id\": \"sha256:0da35eda