": \"evidence.read\"}, \"schema\": {\"const\": \"a_c.fd-support.request/1\"}}, \"required\": [\"schema\", \"id\", \"operation\", \"arguments\"], \"type\": \"object\"}}\n{\"name\": \"tools.describe\", \"input_schema\": {\"$defs\": {\"Id\": {\"minLength\": 1, \"type\": \"string\"}, \"Identity\": {\"additionalProperties\": false, \"properties\": {\"id\": {\"$ref\": \"#/$defs/Id\"}, \"sha256\": {\"$ref\": \"#/$defs/Sha256\"}}, \"required\": [\"id\", \"sha256\"], \"type\": \"object\"}, \"Sha256\": {\"pattern\": \"^[0-9a-f]{64}$\", \"type\": \"string\"}}, \"additionalProperties\": false, \"properties\": {\"arguments\": {\"additionalProperties\": false, \"properties\": {\"method_profile\": {\"$ref\": \"#/$defs/Identity\"}, \"operation\": {\"$ref\": \"#/$defs/Id\"}}, \"required\": [], \"type\": \"object\"}, \"id\": {\"$ref\": \"#/$defs/Id\"}, \"operation\": {\"const\": \"tools.describe\"}, \"schema\": {\"const\": \"a_c.fd-support.request/1\"}}, \"required\": [\"schema\", \"id\", \"operation\", \"arguments\"], \"type\": \"object\"}}\n{\"name\": \"work.write\", \"input_schema\": {\"$defs\": {\"ArtifactRef\": {\"additionalProperties\": false, \"properties\": {\"id\": {\"pattern\": \"^sha256:[0-9a-f]{64}$\", \"type\": \"string\"}, \"sha256\": {\"$ref\": \"#/$defs/Sha256\"}}, \"required\": [\"id\", \"sha256\"], \"type\": \"object\"}, \"Id\": {\"minLength\": 1, \"type\": \"string\"}, \"JsonPointer\": {\"pattern\": \"^(?:/(?:[^~]|~[01])*)*$\", \"type\": \"string\"}, \"Sha256\": {\"pattern\": \"^[0-9a-f]{64}$\", \"type\": \"string\"}, \"SourceRef\": {\"additionalProperties\": false, \"properties\": {\"engine\": {\"enum\": [\"workspace-regular-file\", \"immutable-git-blob\", \"retained-evidence\"]}, \"object\": {\"oneOf\": [{\"type\": \"null\"}, {\"pattern\": \"^(?:[0-9a-f]{40}|[0-9a-f]{64})$\", \"type\": \"string\"}]}, \"path\": {\"$ref\": \"#/$defs/Id\"}, \"root\": {\"$ref\": \"#/$defs/Id\"}, \"selector\": {\"oneOf\": [{\"type\": \"null\"}, {\"additionalProperties\": false, \"properties\": {\"lines\": {\"items\": false, \"maxItems\": 2, \"minItems\": 2, \"prefixItems\": [{\"minimum\": 1, \"type\": \"integer\"}, {\"minimum\": 1, \"type\": \"integer\"}], \"type\": \"array\"}}, \"required\": [\"lines\"], \"type\": \"object\"}, {\"additionalProperties\": false, \"properties\": {\"json_pointer\": {\"$ref\": \"#/$defs/JsonPointer\"}}, \"required\": [\"json_pointer\"], \"type\": \"object\"}]}, \"sha256\": {\"$ref\": \"#/$defs/Sha256\"}}, \"required\": [\"engine\", \"root\", \"path\", \"object\", \"sha256\", \"selector\"], \"type\": \"object\"}}, \"additionalProperties\": false, \"properties\": {\"arguments\": {\"additionalProperties\": false, \"properties\": {\"grant_id\": {\"$ref\": \"#/$defs/Id\"}, \"interpretation\": {\"oneOf\": [{\"type\": \"null\"}, {\"additionalProperties\": false, \"properties\": {\"author\": {\"$ref\": \"#/$defs/SourceRef\"}, \"text\": {\"type\": \"string\"}}, \"required\": [\"text\", \"author\"], \"type\": \"object\"}]}, \"mode\": {\"enum\": [\"append\", \"replace\"]}, \"observations\": {\"items\": {\"$ref\": \"#/$defs/ArtifactRef\"}, \"type\": \"array\"}, \"record\": {\"additionalProperties\": false, \"properties\": {\"provenance\": {\"$ref\": \"#/$defs/SourceRef\"}, \"text\": {\"type\": \"string\"}}, \"required\": [\"text\", \"provenance\"], \"type\": \"object\"}, \"target\": {\"additionalProperties\": false, \"properties\": {\"engine\": {\"enum\": [\"workspace-regular-file\", \"immutable-git-blob\", \"retained-evidence\"]}, \"object\": {\"oneOf\": [{\"type\": \"null\"}, {\"pattern\": \"^(?:[0-9a-f]{40}|[0-9a-f]{64})$\", \"type\": \"string\"}]}, \"path\": {\"$ref\": \"#/$defs/Id\"}, \"root\": {\"$ref\": \"#/$defs/Id\"}, \"selector\": {\"oneOf\": [{\"type\": \"null\"}, {\"additionalProperties\": false, \"properties\": {\"lines\": {\"items\": false, \"maxItems\": 2, \"minItems\": 2, \"prefixItems\": [{\"minimum\": 1, \"type\": \"integer\"}, {\"minimum\": 1, \"type\": \"integer\"}], \"type\": \"array\"}}, \"required\": [\"lines\"], \"type\": \"object\"}, {\"additionalProperties\": false, \"properties\": {\"json_pointer\": {\"$ref\": \"#/$defs/JsonPointer\"}}, \"required\": [\"json_pointer\"], \"type\": \"object\"}]}, \"sha256\": {\"oneOf\": [{\"type\": \"null\"}, {\"$ref\": \"#/$defs/Sha256\"}]}}, \"required\": [\"engine\", \"root\", \"path\", \"object\", \"sha256\", \"selector\"], \"type\": \"object\"}}, \"required\": [\"grant_id\", \"target\", \"mode\", \"record\", \"interpretation\", \"observations\"], \"type\": \"object\"}, \"id\": {\"$ref\": \"#/$defs/Id\"}, \"operation\": {\"const\": \"work.write\"}, \"schema\": {\"const\": \"a_c.fd-support.request/1\"}}, \"required\": [\"schema\", \"id\", \"operation\", \"arguments\"], \"type\": \"object\"}}\n{\"name\": \"workspace.observe\", \"input_schema\": {\"$defs\": {\"ArtifactRef\": {\"additionalProperties\": false, \"properties\": {\"id\": {\"pattern\": \"^sha256:[0-9a-f]{64}$\", \"type\": \"string\"}, \"sha256\": {\"$ref\": \"#/$defs/Sha256\"}}, \"required\": [\"id\", \"sha256\"], \"type\": \"object\"}, \"Id\": {\"minLength\": 1, \"type\": \"string\"}, \"Sha256\": {\"pattern\": \"^[0-9a-f]{64}$\", \"type\": \"string\"}}, \"additionalProperties\": false, \"properties\": {\"arguments\": {\"additionalProperties\": false, \"properties\": {\"previous\": {\"$ref\": \"#/$defs/ArtifactRef\"}, \"scope\": {\"items\": {\"additionalProperties\": false, \"properties\": {\"kind\": {\"enum\": [\"file\", \"directory\"]}, \"path\": {\"$ref\": \"#/$defs/Id\"}, \"root\": {\"$ref\": \"#/$defs/Id\"}}, \"required\": [\"root\", \"path\", \"kind\"], \"type\": \"object\"}, \"type\": \"array\"}}, \"required\": [\"scope\"], \"type\": \"object\"}, \"id\": {\"$ref\": \"#/$defs/Id\"}, \"operation\": {\"const\": \"workspace.observe\"}, \"schema\": {\"const\": \"a_c.fd-support.request/1\"}}, \"required\": [\"schema\", \"id\", \"operation\", \"arguments\"], \"type\": \"object\"}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'cat AGENTS.md README.md specification/GOALS.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'cat AGENTS.md README.md specification/GOALS.md'","aggregated_output":"# STDO Skills bootstrap\n\nSelect `stdo_skills.json`, verify its exact installed basis with `stdo status\n--definition stdo_skills.json --verify`, and read the declared bootstrap and\ndeciding owner sections from that installation. The operative cut is STDO\nv3.0.1-rc.1, manifest\n`60356364a412dbde8cffe68fe0eda4e2749b0162acce93495534eee13b223df8`.\nDo not adopt a newer cut from the discovery selector implicitly.\n\nRead README, Intent, Product, Goals, requirements and the current frame-basis\ndisposition. Common WHAT belongs in `specification/`. Codex and Claude are\nindependent HOW tenants, each with its own design and skills. Shared requirements\ndo not require identical prompts, decomposition or host machinery.\n\nThe initial common documents are candidates for Executive construction\ndisposition. Their presence and the Product Definition locator are not evidence\nof acceptance. T-001 records the owner's concrete construction instruction and\nthe current admission/tooling limitation.\n\nExecutive coordinates; it does not mutate. A separately bound Worker/Writer\nperforms exact named effects. Use bounded delegation for material context,\ncapability or independence boundaries. A sufficient small task may use direct\nWriter entry without automatic tickets or independent review. Reviewers acquire\nsource-derived expectations and the exact candidate independently and return\nfindings; they do not implement repairs or decide promotion.\n\nUse the declared supported tool contracts and retain actual responses. Required\ntool failure or an unsupported method binding withholds its dependent claim;\ndo not simulate a passing result or silently bypass the required path. Preserve\nunrelated work and the frozen released methodology. Native tools and actor calls\nare mechanisms, not new admission, acceptance or release authority.\n# STDO Skills\n\nSTDO Skills makes the selected STDO method usable in ordinary agent work through\ntool-backed skills. One shared specification has two independent build tenants:\nCodex and Claude. Each tenant may choose different skill boundaries, instructions,\ncontext mechanisms and host integration while preserving the same requirements.\n\nThis is a construction candidate. The current work is [T-001](.ai-workspace/tickets/active/T-001-skills-dogfood.md).\nRead [Intent](specification/INTENT.md), [Product](specification/PRODUCT.md),\n[Goals](specification/GOALS.md), [requirements](specification/requirements/README.md)\nand the [frame basis](specification/REFERENCE_FRAME_BASIS.md).\n\nThe static methodology is **STDO 3.0.1 RC1**, selected by\n[stdo_skills.json](stdo_skills.json). Its manifest is\n`60356364a412dbde8cffe68fe0eda4e2749b0162acce93495534eee13b223df8`.\nThe discovery selector never substitutes for that operative basis.\n\n```sh\nstdo status --definition stdo_skills.json --verify\n```\n\nSTDO owns methodology; a_c owns computational support tools; this Product owns\nthe agent-facing application of those contracts. Their release and adoption\ndecisions remain separate. Existing installed STDO skills are donor material,\nnot the new tenants' accepted implementation.\n\nCurrent a_c lifecycle tooling has a Claude RC9 method binding. Its support for\n3.0.1 must be established per operation. An honest legacy mechanical acquisition\ncan supply source bytes; it does not establish 3.0.1 lifecycle admission,\nconjunction or semantic qualification. See the\n[tool-binding requirement](specification/requirements/README.md#sk-04-supported-tool-use).\n\nThe initial proof is a matched finite set of realistic tasks on both hosts,\nincluding automatic discovery, explicit invocation, tool failures and recovery.\nPassing metadata checks alone does not show that agents use the tooling.\n# Goals\n\n## Current selection\n\n[T-001](../.ai-workspace/tickets/active/T-001-skills-dogfood.md) constructs the new\nSTDO Skills Product using static released STDO 3.0.1 RC1 and current tooling.\nThe common WHAT is shared; Codex and Claude receive independently designed and\ntuned build tenants. This is the initial practical test of the method on its own\nagent tooling.\n\nCurrent common documents are candidates awaiting Root's exact construction\ndisposition. Bootstrap installed-basis verification is evidence about the basis,\nnot proof of the skills. Tool compatibility assessment is in progress.\n\n## Delivery outcomes\n\n1. Verify the immutable method pin and preserve it throughout construction.\n2. Establish common capabilities, discriminators, frame basis and work authority.\n3. Resolve the tool contracts required by the selected lifecycle paths.\n4. Construct independent Codex and Claude designs and working skill packages.\n5. Exercise matched finite scenarios on actual hosts and inspect actual tool calls.\n6. Obtain independent assessment, repair supported defects and present a bounded\n   delivery result with all remaining limitations.\n\nThe [T-001 ledger](../.ai-workspace/tickets/active/T-001-skills-dogfood.md#execution-plan-and-ledger)\nowns detailed progress. Publication, fleet deployment, global default changes and\ngeneral efficiency claims are outside the initial delivery result.\n","exit_code":0,"status":"completed"}}
