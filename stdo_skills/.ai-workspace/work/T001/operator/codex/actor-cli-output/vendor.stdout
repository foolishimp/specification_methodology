ay\"}},\"required\":[\"mandate\",\"consumed_results\",\"conjunction\",\"disposition_authority\",\"predicate_ids\"],\"type\":\"object\"},\"Id\":{\"minLength\":1,\"type\":\"string\"},\"Identity\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"$ref\":\"#/$defs/Id\"},\"sha256\":{\"$ref\":\"#/$defs/Sha256\"}},\"required\":[\"id\",\"sha256\"],\"type\":\"object\"},\"Interval\":{\"additionalProperties\":false,\"properties\":{\"clock\":{\"const\":\"unix_ns\"},\"ended_ns\":{\"minimum\":0,\"type\":\"integer\"},\"started_ns\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"clock\",\"started_ns\",\"ended_ns\"],\"type\":\"object\"},\"Invalidator\":{\"oneOf\":[{\"$ref\":\"#/$defs/MaterialChange\"},{\"$ref\":\"#/$defs/BasisChange\"},{\"$ref\":\"#/$defs/RevisingObservation\"}]},\"Invalidators\":{\"additionalProperties\":false,\"properties\":{\"declarations_sha256\":{\"$ref\":\"#/$defs/Sha256\"},\"events\":{\"items\":{\"$ref\":\"#/$defs/Invalidator\"},\"type\":\"array\"},\"id\":{\"$ref\":\"#/$defs/Id\"},\"schema\":{\"const\":\"a_c.fd-support.invalidators/1\"}},\"required\":[\"schema\",\"id\",\"declarations_sha256\",\"events\"],\"type\":\"object\"},\"Json\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"boolean\"},{\"type\":\"integer\"},{\"type\":\"string\"},{\"items\":{\"$ref\":\"#/$defs/Json\"},\"type\":\"array\"},{\"additionalProperties\":{\"$ref\":\"#/$defs/Json\"},\"type\":\"object\"}]},\"JsonPointer\":{\"pattern\":\"^(?:/(?:[^~]|~[01])*)*$\",\"type\":\"string\"},\"JudgmentRef\":{\"additionalProperties\":false,\"properties\":{\"pointer\":{\"$ref\":\"#/$defs/JsonPointer\"},\"record\":{\"$ref\":\"#/$defs/ArtifactRef\"}},\"required\":[\"record\",\"pointer\"],\"type\":\"object\"},\"MaterialChange\":{\"additionalProperties\":false,\"properties\":{\"current\":{\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/SourceRef\"}]},\"evidence\":{\"items\":{\"$ref\":\"#/$defs/ArtifactRef\"},\"type\":\"array\"},\"id\":{\"$ref\":\"#/$defs/Id\"},\"kind\":{\"const\":\"material_input_