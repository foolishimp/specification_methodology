profile\":{\"engine\":\"workspace-regular-file\",\"object\":null,\"path\":\"build_tenants/graphify/design/fd-method-stdo-3.0.1.json\",\"root\":\"tool\",\"selector\":null,\"sha256\":\"a886047e50b8a45c3b47addea0f0809dca2a6c54ac35948df5e01893cc30bbf7\"},\"policy_sha256\":\"6c73ef4eff91f018a79fa5edba57fb6e788d609c4c95e3905059c0a22db9349c\",\"product_definition\":{\"engine\":\"workspace-regular-file\",\"object\":null,\"path\":\"stdo_skills.json\",\"root\":\"product\",\"selector\":null,\"sha256\":\"f0756603b937d0cb0b6c6f2e528c0783f5c8da024ac79aa537d416496bd297d5\"}},\"diff\":[],\"entries\":[{\"exists\":false,\"path\":\".ai-workspace/work/T001/codex/actor\",\"root\":\"product\",\"sha256\":null,\"size\":null,\"type\":\"absent\"},{\"exists\":false,\"path\":\"build_tenants/codex\",\"root\":\"product\",\"sha256\":null,\"size\":null,\"type\":\"absent\"}],\"gaps\":[],\"git\":null,\"observed_interval\":{\"clock\":\"unix_ns\",\"ended_ns\":1792892664211340000,\"started_ns\":1792892664210843000},\"schema\":\"a_c.fd-support.observation/1\",\"scope\":[{\"kind\":\"directory\",\"path\":\"build_tenants/codex\",\"root\":\"product\"},{\"kind\":\"directory\",\"path\":\".ai-workspace/work/T001/codex/actor\",\"root\":\"product\"}]}},\"schema\":\"a_c.fd-support.response/1\",\"status\":\"ok\"}\n","exit_code":0,"status":"completed"}}
