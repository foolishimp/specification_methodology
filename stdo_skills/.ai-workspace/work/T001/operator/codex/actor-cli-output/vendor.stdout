t\\\": null,\\n    \\\"path\\\": \\\"codex/TASK.md\\\",\\n    \\\"root\\\": \\\"operator\\\",\\n    \\\"selector\\\": null,\\n    \\\"sha256\\\": \\\"eae576ac13cbf358889845b6532c62482d0cc593d9c669eb467a88911d01a9e0\\\"\\n  },\\n  \\\"carrier\\\": \\\"a_c.fd-support.closed-return/1\\\",\\n  \\\"id\\\": \\\"urn:stdo-skills:T001:codex:return:1\\\",\\n  \\\"output_slot\\\": \\\"final_stdout_object\\\",\\n  \\\"proof\\\": {\\n    \\\"predicate_ids\\\": [],\\n    \\\"transition_sources\\\": []\\n  },\\n  \\\"required_evaluations\\\": [\\n    {\\n      \\\"id\\\": \\\"requirements-realization\\\",\\n      \\\"predicate\\\": {\\n        \\\"engine\\\": \\\"workspace-regular-file\\\",\\n        \\\"object\\\": null,\\n        \\\"path\\\": \\\"specification/requirements/README.md\\\",\\n        \\\"root\\\": \\\"product\\\",\\n        \\\"selector\\\": null,\\n        \\\"sha256\\\": \\\"dcc2564e597d3d3c8fcff025a515f4a92a62e7f3aa2f7ba80af97f7db75f6acc\\\"\\n      }\\n    },\\n    {\\n      \\\"id\\\": \\\"tenant-artifact-integrity\\\",\\n      \\\"predicate\\\": {\\n        \\\"engine\\\": \\\"workspace-regular-file\\\",\\n        \\\"object\\\": null,\\n        \\\"path\\\": \\\"codex/TASK.md\\\",\\n        \\\"root\\\": \\\"operator\\\",\\n        \\\"selector\\\": null,\\n        \\\"sha256\\\": \\\"eae576ac13cbf358889845b6532c62482d0cc593d9c669eb467a88911d01a9e0\\\"\\n      }\\n    }\\n  ],\\n  \\\"role\\\": \\\"Worker\\\",\\n  \\\"schema\\\": \\\"a_c.fd-support.return-contract/1\\\"\\n}\\n\",\"coordinates\":null,\"encoding\":\"utf8\",\"parent_sha256\":\"502ef35527431c9146e17f36357dd8a67e42ae0c6080c99ec38596d23fa0472b\",\"selected_sha256\":\"502ef35527431c9146e17f36357dd8a67e42ae0c6080c99ec38596d23fa0472b\",\"size_bytes\":1221,\"source\":{\"engine\":\"workspace-regular-file\",\"object\":null,\"path\":\"codex/RETURN-CONTRACT.json\",\"root\":\"operator\",\"selector\":null,\"sha256\":\"502ef35527431c9146e17f36357dd8a67e42ae0c6080c99ec38596d23fa0472b\"}}},\"schema\":\"a_c.fd