\\u00eb\"\n  ],\n  \"assessment\": {\n    \"id\": \"sample-assessment-1\",\n    \"predicate\": \"selected renderer returns the required greeting for both domain names\",\n    \"value\": \"satisfied\",\n    \"evidence\": {\n      \"Ada\": \"Hello, Ada.\\n\",\n      \"Zo\\u00eb\": \"Hello, Zo\\u00eb.\\n\"\n    },\n    \"currentness\": \"applicable until conflicting observation or basis change\"\n  },\n  \"owner_disposition\": {\n    \"value\": \"accepted for next selected local preview preparation\",\n    \"standing\": \"controlled history premise only\"\n  },\n  \"selected_next\": \"prepare local preview under a separately admitted effect; this task only reports its eligibility\",\n  \"unresolved_counterexamples\": [\n    {\n      \"id\": \"ce-render-zoe\",\n      \"observed_after\": \"sample-assessment-1\",\n      \"candidate_sha256\": \"8b6bd00da7be7b289ca0d28e1d3d4fec77c1172ced31194812eb8c73f09a09e8\",\n      \"requirement_sha256\": \"42d474e2d82c9bac0a42324377aa63c944fb0c3cb6d2f5fe33bbd77d7a95da8c\",\n      \"input\": \"Zo\\u00eb\",\n      \"actual_output\": \"Hello, .\\n\",\n      \"expected_output\": \"Hello, Zo\\u00eb.\\n\",\n      \"standing\": \"retained applicable counterexample; unresolved, no repair or superseding assessment\"\n    }\n  ]\n}\n\n=== jobs/B-counterexample/requirement.txt ===\nThe selected renderer must produce Hello, <name>. followed by one newline for each supported name in the retained assessment domain.\n\n=== jobs/C-stale/candidate.txt ===\nHello, Ada.\n\n=== jobs/C-stale/history.json ===\n{\n  \"provenance\": \"controlled scenario premise\",\n  \"old_assessment\": {\n    \"id\": \"punctuation-review-old\",\n    \"candidate_sha256\": \"8b1560f395c0248eca4d2d6cc361825a9f8c00d11ce6f52b26eea2872573c2c1\",\n    \"governing_source\": \"requirement-old.txt\",\n    \"governing_sha256\": \"3599b98fcf45dba3761294d21eb721d03551060162793ebeb3b88ca9e173a9c3\",\n    \"predicate\": \"candidate satisfies selected greeting requirement\",\n    \"value\"