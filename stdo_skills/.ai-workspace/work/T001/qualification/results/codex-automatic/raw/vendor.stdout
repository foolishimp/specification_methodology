put file terminal newline when substituting the name. Preserve unrelated files.\\n\",\"coordinates\":null,\"encoding\":\"utf8\",\"parent_sha256\":\"48a34de6cf1ea24dc661d0c6f730bf2c21f6791bc4a9cdee1a6b46d3aa8548d9\",\"selected_sha256\":\"48a34de6cf1ea24dc661d0c6f730bf2c21f6791bc4a9cdee1a6b46d3aa8548d9\",\"size_bytes\":248,\"source\":{\"engine\":\"workspace-regular-file\",\"object\":null,\"path\":\"specification/REQUIREMENT.md\",\"root\":\"product\",\"selector\":null,\"sha256\":\"48a34de6cf1ea24dc661d0c6f730bf2c21f6791bc4a9cdee1a6b46d3aa8548d9\"}}},\"schema\":\"a_c.fd-support.response/1\",\"status\":\"ok\"}\n","exit_code":0,"status":"completed"}}
