on-schema.org/draft/2020-12/schema\",\"oneOf\":[{\"$ref\":\"#/$defs/ConjunctionPlan\"},{\"$ref\":\"#/$defs/RefreshDeclarations\"},{\"$ref\":\"#/$defs/Invalidators\"},{\"$ref\":\"#/$defs/Accounting\"},{\"$ref\":\"#/$defs/Resource\"},{\"$ref\":\"#/$defs/ReturnContract\"},{\"$ref\":\"#/$defs/ContractSupersession\"},{\"$ref\":\"#/$defs/RelationDeclarations\"},{\"$ref\":\"#/$defs/ReviewClaim\"}]},\"method_profile\":{\"id\":\"urn:a-c:fd-support:method:stdo-3.0.1-rc.1:executive:1\",\"sha256\":\"a886047e50b8a45c3b47addea0f0809dca2a6c54ac35948df5e01893cc30bbf7\"},\"operations\":[{\"checked_fragment\":\"selected finite declared contract only\",\"effect\":false,\"input_schema\":{\"$defs\":{\"ArtifactRef\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"pattern\":\"^sha256:[0-9a-f]{64}$\",\"type\":\"string\"},\"sha256\":{\"$ref\":\"#/$defs/Sha256\"}},\"required\":[\"id\",\"sha256\"],\"type\":\"object\"},\"Id\":{\"minLength\":1,\"type\":\"string\"},\"Sha256\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"}},\"additionalProperties\":false,\"properties\":{\"arguments\":{\"additionalProperties\":false,\"properties\":{\"artifact\":{\"$ref\":\"#/$defs/ArtifactRef\"},\"max_content_bytes\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"artifact\"],\"type\":\"object\"},\"id\":{\"$ref\":\"#/$defs/Id\"},\"operation\":{\"const\":\"evidence.read\"},\"schema\":{\"const\":\"a_c.fd-support.request/1\"}},\"required\":[\"schema\",\"id\",\"operation\",\"arguments\"],\"type\":\"object\"},\"name\":\"evidence.read\",\"output_schema\":{\"$defs\":{\"ArtifactRef\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"pattern\":\"^sha256:[0-9a-f]{64}$\",\"type\":\"string\"},\"sha256\":{\"$ref\":\"#/$defs/Sha256\"}},\"required\":[\"id\",\"sha256\"],\"type\":\"object\"},\"Id\":{\"minLength\":1,\"type\":\"string\"},\"Json\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"boolean\"},{\"type\":\"integer\"},{\"type\":\"string\"},{\"items\":{\"$ref\":\"#/$defs/Json\"},\"type\":\"array\"},{\"additionalProperties\":{\"$ref\":\"#/$defs/Json\"},\"type\":\"object\"}]},\"Sha256\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"}},\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"evidence\":{\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/ArtifactRef\"}]},\"id\":{\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/Id\"}]},\"operation\":{\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/Id\"}]},\"operation_outcome\":{\"oneOf\":[{\"type\":\"null\"},{\"additionalProperties\":false,\"properties\":{\"cause\":{\"$ref\":\"#/$defs/Id\"},\"core_value\":{\"enum\":[\"satisfied\",\"falsified\",\"indeterminate\",\"out_of_frame\",\"invalid_basis\"]},\"evidence\":{\"items\":{\"$ref\":\"#/$defs/Json\"},\"type\":\"array\"},\"limits\":{\"items\":{\"$ref\":\"#/$defs/Json\"},\"type\":\"array\"},\"predicate\":{\"$ref\":\"#/$defs/Json\"},\"source_parent\":{\"additionalProperties\":false,\"properties\":{\"clause\":{\"$ref\":\"#/$defs/Id\"},\"member\":{\"$ref\":\"#/$defs/Id\"},\"sha256\":{\"$ref\":\"#/$defs/Sha256\"}},\"required\":[\"member\",\"sha256\",\"clause\"],\"type\":\"object\"},\"value\":{\"enum\":[\"returned\",\"held(observation)\",\"held(effect)\",\"refused(constraint)\",\"refused(basis)\",\"refused(authority)\",\"refused(capability)\"]}},\"required\":[\"predicate\",\"value\",\"cause\",\"core_value\",\"source_parent\",\"evidence\",\"limits\"],\"type\":\"object\"}]},\"refusal\":{\"oneOf\":[{\"type\":\"null\"},{\"additionalProperties\":false,\"properties\":{\"code\":{\"enum\":[\"acquisition_denied\",\"authority_missing\",\"basis_ambiguous\",\"basis_missing\",\"basis_stale\",\"budget_exceeded\",\"contract_violation\",\"dependency_changed\",\"digest_mismatch\",\"domain_invalid\",\"effect_completion_unknown\",\"effect_unreconciled\",\"evidence_publication_failed\",\"history_incomplete\",\"internal_failure\",\"invalid_initialize\",\"malformed_request\",\"observation_unavailable\",\"path_refused\",\"request_iden