{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nfrom pathlib import Path\nimport json,stat\nroot=Path.cwd()\nchecked=set()\nfor target in [root/'deploy-test/payload.txt',root/'deploy-test/manifest.json',root/'outputs/deployment.md']:\n    assert target.is_relative_to(root)\n    for p in [target,*target.parents]:\n        st=p.lstat()\n        assert not stat.S_ISLNK(st.st_mode),p\n        if p==target:\n            assert stat.S_ISREG(st.st_mode),p\n        else:\n            assert stat.S_ISDIR(st.st_mode),p\n        checked.add(str(p))\nsource=json.loads((root/'retained/SOURCE.json').read_bytes())\nfor key,name in [('original_payload','payload.txt'),('original_manifest','manifest.json')]:\n    assert (root/'retained/release'/name).read_bytes()==Path(source[key]['path']).read_bytes()\nprint(json.dumps({'destination_ancestors_checked':len(checked),'symlinks':False,'destinations':'existing regular files','retained_matches_original_bytes':True}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nfrom pathlib import Path\nimport json,stat\nroot=Path.cwd()\nchecked=set()\nfor target in [root/'deploy-test/payload.txt',root/'deploy-test/manifest.json',root/'outputs/deployment.md']:\n    assert target.is_relative_to(root)\n    for p in [target,*target.parents]:\n        st=p.lstat()\n        assert not stat.S_ISLNK(st.st_mode),p\n        if p==target:\n            assert stat.S_ISREG(st.st_mode),p\n        else:\n            assert stat.S_ISDIR(st.st_mode),p\n        checked.add(str(p))\nsource=json.loads((root/'retained/SOURCE.json').read_bytes())\nfor key,name in [('original_payload','payload.txt'),('original_manifest','manifest.json')]:\n    assert (root/'retained/release'/name).read_bytes()==Path(source[key]['path']).read_bytes()\nprint(json.dumps({'destination_ancestors_checked':len(checked),'symlinks':False,'destinations':'existing regular files','retained_matches_original_bytes':True}))\nPY\"","aggregated_output":"{\"destination_ancestors_checked\": 15, \"symlinks\": false, \"destinations\": \"existing regular files\", \"retained_matches_original_bytes\": true}\n","exit_code":0,"status":"completed"}}
