t hashlib,json,sys\\nroot=Path(__file__).resolve().parent.parent\\nbundle=(root/sys.argv[1]).resolve()\\nassert bundle.is_relative_to(root)\\nmanifest=json.loads((bundle/'manifest.json').read_text())\\npayload=(bundle/'payload.txt').read_bytes()\\nassert manifest=={'schema':'fixture.release/1','release_id':'demo/v1.0.0-rc.1','payload':{'path':'payload.txt','sha256':hashlib.sha256(payload).hexdigest()}}\\nassert payload==(root/'inputs/payload.txt').read_bytes()\\nassert sorted(p.name for p in bundle.iterdir())==['manifest.json','payload.txt']\\nprint(json.dumps({'valid':True,'release_id':manifest['release_id'],'payload_sha256':hashlib.sha256(payload).hexdigest(),'manifest_sha256':hashlib.sha256((bundle/'manifest.json').read_bytes()).hexdigest()}))\\n\",\"coordinates\":null,\"encoding\":\"utf8\",\"parent_sha256\":\"1cd3a0775be14d8556458357192b0fe930602ead20a01f96a3761be59ec903d6\",\"selected_sha256\":\"1cd3a0775be14d8556458357192b0fe930602ead20a01f96a3761be59ec903d6\",\"size_bytes\":836,\"source\":{\"engine\":\"workspace-regular-file\",\"object\":null,\"path\":\"tools/verify_release.py\",\"root\":\"product\",\"selector\":null,\"sha256\":\"1cd3a0775be14d8556458357192b0fe930602ead20a01f96a3761be59ec903d6\"}}},\"schema\":\"a_c.fd-support.response/1\",\"status\":\"ok\"}\n","exit_code":0,"status":"completed"}}
