unrelated/sentinel.txt\\\":{\\\"kind\\\":\\\"file\\\",\\\"mode\\\":420,\\\"sha256\\\":\\\"56686d9c77cc9592aee6e2e4514fe02a7f59daa3c0befced80b3980bc6cb51b3\\\",\\\"size\\\":33}}''')\nintended=json.loads(r'''[{\\\"key\\\":\\\"payload\\\",\\\"path\\\":\\\"outputs/release/payload.txt\\\",\\\"text\\\":\\\"Release fixture payload.\\\\n\\\"},{\\\"key\\\":\\\"manifest\\\",\\\"path\\\":\\\"outputs/release/manifest.json\\\",\\\"text\\\":\\\"{\\\\n  \\\\\\\"schema\\\\\\\": \\\\\\\"fixture.release/1\\\\\\\",\\\\n  \\\\\\\"release_id\\\\\\\": \\\\\\\"demo/v1.0.0-rc.1\\\\\\\",\\\\n  \\\\\\\"payload\\\\\\\": {\\\\n    \\\\\\\"path\\\\\\\": \\\\\\\"payload.txt\\\\\\\",\\\\n    \\\\\\\"sha256\\\\\\\": \\\\\\\"b31b59c929fa045605276ea8b5492a408361288268539ae2b52c1586ba584da2\\\\\\\"\\\\n  }\\\\n}\\\\n\\\"}]''')\nroot=Path.cwd()\ncurrent={}\nfor p in sorted(root.rglob('*')):\n rel=p.relative_to(root).as_posix()\n s=p.lstat()\n if stat.S_ISLNK(s.st_mode): current[rel]={'kind':'symlink','target':os.readlink(p),'mode':stat.S_IMODE(s.st_mode)}\n elif stat.S_ISREG(s.st_mode):\n  data=p.read_bytes()\n  current[rel]={'kind':'file','size':len(data),'sha256':hashlib.sha256(data).hexdigest(),'mode':stat.S_IMODE(s.st_mode)}\n elif stat.S_ISDIR(s.st_mode): current[rel]={'kind':'directory','mode':stat.S_IMODE(s.st_mode)}\n else: current[rel]={'kind':'other','mode':stat.S_IMODE(s.st_mode)}\nallowed={x['path'] for x in intended}\nchanges=[p for p in sorted(set(baseline)|set(current)) if baseline.get(p)\"'!=current.get(p)]\nunexpected=[p for p in changes if p not in allowed]\nassert not unexpected,unexpected\nfor f in intended:\n assert (root/f['\"'path']).read_bytes()==f['text'].encode('utf8'),f['path']\nassert root.resolve()==root\nfor rel in ['outputs','outputs/release','outputs/release/payload.txt','outputs/release/manifest.json']:\n assert not (root/rel).is_symlink(),rel\nprotected={p:v for p,v in current.items() if p.startswith('deploy-test') or p=='unrelated/sentinel.txt'}\nprint(json.dumps({'v