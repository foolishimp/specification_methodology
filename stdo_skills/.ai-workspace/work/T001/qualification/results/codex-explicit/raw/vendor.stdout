{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport hashlib, json, os, pathlib, subprocess\np = pathlib.Path.cwd()\ns = subprocess.run(['stdo', 'status', '--definition', str(p/'fixture_product.json'), '--verify'], capture_output=True, text=True)\nd = json.loads(s.stdout)\nprint(json.dumps({'manager_exit':s.returncode,'status':{k:v for k,v in d.items() if k\"'!='\"'manifest'}},sort_keys=True))\nfiles = {}\nfor parent, dirs, names in os.walk(p):\n    dirs[:] = [v for v in dirs if v \"'!= '\"'.git']\n    for name in names:\n        f = pathlib.Path(parent)/name\n        if f.is_symlink():\n            files[str(f.relative_to(p))] = {'symlink':str(f.readlink())}\n        else:\n            files[str(f.relative_to(p))] = {'sha256':hashlib.sha256(f.read_bytes()).hexdigest()}\nprint(json.dumps({'workspace_preimage':files},sort_keys=True))\nmethod=pathlib.Path('/Users/jim/Library/Application Support/STDO/releases/v3.0.1-rc.1')\nfor rel in ['standards/frames/bootstrap.md','standards/ACTIVATION.md']:\n    print(json.dumps({'method_source':rel,'sha256':hashlib.sha256((method/rel).read_bytes()).hexdigest()}))\nprint(subprocess.run(['codex','--version'], capture_output=True, text=True).stdout.strip())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
