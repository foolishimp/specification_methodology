pository\": \"https://github.com/foolishimp/specification_methodology.git\"\n      }\n    }\n  },\n  \"how\": {\n    \"build_tenants\": [\n      {\n        \"design\": [\n          \"./design/DESIGN.md\"\n        ],\n        \"id\": \"urn:stdo:product-definition:qualification-diagnostic-beta-0:tenant\",\n        \"implementation\": [\n          \"./outputs/greeting.txt\"\n        ],\n        \"root\": \"./outputs/\"\n      }\n    ],\n    \"common\": [\n      \"./design/DESIGN.md\",\n      \"./.qualification/OWNER.json\"\n    ]\n  },\n  \"kind\": \"stdo.product-definition\",\n  \"local_constitution\": {\n    \"axioms\": [],\n    \"disambiguations\": [],\n    \"overrides\": []\n  },\n  \"product\": {\n    \"bounded_context\": {\n      \"definition\": \"./specification/PRODUCT.md#product-boundary\",\n      \"id\": \"urn:stdo:product-definition:qualification-diagnostic-beta-0:boundary\"\n    },\n    \"definition_id\": \"urn:stdo:product-definition:qualification-diagnostic-beta-0\",\n    \"name\": \"Qualification diagnostic-beta-0\",\n    \"source_project\": \"./\"\n  },\n  \"reference_frame_bases\": [\n    {\n      \"applies_to\": [\n        \"urn:stdo:product-definition:qualification-diagnostic-beta-0\"\n      ],\n      \"authority\": [\n        \"./specification/PRODUCT.md#construction-authority\"\n      ],\n      \"uri\": \"./TASK.md\"\n    }\n  ],\n  \"ticketing\": {\n    \"comments\": {\n      \"root\": \"./.ai-workspace/comments/\"\n    },\n    \"goals\": \"./specification/GOALS.md\",\n    \"sprints\": {\n      \"root\": \"./.ai-workspace/sprints/\"\n    },\n    \"tickets\": {\n      \"lanes\": {\n        \"active\": \"./.ai-workspace/tickets/active/\",\n        \"backlog\": \"./.ai-workspace/tickets/backlog/\",\n        \"completed\": \"./.ai-workspace/tickets/completed/\"\n      },\n      \"root\": \"./.ai-workspace/tickets/\"\n    }\n  },\n  \"what\": {\n    \"intent\": \"./specification/INTENT.md\",\n    \"product\": \"./specification/PRODUCT.md\",\n    \"specification\": [\n      \"./specification/REQUIREMENT.md\"\n    ]\n  }\n}\n\n=== cases/beta/TASK.md ===\n# Task\nConditional correction on a verified selected Product and store.\n\n=== cases/beta/CLAUDE.md ===\nRead CASE.json, Product definition, requirement and design before any correction.\n\n=== cases/beta/AGENTS.md ===\nRead CASE.json, Product definition, requirement and design before any correction.\n\n=== cases/beta/inputs/name.txt ===\nAda\n\n=== cases/beta/outputs/greeting.txt ===\nHello, Grace.\n\n=== cases/beta/design/DESIGN.md ===\n# D1\nSubstitute the input name exactly; only outputs/greeting.txt is mutable.\n\n=== cases/beta/specification/REQUIREMENT.md ===\n# R1\nProduce Hello, <name>. and one newline for inputs/name.txt.\n\n=== cases/beta/specification/PRODUCT.md ===\n# Product\n\n## Product boundary\nOne greeting.\n\n## Construction authority\nConditional correction in parent TASK.md.\n\n=== cases/beta/specification/INTENT.md ===\n# Intent\nCorrect the greeting on a verified local basis.\n\n=== cases/beta/specification/GOALS.md ===\n# Selection\nBounded conditional correction.\n\n=== cases/beta/store/releases/v3.0.1-rc.1/manifest.json ===\n{\n  \"auxiliary\": {\n    \"license\": {\n      \"path\": \"LICENSE\",\n      \"sha256\": \"cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30\"\n    },\n    \"plugin\": {\n      \"installed_root\": \"plugins/spec\",\n      \"member_count\": 17,\n      \"members\": [\n        {\n          \"path\": \".claude-plugin/plugin.json\",\n          \"sha256\": \"d396954fd4fe9cdcf9ba74b56087870bf8ee4a9313a227dc833d40e5220643e3\"\n        },\n        {\n          \"path\": \".codex-plugin/plugin.json\",\n          \"sha256\": \"db16c241c09611ecadc51a8bf141b84585cbcfc9cfa174495110971f26f14643\"\n        },\n        {\n          \"path\": \"LICENSE\",\n          \"sha256\": \"cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30\"\n        },\n        {\n          \"path\": \"claude-skills/refresh/SKILL