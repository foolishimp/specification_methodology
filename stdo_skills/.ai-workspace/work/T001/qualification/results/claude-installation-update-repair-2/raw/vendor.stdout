y\",\n      \"id\": \"urn:stdo:product-definition:qualification-installed-update:boundary\"\n    },\n    \"definition_id\": \"urn:stdo:product-definition:qualification-installed-update\",\n    \"name\": \"Qualification installed-update\",\n    \"source_project\": \"./\"\n  },\n  \"reference_frame_bases\": [\n    {\n      \"applies_to\": [\n        \"urn:stdo:product-definition:qualification-installed-update\"\n      ],\n      \"authority\": [\n        \"./specification/PRODUCT.md#construction-authority\"\n      ],\n      \"uri\": \"./TASK.md\"\n    }\n  ],\n  \"ticketing\": {\n    \"comments\": {\n      \"root\": \"./.ai-workspace/comments/\"\n    },\n    \"goals\": \"./specification/GOALS.md\",\n    \"sprints\": {\n      \"root\": \"./.ai-workspace/sprints/\"\n    },\n    \"tickets\": {\n      \"lanes\": {\n        \"active\": \"./.ai-workspace/tickets/active/\",\n        \"backlog\": \"./.ai-workspace/tickets/backlog/\",\n        \"completed\": \"./.ai-workspace/tickets/completed/\"\n      },\n      \"root\": \"./.ai-workspace/tickets/\"\n    }\n  },\n  \"what\": {\n    \"intent\": \"./specification/INTENT.md\",\n    \"product\": \"./specification/PRODUCT.md\",\n    \"specification\": [\n      \"./specification/REQUIREMENT.md\"\n    ]\n  }\n}\n","numLines":110,"startLine":1,"totalLines":110}},"tool_result_meta":[{"id":"toolu_01VSMKpVBw3rEo7H4Fdi4CWn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
