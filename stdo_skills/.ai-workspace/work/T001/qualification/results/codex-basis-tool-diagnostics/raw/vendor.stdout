efs/RequiredEvaluation\"},\"type\":\"array\"},\"role\":{\"const\":\"Reviewer\"},\"schema\":{\"const\":\"a_c.fd-support.return-contract/1\"}},\"required\":[\"schema\",\"id\",\"authority_source\",\"carrier\",\"output_slot\",\"required_evaluations\",\"role\",\"proof\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"authority_source\":{\"$ref\":\"#/$defs/SourceRef\"},\"carrier\":{\"const\":\"a_c.fd-support.closed-return/1\"},\"id\":{\"$ref\":\"#/$defs/Id\"},\"output_slot\":{\"const\":\"final_stdout_object\"},\"proof\":{\"$ref\":\"#/$defs/ExecutiveProof\"},\"required_evaluations\":{\"items\":{\"$ref\":\"#/$defs/RequiredEvaluation\"},\"type\":\"array\"},\"role\":{\"const\":\"Executive\"},\"schema\":{\"const\":\"a_c.fd-support.return-contract/1\"}},\"required\":[\"schema\",\"id\",\"authority_source\",\"carrier\",\"output_slot\",\"required_evaluations\",\"role\",\"proof\"],\"type\":\"object\"}]},\"ReviewClaim\":{\"additionalProperties\":false,\"properties\":{\"candidate_sources\":{\"items\":{\"$ref\":\"#/$defs/SourceRef\"},\"type\":\"array\",\"uniqueItems\":true},\"id\":{\"$ref\":\"#/$defs/Id\"}},\"required\":[\"id\",\"candidate_sources\"],\"type\":\"object\"},\"ReviewerProof\":{\"additionalProperties\":false,\"properties\":{\"claim\":{\"$ref\":\"#/$defs/SourceRef\"},\"comparison\":{\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/SourceRef\"}]},\"expectations\":{\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/ArtifactRef\"}]},\"independence_policy\":{\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/SourceRef\"}]},\"predicate_ids\":{\"items\":{\"$ref\":\"#/$defs/Id\"},\"type\":\"array\"},\"proof_sources\":{\"items\":{\"$ref\":\"#/$defs/SourceRef\"},\"type\":\"array\"}},\"required\":[\"claim\",\"expectations\",\"proof_sources\",\"comparison\",\"independence_policy\",\"predicate_ids\"],\"type\":\"object\"},\"RevisingObservation\":{\"additionalProperties\":false,\"properties\":{\"declaration\":{\"$ref\":\"#/$defs/SourceRef\"},\"id\":{\"$ref\":\"#