ation_failed\",\"history_incomplete\",\"internal_failure\",\"invalid_initialize\",\"malformed_request\",\"observation_unavailable\",\"path_refused\",\"request_identity_conflict\",\"result_surface_denied\",\"role_effect_denied\",\"source_missing\",\"target_conflict\",\"transition_record_missing\",\"unknown_operation\",\"unqualified_operator\",\"unsupported_check\",\"unsupported_contract\",\"unsupported_executor\",\"unsupported_measurement\",\"unsupported_protocol_method\",\"unsupported_translation\"]},\"gaps\":{\"items\":{\"$ref\":\"#/$defs/Json\"},\"type\":\"array\"},\"reason\":{\"type\":\"string\"},\"source_refs\":{\"items\":{\"$ref\":\"#/$defs/Json\"},\"type\":\"array\"}},\"required\":[\"code\",\"reason\",\"gaps\",\"source_refs\"],\"type\":\"object\"}]},\"result\":{\"oneOf\":[{\"type\":\"null\"},{\"additionalProperties\":false,\"properties\":{\"artifact\":{\"oneOf\":[{\"type\":\"null\"},{\"$ref\":\"#/$defs/ArtifactRef\"}]},\"value\":{\"$ref\":\"#/$defs/Json\"}},\"required\":[\"artifact\",\"value\"],\"type\":\"object\"}]},\"schema\":{\"const\":\"a_c.fd-support.response/1\"},\"status\":{\"enum\":[\"ok\",\"refused\",\"error\"]}},\"required\":[\"schema\",\"id\",\"operation\",\"status\",\"result\",\"refusal\",\"operation_outcome\",\"evidence\"],\"type\":\"object\"},\"prerequisites\":[\"trusted exact policy\",\"fixed principal operation grant\",\"exact acquired input basis\"]}],\"qualification\":\"provisional construction; independent integrated qualification and owner acceptance pending\",\"refusal_codes\":{\"acquisition_denied\":\"refused(authority)\",\"authority_missing\":\"refused(authority)\",\"basis_ambiguous\":\"refused(basis)\",\"basis_missing\":\"refused(basis)\",\"basis_stale\":\"refused(basis)\",\"budget_exceeded\":\"refused(constraint)\",\"contract_violation\":\"refused(constraint)\",\"dependency_changed\":\"refused(basis)\",\"digest_mismatch\":\"refused(basis)\",\"domain_invalid\":\"refused(basis)\",\"effect_completion_unknown\":\"held(effect)\",\"effect_un