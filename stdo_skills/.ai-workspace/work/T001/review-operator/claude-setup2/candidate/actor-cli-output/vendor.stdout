6|         \"7-closed-result-and-reuse\"\n7891\t   37|       ]\n7892\t   38|     },\n7893\t   39|     {\n7894\t   40|       \"member\": \"FOUNDATIONS.md\",\n7895\t   41|       \"sha256\": \"92fe2f3c09a59b4e9a732463a41d4a45d7efd693648159621e03c75f7127eac5\",\n7896\t   42|       \"clauses\": [\n7897\t   43|         \"results\",\n7898\t   44|         \"assertions-and-observation\",\n7899\t   45|         \"change-impact-and-evidence-reuse\"\n7900\t   46|       ]\n7901\t   47|     },\n7902\t   48|     {\n7903\t   49|       \"member\": \"EXECUTIVE_BASELINE.md\",\n7904\t   50|       \"sha256\": \"fcef434630e270d216f494de97ee727ad46690db89a4b73edac4b88ff921c62e\",\n7905\t   51|       \"clauses\": [\n7906\t   52|         \"19-baseline-specific-basis-and-activation-additions\",\n7907\t   53|         \"no-mutation-while-executive\"\n7908\t   54|       ]\n7909\t   55|     },\n7910\t   56|     {\n7911\t   57|       \"member\": \"AXIOMATIC_CALCULUS.md\",\n7912\t   58|       \"sha256\": \"b39c45fd86b8f9add7d196b2974a8e5f75bf4a327cf796e362716a6b4f5776d5\",\n7913\t   59|       \"clauses\": [\n7914\t   60|         \"5-traversals-and-functor-kinds\"\n7915\t   61|       ]\n7916\t   62|     },\n7917\t   63|     {\n7918\t   64|       \"member\": \"EVALUATION.md\",\n7919\t   65|       \"sha256\": \"478fd21feda72d64e62a92f970b37bade3f9aadfb17c73649cdb1a7866581eff\",\n7920\t   66|       \"clauses\": [\n7921\t   67|         \"3-independent-assessment\"\n7922\t   68|       ]\n7923\t   69|     },\n7924\t   70|     {\n7925\t   71|       \"member\": \"SPEC_METHOD.md\",\n7926\t   72|       \"sha256\": \"b2773dc0c9feb429b6b357bcfd60e7df46e54db8adcb04dc8d6dbfa023b73677\",\n7927\t   73|       \"clauses\": [\n7928\t   74|         \"11-build-tenant-binding\"\n7929\t   75|       ]\n7930\t   76|     }\n7931\t   77|   ],\n7932\t   78|   \"carrier\": \"Existing a_c.fd-support /1 carriers; this profile supplies the native semantic binding, not new method law.\",\n7933\t   79|   \"mapping\": {\n7934\t   80|     \"packet\": \"REFERENCE_FRAME section11; existing groups preserve required native coordinates. Native intake outcome/admission/shared machinery are supplied as exact sources in packet relations and grant.\",\n7935\t   81|     \"admission\": \"ACTIVATION Admission; existing Product-located mechanism and exact contract evidence remain necessary; profile selection supplies no grant.\",\n7936\t   82|     \"work_result\": \"ACTIVATION Construction availability: candidate_ready/satisfied, incomplete/falsified, refused/falsified, re_entry_requested cause determines out_of_frame or invalid_basis; no assessment manufactured.\",\n7937\t   83|     \"return\": \"ACTIVATION section7; original evaluations/not_performed/residuals/invalidators remain distinct, and currentness is consumer-relative.\",\n7938\t   84|     \"operation_outcome\": \"B(op) is output/effect-evidence payload availability, not physical completion, semantic success or admission. Existing cause-tagged mapping is retained under native FOUNDATIONS Results.\",\n7939\t   85|     \"classification\": \"Named read, render, launch and write operations are not universally classified F_D; pure finite declared predicate checks retain their narrow evidence claim. External execution and F_P meaning remain separate.\"\n7940\t   86|   },\n7941\t   87|   \"unsupported\": [\n7942\t   88|     \"results.conjoin: no native operator qualification\",\n7943\t   89|     \"arbitrary method profiles or translations\",\n7944\t   90|     \"semantic context sufficiency certification\",\n7945\t   91|     \"universal F_D classification or full calculus conformance\",\n7946\t   92|     \"OS sandboxing or actor/provider qualification\"\n7947\t   93|   ]\n7948\t   94| }\n7949\t   95| \n7950\t\n7951\t######## [30] tool:build_tenants/graphify/design/fd-support-stdo-3.0.1.md sel=None ########\n7952\t    1| # Native STDO 3.0.1 support binding\n7953\t    2| \n7954\t    3| This is the bounded successor binding for the existing Graphify support tools.\n7955\t    4| Its consumer method is released `stdo://releases/v3.0.1-rc.1/`, manifest\n7956\t    5| `60356364a412dbde8cffe68fe0eda4e2749b0162acce93495534eee13b223df8`, native commit\n7957\t    6| `fe4941f56a52ed3697a2b516d8d68948b0ea65d9`. The a_c builder remains its selected\n7958\t    7| installed 2.5.1 RC2. The [profile](fd-method-stdo-3.0.1.json) pins the native\n7959\t    8| owner files. The [requirements](../../../specification/requirements/fd-stdo-3.0.1-binding.md)\n7960\t    9| own this increment's WHAT. Existing [public wire and computational design](fd-support.md)\n7961\t   10| owns the shared realization, with the changes below. This is a development\n7962\t   11| candidate, not evidence of complete calculus or ordinary actor qualification.\n7963\t   12| \n7964\t   13| ## Native contract mapping\n7965\t   14| \n7966\t   15| | Native owner | Existing carrier/computation retained | Preservation and boundary |\n7967\t   16| |---|---|---|\n7968\t   17| | REFERENCE_FRAME §11 | Packet groups, exact source acquisition, rendered Context, actor envelope | Identity/revision, subject/basis, relations/invariants, authorities, inputs/tools, dependencies, consumer and stop/change remain explicit. Rendered byte fit is not semantic sufficiency. |\n7969\t   18| | ACTIVATION §1 Intake; EXECUTIVE_BASELINE §19 | Packet plus supplied grant and exact source references | Governed outcome, accepted transformation relations and shared-machinery dispositions belong in the supplied deciding sources/grant. The tool does not infer them or claim it checks their semantic sufficiency. Role additions retain the native Worker/Reviewer/Executive coordinates; Reviewer technical-triage capability is in generic actor capability and source references. |\n7970\t   19| | ACTIVATION §1 Admission | Product-located owner record, exact mechanism digest, grant, preconditions, preflight contract receipt | Drafting does not admit. A source-authorized operator selects the actual owner binding and grant; preflight validates that exact contract. No role/profile name or example setup grants authority. |\n7971\t   20| | ACTIVATION §3 | Closed return: evaluations, not_performed, work_result, residuals | An available report can say construction incomplete; report availability does not satisfy construction or unperformed assessment. The original actor values are preserved. Semantic legality remains an evaluation obligation. |\n7972\t   21| | ACTIVATION §7; FOUNDATIONS observation sufficiency | Original return, consumer/context coordinates, explicit observations, invalidators and dependencies | Consumers retain currentness and continuation distinctions; byte equality alone supplies no applicability claim. Existing return checks retain unknowns and compare supplied coordinates. No general context compression or future-behaviour theorem is claimed. |\n7973\t   22| | FOUNDATIONS Results; SPEC_METHOD §11 | Public operation_outcome | B(op) means the requested exact output/effect-evidence payload is available. The original cause-tagged mapping is retained with the native Results parent. Successful dispatch/observation is neither task success nor physical effect completion. |\n7974\t   23| | AXIOMATIC_CALCULUS §5 | Named domain operations and bounded predicate primitives | No blanket F_D reclassification. A native F_D claim needs its own closed domain/dependencies/outcomes/termination argument. Source acquisition and external execution remain named operations; an LLM's semantic output remains F_P. |\n7975\t   24| \n7976\t   25| Example: a process times out and yields a complete observation with unknown\n7977\t   26| external completion. `dispatch.observe` may satisfy B(observe); its effect is\n7978\t   27| still unknown. An authenticated actor report of `incomplete` preserves that\n7979\t   28| construction-availability value; absent assessments stay in `not_performed`.\n7980\t   29| The operation's availability result does not convert either into success.\n7981\t   30| \n7982\t   31| ## Shared implementation and selected profile\n7983\t   32| \n7984\t   33| The two supported profiles have curated exact id/digest pairs. Runtime carries\n7985\t   34| the selected pair from the operator policy; no caller supplies executable\n7986\t   35| profile logic. Native startup also requires the consumer Product Definition's\n7987\t   36| exact 3.0.1 release URI and manifest. Profile bytes are reacquired and hashed.\n7988\t   37| Catalogs, output parents, provenance, packet/return basis and effect replay\n7989\t   38| checks use that selected identity. RC9 history and source pins remain intact.\n7990\t   39| \n7991\t   40| The common algorithms are retained because the mapped native contracts above\n7992\t   41| require the same declared coordinate and evidence relations. A future material\n7993\t   42| semantic difference requires a separately justified implementation change;\n7994\t   43| a matching carrier shape alone would not justify reuse.\n7995\t   44| \n7996\t   45| All existing public operations are exposed for this bounded profile except\n7997\t   46| `results.conjoin`, which refuses `unsupported_check` and is omitted from native\n7998\t   47| CLI/MCP inventory. The only existing conjunction schema/operator is RC9-specific.\n7999\t   48| An Executive may perform its declared native F_P decision over original results;\n8000\t   49| it must not present that decision as a tool-computed native conjunction.\n8001\t   50| Models queried through record/graph operations retain their own exact model\n8002\t   51| basis; selecting this tool profile neither migrates nor accepts a model.\n8003\t   52| \n8004\t   53| ## Public setup and use\n8005\t   54| \n8006\t   55| For source acquisition on an explicitly selected consumer, from any directory:\n8007\t   56| \n8008\t   57| ```sh\n8009\t   58| python3 -B \"$ac_root/build_tenants/graphify/examples/fd-support/prepare_readonly.py\" \\\n8010\t   59|   --out \"$fresh_setup\" --profile stdo-3.0.1 \\\n8011\t   60|   --product-root \"$consumer_root\" --definition-name stdo_skills.json\n8012\t   61| ```\n8013\t   62| \n8014\t   63| `SETUP.json` gives the exact policy path and digest; `requests/describe.json`,\n8015\t   64| `read-product.json` and `observe.json` are ready public requests. Read-only setup\n8016\t   65| registers no work grant or executor. Its mechanism coordinate uses the real\n8017\t   66| implementation digest, but the demonstration operator record is not an admitted\n8018\t   67| Product work owner. It cannot perform preflight, dispatch or authoritative writes.\n8019\t   68| \n8020\t   69| ```sh\n8021\t   70| python3 -B \"$ac_root/build_tenants/graphify/code/ac_support.py\" \\\n8022\t   71|   --policy \"$policy\" --policy-sha256 \"$policy_sha256\" --principal executive \\\n8023\t   72|   call --request \"$request\"\n8024\t   73| ```\n8025\t   74| \n8026\t   75| `mcp` in place of `call --request ...` serves the same full envelopes. Invoke\n8027\t   76| `tools.describe` for each selected operation's actual request and result schemas.\n8028\t   77| \n8029\t   78| ### Real work policy: operator recipe\n8030\t   79| \n8031\t   80| The public mechanism is the existing `product-policy-preflight/1`; the policy is\n8032\t   81| trusted operator configuration, not an actor-supplied work request. Use the\n8033\t   82| [Product-bound admission contract](fd-support.md#product-bound-admission-and-exact-dispatch)\n8034\t   83| and the public schemas. The required preparation is:\n8035\t   84| \n8036\t   85| 1. Record the actual owner instruction, selected outcome, limits and permitted\n8037\t   86|    effects. Reference an existing Product-local JSON owner record through a\n8038\t   87|    supported URI slot in the Product Definition (for example a declared\n8039\t   88|    `reference_frame_bases` authority). The policy's `definition_locator` is the\n8040\t   89|    JSON Pointer to that exact URI. The record has `mechanism`, `result_surface`\n8041\t   90|    and `scope`; the selected mechanism source/digest names the current\n8042\t   91|    `ac_support_core.py`, and the surface names the actual protected evidence\n8043\t   92|    root, namespace and consumer. The tool verifies record/definition agreement;\n8044\t   93|    hashes do not authenticate the human who selected it.\n8045\t   94| 2. Supply exact SourceRefs for the Product Definition, native profile, owner,\n8046\t   95|    role bindings and deciding task/source/evidence files. Register their roots\n8047\t   96|    and read scopes. Mark only granted Worker territory writable; keep policy,\n8048\t   97|    implementation, method and protected evidence outside that territory.\n8049\t   98| 3. Register fixed principals with their actor/role/provenance and operation\n8050\t   99|    permissions. Bind an existing grant: authority_sources, outcome, authorized\n8051\t  100|    principals/targets, operations/tools, executor IDs, territory, preconditions,\n8052\t  101|    admission selection and notification sink. Its admission selection names\n8053\t  102|    the exact mechanism/source/owner, required predicates and allowed override\n8054\t  103|    sources; use empty collections only when the actual work contract requires\n8055\t  104|    none. Do not create dummy satisfied predicates or approval receipts.\n8056\t  105| 4. Register the actual fixed executor: executable and digest, full argv, all\n8057\t  106|    declared dependencies, cwd/environment, actor identity, settings/tool set,\n8058\t  107|    effect scope, stdin Context mode, decoder and observations. The existing\n8059\t  108|    [actor CLI adapter](../examples/fd-support/README.md#optional-cli-transport-helper)\n8060\t  109|    can invoke either host. Preserve its fixed-plan and actual-output contract.\n8061\t  110|    Native profile selection does not qualify a provider, model or executor.\n8062\t  111| 5. Freeze the complete policy bytes/digest. Public `context.assemble` consumes\n8063\t  112|    the caller-selected packet and exact sources. Public `contract.preflight`\n8064\t  113|    creates the actual admission receipt only after its checks pass.\n8065\t  114|    `dispatch.start` takes that receipt, not arbitrary argv. Observe completion;\n8066\t  115|    `return.capture` takes the actual retained final stdout and original return\n8067\t  116|    contract, followed by `return.check`. The Executive consumes these results\n8068\t  117|    and decides the next authorized action.\n8069\t  118| \n8070\t  119| A complete policy has the same closed fields as the existing public contract:\n8071\t  120| `schema`, `id`, `product`, `method_profile`, `sources`, `principals`, `grants`,\n8072\t  121| `predicates`, `operators`, `executors`, `event_sinks`, `independence_policy`,\n8073\t  122| `evidence_root`, `limits`, `authority_sources`. For this profile, `operators`\n8074\t  123| may be empty; a native conjunction registration is not currently supported.\n8075\t  124| The shipped tests construct synthetic authority only inside isolated fixtures;\n8076\t  125| they are not an ordinary admission generator.\n8077\t  126| \n8078\t  127| ## Verification and remaining work\n8079\t  128| \n8080\t  129| `test_ac_support_native301.py` exercises native public CLI discovery/source/\n8081\t  130| observation, legacy-profile rejection, exact Product-basis rejection, reassembled\n8082\t  131| activation retry refusal, material-source staleness before launch, and an actual\n8083\t  132| local subprocess through capture/check preserving an incomplete work report.\n8084\t  133| The actor is a controlled deterministic transport fixture. Existing core,\n8085\t  134| effects and CLI/MCP tests cover the retained RC9 path. Real Codex/Claude use,\n8086\t  135| semantic migration assessment, context adequacy, and Product acceptance remain\n8087\t  136| separate evidence obligations.\n8088\t  137| \n8089\t\n8090\t######## [31] tool:build_tenants/graphify/examples/fd-support/README.md sel=None ########\n8091\t    1| # Public support-tool setup\n8092\t    2| \n8093\t    3| `prepare_readonly.py` creates a fresh, disposable operator configuration for\n8094\t    4| discovery and exact source acquisition. It uses the ordinary public CLI/MCP,\n8095\t    5| the real policy validator and the shipped method profile. It creates three\n8096\t    6| example principals with the same nine read/query permissions. They are not\n8097\t    7| actual F_P actors or independent assessors.\n8098\t    8| \n8099\t    9| The configuration has **no work grants or executors**. Its required admission\n8100\t   10| binding contains a visibly unqualified implementation placeholder. It grants\n8101\t   11| no Product work and cannot admit preflight, dispatch or authoritative writing.\n8102\t   12| The current Product owner binding is a separate authority surface; this example\n8103\t   13| does not ratify it. A trusted operator must select and verify real authority\n8104\t   14| before preparing a real task policy.\n8105\t   15| \n8106\t   16| From `a_c/`, with Python 3.11 or later:\n8107\t   17| \n8108\t   18| ```sh\n8109\t   19| ac_example_parent=\"$(python3 -c 'import pathlib,tempfile; print(pathlib.Path(tempfile.mkdtemp()).resolve())')\"\n8110\t   20| python3 build_tenants/graphify/examples/fd-support/prepare_readonly.py --out \"$ac_example_parent/demo\"\n8111\t   21| ac_example_sha=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"policy_sha256\"])' \"$ac_example_parent/demo/SETUP.json\")\"\n8112\t   22| \n8113\t   23| python3 build_tenants/graphify/code/ac_support.py --policy \"$ac_example_parent/demo/policy.json\" --policy-sha256 \"$ac_example_sha\" --principal executive call --request \"$ac_example_parent/demo/requests/describe.json\"\n8114\t   24| python3 build_tenants/graphify/code/ac_support.py --policy \"$ac_example_parent/demo/policy.json\" --policy-sha256 \"$ac_example_sha\" --principal worker call --request \"$ac_example_parent/demo/requests/read-product.json\"\n8115\t   25| python3 build_tenants/graphify/code/ac_support.py --policy \"$ac_example_parent/demo/policy.json\" --policy-sha256 \"$ac_example_sha\" --principal reviewer mcp < \"$ac_example_parent/demo/mcp-session.jsonl\"\n8116\t   26| ```\n8117\t   27| \n8118\t   28| The setup output supplies the exact policy byte digest. `source.read` returns\n8119\t   29| actual Product Definition content, its parent hash and acquisition route;\n8120\t   30| `workspace.observe` observes the named current file. The MCP example initializes,\n8121\t   31| lists the same operation contracts and acquires source through a full request\n8122\t   32| envelope. A policy lists core capabilities separately from the operations its\n8123\t   33| principals may perform.\n8124\t   34| \n8125\t   35| Setup resolves the operator-selected fresh output to its actual canonical path\n8126\t   36| before creating any policy or source binding. `SETUP.json` records those exact\n8127\t   37| paths. Use them for subsequent invocations; registered source/evidence paths\n8128\t   38| continue to refuse symlink aliases such as a macOS `/var` alias. No admitted\n8129\t   39| path or source hash is silently replaced.\n8130\t   40| \n8131\t   41| Run the negative example with `requests/denied-preflight.json`: it returns a\n8132\t   42| refusal and CLI exit 2. Changing the policy without changing the operator's\n8133\t   43| expected digest also refuses. The setup will not overwrite an existing output\n8134\t   44| directory. Keep any partial directory after a setup failure as observed evidence;\n8135\t   45| choose a fresh output for another attempt.\n8136\t   46| \n8137\t   47| For a real task, the Product operator supplies an existing Product-located owner\n8138\t   48| binding and work grant, exact role/packet/return contract, source and method\n8139\t   49| bases, effect territory, evidence surface, registered executor and dependency\n8140\t   50| pins. Discover their concrete contracts with `tools.describe` and re-enter the\n8141\t   51| [tenant design](../../design/fd-support.md). Source hashes establish exact bytes;\n8142\t   52| they do not authenticate whoever wrote a grant. Register no arbitrary caller\n8143\t   53| shell command, argv suffix, environment or endpoint.\n8144\t   54| \n8145\t   55| The ordinary development path is caller-selected: Executive acquires current\n8146\t   56| source and prepares a contract; Worker acquires deciding source/proof and\n8147\t   57| returns its candidate; Reviewer records actual source-derived expectations\n8148\t   58| before candidate exposure, then acquires candidate/proof directly. The selected\n8149\t   59| F_P actors and existing owner retain semantic judgment and disposition. Only\n8150\t   60| actual final output from a registered dispatched Attempt can authenticate a\n8151\t   61| return through this tool. Fresh contexts, example personas and fixture answers\n8152\t   62| prove no independent semantic result or actor usability.\n8153\t   63| \n8154\t   64| Actual actor/provider runs require their separately selected exact executor,\n8155\t   65| configuration, context, source/exposure plan and approved work authority. This\n8156\t   66| setup invokes none. Source-first transport records establish scoped writes,\n8157\t   67| not that an actor mentally attended to the supplied bytes. Missing delivery or\n8158\t   68| external exposure remains unknown.\n8159\t   69| \n8160\t   70| ## Optional CLI transport helper\n8161\t   71| \n8162\t   72| `actor_cli.py` is a stdlib adapter for a separately registered Claude or Codex\n8163\t   73| CLI executor. It forwards the exact stdin Context bytes, captures the actual\n8164\t   74| vendor stdout/stderr, and emits the actual final answer bytes. It supplies no\n8165\t   75| prompt, model, grant, default answer, semantic repair or retry. A direct helper\n8166\t   76| run authenticates no actor. Authentication and the exact Context/activation\n8167\t   77| binding come from an admitted registered Attempt through the ordinary tool.\n8168\t   78| \n8169\t   79| An operator first freezes a JSON plan and its raw SHA-256. The closed plan has\n8170\t   80| these fields; none can be supplied as a public tool argument or argv suffix:\n8171\t   81| \n8172\t   82| | Field | Operator-selected value |\n8173\t   83| | --- | --- |\n8174\t   84| | `schema`, `id`, `backend` | `a_c.fd-support.actor-cli-plan/1`, a fixed identifier, and `claude` or `codex` |\n8175\t   85| | `executable` | Actual regular-file absolute `path` and lowercase byte `sha256` |\n8176\t   86| | `argv` | Complete fixed argument array, beginning with that executable path |\n8177\t   87| | `dependencies` | Explicit array of regular-file `{path, sha256}` pins, including scripts, loaders and configuration used by the registered call |\n8178\t   88| | `cwd` | Exact existing absolute working directory |\n8179\t   89| | `environment` | Complete selected string map, apart from protected unchanged pass-through below |\n8180\t   90| | `settings` | Exact operator-declared selected settings and known unknowns; declarations never override argv or infer defaults |\n8181\t   91| | `decoder` | One of the three fixed profiles below, matching the backend |\n8182\t   92| | `evidence_directory` | Fresh absolute directory under an existing operator-owned parent |\n8183\t   93| | `limits` | Positive integer `max_input_bytes`, `max_output_bytes`, `timeout_ms`, `termination_grace_ms` |\n8184\t   94| \n8185\t   95| Register the helper interpreter, helper, core parser, frozen plan, native\n8186\t   96| executable and its actual loader/configuration chain under the existing\n8187\t   97| Executor dependency controls. The helper rechecks plan and listed file pins\n8188\t   98| immediately before child launch. It rejects symlink path components and starts\n8189\t   99| the fixed argv without a shell. Pinning a path or configuration file is not a\n8190\t  100| claim that it covers all host effects or all dynamically loaded dependencies.\n8191\t  101| \n8192\t  102| `HOME`, `home` and `CODEX_HOME` cannot appear in the plan environment. If already\n8193\t  103| present in the registered helper process, they pass through unchanged and are\n8194\t  104| recorded separately with that provenance. Absent values stay absent. The\n8195\t  105| helper reads no authentication files. Other selected environment values are\n8196\t  106| explicit; an operator must not place credential values in the plan or its\n8197\t  107| retained evidence.\n8198\t  108| \n8199\t  109| For Claude OAuth supplied through the invoking process environment, the trusted\n8200\t  110| operator may select `settings.environment_passthrough` as\n8201\t  111| `[\"CLAUDE_CODE_OAUTH_TOKEN\"]` in **both** the registered Executor and the fixed\n8202\t  112| actor plan. This is a reserved setting with a fixed supported-name allowlist;\n8203\t  113| it does not accept caller selectors, token values or alternate variable names.\n8204\t  114| The named credential is forbidden in either serialized `environment` map.\n8205\t  115| Without the setting, the existing exact environment behavior is unchanged.\n8206\t  116| \n8207\t  117| Dispatch privately copies the existing selected value into the supervisor;\n8208\t  118| the supervisor privately copies it into the registered helper; the helper\n8209\t  119| privately copies it into the vendor process. Values are unchanged, never\n8210\t  120| serialized or hashed by these boundaries. Attempt and helper invocation\n8211\t  121| records contain selected names and presence booleans only. Absence stays\n8212\t  122| absent, and authentication success is never inferred from presence. A selected\n8213\t  123| name present in the dispatcher but absent in a resumed supervisor is refused\n8214\t  124| as a changed launch observation. Credential identity is deliberately not\n8215\t  125| pinned or proven by this mechanism. Raw vendor output remains exact; the\n8216\t  126| registered vendor must not emit credential values into its own output.\n8217\t  127| \n8218\t  128| The selected decoder is part of the frozen plan:\n8219\t  129| \n8220\t  130| - `claude-result-json/1` requires one JSON object: a terminal `type: \"result\"`,\n8221\t  131|   `subtype: \"success\"`, `is_error: false`, with nonempty string `result`.\n8222\t  132| - `claude-result-jsonl/1` requires JSON objects on lines and exactly one such\n8223\t  133|   terminal result at the end. Earlier partial events remain raw evidence.\n8224\t  134| - `codex-final-jsonl/1` requires one final `turn.completed` and selects the last\n8225\t  135|   preceding `item.completed` with `item.type: \"agent_message\"` and string `text`.\n8226\t  136|   Earlier commentary is retained and is never concatenated into the answer.\n8227\t  137| \n8228\t  138| These are explicit decoder profiles for the documented\n8229\t  139| [Claude JSON/result and streaming formats](https://code.claude.com/docs/en/headless)\n8230\t  140| and [Codex JSONL events](https://learn.chatgpt.com/docs/non-interactive-mode).\n8231\t  141| They select final text only; Claude `structured_output` is not an alternative\n8232\t  142| answer route in these profiles. Multiple turns/results, missing final output,\n8233\t  143| failed terminal events, malformed JSON and nonzero process exits fail. Later\n8234\t  144| real-CLI trials must qualify the exact selected executable/profile combination.\n8235\t  145| \n8236\t  146| The final text must parse through the ordinary integer-only core JSON grammar\n8237\t  147| as an object with `schema: \"a_c.fd-support.closed-return/1\"`. Its original UTF-8\n8238\t  148| bytes, including whitespace, are forwarded unchanged. Decimal/exponent public\n8239\t  149| numbers, duplicate keys, nonfinite values, code fences or a missing schema\n8240\t  150| fail; none is repaired. The helper checks only this transport grammar and tag.\n8241\t  151| The actual return contract, activation identity, proof and semantics remain\n8242\t  152| with the existing return capture/check and F_P owners.\n8243\t  153| \n8244\t  154| On each fresh run the helper retains `plan.json`, `context.bin`,\n8245\t  155| `invocation.json`, `vendor.stdout`, `vendor.stderr`, `process.json` and\n8246\t  156| `result.json`, as far as the actual failure permits. A successful decode also\n8247\t  157| retains `final.payload` and `decoded.json`. Vendor usage, settings and costs\n8248\t  158| remain exact raw metadata; decoded evidence supplies source pointers rather\n8249\t  159| than converting floats or inventing missing usage. No secret values are read\n8250\t  160| from the host. The process observation records parent exit, input forwarding,\n8251\t  161| pipe EOF, bounds and requested termination. Descendant end, external effects,\n8252\t  162| host active context, backend retries and semantic outcome remain unknown.\n8253\t  163| An output bound retains the observed partial chunk and refuses success; it\n8254\t  164| never truncates a stream into an apparently successful answer.\n8255\t  165| \n8256\t  166| The existing operator registers a command of this shape only after the plan,\n8257\t  167| authority, source/exposure path and actual model call have been selected:\n8258\t  168| \n8259\t  169| ```sh\n8260\t  170| python3 build_tenants/graphify/examples/fd-support/actor_cli.py --plan \"$ac_actor_plan\" --plan-sha256 \"$ac_actor_plan_sha\"\n8261\t  171| ```\n8262\t  172| \n8263\t  173| The helper performs no CLI settings migration. Preserve the selected existing\n8264\t  174| model/effort/defaults in the registered argv/configuration and record unresolved\n8265\t  175| host scope. Installed CLI help and current official references must support\n8266\t  176| the exact flags. Claude offers explicit tool/MCP selection; `--bare` changes\n8267\t  177| authentication behavior and is not a substitute for preserving the selected\n8268\t  178| existing login. No source-supported Codex option confining access to only the\n8269\t  179| selected MCP tools was established for this implementation. A read-only\n8270\t  180| sandbox alone does not establish that confinement. Record that limitation in\n8271\t  181| any proposed Codex packet rather than claiming only-tools isolation.\n8272\t  182| \n8273\t  183| The helper tests use controlled Python subprocesses with simulated vendor\n8274\t  184| streams. They establish transport discriminators and never establish actual\n8275\t  185| model usability, independence, cost/quality benefit or a Product acceptance.\n8276\t  186| \n8277\t  187| ## Explicit native STDO 3.0.1 consumer\n8278\t  188| \n8279\t  189| The read-only setup also accepts `--profile stdo-3.0.1 --product-root <consumer>\n8280\t  190| --definition-name <consumer-definition.json>`. It checks the consumer's exact\n8281\t  191| released 3.0.1 basis and uses the shipped native profile. Its mechanism pin is\n8282\t  192| the actual current implementation; it still registers no grants/executors and\n8283\t  193| cannot admit work. The [native binding and real-work operator recipe](../../design/fd-support-stdo-3.0.1.md#public-setup-and-use)\n8284\t  194| explains the supported lifecycle path and the real Product-located owner/grant\n8285\t  195| needed for effects. Native `results.conjoin` remains explicitly unsupported.\n8286\t  196| \n8287\t\n8288\t######## [32] tool:build_tenants/graphify/examples/fd-support/actor_cli.py sel=None ########\n8289\t    1| \"\"\"Optional transport-only executor for an operator-pinned Claude/Codex CLI."}]},"parent_tool_use_id":null,"session_id":"628dfe7c-13d9-4c76-8146-64fd9787ee38","uuid":"30aead5d-0ed8-4683-a155-4066ddd2691c","timestamp":"2026-10-25T03:12:43.027Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jim/.claude/projects/-Users-jim-src-apps-specification-methodology-skills/628dfe7c-13d9-4c76-8146-64fd9787ee38/tool-results/barha86i9.txt","content":"######## [29] tool:build_tenants/graphify/design/fd-method-stdo-3.0.1.json sel=None ########\n    1| {\n    2|   \"schema\": \"a_c.fd-support.method-binding/1\",\n    3|   \"id\": \"urn:a-c:fd-support:method:stdo-3.0.1-rc.1:executive:1\",\n    4|   \"status\": \"bounded-native-binding-candidate\",\n    5|   \"method\": {\n    6|     \"name\": \"STDO3.0.1 RC1\",\n    7|     \"uri\": \"stdo://releases/v3.0.1-rc.1/\",\n    8|     \"manifest_sha256\": \"60356364a412dbde8cffe68fe0eda4e2749b0162acce93495534eee13b223df8\",\n    9|     \"source_commit\": \"fe4941f56a52ed3697a2b516d8d68948b0ea65d9\",\n   10|     \"package\": \"specification_methodology/v3/\",\n   11|     \"selected_profiles\": [\n   12|       \"EXECUTIVE_BASELINE.md\"\n   13|     ]\n   14|   },\n   15|   \"builder\": {\n   16|     \"uri\": \"stdo://releases/v2.5.1-rc.2/\",\n   17|     \"manifest_sha256\": \"3d860ff4c1746f06ac25295a9e205cffb8e7725869615ac77cf2304b70ff2782\"\n   18|   },\n   19|   \"members\": [\n   20|     {\n   21|       \"member\": \"REFERENCE_FRAME.md\",\n   22|       \"sha256\": \"8152838639950b09389f99181172792100e4470b4807b4e112870cd4e6f6ba21\",\n   23|       \"clauses\": [\n   24|         \"11-the-activation-packet\",\n   25|         \"13-minimal-declarations\",\n   26|         \"rf-016-implementation-neutrality\"\n   27|       ]\n   28|     },\n   29|     {\n   30|       \"member\": \"ACTIVATION.md\",\n   31|       \"sha256\": \"56109ffa2e8ec6f158e6dbd0b387fededa685abc100a288ea88525854a78441d\",\n   32|       \"clauses\": [\n   33|         \"intake\",\n   34|         \"admission\",\n   35|         \"3-step-results-and-disposition\",\n   36|         \"7-closed-result-and-reuse\"\n   37|       ]\n   38|     },\n   39|     {\n   40|       \"member\": \"FOUNDATIONS.md\",\n   41|       \"sha256\": \"92fe2f3c09a59b4e9a732463a41d4a45d7efd693648159621e03c75f7127eac5\",\n   42|       \"clauses\": [\n   43|         \"results\",\n   44|         \"assertions-and-observation\",\n   45|         \"change-impact-and-evidence-reuse\"\n   46|       ]\n   47|     },\n   48|     {\n   49|       \"member\": \"EXECUTIVE_BASELINE.md\",\n   50|       \"sha256\": \"fcef434630e270d216f494de97ee727ad46690db89a4b73edac4b88ff921c62e\",\n   51|       \"clauses\": [\n   52|         \"19-baseline-specific-basis-and-activation-additions\",\n   53|         \"no-mutation-while-executive\"\n   54|       ]\n   55|     },\n   56|     {\n   57|       \"member\": \"AXIOMATIC_CALCULUS.md\",\n   58|       \"sha256\": \"b39c45fd86b8f9add7d196b2974a8e5f75bf4a327cf796e362716a6b4f5776d5\",\n   59|       \"clauses\": [\n   60|         \"5-traversals-and-functor-kinds\"\n   61|       ]\n   62|     },\n   63|     {\n   64|       \"member\": \"EVALUATION.md\",\n   65|       \"sha256\": \"478fd21feda72d64e62a92f970b37bade3f9aadfb17c73649cdb1a7866581eff\",\n   66|       \"clauses\": [\n   67|         \"3-independent-assessment\"\n   68|       ]\n   69|     },\n   70|     {\n   71|       \"member\": \"SPEC_METHOD.md\",\n   72|       \"sha256\": \"b2773dc0c9feb429b6b357bcfd60e7df46e54db8adcb04dc8d6dbfa023b73677\",\n   73|       \"clauses\": [\n   74|         \"11-build-tenant-binding\"\n   75|       ]\n   76|     }\n   77|   ],\n   78|   \"carrier\": \"Existing a_c.fd-support /1 carriers; this profile supplies the native semantic binding, not new method law.\",\n   79|   \"mapping\": {\n   80|     \"packet\": \"REFERENCE_FRAME section11; existing groups preserve required native coordinates. Native intake outcome/admission/shared machinery are supplied as exact sources in packet relations and grant.\",\n   81|     \"admission\": \"ACTIVATION Admission; existing Product-located mechanism and exact contract evidence remain necessary; profile selection supplies no grant.\",\n   82|     \"work_result\": \"ACTIVATION Construction availability: candidate_ready/satisfied, incomplete/falsified, refused/falsified, re_entry_requested cause determines out_of_frame or invalid_basis; no assessment manufactured.\",\n   83|     \"return\": \"ACTIVATION section7; original evaluations/not_performed/residuals/invalidators remain distinct, and currentness is consumer-relative.\",\n   84|     \"operation_outcome\": \"B(op) is output/effect-evidence payload availability, not physical completion, semantic success or admission. Existing cause-tagged mapping is retained under native FOUNDATIONS Results.\",\n   85|     \"classification\": \"Named read, render, launch and write operations are not universally classified F_D; pure finite declared predicate checks retain their narrow evidence claim. External execution and F_P meaning remain separate.\"\n   86|   },\n   87|   \"unsupported\": [\n   88|     \"results.conjoin: no native operator qualification\",\n   89|     \"arbitrary method profiles or translations\",\n   90|     \"semantic context sufficiency certification\",\n   91|     \"universal F_D classification or full calculus conformance\",\n   92|     \"OS sandboxing or actor/provider qualification\"\n   93|   ]\n   94| }\n   95| \n\n######## [30] tool:build_tenants/graphify/design/fd-support-stdo-3.0.1.md sel=None ########\n    1| # Native STDO 3.0.1 support binding\n    2| \n    3| This is the bounded successor binding for the existing Graphify support tools.\n    4| Its consumer method is released `stdo://releases/v3.0.1-rc.1/`, manifest\n    5| `60356364a412dbde8cffe68fe0eda4e2749b0162acce93495534eee13b223df8`, native commit\n    6| `fe4941f56a52ed3697a2b516d8d68948b0ea65d9`. The a_c builder remains its selected\n    7| installed 2.5.1 RC2. The [profile](fd-method-stdo-3.0.1.json) pins the native\n    8| owner files. The [requirements](../../../specification/requirements/fd-stdo-3.0.1-binding.md)\n    9| own this increment's WHAT. Existing [public wire and computational design](fd-support.md)\n   10| owns the shared realization, with the changes below. This is a development\n   11| candidate, not evidence of complete calculus or ordinary actor qualification.\n   12| \n   13| ## Native contract mapping\n   14| \n   15| | Native owner | Existing carrier/computation retained | Preservation and boundary |\n   16| |---|---|---|\n   17| | REFERENCE_FRAME §11 | Packet groups, exact source acquisition, rendered Context, actor envelope | Identity/revision, subject/basis, relations/invariants, authorities, inputs/tools, dependencies, consumer and stop/change remain explicit. Rendered byte fit is not semantic sufficiency. |\n   18| | ACTIVATION §1 Intake; EXECUTIVE_BASELINE §19 | Packet plus supplied grant and exact source references | Governed outcome, accepted transformation relations and shared-machinery dispositions belong in the supplied deciding sources/grant. The tool does not infer them or claim it checks their semantic sufficiency. Role additions retain the native Worker/Reviewer/Executive coordinates; Reviewer technical-triage capability is in generic actor capability and source references. |\n   19| | ACTIVATION §1 Admission | Product-located owner record, exact mechanism digest, grant, preconditions, preflight contract receipt | Drafting does not admit. A source-authorized operator selects the actual owner binding and grant; preflight validates that exact contract. No role/profile name or example setup grants authority. |\n   20| | ACTIVATION §3 | Closed return: evaluations, not_performed, work_result, residuals | An available report can say construction incomplete; report availability does not satisfy construction or unperformed assessment. The original actor values are preserved. Semantic legality remains an evaluation obligation. |\n   21| | ACTIVATION §7; FOUNDATIONS observation sufficiency | Original return, consumer/context coordinates, explicit observations, invalidators and dependencies | Consumers retain currentness and continuation distinctions; byte equality alone supplies no applicability claim. Existing return checks retain unknowns and compare supplied coordinates. No general context compression or future-behaviour theorem is claimed. |\n   22| | FOUNDATIONS Results; SPEC_METHOD §11 | Public operation_outcome | B(op) means the requested exact output/effect-evidence payload is available. The original cause-tagged mapping is retained with the native Results parent. Successful dispatch/observation is neither task success nor physical effect completion. |\n   23| | AXIOMATIC_CALCULUS §5 | Named domain operations and bounded predicate primitives | No blanket F_D reclassification. A native F_D claim needs its own closed domain/dependencies/outcomes/termination argument. Source acquisition and external execution remain named operations; an LLM's semantic output remains F_P. |\n   24| \n   25| Example: a process times out and yields a complete observation with unknown\n   26| external completion. `dispatch.observe` may satisfy B(observe); its effect is\n   27| still unknown. An authenticated actor report of `incomplete` preserves that\n   28| construction-availability value; absent assessments stay in `not_performed`.\n   29| The operation's availability result does not convert either into success.\n   30| \n   31| ## Shared implementation and selected profile\n   32| \n   33| The two supported profiles have curated exact id/digest pairs. Runtime carries\n   34| the selected pair from the operator policy; no caller supplies executable\n   35| profile logic. Native startup also requires the consumer Product Definition's\n   36| exact 3.0.1 release URI and manifest. Profile bytes are reacquired and hashed.\n   37| Catalogs, output parents, provenance, packet/return basis and effect replay\n   38| checks use that selected identity. RC9 history and source pins remain intact.\n   39| \n   40| The common algorithms are retained because the mapped native contracts above\n   41| require the same declared coordinate and evidence relations. A future material\n   42| semantic difference requires a separately justified implementation change;\n   43| a matching carrier shape alone would not justify reuse.\n   44| \n   45| All existing public operations are exposed for this bounded profile except\n   46| `results.conjoin`, which refuses `unsupported_check` and is omitted from native\n   47| CLI/MCP inventory. The only existing conjunction schema/operator is RC9-specific.\n   48| An Executive may perform its declared native F_P decision over original results;\n   49| it must not present that decision as a tool-computed native conjunction.\n   50| Models queried through record/graph operations retain their own exact model\n   51| basis; selecting this tool profile neither migrates nor accepts a model.\n   52| \n   53| ## Public setup and use\n   54| \n   55| For source acquisition on an explicitly selected consumer, from any directory:\n   56| \n   57| ```sh\n   58| python3 -B \"$ac_root/build_tenants/graphify/examples/fd-support/prepare_readonly.py\" \\\n   59|   --out \"$fresh_setup\" --profile stdo-3.0.1 \\\n   60|   --product-root \"$consumer_root\" --definition-name stdo_skills.json\n   61| ```\n   62| \n   63| `SETUP.json` gives the exact policy path and digest; `requests/describe.json`,\n   64| `read-product.json` and `observe.json` are ready public requests. Read-only setup\n   65| registers no work grant or executor. Its mechanism coordinate uses the real\n   66| implementation digest, but the demonstration operator record is not an admitted\n   67| Product work owner. It cannot perform preflight, dispatch or authoritative writes.\n   68| \n   69| ```sh\n   70| python3 -B \"$ac_root/build_tenants/graphify/code/ac_support.py\" \\\n   71|   --policy \"$policy\" --policy-sha256 \"$policy_sha256\" --principal executive \\\n   72|   call --request \"$request\"\n   73| ```\n   74| \n   75| `mcp` in place of `call --request ...` serves the same full envelopes. Invoke\n   76| `tools.describe` for each selected operation's actual request and result schemas.\n   77| \n   78| ### Real work policy: operator recipe\n   79| \n   80| The public mechanism is the existing `product-policy-preflight/1`; the policy is\n   81| trusted operator configuration, not an actor-supplied work request. Use the\n   82| [Product-bound admission contract](fd-support.md#product-bound-admission-and-exact-dispatch)\n   83| and the public schemas. The required preparation is:\n   84| \n   85| 1. Record the actual owner instruction, selected outcome, limits and permitted\n   86|    effects. Reference an existing Product-local JSON owner record through a\n   87|    supported URI slot in the Product Definition (for example a declared\n   88|    `reference_frame_bases` authority). The policy's `definition_locator` is the\n   89|    JSON Pointer to that exact URI. The record has `mechanism`, `result_surface`\n   90|    and `scope`; the selected mechanism source/digest names the current\n   91|    `ac_support_core.py`, and the surface names the actual protected evidence\n   92|    root, namespace and consumer. The tool verifies record/definition agreement;\n   93|    hashes do not authenticate the human who selected it.\n   94| 2. Supply exact SourceRefs for the Product Definition, native profile, owner,\n   95|    role bindings and deciding task/source/evidence files. Register their roots\n   96|    and read scopes. Mark only granted Worker territory writable; keep policy,\n   97|    implementation, method and protected evidence outside that territory.\n   98| 3. Register fixed principals with their actor/role/provenance and operation\n   99|    permissions. Bind an existing grant: authority_sources, outcome, authorized\n  100|    principals/targets, operations/tools, executor IDs, territory, preconditions,\n  101|    admission selection and notification sink. Its admission selection names\n  102|    the exact mechanism/source/owner, required predicates and allowed override\n  103|    sources; use empty collections only when the actual work contract requires\n  104|    none. Do not create dummy satisfied predicates or approval receipts.\n  105| 4. Register the actual fixed executor: executable and digest, full argv, all\n  106|    declared dependencies, cwd/environment, actor identity, settings/tool set,\n  107|    effect scope, stdin Context mode, decoder and observations. The existing\n  108|    [actor CLI adapter](../examples/fd-support/README.md#optional-cli-transport-helper)\n  109|    can invoke either host. Preserve its fixed-plan and actual-output contract.\n  110|    Native profile selection does not qualify a provider, model or executor.\n  111| 5. Freeze the complete policy bytes/digest. Public `context.assemble` consumes\n  112|    the caller-selected packet and exact sources. Public `contract.preflight`\n  113|    creates the actual admission receipt only after its checks pass.\n  114|    `dispatch.start` takes that receipt, not arbitrary argv. Observe completion;\n  115|    `return.capture` takes the actual retained final stdout and original return\n  116|    contract, followed by `return.check`. The Executive consumes these results\n  117|    and decides the next authorized action.\n  118| \n  119| A complete policy has the same closed fields as the existing public contract:\n  120| `schema`, `id`, `product`, `method_profile`, `sources`, `principals`, `grants`,\n  121| `predicates`, `operators`, `executors`, `event_sinks`, `independence_policy`,\n  122| `evidence_root`, `limits`, `authority_sources`. For this profile, `operators`\n  123| may be empty; a native conjunction registration is not currently supported.\n  124| The shipped tests construct synthetic authority only inside isolated fixtures;\n  125| they are not an ordinary admission generator.\n  126| \n  127| ## Verification and remaining work\n  128| \n  129| `test_ac_support_native301.py` exercises native public CLI discovery/source/\n  130| observation, legacy-profile rejection, exact Product-basis rejection, reassembled\n  131| activation retry refusal, material-source staleness before launch, and an actual\n  132| local subprocess through capture/check preserving an incomplete work report.\n  133| The actor is a controlled deterministic transport fixture. Existing core,\n  134| effects and CLI/MCP tests cover the retained RC9 path. Real Codex/Claude use,\n  135| semantic migration assessment, context adequacy, and Product acceptance remain\n  136| separate evidence obligations.\n  137| \n\n######## [31] tool:build_tenants/graphify/examples/fd-support/README.md sel=None ########\n    1| # Public support-tool setup\n    2| \n    3| `prepare_readonly.py` creates a fresh, disposable operator configuration for\n    4| discovery and exact source acquisition. It uses the ordinary public CLI/MCP,\n    5| the real policy validator and the shipped method profile. It creates three\n    6| example principals with the same nine read/query permissions. They are not\n    7| actual F_P actors or independent assessors.\n    8| \n    9| The configuration has **no work grants or executors**. Its required admission\n   10| binding contains a visibly unqualified implementation placeholder. It grants\n   11| no Product work and cannot admit preflight, dispatch or authoritative writing.\n   12| The current Product owner binding is a separate authority surface; this example\n   13| does not ratify it. A trusted operator must select and verify real authority\n   14| before preparing a real task policy.\n   15| \n   16| From `a_c/`, with Python 3.11 or later:\n   17| \n   18| ```sh\n   19| ac_example_parent=\"$(python3 -c 'import pathlib,tempfile; print(pathlib.Path(tempfile.mkdtemp()).resolve())')\"\n   20| python3 build_tenants/graphify/examples/fd-support/prepare_readonly.py --out \"$ac_example_parent/demo\"\n   21| ac_example_sha=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"policy_sha256\"])' \"$ac_example_parent/demo/SETUP.json\")\"\n   22| \n   23| python3 build_tenants/graphify/code/ac_support.py --policy \"$ac_example_parent/demo/policy.json\" --policy-sha256 \"$ac_example_sha\" --principal executive call --request \"$ac_example_parent/demo/requests/describe.json\"\n   24| python3 build_tenants/graphify/code/ac_support.py --policy \"$ac_example_parent/demo/policy.json\" --policy-sha256 \"$ac_example_sha\" --principal worker call --request \"$ac_example_parent/demo/requests/read-product.json\"\n   25| python3 build_tenants/graphify/code/ac_support.py --policy \"$ac_example_parent/demo/policy.json\" --policy-sha256 \"$ac_example_sha\" --principal reviewer mcp < \"$ac_example_parent/demo/mcp-session.jsonl\"\n   26| ```\n   27| \n   28| The setup output supplies the exact policy byte digest. `source.read` returns\n   29| actual Product Definition content, its parent hash and acquisition route;\n   30| `workspace.observe` observes the named current file. The MCP example initializes,\n   31| lists the same operation contracts and acquires source through a full request\n   32| envelope. A policy lists core capabilities separately from the operations its\n   33| principals may perform.\n   34| \n   35| Setup resolves the operator-selected fresh output to its actual canonical path\n   36| before creating any policy or source binding. `SETUP.json` records those exact\n   37| paths. Use them for subsequent invocations; registered source/evidence paths\n   38| continue to refuse symlink aliases such as a macOS `/var` alias. No admitted\n   39| path or source hash is silently replaced.\n   40| \n   41| Run the negative example with `requests/denied-preflight.json`: it returns a\n   42| refusal and CLI exit 2. Changing the policy without changing the operator's\n   43| expected digest also refuses. The setup will not overwrite an existing output\n   44| directory. Keep any partial directory after a setup failure as observed evidence;\n   45| choose a fresh output for another attempt.\n   46| \n   47| For a real task, the Product operator supplies an existing Product-located owner\n   48| binding and work grant, exact role/packet/return contract, source and method\n   49| bases, effect territory, evidence surface, registered executor and dependency\n   50| pins. Discover their concrete contracts with `tools.describe` and re-enter the\n   51| [tenant design](../../design/fd-support.md). Source hashes establish exact bytes;\n   52| they do not authenticate whoever wrote a grant. Register no arbitrary caller\n   53| shell command, argv suffix, environment or endpoint.\n   54| \n   55| The ordinary development path is caller-selected: Executive acquires current\n   56| source and prepares a contract; Worker acquires deciding source/proof and\n   57| returns its candidate; Reviewer records actual source-derived expectations\n   58| before candidate exposure, then acquires candidate/proof directly. The selected\n   59| F_P actors and existing owner retain semantic judgment and disposition. Only\n   60| actual final output from a registered dispatched Attempt can authenticate a\n   61| return through this tool. Fresh contexts, example personas and fixture answers\n   62| prove no independent semantic result or actor usability.\n   63| \n   64| Actual actor/provider runs require their separately selected exact executor,\n   65| configuration, context, source/exposure plan and approved work authority. This\n   66| setup invokes none. Source-first transport records establish scoped writes,\n   67| not that an actor mentally attended to the supplied bytes. Missing delivery or\n   68| external exposure remains unknown.\n   69| \n   70| ## Optional CLI transport helper\n   71| \n   72| `actor_cli.py` is a stdlib adapter for a separately registered Claude or Codex\n   73| CLI executor. It forwards the exact stdin Context bytes, captures the actual\n   74| vendor stdout/stderr, and emits the actual final answer bytes. It supplies no\n   75| prompt, model, grant, default answer, semantic repair or retry. A direct helper\n   76| run authenticates no actor. Authentication and the exact Context/activation\n   77| binding come from an admitted registered Attempt through the ordinary tool.\n   78| \n   79| An operator first freezes a JSON plan and its raw SHA-256. The closed plan has\n   80| these fields; none can be supplied as a public tool argument or argv suffix:\n   81| \n   82| | Field | Operator-selected value |\n   83| | --- | --- |\n   84| | `schema`, `id`, `backend` | `a_c.fd-support.actor-cli-plan/1`, a fixed identifier, and `claude` or `codex` |\n   85| | `executable` | Actual regular-file absolute `path` and lowercase byte `sha256` |\n   86| | `argv` | Complete fixed argument array, beginning with that executable path |\n   87| | `dependencies` | Explicit array of regular-file `{path, sha256}` pins, including scripts, loaders and configuration used by the registered call |\n   88| | `cwd` | Exact existing absolute working directory |\n   89| | `environment` | Complete selected string map, apart from protected unchanged pass-through below |\n   90| | `settings` | Exact operator-declared selected settings and known unknowns; declarations never override argv or infer defaults |\n   91| | `decoder` | One of the three fixed profiles below, matching the backend |\n   92| | `evidence_directory` | Fresh absolute directory under an existing operator-owned parent |\n   93| | `limits` | Positive integer `max_input_bytes`, `max_output_bytes`, `timeout_ms`, `termination_grace_ms` |\n   94| \n   95| Register the helper interpreter, helper, core parser, frozen plan, native\n   96| executable and its actual loader/configuration chain under the existing\n   97| Executor dependency controls. The helper rechecks plan and listed file pins\n   98| immediately before child launch. It rejects symlink path components and starts\n   99| the fixed argv without a shell. Pinning a path or configuration file is not a\n  100| claim that it covers all host effects or all dynamically loaded dependencies.\n  101| \n  102| `HOME`, `home` and `CODEX_HOME` cannot appear in the plan environment. If already\n  103| present in the registered helper process, they pass through unchanged and are\n  104| recorded separately with that provenance. Absent values stay absent. The\n  105| helper reads no authentication files. Other selected environment values are\n  106| explicit; an operator must not place credential values in the plan or its\n  107| retained evidence.\n  108| \n  109| For Claude OAuth supplied through the invoking process environment, the trusted\n  110| operator may select `settings.environment_passthrough` as\n  111| `[\"CLAUDE_CODE_OAUTH_TOKEN\"]` in **both** the registered Executor and the fixed\n  112| actor plan. This is a reserved setting with a fixed supported-name allowlist;\n  113| it does not accept caller selectors, token values or alternate variable names.\n  114| The named credential is forbidden in either serialized `environment` map.\n  115| Without the setting, the existing exact environment behavior is unchanged.\n  116| \n  117| Dispatch privately copies the existing selected value into the supervisor;\n  118| the supervisor privately copies it into the registered helper; the helper\n  119| privately copies it into the vendor process. Values are unchanged, never\n  120| serialized or hashed by these boundaries. Attempt and helper invocation\n  121| records contain selected names and presence booleans only. Absence stays\n  122| absent, and authentication success is never inferred from presence. A selected\n  123| name present in the dispatcher but absent in a resumed supervisor is refused\n  124| as a changed launch observation. Credential identity is deliberately not\n  125| pinned or proven by this mechanism. Raw vendor output remains exact; the\n  126| registered vendor must not emit credential values into its own output.\n  127| \n  128| The selected decoder is part of the frozen plan:\n  129| \n  130| - `claude-result-json/1` requires one JSON object: a terminal `type: \"result\"`,\n  131|   `subtype: \"success\"`, `is_error: false`, with nonempty string `result`.\n  132| - `claude-result-jsonl/1` requires JSON objects on lines and exactly one such\n  133|   terminal result at the end. Earlier partial events remain raw evidence.\n  134| - `codex-final-jsonl/1` requires one final `turn.completed` and selects the last\n  135|   preceding `item.completed` with `item.type: \"agent_message\"` and string `text`.\n  136|   Earlier commentary is retained and is never concatenated into the answer.\n  137| \n  138| These are explicit decoder profiles for the documented\n  139| [Claude JSON/result and streaming formats](https://code.claude.com/docs/en/headless)\n  140| and [Codex JSONL events](https://learn.chatgpt.com/docs/non-interactive-mode).\n  141| They select final text only; Claude `structured_output` is not an alternative\n  142| answer route in these profiles. Multiple turns/results, missing final output,\n  143| failed terminal events, malformed JSON and nonzero process exits fail. Later\n  144| real-CLI trials must qualify the exact selected executable/profile combination.\n  145| \n  146| The final text must parse through the ordinary integer-only core JSON grammar\n  147| as an object with `schema: \"a_c.fd-support.closed-return/1\"`. Its original UTF-8\n  148| bytes, including whitespace, are forwarded unchanged. Decimal/exponent public\n  149| numbers, duplicate keys, nonfinite values, code fences or a missing schema\n  150| fail; none is repaired. The helper checks only this transport grammar and tag.\n  151| The actual return contract, activation identity, proof and semantics remain\n  152| with the existing return capture/check and F_P owners.\n  153| \n  154| On each fresh run the helper retains `plan.json`, `context.bin`,\n  155| `invocation.json`, `vendor.stdout`, `vendor.stderr`, `process.json` and\n  156| `result.json`, as far as the actual failure permits. A successful decode also\n  157| retains `final.payload` and `decoded.json`. Vendor usage, settings and costs\n  158| remain exact raw metadata; decoded evidence supplies source pointers rather\n  159| than converting floats or inventing missing usage. No secret values are read\n  160| from the host. The process observation records parent exit, input forwarding,\n  161| pipe EOF, bounds and requested termination. Descendant end, external effects,\n  162| host active context, backend retries and semantic outcome remain unknown.\n  163| An output bound retains the observed partial chunk and refuses success; it\n  164| never truncates a stream into an apparently successful answer.\n  165| \n  166| The existing operator registers a command of this shape only after the plan,\n  167| authority, source/exposure path and actual model call have been selected:\n  168| \n  169| ```sh\n  170| python3 build_tenants/graphify/examples/fd-support/actor_cli.py --plan \"$ac_actor_plan\" --plan-sha256 \"$ac_actor_plan_sha\"\n  171| ```\n  172| \n  173| The helper performs no CLI settings migration. Preserve the selected existing\n  174| model/effort/defaults in the registered argv/configuration and record unresolved\n  175| host scope. Installed CLI help and current official references must support\n  176| the exact flags. Claude offers explicit tool/MCP selection; `--bare` changes\n  177| authentication behavior and is not a substitute for preserving the selected\n  178| existing login. No source-supported Codex option confining access to only the\n  179| selected MCP tools was established for this implementation. A read-only\n  180| sandbox alone does not establish that confinement. Record that limitation in\n  181| any proposed Codex packet rather than claiming only-tools isolation.\n  182| \n  183| The helper tests use controlled Python subprocesses with simulated vendor\n  184| streams. They establish transport discriminators and never establish actual\n  185| model usability, independence, cost/quality benefit or a Product acceptance.\n  186| \n  187| ## Explicit native STDO 3.0.1 consumer\n  188| \n  189| The read-only setup also accepts `--profile stdo-3.0.1 --product-root <consumer>\n  190| --definition-name <consumer-definition.json>`. It checks the consumer's exact\n  191| released 3.0.1 basis and uses the shipped native profile. Its mechanism pin is\n  192| the actual current implementation; it still registers no grants/executors and\n  193| cannot admit work. The [native binding and real-work operator recipe](../../design/fd-support-stdo-3.0.1.md#public-setup-and-use)\n  194| explains the supported lifecycle path and the real Product-located owner/grant\n  195| needed for effects. Native `results.conjoin` remains explicitly unsupported.\n  196| \n\n######## [32] tool:build_tenants/graphify/examples/fd-support/actor_cli.py sel=None ########\n    1| \"\"\"Optional transport-only executor for an operator-pinned Claude/Codex CLI.","numLines":436,"startLine":7854,"totalLines":9949}},"tool_result_meta":[{"id":"toolu_01KoHHpCKZE8G1ezom1DEbMu","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgNDxrCJetQoMgWk1uiMf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BjGzod6NLBCr54aas4Yt8F","name":"Read","input":{"file_path":"/Users/jim/.claude/projects/-Users-jim-src-apps-specification-methodology-skills/628dfe7c-13d9-4c76-8146-64fd9787ee38/tool-results/barha86i9.txt","offset":8948,"limit":440},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":7166,"cache_read_input_tokens":247181,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7166},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"628dfe7c-13d9-4c76-8146-64fd9787ee38","uuid":"dc0ac585-883c-4f0b-a612-190324467a51","timestamp":"2026-10-25T03:12:44.430Z","request_id":"req_011CgNDxqxAK1Who3PGXriGQ","wire_tool_inputs":{"toolu_01BjGzod6NLBCr54aas4Yt8F":{"file_path":"/Users/jim/.claude/projects/-Users-jim-src-apps-specification-methodology-skills/628dfe7c-13d9-4c76-8146-64fd9787ee38/tool-results/barha86i9.txt","offset":8948,"limit":440}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BjGzod6NLBCr54aas4Yt8F","type":"tool_result","content":"8948\t######## [34] tool:build_tenants/graphify/test_env/test_ac_support_environment_passthrough.py sel=None ########\n8949\t    1| \"\"\"Actual native dispatch transport controls; no credential or model is acquired.\n8950\t    2| \n8951\t    3| The only credential-like value is freshly generated test data. A loopback test\n8952\t    4| oracle compares its actual child value in memory, retaining only a boolean.\n8953\t    5| All public requests, responses, helper evidence and test files are scanned for\n8954\t    6| the synthetic value before custody. Fixtures do not establish Product authority.\n8955\t    7| \"\"\"\n8956\t    8| from pathlib import Path\n8957\t    9| import hashlib\n8958\t   10| import json\n8959\t   11| import os\n8960\t   12| import secrets\n8961\t   13| import socket\n8962\t   14| import subprocess\n8963\t   15| import sys\n8964\t   16| import threading\n8965\t   17| import time\n8966\t   18| import unittest\n8967\t   19| \n8968\t   20| sys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"code\"))\n8969\t   21| import ac_support_core as c\n8970\t   22| import test_ac_support_native301 as native\n8971\t   23| \n8972\t   24| \n8973\t   25| NAME = \"CLAUDE_CODE_OAUTH_TOKEN\"\n8974\t   26| \n8975\t   27| \n8976\t   28| class EnvironmentPassthroughTests(unittest.TestCase):\n8977\t   29|     _select_policy = native.Native301PublicTests._select_policy\n8978\t   30|     _ok = native.Native301PublicTests._ok\n8979\t   31|     _assemble = native.Native301PublicTests._assemble\n8980\t   32|     _admit = native.Native301PublicTests._admit\n8981\t   33|     _finished = native.Native301PublicTests._finished\n8982\t   34|     tearDown = native.Native301PublicTests.tearDown\n8983\t   35| \n8984\t   36|     def setUp(self):\n8985\t   37|         native.Native301PublicTests.setUp(self)\n8986\t   38|         # Never copy the real test runner's environment or read its credentials.\n8987\t   39|         self.dispatch_environment = {\"PATH\": os.defpath, \"PYTHONDONTWRITEBYTECODE\": \"1\"}\n8988\t   40|         self.sentinel = secrets.token_urlsafe(48)\n8989\t   41|         self.oracle_observations = []\n8990\t   42| \n8991\t   43|     def _public(self, operation, arguments):\n8992\t   44|         self.sequence += 1\n8993\t   45|         folder = self.root / \"calls\" / (str(self.sequence).zfill(3) + \"-\" + operation)\n8994\t   46|         folder.mkdir(parents=True)\n8995\t   47|         request = {\"schema\": c.REQUEST, \"id\": \"public-\" + str(self.sequence),\n8996\t   48|                    \"operation\": operation, \"arguments\": arguments}\n8997\t   49|         path = folder / \"request.json\"\n8998\t   50|         path.write_bytes(c.canonical(request))\n8999\t   51|         argv = [str(self.python), \"-B\", str(self.code / \"ac_support.py\"),\n9000\t   52|                 \"--policy\", str(self.policy_path), \"--policy-sha256\", self.policy_sha,\n9001\t   53|                 \"--principal\", \"executive\", \"call\", \"--request\", str(path)]\n9002\t   54|         started = time.time_ns()\n9003\t   55|         result = subprocess.run(argv, cwd=self.root, capture_output=True, timeout=10,\n9004\t   56|                                 env=self.dispatch_environment, check=False)\n9005\t   57|         (folder / \"stdout.bin\").write_bytes(result.stdout)\n9006\t   58|         (folder / \"stderr.bin\").write_bytes(result.stderr)\n9007\t   59|         (folder / \"execution.json\").write_bytes(c.canonical({\n9008\t   60|             \"argv\": argv, \"started_ns\": started, \"ended_ns\": time.time_ns(),\n9009\t   61|             \"returncode\": result.returncode, \"policy_sha256\": self.policy_sha}))\n9010\t   62|         response = c.parse_json(result.stdout)\n9011\t   63|         self.assertIsNotNone(response[\"evidence\"], response)\n9012\t   64|         return response\n9013\t   65| \n9014\t   66|     def _prepare(self, executor_selected, helper_selected, supplied):\n9015\t   67|         if supplied:\n9016\t   68|             self.dispatch_environment[NAME] = self.sentinel\n9017\t   69|         listener = socket.socket()\n9018\t   70|         listener.bind((\"127.0.0.1\", 0))\n9019\t   71|         listener.listen(1)\n9020\t   72|         listener.settimeout(8)\n9021\t   73|         self.addCleanup(listener.close)\n9022\t   74|         port = listener.getsockname()[1]\n9023\t   75| \n9024\t   76|         def oracle():\n9025\t   77|             try:\n9026\t   78|                 connection, _ = listener.accept()\n9027\t   79|                 with connection:\n9028\t   80|                     raw = b\"\"\n9029\t   81|                     while True:\n9030\t   82|                         part = connection.recv(1024)\n9031\t   83|                         if not part:\n9032\t   84|                             break\n9033\t   85|                         raw += part\n9034\t   86|                     # No synthetic value or digest leaves this test process.\n9035\t   87|                     self.oracle_observations.append({\n9036\t   88|                         \"present\": raw[:1] == b\"1\",\n9037\t   89|                         \"unchanged\": raw == b\"1\" + self.sentinel.encode(),\n9038\t   90|                     })\n9039\t   91|             except OSError:\n9040\t   92|                 self.oracle_observations.append({\"oracle_failed\": True})\n9041\t   93| \n9042\t   94|         self.oracle_thread = threading.Thread(target=oracle, daemon=True)\n9043\t   95|         self.oracle_thread.start()\n9044\t   96|         vendor = self.f.write(\"inputs/synthetic_vendor.py\", b'''import json,os,socket,sys\n9045\t   97| sys.stdin.buffer.read()\n9046\t   98| value=os.environ.get(\"CLAUDE_CODE_OAUTH_TOKEN\")\n9047\t   99| with socket.create_connection((\"127.0.0.1\",int(sys.argv[1])),timeout=3) as connection:\n9048\t  100|  connection.sendall(b\"0\" if value is None else b\"1\"+value.encode())\n9049\t  101|  connection.shutdown(socket.SHUT_WR)\n9050\t  102| if value is None:\n9051\t  103|  print(json.dumps({\"type\":\"result\",\"subtype\":\"error\",\"is_error\":True,\"error\":\"authentication_failed\",\"result\":\"Synthetic credential missing\",\"total_cost_usd\":0}))\n9052\t  104|  raise SystemExit(1)\n9053\t  105| print(json.dumps({\"type\":\"result\",\"subtype\":\"success\",\"is_error\":False,\"result\":json.dumps({\"schema\":\"a_c.fd-support.closed-return/1\",\"opaque\":\"synthetic transport only\"})}))\n9054\t  106| ''')\n9055\t  107|         tenant = self.code.parent\n9056\t  108|         helper = tenant / \"examples/fd-support/actor_cli.py\"\n9057\t  109|         core = self.code / \"ac_support_core.py\"\n9058\t  110|         self.f.policy[\"sources\"][\"tool\"] = {\n9059\t  111|             \"path\": str(tenant), \"kind\": \"workspace\", \"writable\": False,\n9060\t  112|             \"read_scope\": [{\"path\": \"code\", \"kind\": \"directory\"},\n9061\t  113|                            {\"path\": \"examples/fd-support\", \"kind\": \"directory\"}]}\n9062\t  114|         settings = {\"scope\": \"synthetic transport control only\"}\n9063\t  115|         if helper_selected:\n9064\t  116|             settings[\"environment_passthrough\"] = [NAME]\n9065\t  117|         document = {\n9066\t  118|             \"schema\": \"a_c.fd-support.actor-cli-plan/1\", \"id\": \"synthetic-auth-transport\",\n9067\t  119|             \"backend\": \"claude\",\n9068\t  120|             \"executable\": {\"path\": str(self.python), \"sha256\": hashlib.sha256(self.python.read_bytes()).hexdigest()},\n9069\t  121|             \"argv\": [str(self.python), \"-B\", str(self.f.workspace / vendor[\"path\"]), str(port)],\n9070\t  122|             \"dependencies\": [{\"path\": str(self.f.workspace / vendor[\"path\"]), \"sha256\": vendor[\"sha256\"]}],\n9071\t  123|             \"cwd\": str(self.f.workspace), \"environment\": {\"PYTHONDONTWRITEBYTECODE\": \"1\"},\n9072\t  124|             \"settings\": settings, \"decoder\": \"claude-result-json/1\",\n9073\t  125|             \"evidence_directory\": str(self.root / \"helper-output\"),\n9074\t  126|             \"limits\": {\"max_input_bytes\": 1048576, \"max_output_bytes\": 1048576,\n9075\t  127|                        \"timeout_ms\": 3000, \"termination_grace_ms\": 100}}\n9076\t  128|         plan_ref = self.f.write(\"inputs/actor-plan.json\", document)\n9077\t  129|         executor = self.f.policy[\"executors\"][\"registered\"]\n9078\t  130|         executor[\"argv\"] = [str(self.python), \"-B\", str(helper), \"--plan\",\n9079\t  131|                             str(self.f.workspace / plan_ref[\"path\"]), \"--plan-sha256\", plan_ref[\"sha256\"]]\n9080\t  132|         executor[\"dependencies\"] = [vendor, plan_ref,\n9081\t  133|             self.f.ref(helper, \"tool\", \"examples/fd-support/actor_cli.py\"),\n9082\t  134|             self.f.ref(core, \"tool\", \"code/ac_support_core.py\")]\n9083\t  135|         executor[\"settings\"] = {\"timeout_ms\": 5000, \"termination_grace_ms\": 100}\n9084\t  136|         if executor_selected:\n9085\t  137|             executor[\"settings\"][\"environment_passthrough\"] = [NAME]\n9086\t  138|         self._select_policy()\n9087\t  139|         return document\n9088\t  140| \n9089\t  141|     def _whole_path(self, *, executor_selected, helper_selected, supplied):\n9090\t  142|         self._prepare(executor_selected, helper_selected, supplied)\n9091\t  143|         receipt = self._admit(self._assemble())\n9092\t  144|         started = self._public(\"dispatch.start\", {\"preflight\": receipt})\n9093\t  145|         self._ok(started)\n9094\t  146|         attempt = started[\"result\"][\"artifact\"]\n9095\t  147|         observed = self._ok(self._finished(attempt, timeout=8))\n9096\t  148|         self.oracle_thread.join(timeout=2)\n9097\t  149|         expected = executor_selected and helper_selected and supplied\n9098\t  150|         self.assertEqual(self.oracle_observations, [{\"present\": expected, \"unchanged\": expected}])\n9099\t  151|         result = json.loads((self.root / \"helper-output/result.json\").read_bytes())\n9100\t  152|         self.assertEqual(result[\"output_available\"], expected)\n9101\t  153|         self.assertIsNone(result[\"semantic_result\"])\n9102\t  154|         self.assertEqual(observed[\"process_end\"][\"returncode\"], 0 if expected else 1)\n9103\t  155|         invocation = json.loads((self.root / \"helper-output/invocation.json\").read_bytes())\n9104\t  156|         if helper_selected:\n9105\t  157|             self.assertEqual(invocation[\"environment_passthrough\"],\n9106\t  158|                              [{\"name\": NAME, \"present\": executor_selected and supplied}])\n9107\t  159|         else:\n9108\t  160|             self.assertNotIn(\"environment_passthrough\", invocation)\n9109\t  161|         retained = self._ok(self._public(\"evidence.read\", {\"artifact\": attempt}))[\"envelope\"][\"payload\"]\n9110\t  162|         if executor_selected:\n9111\t  163|             self.assertEqual(retained[\"invocation\"][\"environment_passthrough\"], [{\"name\": NAME, \"present\": supplied}])\n9112\t  164|         else:\n9113\t  165|             self.assertNotIn(\"environment_passthrough\", retained[\"invocation\"])\n9114\t  166|         (self.root / \"ORACLE.json\").write_bytes(c.canonical({\n9115\t  167|             \"observations\": self.oracle_observations,\n9116\t  168|             \"scope\": \"Synthetic value compared in memory after actual dispatcher/supervisor/helper/vendor traversal; no model or real credentials\"}))\n9117\t  169|         for path in self.root.rglob(\"*\"):\n9118\t  170|             if path.is_file():\n9119\t  171|                 self.assertFalse(self.sentinel.encode() in path.read_bytes(), str(path.relative_to(self.root)))\n9120\t  172| \n9121\t  173|     def test_selected_value_crosses_complete_native_path_without_retention(self):\n9122\t  174|         self._whole_path(executor_selected=True, helper_selected=True, supplied=True)\n9123\t  175| \n9124\t  176|     def test_selected_missing_value_remains_missing_and_transport_fails(self):\n9125\t  177|         self._whole_path(executor_selected=True, helper_selected=True, supplied=False)\n9126\t  178| \n9127\t  179|     def test_no_selection_preserves_exact_environment_behavior(self):\n9128\t  180|         self._whole_path(executor_selected=False, helper_selected=False, supplied=True)\n9129\t  181| \n9130\t  182|     def test_helper_selection_cannot_recover_value_dropped_by_supervisor(self):\n9131\t  183|         self._whole_path(executor_selected=False, helper_selected=True, supplied=True)\n9132\t  184| \n9133\t  185|     def test_executor_selection_does_not_enable_unselected_helper(self):\n9134\t  186|         self._whole_path(executor_selected=True, helper_selected=False, supplied=True)\n9135\t  187| \n9136\t  188|     def test_preflight_refuses_unsupported_or_value_bearing_selection(self):\n9137\t  189|         for selected in ([\"PATH\"], [NAME, NAME], {NAME: \"not-a-credential\"}, NAME):\n9138\t  190|             with self.subTest(selection_type=type(selected).__name__):\n9139\t  191|                 self.f.policy[\"executors\"][\"registered\"][\"settings\"][\"environment_passthrough\"] = selected\n9140\t  192|                 self._select_policy()\n9141\t  193|                 response = self._public(\"contract.preflight\", {\"context\": self._assemble(),\n9142\t  194|                     \"grant_id\": \"work\", \"executor_id\": \"registered\", \"result_key\": \"refused-selection\", \"observations\": []})\n9143\t  195|                 self.assertEqual(response[\"refusal\"][\"code\"], \"unsupported_executor\")\n9144\t  196| \n9145\t  197|     def test_serialized_credential_is_refused_by_preflight_and_helper(self):\n9146\t  198|         document = self._prepare(True, True, False)\n9147\t  199|         executor = self.f.policy[\"executors\