: self.f.ref(self.f.authorities / 'profile.json', 'authority', 'profile.json')}\n9204\t   30|         self._select_policy()\n9205\t   31| \n9206\t   32|     def test_discovery_acquisition_observation_and_native_provenance(self):\n9207\t   33|         discovery = self._ok(self._public('tools.describe', {'method_profile': self.native}))\n9208\t   34|         self.assertEqual(discovery['method_profile'], self.native)\n9209\t   35|         self.assertNotIn('results.conjoin', [x['name'] for x in discovery['operations']])\n9210\t   36|         source = self._public('source.read', {'source': self.f.law, 'encoding': 'utf8'})\n9211\t   37|         self.assertEqual(self._ok(source)['content'], 'one\\ntwo\\nthree\\n')\n9212\t   38|         self.assertEqual(source['operation_outcome']['source_parent']['sha256'], c.NATIVE_FOUNDATIONS_SHA256)\n9213\t   39|         operation = self._ok(self._public('evidence.read', {'artifact': source['evidence']}))\n9214\t   40|         self.assertEqual(operation['envelope']['provenance']['method_profile_sha256'], c.NATIVE_PROFILE_SHA256)\n9215\t   41|         observed = self._ok(self._public('workspace.observe', {'scope': [{'root': 'workspace', 'path': 'inputs/law.txt', 'kind': 'file'}]}))\n9216\t   42|         self.assertTrue(observed['entries'])\n9217\t   43|         refused = self._public('tools.describe', {'operation': 'results.conjoin'})\n9218\t   44|         self.assertEqual(refused['refusal']['code'], 'unsupported_check')\n9219\t   45| \n9220\t   46|     def test_legacy_packet_is_not_relabelled_native(self):\n9221\t   47|         packet = self.f.packet()\n9222\t   48|         packet['subject_basis']['method_profile'] = {'id': c.PROFILE_ID, 'sha256': c.PROFILE_SHA256}\n9223\t   49|         response = self._public('context.assemble', {'packet': packet, 'models': [], 'sources': [], 'late_acquisition': [], 'envelope': {'capacity_bytes': None, 'boundary': 'executor-stdin-utf8', 'host_context': {'state': 'unknown', 'bytes': None, 'evidence': None}}})\n9224\t   50|         self.assertEqual(response['refusal']['code'], 'basis_stale')\n9225\t   51| \n9226\t   52|     def test_native_profile_requires_exact_product_basis(self):\n9227\t   53|         value = json.loads((self.f.workspace / 'Product.json').read_text())\n9228\t   54|         value['constitution']['stdo']['basis']['manifest_sha256'] = '0' * 64\n9229\t   55|         self.f.definition = self.f.write('Product.json', value)\n9230\t   56|         self.f.policy['product']['definition'] = self.f.definition\n9231\t   57|         self._select_policy()\n9232\t   58|         with self.assertRaises(c.SupportError) as raised:\n9233\t   59|             c.Runtime.from_policy(self.policy_path, self.policy_sha, 'executive')\n9234\t   60|         self.assertEqual(raised.exception.code, 'basis_stale')\n9235\t   61| \n9236\t   62|     def test_native_public_retry_keeps_activation_history(self):\n9237\t   63|         legacy_tests.PublicRetryTests.test_public_reassembled_context_cannot_reset_activation_history(self)\n9238\t   64| \n9239\t   65|     def test_native_stale_source_stops_dispatch(self):\n9240\t   66|         material = self.f.write('inputs/material.txt', b'original deciding material')\n9241\t   67|         packet = self.f.packet()\n9242\t   68|         packet['attention']['semantic_sources'].append(material)\n9243\t   69|         context = self._assemble(packet)\n9244\t   70|         receipt = self._admit(context)\n9245\t   71|         (self.f.workspace / 'inputs/material.txt').write_text('changed deciding source\\n')\n9246\t   72|         response = self._public('dispatch.start', {'preflight': receipt})\n9247\t   73|         self.assertNotEqual(response['status'], 'ok')\n9248\t   74|         self.assertFalse(self.target.exists())\n9249\t   75| \n9250\t   76|     def test_actual_process_completion_capture_and_return_check(self):\n9251\t   77|         packet = self.f.packet()\n9252\t   78|         original = {'schema': 'a_c.fd-support.closed-return/1', 'id': 'fixture-return', 'frame': {k: packet['frame'][k] for k in ('id','revision')}, 'activation': c.activation_identity(packet), 'subject': self.f.subject, 'basis': self.f.basis, 'actor': {'id': 'worker','family': 'A','authorship': 'worker'}, 'consumer': 'executive', 'evaluations': [], 'not_performed': [], 'work_result': {'value': 'incomplete', 'cause': 'bounded fixture constructs no candidate', 'candidate': None, 'evidence': [], 'residuals': ['semantic work unperformed']}, 'residuals': ['semantic actor qualification not performed'], 'invalidators': []}\n9253\t   79|         payload = self.f.write('inputs/closed-return.json', original)\n9254\t   80|         actor = self.f.write('inputs/closed_actor.py', b'import sys\\nfrom pathlib import Path\\nsys.stdin.buffer.read()\\nsys.stdout.buffer.write(Path(sys.argv[1]).read_bytes())\\n')\n9255\t   81|         executor = self.f.policy['executors']['registered']\n9256\t   82|         executor['argv'] = [str(self.python), '-B', str(self.f.workspace / 'inputs/closed_actor.py'), str(self.f.workspace / 'inputs/closed-return.json')]\n9257\t   83|         executor['dependencies'] = [actor, payload]\n9258\t   84|         self._select_policy()\n9259\t   85|         context = self._assemble(packet)\n9260\t   86|         started = self._public('dispatch.start', {'preflight': self._admit(context)})\n9261\t   87|         attempt = started['result']['artifact']\n9262\t   88|         observed = self._ok(self._finished(attempt))\n9263\t   89|         self.assertEqual(observed['process_end']['returncode'], 0)\n9264\t   90|         captured = self._public('return.capture', {'attempt': attempt, 'payload': observed['output']['stdout'], 'return_contract': self.f.return_contract})\n9265\t   91|         value = self._ok(captured)\n9266\t   92|         self.assertTrue(value['producer']['authenticated'])\n9267\t   93|         self.assertEqual(value['binding_checks']['gaps'], [])\n9268\t   94|         checked = self._ok(self._public('return.check', {'return': captured['result']['artifact'], 'context': context, 'consumer': 'executive', 'observations': [], 'predicates': []}))\n9269\t   95|         self.assertTrue(checked['consumable'], checked['gaps'])\n9270\t   96|         self.assertEqual(checked['original']['work_result']['value'], 'incomplete')\n9271\t   97|         self.assertEqual(checked['original']['evaluations'], [])\n9272\t   98| \n9273\t   99| if __name__ == '__main__':\n9274\t  100|     unittest.main()\n9275\t  101| \n9276\t\n9277\t######## [36] tool:build_tenants/graphify/test_env/test_ac_support_native301_conjunction.py sel=None ########\n9278\t    1| \"\"\"Consumer-boundary controls with explicitly synthetic protected history.\n9279\t    2| \n9280\t    3| Actor authentication is a fixture premise; these are not ordinary actor trials.\n9281\t    4| Native301PublicTests separately covers the actual CLI/process return path.\n9282\t    5| \"\"\"\n9283\t    6| from pathlib import Path\n9284\t    7| import json\n9285\t    8| import tempfile\n9286\t    9| import unittest\n9287\t   10| import test_ac_support_core as t\n9288\t   11| c = t.c\n9289\t   12| \n9290\t   13| class ConjunctionProofConsumerTests(unittest.TestCase):\n9291\t   14|     def check(self, native, conjunction):\n9292\t   15|         with tempfile.TemporaryDirectory(prefix='native-conjunction-') as temp:\n9293\t   16|             f = t.Fixture(Path(temp).resolve())\n9294\t   17|             legacy = f.runtime()\n9295\t   18|             historical = f.artifact(legacy, 'operation', {'request': f.request('results.conjoin', {\n9296\t   19|                 'operator_id': 'claude-rc9.conjunction/1', 'plan': f.data,\n9297\t   20|                 'returns': [], 'current_observations': []}), 'response_without_evidence': {'result': {'artifact': None, 'value': {'judgment': {'core_value': 'satisfied'}}}}})\n9298\t   21|             if native:\n9299\t   22|                 profile = t.CODE.parent / 'design/fd-method-stdo-3.0.1.json'\n9300\t   23|                 (f.authorities / 'profile.json').write_bytes(profile.read_bytes())\n9301\t   24|                 f.basis['method_profile'] = {'id': c.NATIVE_PROFILE_ID, 'sha256': c.NATIVE_PROFILE_SHA256}\n9302\t   25|                 definition = json.loads((f.workspace / 'Product.json').read_text())\n9303\t   26|                 definition['constitution'] = {'stdo': {'basis': {'uri': 'stdo://releases/v3.0.1-rc.1/', 'manifest_sha256': c.NATIVE_MANIFEST_SHA256}}}\n9304\t   27|                 f.definition = f.write('Product.json', definition)\n9305\t   28|                 f.policy['product']['definition'] = f.definition\n9306\t   29|                 f.policy['method_profile'] = {**f.basis['method_profile'], 'source': f.ref(f.authorities / 'profile.json', 'authority', 'profile.json')}\n9307\t   30|             f.return_contract = f.write('inputs/executive-return.json', {\n9308\t   31|                 'schema': 'a_c.fd-support.return-contract/1', 'id': 'executive-return',\n9309\t   32|                 'authority_source': f.law, 'carrier': 'a_c.fd-support.closed-return/1',\n9310\t   33|                 'output_slot': 'final_stdout_object', 'required_evaluations': [], 'role': 'Executive',\n9311\t   34|                 'proof': {'mandate': f.law, 'consumed_results': [],\n9312\t   35|                     'conjunction': historical if conjunction else None,\n9313\t   36|                     'disposition_authority': None, 'predicate_ids': []}})\n9314\t   37|             runtime = f.runtime()\n9315\t   38|             packet = f.packet('Executive')\n9316\t   39|             response, _ = f.run(runtime, 'context.assemble', {'packet': packet, 'models': [], 'sources': [], 'late_acquisition': [], 'envelope': {'capacity_bytes': None, 'boundary': 'executor-stdin-utf8', 'host_context': {'state': 'unknown', 'bytes': None, 'evidence': None}}})\n9317\t   40|             self.assertEqual(response['status'], 'ok', response)\n9318\t   41|             context = response['result']['artifact']\n9319\t   42|             attempt = f.artifact(runtime, 'attempt', {'fixture': 'controlled producer'})\n9320\t   43|             original = {'schema': 'a_c.fd-support.closed-return/1', 'id': 'executive-closed',\n9321\t   44|                 'frame': {'id': 'frame', 'revision': '1'}, 'activation': c.activation_identity(packet),\n9322\t   45|                 'subject': f.subject, 'basis': f.basis,\n9323\t   46|                 'actor': {'id': 'executive', 'family': 'A', 'authorship': 'executive'},\n9324\t   47|                 'consumer': 'executive', 'evaluations': [], 'not_performed': [],\n9325\t   48|                 'work_result': None, 'residuals': [], 'invalidators': []}\n9326\t   49|             returned = f.artifact(runtime, 'return', {'attempt': attempt, 'original': original,\n9327\t   50|                 'binding_checks': {'gaps': []}, 'return_contract': f.return_contract,\n9328\t   51|                 'producer': {'authenticated': True}})\n9329\t   52|             readable, _ = f.run(runtime, 'evidence.read', {'artifact': historical})\n9330\t   53|             self.assertEqual(readable['status'], 'ok')\n9331\t   54|             self.assertEqual(readable['result']['value']['envelope']['provenance']['method_profile_sha256'], c.PROFILE_SHA256)\n9332\t   55|             checked, _ = f.run(runtime, 'return.check', {'return': returned, 'context': context,\n9333\t   56|                 'consumer': 'executive', 'observations': [], 'predicates': []})\n9334\t   57|             self.assertEqual(checked['status'], 'ok', checked)\n9335\t   58|             return checked['result']['value']\n9336\t   59| \n9337\t   60|     def test_native_rejects_historical_conjunction_proof(self):\n9338\t   61|         value = self.check(native=True, conjunction=True)\n9339\t   62|         self.assertFalse(value['consumable'], value)\n9340\t   63|         self.assertIn('Native conjunction proof is unsupported; historical evidence grants no translation', value['gaps'])\n9341\t   64| \n9342\t   65|     def test_native_without_conjunction_stays_consumable(self):\n9343\t   66|         value = self.check(native=True, conjunction=False)\n9344\t   67|         self.assertTrue(value['consumable'], value['gaps'])\n9345\t   68| \n9346\t   69|     def test_legacy_conjunction_behavior_is_preserved(self):\n9347\t   70|         value = self.check(native=False, conjunction=True)\n9348\t   71|         self.assertTrue(value['consumable'], value['gaps'])\n9349\t   72| \n9350\t\n9351\t######## [37] tool:specification/requirements/fd-stdo-3.0.1-binding.md sel=None ########\n9352\t    1| # Native STDO 3.0.1 consumer binding\n9353\t    2| \n9354\t    3| The owner selected STDO Skills as a separate Product pinned to released STDO\n9355\t    4| 3.0.1, with Codex and Claude skill tenants, and instructed the Executive to use\n9356\t    5| current tooling to construct it. This bounded a_c increment supplies that\n9357\t    6| consumer binding. The a_c builder and its RC9 historical evidence remain as\n9358\t    7| selected; the method used by the new consumer is a separate exact input.\n9359\t    8| \n9360\t    9| - N301-01: Accept only explicitly supported immutable method/profile identities.\n9361\t   10|   Native 3.0.1 use requires its exact released URI, manifest and source routes;\n9362\t   11|   stale or differently selected Product basis refuses.\n9363\t   12| - N301-02: Preserve the native method's packet, role, admission, result,\n9364\t   13|   currentness and authority relations through the public operation path.\n9365\t   14|   Carrier validation establishes its declared checked properties, not semantic\n9366\t   15|   sufficiency, independent assessment, acceptance or effect completion.\n9367\t   16| - N301-03: Preserve the separate predicates of operation payload availability,\n9368\t   17|   task construction, performed assessment and physical effects. Exhaustion or\n9369\t   18|   an unperformed assessment creates no universal result mapping.\n9370\t   19| - N301-04: Keep profile identity in provenance and dependent execution/replay\n9371\t   20|   checks. Context reassembly cannot erase activation history. Native selection\n9372\t   21|   does not relabel old evidence, admit a grant, or change a symbolic model's basis.\n9373\t   22| - N301-05: Make the supported fragment discoverable and usable by ordinary\n9374\t   23|   operators. Unqualified native operators must refuse explicitly. Setup examples\n9375\t   24|   and test fixtures grant no real Product work authority.\n9376\t   25| - N301-06: Demonstrate actual public CLI acquisition, context, preflight,\n9377\t   26|   process completion, original return capture/check and adverse controls, plus\n9378\t   27|   retained-profile regression. Controlled processes establish transport facts;\n9379\t   28|   real actor use and semantic assessment have separate qualification claims.\n9380\t   29| \n9381\t   30| STDO owns method meaning. A tool's named domain operation is not automatically\n9382\t   31| an F_D application under 3.0.1. Any new kind claim must establish that edition's\n9383\t   32| closed dependencies, outcome and totality obligations; authority remains in the\n9384\t   33| operation contract and actual grant.\n9385\t   34| \n9386\t\n9387\t######## [38] product:build_tenants/codex/README.md sel=None ########"}]},"parent_tool_use_id":null,"session_id":"628dfe7c-13d9-4c76-8146-64fd9787ee38","uuid":"ed31be4a-7a64-45d4-b3c9-f10d7c4f5179","timestamp":"2026-10-25T03:12:44.715Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jim/.claude/projects/-Users-jim-src-apps-specification-methodology-skills/628dfe7c-13d9-4c76-8146-64fd9787ee38/tool-results/barha86i9.txt","content":"######## [34] tool:build_tenants/graphify/test_env/test_ac_support_environment_passthrough.py sel=None ########\n    1| \"\"\"Actual native dispatch transport controls; no credential or model is acquired.\n    2| \n    3| The only credential-like value is freshly generated test data. A loopback test\n    4| oracle compares its actual child value in memory, retaining only a boolean.\n    5| All public requests, responses, helper evidence and test files are scanned for\n    6| the synthetic value before custody. Fixtures do not establish Product authority.\n    7| \"\"\"\n    8| from pathlib import Path\n    9| import hashlib\n   10| import json\n   11| import os\n   12| import secrets\n   13| import socket\n   14| import subprocess\n   15| import sys\n   16| import threading\n   17| import time\n   18| import unittest\n   19| \n   20| sys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"code\"))\n   21| import ac_support_core as c\n   22| import test_ac_support_native301 as native\n   23| \n   24| \n   25| NAME = \"CLAUDE_CODE_OAUTH_TOKEN\"\n   26| \n   27| \n   28| class EnvironmentPassthroughTests(unittest.TestCase):\n   29|     _select_policy = native.Native301PublicTests._select_policy\n   30|     _ok = native.Native301PublicTests._ok\n   31|     _assemble = native.Native301PublicTests._assemble\n   32|     _admit = native.Native301PublicTests._admit\n   33|     _finished = native.Native301PublicTests._finished\n   34|     tearDown = native.Native301PublicTests.tearDown\n   35| \n   36|     def setUp(self):\n   37|         native.Native301PublicTests.setUp(self)\n   38|         # Never copy the real test runner's environment or read its credentials.\n   39|         self.dispatch_environment = {\"PATH\": os.defpath, \"PYTHONDONTWRITEBYTECODE\": \"1\"}\n   40|         self.sentinel = secrets.token_urlsafe(48)\n   41|         self.oracle_observations = []\n   42| \n   43|     def _public(self, operation, arguments):\n   44|         self.sequence += 1\n   45|         folder = self.root / \"calls\" / (str(self.sequence).zfill(3) + \"-\" + operation)\n   46|         folder.mkdir(parents=True)\n   47|         request = {\"schema\": c.REQUEST, \"id\": \"public-\" + str(self.sequence),\n   48|                    \"operation\": operation, \"arguments\": arguments}\n   49|         path = folder / \"request.json\"\n   50|         path.write_bytes(c.canonical(request))\n   51|         argv = [str(self.python), \"-B\", str(self.code / \"ac_support.py\"),\n   52|                 \"--policy\", str(self.policy_path), \"--policy-sha256\", self.policy_sha,\n   53|                 \"--principal\", \"executive\", \"call\", \"--request\", str(path)]\n   54|         started = time.time_ns()\n   55|         result = subprocess.run(argv, cwd=self.root, capture_output=True, timeout=10,\n   56|                                 env=self.dispatch_environment, check=False)\n   57|         (folder / \"stdout.bin\").write_bytes(result.stdout)\n   58|         (folder / \"stderr.bin\").write_bytes(result.stderr)\n   59|         (folder / \"execution.json\").write_bytes(c.canonical({\n   60|             \"argv\": argv, \"started_ns\": started, \"ended_ns\": time.time_ns(),\n   61|             \"returncode\": result.returncode, \"policy_sha256\": self.policy_sha}))\n   62|         response = c.parse_json(result.stdout)\n   63|         self.assertIsNotNone(response[\"evidence\"], response)\n   64|         return response\n   65| \n   66|     def _prepare(self, executor_selected, helper_selected, supplied):\n   67|         if supplied:\n   68|             self.dispatch_environment[NAME] = self.sentinel\n   69|         listener = socket.socket()\n   70|         listener.bind((\"127.0.0.1\", 0))\n   71|         listener.listen(1)\n   72|         listener.settimeout(8)\n   73|         self.addCleanup(listener.close)\n   74|         port = listener.getsockname()[1]\n   75| \n   76|         def oracle():\n   77|             try:\n   78|                 connection, _ = listener.accept()\n   79|                 with connection:\n   80|                     raw = b\"\"\n   81|                     while True:\n   82|                         part = connection.recv(1024)\n   83|                         if not part:\n   84|                             break\n   85|                         raw += part\n   86|                     # No synthetic value or digest leaves this test process.\n   87|                     self.oracle_observations.append({\n   88|                         \"present\": raw[:1] == b\"1\",\n   89|                         \"unchanged\": raw == b\"1\" + self.sentinel.encode(),\n   90|                     })\n   91|             except OSError:\n   92|                 self.oracle_observations.append({\"oracle_failed\": True})\n   93| \n   94|         self.oracle_thread = threading.Thread(target=oracle, daemon=True)\n   95|         self.oracle_thread.start()\n   96|         vendor = self.f.write(\"inputs/synthetic_vendor.py\", b'''import json,os,socket,sys\n   97| sys.stdin.buffer.read()\n   98| value=os.environ.get(\"CLAUDE_CODE_OAUTH_TOKEN\")\n   99| with socket.create_connection((\"127.0.0.1\",int(sys.argv[1])),timeout=3) as connection:\n  100|  connection.sendall(b\"0\" if value is None else b\"1\"+value.encode())\n  101|  connection.shutdown(socket.SHUT_WR)\n  102| if value is None:\n  103|  print(json.dumps({\"type\":\"result\",\"subtype\":\"error\",\"is_error\":True,\"error\":\"authentication_failed\",\"result\":\"Synthetic credential missing\",\"total_cost_usd\":0}))\n  104|  raise SystemExit(1)\n  105| print(json.dumps({\"type\":\"result\",\"subtype\":\"success\",\"is_error\":False,\"result\":json.dumps({\"schema\":\"a_c.fd-support.closed-return/1\",\"opaque\":\"synthetic transport only\"})}))\n  106| ''')\n  107|         tenant = self.code.parent\n  108|         helper = tenant / \"examples/fd-support/actor_cli.py\"\n  109|         core = self.code / \"ac_support_core.py\"\n  110|         self.f.policy[\"sources\"][\"tool\"] = {\n  111|             \"path\": str(tenant), \"kind\": \"workspace\", \"writable\": False,\n  112|             \"read_scope\": [{\"path\": \"code\", \"kind\": \"directory\"},\n  113|                            {\"path\": \"examples/fd-support\", \"kind\": \"directory\"}]}\n  114|         settings = {\"scope\": \"synthetic transport control only\"}\n  115|         if helper_selected:\n  116|             settings[\"environment_passthrough\"] = [NAME]\n  117|         document = {\n  118|             \"schema\": \"a_c.fd-support.actor-cli-plan/1\", \"id\": \"synthetic-auth-transport\",\n  119|             \"backend\": \"claude\",\n  120|             \"executable\": {\"path\": str(self.python), \"sha256\": hashlib.sha256(self.python.read_bytes()).hexdigest()},\n  121|             \"argv\": [str(self.python), \"-B\", str(self.f.workspace / vendor[\"path\"]), str(port)],\n  122|             \"dependencies\": [{\"path\": str(self.f.workspace / vendor[\"path\"]), \"sha256\": vendor[\"sha256\"]}],\n  123|             \"cwd\": str(self.f.workspace), \"environment\": {\"PYTHONDONTWRITEBYTECODE\": \"1\"},\n  124|             \"settings\": settings, \"decoder\": \"claude-result-json/1\",\n  125|             \"evidence_directory\": str(self.root / \"helper-output\"),\n  126|             \"limits\": {\"max_input_bytes\": 1048576, \"max_output_bytes\": 1048576,\n  127|                        \"timeout_ms\": 3000, \"termination_grace_ms\": 100}}\n  128|         plan_ref = self.f.write(\"inputs/actor-plan.json\", document)\n  129|         executor = self.f.policy[\"executors\"][\"registered\"]\n  130|         executor[\"argv\"] = [str(self.python), \"-B\", str(helper), \"--plan\",\n  131|                             str(self.f.workspace / plan_ref[\"path\"]), \"--plan-sha256\", plan_ref[\"sha256\"]]\n  132|         executor[\"dependencies\"] = [vendor, plan_ref,\n  133|             self.f.ref(helper, \"tool\", \"examples/fd-support/actor_cli.py\"),\n  134|             self.f.ref(core, \"tool\", \"code/ac_support_core.py\")]\n  135|         executor[\"settings\"] = {\"timeout_ms\": 5000, \"termination_grace_ms\": 100}\n  136|         if executor_selected:\n  137|             executor[\"settings\"][\"environment_passthrough\"] = [NAME]\n  138|         self._select_policy()\n  139|         return document\n  140| \n  141|     def _whole_path(self, *, executor_selected, helper_selected, supplied):\n  142|         self._prepare(executor_selected, helper_selected, supplied)\n  143|         receipt = self._admit(self._assemble())\n  144|         started = self._public(\"dispatch.start\", {\"preflight\": receipt})\n  145|         self._ok(started)\n  146|         attempt = started[\"result\"][\"artifact\"]\n  147|         observed = self._ok(self._finished(attempt, timeout=8))\n  148|         self.oracle_thread.join(timeout=2)\n  149|         expected = executor_selected and helper_selected and supplied\n  150|         self.assertEqual(self.oracle_observations, [{\"present\": expected, \"unchanged\": expected}])\n  151|         result = json.loads((self.root / \"helper-output/result.json\").read_bytes())\n  152|         self.assertEqual(result[\"output_available\"], expected)\n  153|         self.assertIsNone(result[\"semantic_result\"])\n  154|         self.assertEqual(observed[\"process_end\"][\"returncode\"], 0 if expected else 1)\n  155|         invocation = json.loads((self.root / \"helper-output/invocation.json\").read_bytes())\n  156|         if helper_selected:\n  157|             self.assertEqual(invocation[\"environment_passthrough\"],\n  158|                              [{\"name\": NAME, \"present\": executor_selected and supplied}])\n  159|         else:\n  160|             self.assertNotIn(\"environment_passthrough\", invocation)\n  161|         retained = self._ok(self._public(\"evidence.read\", {\"artifact\": attempt}))[\"envelope\"][\"payload\"]\n  162|         if executor_selected:\n  163|             self.assertEqual(retained[\"invocation\"][\"environment_passthrough\"], [{\"name\": NAME, \"present\": supplied}])\n  164|         else:\n  165|             self.assertNotIn(\"environment_passthrough\", retained[\"invocation\"])\n  166|         (self.root / \"ORACLE.json\").write_bytes(c.canonical({\n  167|             \"observations\": self.oracle_observations,\n  168|             \"scope\": \"Synthetic value compared in memory after actual dispatcher/supervisor/helper/vendor traversal; no model or real credentials\"}))\n  169|         for path in self.root.rglob(\"*\"):\n  170|             if path.is_file():\n  171|                 self.assertFalse(self.sentinel.encode() in path.read_bytes(), str(path.relative_to(self.root)))\n  172| \n  173|     def test_selected_value_crosses_complete_native_path_without_retention(self):\n  174|         self._whole_path(executor_selected=True, helper_selected=True, supplied=True)\n  175| \n  176|     def test_selected_missing_value_remains_missing_and_transport_fails(self):\n  177|         self._whole_path(executor_selected=True, helper_selected=True, supplied=False)\n  178| \n  179|     def test_no_selection_preserves_exact_environment_behavior(self):\n  180|         self._whole_path(executor_selected=False, helper_selected=False, supplied=True)\n  181| \n  182|     def test_helper_selection_cannot_recover_value_dropped_by_supervisor(self):\n  183|         self._whole_path(executor_selected=False, helper_selected=True, supplied=True)\n  184| \n  185|     def test_executor_selection_does_not_enable_unselected_helper(self):\n  186|         self._whole_path(executor_selected=True, helper_selected=False, supplied=True)\n  187| \n  188|     def test_preflight_refuses_unsupported_or_value_bearing_selection(self):\n  189|         for selected in ([\"PATH\"], [NAME, NAME], {NAME: \"not-a-credential\"}, NAME):\n  190|             with self.subTest(selection_type=type(selected).__name__):\n  191|                 self.f.policy[\"executors\"][\"registered\"][\"settings\"][\"environment_passthrough\"] = selected\n  192|                 self._select_policy()\n  193|                 response = self._public(\"contract.preflight\", {\"context\": self._assemble(),\n  194|                     \"grant_id\": \"work\", \"executor_id\": \"registered\", \"result_key\": \"refused-selection\", \"observations\": []})\n  195|                 self.assertEqual(response[\"refusal\"][\"code\"], \"unsupported_executor\")\n  196| \n  197|     def test_serialized_credential_is_refused_by_preflight_and_helper(self):\n  198|         document = self._prepare(True, True, False)\n  199|         executor = self.f.policy[\"executors\"][\"registered\"]\n  200|         executor[\"environment\"][NAME] = \"invalid-inline-test-data\"\n  201|         self._select_policy()\n  202|         refused = self._public(\"contract.preflight\", {\"context\": self._assemble(),\n  203|             \"grant_id\": \"work\", \"executor_id\": \"registered\", \"result_key\": \"refused-inline\", \"observations\": []})\n  204|         self.assertEqual(refused[\"refusal\"][\"code\"], \"unsupported_executor\")\n  205|         helper = self.code.parent / \"examples/fd-support/actor_cli.py\"\n  206|         for selected, explicit, backend in [([\"PATH\"], {}, \"claude\"), ([NAME, NAME], {}, \"claude\"),\n  207|                                             ([NAME], {NAME: \"invalid-inline-test-data\"}, \"claude\"),\n  208|                                             ([NAME], {}, \"codex\")]:\n  209|             document[\"settings\"][\"environment_passthrough\"] = selected\n  210|             document[\"environment\"] = explicit\n  211|             document[\"backend\"] = backend\n  212|             document[\"decoder\"] = \"claude-result-json/1\" if backend == \"claude\" else \"codex-final-jsonl/1\"\n  213|             path = self.root / \"invalid-plan.json\"\n  214|             path.write_bytes(c.canonical(document))\n  215|             result = subprocess.run([str(self.python), \"-B\", str(helper), \"--plan\", str(path),\n  216|                     \"--plan-sha256\", hashlib.sha256(path.read_bytes()).hexdigest()],\n  217|                     input=b\"\", capture_output=True, env=self.dispatch_environment, timeout=5)\n  218|             self.assertEqual(result.returncode, 2)\n  219|             self.assertFalse((self.root / \"helper-output\").exists())\n  220| \n  221| \n  222| if __name__ == \"__main__\":\n  223|     unittest.main()\n  224| \n\n######## [35] tool:build_tenants/graphify/test_env/test_ac_support_native301.py sel=None ########\n    1| \"\"\"Native public-path fixtures; no LLM/semantic/production admission qualification.\"\"\"\n    2| from pathlib import Path\n    3| import json\n    4| import sys\n    5| import unittest\n    6| sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'code'))\n    7| import ac_support_core as c\n    8| import test_ac_support_effects as legacy_tests\n    9| \n   10| class Native301PublicTests(unittest.TestCase):\n   11|     _public = legacy_tests.PublicRetryTests._public\n   12|     _select_policy = legacy_tests.PublicRetryTests._select_policy\n   13|     _ok = legacy_tests.PublicRetryTests._ok\n   14|     _assemble = legacy_tests.PublicRetryTests._assemble\n   15|     _admit = legacy_tests.PublicRetryTests._admit\n   16|     _finished = legacy_tests.PublicRetryTests._finished\n   17|     tearDown = legacy_tests.PublicRetryTests.tearDown\n   18| \n   19|     def setUp(self):\n   20|         legacy_tests.PublicRetryTests.setUp(self)\n   21|         profile = self.code.parent / 'design/fd-method-stdo-3.0.1.json'\n   22|         (self.f.authorities / 'profile.json').write_bytes(profile.read_bytes())\n   23|         self.native = {'id': c.NATIVE_PROFILE_ID, 'sha256': c.NATIVE_PROFILE_SHA256}\n   24|         self.f.basis['method_profile'] = self.native\n   25|         definition = json.loads((self.f.workspace / 'Product.json').read_text())\n   26|         definition['constitution'] = {'stdo': {'basis': {'uri': 'stdo://releases/v3.0.1-rc.1/', 'manifest_sha256': c.NATIVE_MANIFEST_SHA256}}}\n   27|         self.f.definition = self.f.write('Product.json', definition)\n   28|         self.f.policy['product']['definition'] = self.f.definition\n   29|         self.f.policy['method_profile'] = {**self.native, 'source': self.f.ref(self.f.authorities / 'profile.json', 'authority', 'profile.json')}\n   30|         self._select_policy()\n   31| \n   32|     def test_discovery_acquisition_observation_and_native_provenance(self):\n   33|         discovery = self._ok(self._public('tools.describe', {'method_profile': self.native}))\n   34|         self.assertEqual(discovery['method_profile'], self.native)\n   35|         self.assertNotIn('results.conjoin', [x['name'] for x in discovery['operations']])\n   36|         source = self._public('source.read', {'source': self.f.law, 'encoding': 'utf8'})\n   37|         self.assertEqual(self._ok(source)['content'], 'one\\ntwo\\nthree\\n')\n   38|         self.assertEqual(source['operation_outcome']['source_parent']['sha256'], c.NATIVE_FOUNDATIONS_SHA256)\n   39|         operation = self._ok(self._public('evidence.read', {'artifact': source['evidence']}))\n   40|         self.assertEqual(operation['envelope']['provenance']['method_profile_sha256'], c.NATIVE_PROFILE_SHA256)\n   41|         observed = self._ok(self._public('workspace.observe', {'scope': [{'root': 'workspace', 'path': 'inputs/law.txt', 'kind': 'file'}]}))\n   42|         self.assertTrue(observed['entries'])\n   43|         refused = self._public('tools.describe', {'operation': 'results.conjoin'})\n   44|         self.assertEqual(refused['refusal']['code'], 'unsupported_check')\n   45| \n   46|     def test_legacy_packet_is_not_relabelled_native(self):\n   47|         packet = self.f.packet()\n   48|         packet['subject_basis']['method_profile'] = {'id': c.PROFILE_ID, 'sha256': c.PROFILE_SHA256}\n   49|         response = self._public('context.assemble', {'packet': packet, 'models': [], 'sources': [], 'late_acquisition': [], 'envelope': {'capacity_bytes': None, 'boundary': 'executor-stdin-utf8', 'host_context': {'state': 'unknown', 'bytes': None, 'evidence': None}}})\n   50|         self.assertEqual(response['refusal']['code'], 'basis_stale')\n   51| \n   52|     def test_native_profile_requires_exact_product_basis(self):\n   53|         value = json.loads((self.f.workspace / 'Product.json').read_text())\n   54|         value['constitution']['stdo']['basis']['manifest_sha256'] = '0' * 64\n   55|         self.f.definition = self.f.write('Product.json', value)\n   56|         self.f.policy['product']['definition'] = self.f.definition\n   57|         self._select_policy()\n   58|         with self.assertRaises(c.SupportError) as raised:\n   59|             c.Runtime.from_policy(self.policy_path, self.policy_sha, 'executive')\n   60|         self.assertEqual(raised.exception.code, 'basis_stale')\n   61| \n   62|     def test_native_public_retry_keeps_activation_history(self):\n   63|         legacy_tests.PublicRetryTests.test_public_reassembled_context_cannot_reset_activation_history(self)\n   64| \n   65|     def test_native_stale_source_stops_dispatch(self):\n   66|         material = self.f.write('inputs/material.txt', b'original deciding material')\n   67|         packet = self.f.packet()\n   68|         packet['attention']['semantic_sources'].append(material)\n   69|         context = self._assemble(packet)\n   70|         receipt = self._admit(context)\n   71|         (self.f.workspace / 'inputs/material.txt').write_text('changed deciding source\\n')\n   72|         response = self._public('dispatch.start', {'preflight': receipt})\n   73|         self.assertNotEqual(response['status'], 'ok')\n   74|         self.assertFalse(self.target.exists())\n   75| \n   76|     def test_actual_process_completion_capture_and_return_check(self):\n   77|         packet = self.f.packet()\n   78|         original = {'schema': 'a_c.fd-support.closed-return/1', 'id': 'fixture-return', 'frame': {k: packet['frame'][k] for k in ('id','revision')}, 'activation': c.activation_identity(packet), 'subject': self.f.subject, 'basis': self.f.basis, 'actor': {'id': 'worker','family': 'A','authorship': 'worker'}, 'consumer': 'executive', 'evaluations': [], 'not_performed': [], 'work_result': {'value': 'incomplete', 'cause': 'bounded fixture constructs no candidate', 'candidate': None, 'evidence': [], 'residuals': ['semantic work unperformed']}, 'residuals': ['semantic actor qualification not performed'], 'invalidators': []}\n   79|         payload = self.f.write('inputs/closed-return.json', original)\n   80|         actor = self.f.write('inputs/closed_actor.py', b'import sys\\nfrom pathlib import Path\\nsys.stdin.buffer.read()\\nsys.stdout.buffer.write(Path(sys.argv[1]).read_bytes())\\n')\n   81|         executor = self.f.policy['executors']['registered']\n   82|         executor['argv'] = [str(self.python), '-B', str(self.f.workspace / 'inputs/closed_actor.py'), str(self.f.workspace / 'inputs/closed-return.json')]\n   83|         executor['dependencies'] = [actor, payload]\n   84|         self._select_policy()\n   85|         context = self._assemble(packet)\n   86|         started = self._public('dispatch.start', {'preflight': self._admit(context)})\n   87|         attempt = started['result']['artifact']\n   88|         observed = self._ok(self._finished(attempt))\n   89|         self.assertEqual(observed['process_end']['returncode'], 0)\n   90|         captured = self._public('return.capture', {'attempt': attempt, 'payload': observed['output']['stdout'], 'return_contract': self.f.return_contract})\n   91|         value = self._ok(captured)\n   92|         self.assertTrue(value['producer']['authenticated'])\n   93|         self.assertEqual(value['binding_checks']['gaps'], [])\n   94|         checked = self._ok(self._public('return.check', {'return': captured['result']['artifact'], 'context': context, 'consumer': 'executive', 'observations': [], 'predicates': []}))\n   95|         self.assertTrue(checked['consumable'], checked['gaps'])\n   96|         self.assertEqual(checked['original']['work_result']['value'], 'incomplete')\n   97|         self.assertEqual(checked['original']['evaluations'], [])\n   98| \n   99| if __name__ == '__main__':\n  100|     unittest.main()\n  101| \n\n######## [36] tool:build_tenants/graphify/test_env/test_ac_support_native301_conjunction.py sel=None ########\n    1| \"\"\"Consumer-boundary controls with explicitly synthetic protected history.\n    2| \n    3| Actor authentication is a fixture premise; these are not ordinary actor trials.\n    4| Native301PublicTests separately covers the actual CLI/process return path.\n    5| \"\"\"\n    6| from pathlib import Path\n    7| import json\n    8| import tempfile\n    9| import unittest\n   10| import test_ac_support_core as t\n   11| c = t.c\n   12| \n   13| class ConjunctionProofConsumerTests(unittest.TestCase):\n   14|     def check(self, native, conjunction):\n   15|         with tempfile.TemporaryDirectory(prefix='native-conjunction-') as temp:\n   16|             f = t.Fixture(Path(temp).resolve())\n   17|             legacy = f.runtime()\n   18|             historical = f.artifact(legacy, 'operation', {'request': f.request('results.conjoin', {\n   19|                 'operator_id': 'claude-rc9.conjunction/1', 'plan': f.data,\n   20|                 'returns': [], 'current_observations': []}), 'response_without_evidence': {'result': {'artifact': None, 'value': {'judgment': {'core_value': 'satisfied'}}}}})\n   21|             if native:\n   22|                 profile = t.CODE.parent / 'design/fd-method-stdo-3.0.1.json'\n   23|                 (f.authorities / 'profile.json').write_bytes(profile.read_bytes())\n   24|                 f.basis['method_profile'] = {'id': c.NATIVE_PROFILE_ID, 'sha256': c.NATIVE_PROFILE_SHA256}\n   25|                 definition = json.loads((f.workspace / 'Product.json').read_text())\n   26|                 definition['constitution'] = {'stdo': {'basis': {'uri': 'stdo://releases/v3.0.1-rc.1/', 'manifest_sha256': c.NATIVE_MANIFEST_SHA256}}}\n   27|                 f.definition = f.write('Product.json', definition)\n   28|                 f.policy['product']['definition'] = f.definition\n   29|                 f.policy['method_profile'] = {**f.basis['method_profile'], 'source': f.ref(f.authorities / 'profile.json', 'authority', 'profile.json')}\n   30|             f.return_contract = f.write('inputs/executive-return.json', {\n   31|                 'schema': 'a_c.fd-support.return-contract/1', 'id': 'executive-return',\n   32|                 'authority_source': f.law, 'carrier': 'a_c.fd-support.closed-return/1',\n   33|                 'output_slot': 'final_stdout_object', 'required_evaluations': [], 'role': 'Executive',\n   34|                 'proof': {'mandate': f.law, 'consumed_results': [],\n   35|                     'conjunction': historical if conjunction else None,\n   36|                     'disposition_authority': None, 'predicate_ids': []}})\n   37|             runtime = f.runtime()\n   38|             packet = f.packet('Executive')\n   39|             response, _ = f.run(runtime, 'context.assemble', {'packet': packet, 'models': [], 'sources': [], 'late_acquisition': [], 'envelope': {'capacity_bytes': None, 'boundary': 'executor-stdin-utf8', 'host_context': {'state': 'unknown', 'bytes': None, 'evidence': None}}})\n   40|             self.assertEqual(response['status'], 'ok', response)\n   41|             context = response['result']['artifact']\n   42|             attempt = f.artifact(runtime, 'attempt', {'fixture': 'controlled producer'})\n   43|             original = {'schema': 'a_c.fd-support.closed-return/1', 'id': 'executive-closed',\n   44|                 'frame': {'id': 'frame', 'revision': '1'}, 'activation': c.activation_identity(packet),\n   45|                 'subject': f.subject, 'basis': f.basis,\n   46|                 'actor': {'id': 'executive', 'family': 'A', 'authorship': 'executive'},\n   47|                 'consumer': 'executive', 'evaluations': [], 'not_performed': [],\n   48|                 'work_result': None, 'residuals': [], 'invalidators': []}\n   49|             returned = f.artifact(runtime, 'return', {'attempt': attempt, 'original': original,\n   50|                 'binding_checks': {'gaps': []}, 'return_contract': f.return_contract,\n   51|                 'producer': {'authenticated': True}})\n   52|             readable, _ = f.run(runtime, 'evidence.read', {'artifact': historical})\n   53|             self.assertEqual(readable['status'], 'ok')\n   54|             self.assertEqual(readable['result']['value']['envelope']['provenance']['method_profile_sha256'], c.PROFILE_SHA256)\n   55|             checked, _ = f.run(runtime, 'return.check', {'return': returned, 'context': context,\n   56|                 'consumer': 'executive', 'observations': [], 'predicates': []})\n   57|             self.assertEqual(checked['status'], 'ok', checked)\n   58|             return checked['result']['value']\n   59| \n   60|     def test_native_rejects_historical_conjunction_proof(self):\n   61|         value = self.check(native=True, conjunction=True)\n   62|         self.assertFalse(value['consumable'], value)\n   63|         self.assertIn('Native conjunction proof is unsupported; historical evidence grants no translation', value['gaps'])\n   64| \n   65|     def test_native_without_conjunction_stays_consumable(self):\n   66|         value = self.check(native=True, conjunction=False)\n   67|         self.assertTrue(value['consumable'], value['gaps'])\n   68| \n   69|     def test_legacy_conjunction_behavior_is_preserved(self):\n   70|         value = self.check(native=False, conjunction=True)\n   71|         self.assertTrue(value['consumable'], value['gaps'])\n   72| \n\n######## [37] tool:specification/requirements/fd-stdo-3.0.1-binding.md sel=None ########\n    1| # Native STDO 3.0.1 consumer binding\n    2| \n    3| The owner selected STDO Skills as a separate Product pinned to released STDO\n    4| 3.0.1, with Codex and Claude skill tenants, and instructed the Executive to use\n    5| current tooling to construct it. This bounded a_c increment supplies that\n    6| consumer binding. The a_c builder and its RC9 historical evidence remain as\n    7| selected; the method used by the new consumer is a separate exact input.\n    8| \n    9| - N301-01: Accept only explicitly supported immutable method/profile identities.\n   10|   Native 3.0.1 use requires its exact released URI, manifest and source routes;\n   11|   stale or differently selected Product basis refuses.\n   12| - N301-02: Preserve the native method's packet, role, admission, result,\n   13|   currentness and authority relations through the public operation path.\n   14|   Carrier validation establishes its declared checked properties, not semantic\n   15|   sufficiency, independent assessment, acceptance or effect completion.\n   16| - N301-03: Preserve the separate predicates of operation payload availability,\n   17|   task construction, performed assessment and physical effects. Exhaustion or\n   18|   an unperformed assessment creates no universal result mapping.\n   19| - N301-04: Keep profile identity in provenance and dependent execution/replay\n   20|   checks. Context reassembly cannot erase activation history. Native selection\n   21|   does not relabel old evidence, admit a grant, or change a symbolic model's basis.\n   22| - N301-05: Make the supported fragment discoverable and usable by ordinary\n   23|   operators. Unqualified native operators must refuse explicitly. Setup examples\n   24|   and test fixtures grant no real Product work authority.\n   25| - N301-06: Demonstrate actual public CLI acquisition, context, preflight,\n   26|   process completion, original return capture/check and adverse controls, plus\n   27|   retained-profile regression. Controlled processes establish transport facts;\n   28|   real actor use and semantic assessment have separate qualification claims.\n   29| \n   30| STDO owns method meaning. A tool's named domain operation is not automatically\n   31| an F_D application under 3.0.1. Any new kind claim must establish that edition's\n   32| closed dependencies, outcome and totality obligations; authority remains in the\n   33| operation contract and actual grant.\n   34| \n\n######## [38] product:build_tenants/codex/README.md sel=None ########","numLines":440,"startLine":8948,"totalLines":9949}},"tool_result_meta":[{"id":"toolu_01BjGzod6NLBCr54aas4Yt8F","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
