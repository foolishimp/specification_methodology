ce-regular-file\",\n   77|       \"object\": null,\n   78|       \"path\": \"specification/SOURCE_OWNERS.md\",\n   79|       \"root\": \"product\",\n   80|       \"selector\": null,\n   81|       \"sha256\": \"15300e9871b842cb6ab81b360fe9717766638e82abc2d1cf06c5cebc2febfca3\"\n   82|     },\n   83|     {\n   84|       \"engine\": \"workspace-regular-file\",\n   85|       \"object\": null,\n   86|       \"path\": \"specification/requirements/README.md\",\n   87|       \"root\": \"product\",\n   88|       \"selector\": null,\n   89|       \"sha256\": \"dcc2564e597d3d3c8fcff025a515f4a92a62e7f3aa2f7ba80af97f7db75f6acc\"\n   90|     },\n   91|     {\n   92|       \"engine\": \"workspace-regular-file\",\n   93|       \"object\": null,\n   94|       \"path\": \"specification/requirements/SCENARIOS.md\",\n   95|       \"root\": \"product\",\n   96|       \"selector\": null,\n   97|       \"sha256\": \"089221fb9d7eee532f91c6ef40a4bfdaaa18c00fcc28bc2f538ddd6b6e3ff03e\"\n   98|     },\n   99|     {\n  100|       \"engine\": \"workspace-regular-file\",\n  101|       \"object\": null,\n  102|       \"path\": \"build_tenants/graphify/code/ac_support.py\",\n  103|       \"root\": \"tool\",\n  104|       \"selector\": null,\n  105|       \"sha256\": \"d238c15bd2ea5b94789417efd00339f4a610d4637ddfdfe661441424661134c7\"\n  106|     },\n  107|     {\n  108|       \"engine\": \"workspace-regular-file\",\n  109|       \"object\": null,\n  110|       \"path\": \"build_tenants/graphify/code/ac_support_core.py\",\n  111|       \"root\": \"tool\",\n  112|       \"selector\": null,\n  113|       \"sha256\": \"bf72a28444e0497cd564066e41c7e5943810d5a2e0be5488c92fa5add5a67209\"\n  114|     },\n  115|     {\n  116|       \"engine\": \"workspace-regular-file\",\n  117|       \"object\": null,\n  118|       \"path\": \"build_tenants/graphify/code/ac_support_effects.py\",\n  119|       \"root\": \"tool\",\n  120|       \"selector\": null,\n  121|       \"sha256\": \"d9b5ff7d147930dbd368a63991ffe1f77