{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TBZy9kF6jmaTEe2f3oFJ8H","type":"tool_result","content":"1836\t            raise SupportError(\"contract_violation\", \"Dispatch grant requires exact registered notification binding\")\n1837\t        sink = as_object(as_object(runtime.policy[\"event_sinks\"])[text(sink_id)])\n1838\t        exact_keys(sink, (\"kind\", \"directory\", \"consumer\", \"authority_source\", \"retention\"))\n1839\t        if sink[\"kind\"] != \"durable-file-events\" or sink[\"retention\"] != \"indefinite\":\n1840\t            raise SupportError(\"unsupported_contract\", \"Unsupported sink kind/retention\")\n1841\t        _relative(text(sink[\"directory\"]))\n1842\t        if sink[\"consumer\"] != evidence[\"consumer\"]:\n1843\t            raise SupportError(\"contract_violation\", \"Grant-selected sink consumer differs from activated packet\")\n1844\t        read_source(runtime, as_object(sink[\"authority_source\"]))\n1845\t    guard(\"Product result consumer\", as_object(authority[\"result_surface\"])[\"consumer\"] == evidence[\"consumer\"], \"result_surface_denied\")\n1846\t    if executor[\"stdin_mode\"] != \"context-utf8\":\n1847\t        raise SupportError(\"unsupported_executor\", \"Unsupported executor stdin contract\")\n1848\t    executable = as_object(executor[\"executable\"]); exact_keys(executable, (\"path\", \"sha256\"))\n1849\t    if _sha(_regular_bytes(Path(text(executable[\"path\"])))) != executable[\"sha256\"]:\n1850\t        raise SupportError(\"dependency_changed\", \"Executor executable preimage changed\")\n1851\t    argv = _strings(executor[\"argv\"])\n1852\t    if not argv or argv[0] != executable[\"path\"] or not Path(text(executor[\"cwd\"])).is_absolute():\n1853\t        raise SupportError(\"unsupported_executor\", \"Fixed executor argv/cwd not bound to executable\")\n1854\t    if any(not isinstance(value, str) for value in as_object(executor[\"environment\"]).values()):\n1855\t        raise SupportError(\"unsupported_executor\", \"Executor environment must be an explicit string map\")\n1856\t    environment_passthrough(executor[\"settings\"], executor[\"environment\"])\n1857\t    admission = _admission_selection(grant[\"admission\"])\n1858\t    if admission[\"mechanism_id\"] != \"product-policy-preflight/1\":\n1859\t        raise SupportError(\"unsupported_contract\", \"Unsupported selected admission mechanism\")\n1860\t    read_source(runtime, as_object(admission[\"mechanism_source\"])); read_source(runtime, as_object(admission[\"authority_source\"]))\n1861\t    contract: Object = document({\"context\": context_ref, \"grant_id\": grant_id, \"executor_id\": executor_id,\n1862\t                        \"result_key\": args[\"result_key\"], \"requester\": runtime.principal_id,\n1863\t                        \"target\": target_id, \"policy_sha256\": runtime.policy_sha256})\n1864\t    contract_sha = digest(contract)\n1865\t    observations = as_list(args[\"observations\"])\n1866\t    if not _equal(context[\"observations\"], observations):\n1867\t        guard(\"context observation currentness\", False, \"basis_stale\")\n1868\t    fit = as_object(context[\"fit\"])\n1869\t    fit_judgment = fit.get(\"judgment\")\n1870\t    if fit.get(\"selected\") is True:\n1871\t        guard(\"selected required full-active-input fit\", isinstance(fit_judgment, dict) and fit_judgment.get(\"core_value\") == \"satisfied\", \"basis_missing\")\n1872\t    sources: list[JSON] = list(_all_source_refs(packet)) + _context_material_sources(context) + as_list(grant[\"authority_sources\"]) + [as_object(grant[\"outcome\"])[\"source\"], admission[\"mechanism_source\"], admission[\"authority_source\"], as_object(as_object(runtime.policy[\"product\"])[\"authority_binding\"])[\"owner_record\"]]\n1873\t    if sink is not None:\n1874\t        sources.append(sink[\"authority_source\"])\n1875\t    source_preconditions: list[JSON] = []"}]},"parent_tool_use_id":null,"session_id":"99e1b978-3749-4e94-9