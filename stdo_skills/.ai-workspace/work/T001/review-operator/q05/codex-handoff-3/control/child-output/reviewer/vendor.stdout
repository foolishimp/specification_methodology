ordinates\":null,\"encoding\":\"utf8\",\"parent_sha256\":\"eed988f799576ba8b33bfe2af830edd6d7fe53ac0c8bde13d760268df6102089\",\"selected_sha256\":\"eed988f799576ba8b33bfe2af830edd6d7fe53ac0c8bde13d760268df6102089\",\"size_bytes\":2293,\"source\":{\"engine\":\"workspace-regular-file\",\"object\":null,\"path\":\".qualification/OWNER.json\",\"root\":\"product\",\"selector\":null,\"sha256\":\"eed988f799576ba8b33bfe2af830edd6d7fe53ac0c8bde13d760268df6102089\"}}},\"schema\":\"a_c.fd-support.response/1\",\"status\":\"ok\"}"}],"structured_content":{"evidence":{"id":"sha256:9f42c497596021fb225d18010bb33dde9711e7e03ebd6f29925d7f6e75d78d3c","sha256":"9f42c497596021fb225d18010bb33dde9711e7e03ebd6f29925d7f6e75d78d3c"},"id":"q05-handoff3-reviewer-governing-7","operation":"source.read","operation_outcome":{"cause":"declared output available","core_value":"satisfied","evidence":[],"limits":["output availability only; no semantic acceptance"],"predicate":"B(source.read)[request_sha256=ed7a5b6114d44d9f04a3dca999db3014e653ae87ed6350fd04395b12cd9cbe00]: declared output availability","source_parent":{"clause":"results","member":"FOUNDATIONS.md","sha256":"92fe2f3c09a59b4e9a732463a41d4a45d7efd693648159621e03c75f7127eac5"},"value":"returned"},"refusal":null,"result":{"artifact":null,"value":{"acquisition":{},"content":"{\n  \"authority\": \"User authorized decoupled two-tenant skill dogfood; Root selected exact Q05 structure and prospective child600s/Executive900s ceilings. Root selects concrete readiness before launch; children dispatch only under actual Executive principal. The named result consumer is this actual installed native Executive, distinct from the external Root operator.\",\n  \"mechanism\": {\n    \"id\": \"product-policy-preflight/1\",\n    \"implementation_sha256\": \"bf72a28444e0497cd564066e41c7e5943810d5a2e0be5488c92fa5add5a67209\",\n    \"source\": {\n      \"engine\": \"workspace-regular-file\",\n      \"object\": null,\n      \"path\": \"build_tenants/graphify/code/ac_support_core.py\",\n      \"root\": \"tool\",\n      \"selector\": null,\n      \"sha256\": \"bf72a28444e0497cd564066e41c7e5943810d5a2e0be5488c92fa5add5a67209\"\n    }\n  },\n  \"result_surface\": {\n    \"consumer\": \"urn:stdo-skills:T001:q05:codex:handoff:3:executive\",\n    \"namespace\": \"results\",\n    \"root\": \"/Users/jim/src/apps/specification_methodology-skills/stdo_skills/.ai-workspace/work/T001/review-operator/q05/codex-handoff-3/control/evidence\"\n  },\n  \"scope\": {\n    \"forbidden\": [\n      \"Executive candidate mutation\",\n      \"Reviewer candidate mutation\",\n      \"oracle acquisition\",\n      \"Git/remote/global configuration\",\n      \"ungranted scratch/redirection/deletion\",\n      \"unselected launches\"\n    ],\n    \"host_artifact_writes\": [\n      \"outputs/greeting.txt by Worker only\"\n    ],\n    \"limits\": \"Cooperative role/tool grants, not an OS confinement or universal external-effect claim\",\n    \"physical_capture\": [\n      \"/Users/jim/src/apps/specification_methodology-skills/stdo_skills/.ai-workspace/work/T001/review-operator/q05/codex-handoff-3/control/actor-output\",\n      \"/Users/jim/src/apps/specification_methodology-skills/stdo_skills/.ai-workspace/work/T001/review-operator/q05/codex-handoff-3/control/child-output\",\n      \"/Users/jim/src/apps/specification_methodology-skills/stdo_skills/.ai-workspace/work/T001/review-operator/q05/codex-handoff-3/control/tmp\"\n    ],\n    \"public_evidence\": \"/Users/jim/src/apps/specification_methodology-skills/stdo_skills/.ai-workspace/work/T001/review-operator/q05/codex-handoff-3/control/evidence\",\n    \"purpose\": \"Root-selected actual installed-skill Q05 handoff, exact staged child plans only\"\n  }\n}\n","coordinates":null,"encoding":"utf8","parent_sha256":"eed988f799576ba8b33bfe2af830edd6d7fe53ac0c8bde13d760268df6102089","selected_sha256":"eed988f799576ba8b33bfe2af830edd6d7fe53ac0c8bde13d760268df6102089","size_bytes":2293,"source":{"engine":"workspace-regu