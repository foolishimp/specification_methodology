": \"roles/PREDICATES.md\",\n        \"root\": \"control\",\n        \"selector\": null,\n        \"sha256\": \"724dee7972dc6f7429bbbd2c018ea76f4b7e05887b6f636db6a07a525ed4c1db\"\n      }\n    }\n  ],\n  \"role\": \"Reviewer\",\n  \"schema\": \"a_c.fd-support.return-contract/1\"\n}\n","coordinates":null,"encoding":"utf8","parent_sha256":"6d31bfc8f6d996c3429adadc321e646b769b83852866cf14300d73ae652c638c","selected_sha256":"6d31bfc8f6d996c3429adadc321e646b769b83852866cf14300d73ae652c638c","size_bytes":1479,"source":{"engine":"workspace-regular-file","object":null,"path":"roles/reviewer-RETURN-CONTRACT.json","root":"control","selector":null,"sha256":"6d31bfc8f6d996c3429adadc321e646b769b83852866cf14300d73ae652c638c"}}},"schema":"a_c.fd-support.response/1","status":"ok"}},"error":null,"status":"completed"}}
