UTES. First acquire with phase=expectation,candidate=null,proof=[],comparison=null,expectations=null,expectation_body=null; retain the actual source_input acquisition refs. Derive a compact expectation from R1/R2/D1/authority and record it with expectation_body={text:your expectations,source_inputs:[actual acquisition ArtifactRefs]}. Do not manufacture an expectation or claim candidate review. Emit the original closed return per roles/RETURN.md, evaluate expectation-recording with actual evidence, candidate-review not_performed, work_result=null. Use the new Context identities and original new-Context observation basis. 600s ceiling; no scratch, candidate mutation or new model launch.\\n\",\"coordinates\":null,\"encoding\":\"utf8\",\"parent_sha256\":\"ec68b8a2722b9dbef6d9650f5d551b8f41065149762d6cfedd0c7c55f63ce6b9\",\"selected_sha256\":\"ec68b8a2722b9dbef6d9650f5d551b8f41065149762d6cfedd0c7c55f63ce6b9\",\"size_bytes\":1364,\"source\":{\"engine\":\"workspace-regular-file\",\"object\":null,\"path\":\"roles/reviewer-TASK.md\",\"root\":\"phase\",\"selector\":null,\"sha256\":\"ec68b8a2722b9dbef6d9650f5d551b8f41065149762d6cfedd0c7c55f63ce6b9\"}}},\"schema\":\"a_c.fd-support.response/1\",\"status\":\"ok\"}"}],"structured_content":{"evidence":{"id":"sha256:a215fb5bea9e118b99fc5b7491b330f389bf33eaefd42747ebcaa069c4710ba6","sha256":"a215fb5bea9e118b99fc5b7491b330f389bf33eaefd42747ebcaa069c4710ba6"},"id":"exec-reentry1-task-read","operation":"source.read","operation_outcome":{"cause":"declared output available","core_value":"satisfied","evidence":[],"limits":["output availability only; no semantic acceptance"],"predicate":"B(source.read)[request_sha256=2646950db1032c66353e7f72bcbeaef3df9caa484b556ce25961e887e33b675b]: declared output availability","source_parent":{"clause":"results","member":"FOUNDATIONS.md","sha256":"92fe2f3c09a59b4e9a732463a41d4a45d7efd693648159621e03c75f7127eac5"},"value":"returned"},"refusal":null,"result":{"artifact":null,"value":{"acquisition":{},"conte